[416.361967, "o", "    for sub_id, ratio, rank in substitutes.get(leaf, []):\r\n\u001b[?2004l\r"]
[416.362069, "o", "\u001b[?2004h> "]
[416.362489, "o", "        stock = inv_before.get(sub_id, 0)\r\n\u001b[?2004l\r"]
[416.362518, "o", "\u001b[?2004h> "]
[416.362916, "o", "        if stock > 0 and ratio > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.362948, "o", "> "]
[416.363371, "o", "            total += int(stock // ratio)\r\n\u001b[?2004l\rq"]
[416.3634, "o", "\u001b[?2004h> "]
[416.36361, "o", "    return total\r\n\u001b[?2004l\r"]
[416.363644, "o", "\u001b[?2004h> "]
[416.363719, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.363748, "o", "> "]
[416.364325, "o", "def compute_leaf_usage(leaf_demands, inv_before):\r\n\u001b[?2004l\roc\u001b[?2004h"]
[416.364353, "o", "> "]
[416.364712, "o", "    consume_own = defaultdict(float)\r\n\u001b[?2004l\r"]
[416.364778, "o", "\u001b[?2004h> "]
[416.365141, "o", "    consume_sub = defaultdict(float)\r\n\u001b[?2004l\r"]
[416.365243, "o", "\u001b[?2004h> "]
[416.365438, "o", "    feasible = True\r\n\u001b[?2004l\rt"]
[416.365468, "o", "\u001b[?2004h> "]
[416.36595, "o", "    for leaf, demand in leaf_demands.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.366207, "o", "        if demand <= 0:\r\n\u001b[?2004l\r"]
[416.366236, "o", "\u001b[?2004h> "]
[416.366457, "o", "            continue\r\n\u001b[?2004l\r"]
[416.366487, "o", "\u001b[?2004h> "]
[416.366832, "o", "        own = inv_before.get(leaf, 0)\r\n\u001b[?2004l\r"]
[416.366868, "o", "\u001b[?2004h> "]
[416.367199, "o", "        use_own = min(own, demand)\r\n\u001b[?2004l\r"]
[416.367233, "o", "\u001b[?2004h"]
[416.367293, "o", "> "]
[416.367587, "o", "        consume_own[leaf] = use_own\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.367622, "o", "> "]
[416.367956, "o", "        remaining = demand - use_own\r\n\u001b[?2004l\r"]
[416.367985, "o", "\u001b[?2004h> "]
[416.368282, "o", "        if remaining <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.368314, "o", "> "]
[416.368522, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.368556, "o", "> "]
[416.369095, "o", "        for sub_id, ratio, rank in substitutes.get(leaf, []):\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.369229, "o", "> "]
[416.369496, "o", "            if remaining <= 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.369567, "o", "> "]
[416.369745, "o", "                break\r\n\u001b[?2004l\r"]
[416.369779, "o", "\u001b[?2004h> "]
[416.370201, "o", "            stock = inv_before.get(sub_id, 0)\r\n\u001b[?2004l\r"]
[416.370294, "o", "\u001b[?2004h> "]
[416.370607, "o", "            if stock <= 0 or ratio <= 0:\r\n\u001b[?2004l\r"]
[416.37064, "o", "\u001b[?2004h> "]
[416.370899, "o", "                continue\r\n\u001b[?2004l\r"]
[416.370932, "o", "\u001b[?2004h> "]
[416.371345, "o", "            cover = int(stock // ratio)\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.371372, "o", "> "]
[416.37182, "o", "            use_primary = int(min(remaining, cover))\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.371848, "o", "> "]
[416.37219, "o", "            if use_primary > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.372225, "o", "> "]
[416.372942, "o", "                consume_sub[sub_id] = consume_sub.get(sub_id, 0) + use_primary * ratio\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.372968, "o", "> "]
[416.373374, "o", "                remaining -= use_primary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.37367, "o", "        if remaining > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.373762, "o", "> "]
[416.373971, "o", "            feasible = False\r\n\u001b[?2004l\r"]
[416.374003, "o", "\u001b[?2004h"]
[416.374102, "o", "> "]
[416.374462, "o", "    return feasible, consume_own, consume_sub\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.37449, "o", "> \r\n\u001b[?2004l\r"]
[416.374561, "o", "\u001b[?2004h"]
[416.374589, "o", "> "]
[416.374886, "o", "def is_feasible(plan, inv_before):\r\n\u001b[?2004l\r"]
[416.374914, "o", "\u001b[?2004h> "]
[416.37521, "o", "    # Workcenter feasibility\r\n\u001b[?2004l\r"]
[416.375303, "o", "\u001b[?2004h> "]
[416.375667, "o", "    for wc_id, hrs in plan['wc_req'].items():\r\n\u001b[?2004l\r"]
[416.375697, "o", "\u001b[?2004h> "]
[416.376048, "o", "        avail = wc_avail.get(wc_id, 0)\r\n\u001b[?2004l\r"]
[416.376084, "o", "\u001b[?2004h> "]
[416.376413, "o", "        if hrs > avail + 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.376441, "o", "> "]
[416.376682, "o", "            return False\r\n\u001b[?2004l\r"]
[416.37671, "o", "\u001b[?2004h> "]
[416.376938, "o", "    # Leaf feasibility\r\n\u001b[?2004l\r"]
[416.376966, "o", "\u001b[?2004h> "]
[416.377637, "o", "    feasible, *_ = compute_leaf_usage(plan['leaf_demands'], inv_before)\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.377678, "o", "> "]
[416.377856, "o", "    return feasible\r\n\u001b[?2004l\r"]
[416.377884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[416.377989, "o", "\u001b[?2004h> "]
[416.378195, "o", "report_orders = []\r\n\u001b[?2004l\r"]
[416.378257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[416.378308, "o", "\u001b[?2004h> "]
[416.378651, "o", "for order in orders_sorted_by_priority:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.378729, "o", "> "]
[416.378941, "o", "    oid = order['order_id']\r\n\u001b[?2004l\r"]
[416.379005, "o", "\u001b[?2004h> "]
[416.37943, "o", "    product_id = order['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.379779, "o", "    requested = order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.379811, "o", "> "]
[416.380228, "o", "    product_batch = batch_size.get(product_id, 1)\r\n\u001b[?2004l\r"]
[416.380286, "o", "\u001b[?2004h> "]
[416.380365, "o", "    \r\n\u001b[?2004l\r"]
[416.380429, "o", "\u001b[?2004h> "]
[416.380909, "o", "    print('\\nProcessing order', oid, 'product', product_id, 'requested', requested)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.381146, "o", "    print('Before state:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.381546, "o", "    print('  inv', {k: inv[k] for k in sorted(inv)})\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.381594, "o", "> "]
[416.381801, "o", "    print('  WC  ', wc_avail)\r\n\u001b[?2004l\r"]
[416.381853, "o", "\u001b[?2004h> "]
[416.381906, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[416.381947, "o", "> "]
[416.38201, "o", "    max_q = 0"]
[416.382071, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.382234, "o", "    max_plan = None\r\n\u001b[?2004l\r"]
[416.38229, "o", "\u001b[?2004h> "]
[416.382712, "o", "    for q in range(product_batch, requested + 1, product_batch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.383071, "o", "        plan = calc_plan(product_id, q, inv)\r\n\u001b[?2004l\r"]
[416.383128, "o", "\u001b[?2004h> "]
[416.383378, "o", "        if is_feasible(plan, inv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.383572, "o", "            max_q = q\r\n\u001b[?2004l\r"]
[416.383629, "o", "\u001b[?2004h> "]
[416.383805, "o", "            max_plan = plan\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.383843, "o", "> "]
[416.38396, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.38404, "o", "> "]
[416.384113, "o", "            break\r\n\u001b[?2004l\r"]
[416.384198, "o", "\u001b[?2004h> "]
[416.384243, "o", "    \r\n\u001b[?2004l\r"]
[416.384322, "o", "\u001b[?2004h> "]
[416.384504, "o", "    short = requested - max_q\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.384538, "o", "> "]
[416.384696, "o", "    limiting = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.384723, "o", "> "]
[416.384781, "o", "    \r\n\u001b[?2004l\r"]
[416.384805, "o", "\u001b[?2004h> "]
[416.384963, "o", "    if short > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.384995, "o", "> "]
[416.385293, "o", "        next_q = max_q + product_batch\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.385327, "o", "> "]
[416.385707, "o", "        next_plan = calc_plan(product_id, next_q, inv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.385734, "o", "> "]
[416.385901, "o", "        ratios = {}\r\n\u001b[?2004l\r"]
[416.385935, "o", "\u001b[?2004h> "]
[416.386388, "o", "        for leaf, gross in next_plan['leaf_demands'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.386619, "o", "            if gross <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.386841, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.387306, "o", "            available = leaf_equivalent_available(leaf, inv)\r\n\u001b[?2004l\r"]
[416.387332, "o", "\u001b[?2004h> "]
[416.387693, "o", "            ratios[leaf] = available / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.388107, "o", "        for wc_id, gross in next_plan['wc_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.38839, "o", "            if gross <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.388582, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.38861, "o", "> "]
[416.388946, "o", "            available = wc_avail.get(wc_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.389349, "o", "            ratios[wc_id] = available / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.389959, "o", "        below_one = {res: ratio for res, ratio in ratios.items() if ratio < 1.0 - 1e-12}\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.389988, "o", "> "]
[416.390208, "o", "        if below_one:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.390453, "o", "            limiting = min(below_one, key=lambda res: (below_one[res], str(res)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.390537, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.390639, "o", "            limiting = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.390933, "o", "        print('  Failed next qty', next_q, 'ratios', ratios, 'limiting', limiting)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[416.39096, "o", "\u001b[?2004h> "]
[416.391081, "o", "    if max_q > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.391438, "o", "        plan = max_plan if max_plan is not None else calc_plan(product_id, max_q, inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.39155, "o", "        # commit production plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.391739, "o", "        for part, prod in plan['productions'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.391881, "o", "            if prod['build'] > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.392199, "o", "                # Add produced extras and remove consumed subassembly inventory\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.392462, "o", "                inv[part] = inv.get(part, 0) - prod['use'] + prod['extra']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.392586, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.392799, "o", "                inv[part] = inv.get(part, 0) - prod['use']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.392987, "o", "        for wc_id, hrs in plan['wc_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.393246, "o", "            wc_avail[wc_id] = wc_avail.get(wc_id, 0) - hrs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.393375, "o", "        # commit leaf consumption\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.393912, "o", "        feasible, own_use, sub_use = compute_leaf_usage(plan['leaf_demands'], inv_before=dict(inv)) if False else compute_leaf_usage(plan['leaf_demands'], inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.394313, "o", "        # To be exactly relative to state before order, recompute using a snapshot of before-order inv.\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.394572, "o", "    print('After state (production partial, leaf cons soon):')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.394767, "o", "    print('  inv', {k: inv[k] for k in sorted(inv)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.3949, "o", "    print('  WC  ', wc_avail)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[416.394929, "o", "\u001b[?2004h> "]
[416.395395, "o", "    report_orders.append({'order_id': oid, 'allocated_qty': max_q, 'shortfall_qty': short, 'limiting_resource': limiting})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[416.395432, "o", "> "]
[416.395728, "o", "# The above commit block has a bug; we will rewrite carefully in the final script.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.395954, "o", "print('\\n\\nBug mentioned in script placeholder; need fix.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[416.396039, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[416.489233, "o", "Initial inventory: {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'SUB_L3_A': 12, 'SUB_L3_B': 8, 'SA1': 3, 'SA2': 0, 'P1': 0, 'P2': 0, 'P3': 0, 'P4': 0, 'P5': 0, 'P_B': 0}\r\nInitial WC: {'WC1': 250.0, 'WC2': 100.0, 'WC_TIE': 10.0}\r\nOrders by priority: [('O1', 'P1', 12), ('O2', 'P2', 10), ('O3', 'P3', 10), ('O3b', 'P_B', 10), ('O4', 'P4', 5), ('O5', 'P5', 100)]\r\n\r\nProcessing order O1 product P1 requested 12\r\nBefore state:\r\n  inv {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'P1': 0, 'P2': 0, 'P3': 0, 'P4': 0, 'P5': 0, 'P_B': 0, 'SA1': 3, 'SA2': 0, 'SUB_L3_A': 12, 'SUB_L3_B': 8}\r\n  WC   {'WC1': 250.0, 'WC2': 100.0, 'WC_TIE': 10.0}\r\n"]
