[416.489802, "o", "  inv {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'P1': 0.0, 'P2': 0, 'P3': 0, 'P4': 0, 'P5': 0, 'P_B': 0, 'SA1': 1.0, 'SA2': 0, 'SUB_L3_A': 12, 'SUB_L3_B': 8}\r\n  WC   {'WC1': 227.0, 'WC2': 100.0, 'WC_TIE': 10.0}\r\n"]
[416.490095, "o", "  Failed next qty 9 ratios {'L2': 0.819672131147541, 'L1': 1.6666666666666667, 'WC1': 5.044444444444444, 'WC2': 2.0} limiting L2\r\nAfter state (production partial, leaf cons soon):\r\n  inv {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'P1': 0.0, 'P2': 0.0, 'P3': 0, 'P4': 0, 'P5': 0, 'P_B': 0, 'SA1': 1.0, 'SA2': 0.0, 'SUB_L3_A': 12, 'SUB_L3_B': 8}\r\n"]
[416.490129, "o", "  WC   {'WC1': 187.0, 'WC2': 58.0, 'WC_TIE': 10.0}\r\n\r\nProcessing order O3 product P3 requested 10\r\n"]
[416.490305, "o", "Before state:\r\n  inv {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'P1': 0.0, 'P2': 0.0, 'P3': 0, 'P4': 0, 'P5': 0, 'P_B': 0, 'SA1': 1.0, 'SA2': 0.0, 'SUB_L3_A': 12, 'SUB_L3_B': 8}\r\n  WC   {'WC1': 187.0, 'WC2': 58.0, 'WC_TIE': 10.0}\r\n"]
[416.490467, "o", "  Failed next qty 6 ratios {'L3': 0.9666666666666667, 'WC2': 8.285714285714286} limiting L3\r\nAfter state (production partial, leaf cons soon):\r\n  inv {'L1': 200, 'L2': 50, 'L3': 15, 'L4': 10, 'L_TIE': 10, 'P1': 0.0, 'P2': 0.0, 'P3': 0.0, 'P4': 0, 'P5': 0, 'P_B': 0, 'SA1': 1.0, 'SA2': 0.0, 'SUB_L3_A': 12, 'SUB_L3_B': 8}\r\n  WC   {'WC1': 187.0, 'WC2': 52.0, 'WC_TIE': 10.0}\r\n\r\nProcessing order"]
