[416.274576, "i", " wc_req}\n\ndef leaf_equivalent_available(leaf, inv_before):\n    total = inv_before.get(leaf, 0)\n    for sub_id, ratio, rank in substitutes.get(leaf, []):\n        stock = inv_before.get(sub_id, 0)\n        if stock > 0 and ratio > 0:\n            total += int(stock // ratio)\n    return total\n\ndef compute_leaf_usage(leaf_demands, inv_before):\n    consume_own = defaultdict(float)\n    consume_sub = defaultdict(float)\n    feasible = True\n    for leaf, demand in leaf_demands.items():\n        if demand <= 0:\n            continue\n        own = inv_before.get(leaf, 0)\n        use_own = min(own, demand)\n        consume_own[leaf] = use_own\n        remaining = demand - use_own\n        if remaining <= 0:\n            continue\n        for sub_id, ratio, rank in substitutes.get(leaf, []):\n            if remaining <= 1e-12:\n                break\n            stock = inv_before.get(sub_id, 0)\n            if stock <= 0 or ratio <= 0:\n                continue\n            cover = int(stock // ratio)\n            use_primary = int(min("]
