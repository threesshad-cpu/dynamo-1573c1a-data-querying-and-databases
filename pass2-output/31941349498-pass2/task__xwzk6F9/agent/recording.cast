[636.004732, "i", "cat > /tmp/process_bom.py <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict\n\nDB = '/app/manufacturing.db'\nconn = sqlite3.connect(DB)\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Load parts/inventory\nparts = {}\ncur.execute('SELECT * FROM parts')\nfor r in cur:\n    parts[r['part_id']] = {\n        'name': r['name'],\n        'on_hand_qty': r['on_hand_qty'],\n        'batch_size': r['batch_size']\n    }\n\ninv = {pid: parts[pid]['on_hand_qty'] for pid in parts}\nbatch_size = {pid: parts[pid]['batch_size'] for pid in parts}\n\n# Load BOM\nbom_children = defaultdict(list)\ncur.execute('SELECT * FROM bom')\nfor r in cur:\n    bom_children[r['parent_part_id']].append(\n        (r['child_part_id'], r['qty_per'], r['scrap_rate_pct'], r['setup_scrap_qty'])\n    )\n\n# Load routing\nrouting = defaultdict(list)\ncur.execute('SELECT * FROM routing')\nfor r in cur:\n    routing[r['parent_part_id']].append(\n        (r['workcenter_id'], r['setup_hours'], r['run_hours_per_unit'])\n    )\n\n# Load workcenters\nworkcenters ="]
[636.004804, "i", " {}\ncur.execute('SELECT * FROM workcenters')\nfor r in cur:\n    workcenters[r['workcenter_id']] = {\n        'name': r['name'],\n        'available_hours': r['available_hours']\n    }\n\nwc_avail = {wid: workcenters[wid]['available_hours'] for wid in workcenters}\n\n# Load substitutes, ordered by rank and id\nsubstitutes = defaultdict(list)\ncur.execute('SELECT * FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id')\nfor r in cur:\n    substitutes[r['primary_part_id']].append(\n        (r['substitute_part_id'], r['qty_ratio'], r['preference_rank'])\n    )\n\n# Load orders\norders = []\ncur.execute('SELECT * FROM orders')\nfor r in cur:\n    orders.append({\n        'order_id': r['order_id'],\n        'product_part_id': r['product_part_id'],\n        'requested_qty': r['requested_qty'],\n        'priority': r['priority']\n    })\norders_by_priority = sorted(orders, key=lambda o: (o['priority'], o['order_id']))\n\n\ndef topological_manufactured_order(product_id):\n    \"\"\"Return all parts reachable in this BOM sort"]
[636.005041, "i", "ed parents before children.\"\"\"\n    dist = {product_id: 0}\n    def dfs(p):\n        for child, *_ in bom_children.get(p, []):\n            nd = dist[p] + 1\n            if nd > dist.get(child, -1):\n                dist[child] = nd\n                dfs(child)\n    dfs(product_id)\n    return sorted(dist.keys(), key=lambda p: dist[p])\n\n\ndef calc_plan(product_id, qty, inv_before):\n    \"\"\"Compute aggregate production plan and gross leaf demands for qty units.\"\"\"\n    demand = defaultdict(float)\n    demand[product_id] += float(qty)\n    productions = {}\n    wc_req = defaultdict(float)\n    topo_parts = topological_manufactured_order(product_id)\n\n    for part in topo_parts:\n        d = demand.get(part, 0.0)\n        if part not in bom_children:\n            continue  # leaf, no children\n\n        if d <= 1e-12:\n            productions[part] = {\n                'use': 0.0, 'build': 0.0, 'extra': 0.0,\n                'hours_by_wc': {}, 'rem': 0.0\n            }\n            continue\n\n        on_hand = float(inv_before.get(part, 0))"]
[636.00513, "i", "\n        use = min(on_hand, d)\n        rem = d - use\n\n        if rem <= 1e-12:\n            productions[part] = {\n                'use': use, 'build': 0.0, 'extra': 0.0,\n                'hours_by_wc': {}, 'rem': rem\n            }\n            continue\n\n        bs = batch_size.get(part, 1)\n        build = int(math.ceil(rem / bs)) * bs\n        extra = float(build - rem)\n\n        hours_by_wc = {}\n        for wc_id, setup_h, run_h in routing.get(part, []):\n            hrs = setup_h + run_h * build\n            hours_by_wc[wc_id] = hrs\n            wc_req[wc_id] += hrs\n\n        productions[part] = {\n            'use': use, 'build': build, 'extra': extra,\n            'hours_by_wc': hours_by_wc, 'rem': rem\n        }\n\n        # Propagate child requirements based on actual build quantity.\n        for child, qty_per, scrap_pct, setup_scrap in bom_children.get(part, []):\n            base = qty_per * build\n            need = int(math.ceil(base * (1.0 + scrap_pct / 100.0))) + setup_scrap\n            demand[child] += need\n\n   "]
[636.005252, "o", "cat > /tmp/process_bom.py <<'PY'\r\n"]
[636.005334, "i", " leaf_demands = {p: demand[p] for p in demand if p not in bom_children and demand[p] > 1e-12}\n    return {'leaf_demands': leaf_demands, 'productions': productions, 'wc_req': wc_req}\n\n\ndef leaf_equiv_available(leaf, inv_before):\n    total = float(inv_before.get(leaf, 0))\n    for sub_id, ratio, rank in substitutes.get(leaf, []):\n        stock = float(inv_before.get(sub_id, 0))\n        if stock > 0 and ratio > 0:\n            total += float(math.floor(stock / ratio))\n    return total\n\n\ndef compute_leaf_usage(leaf_demands, inv_before):\n    consume_own = defaultdict(float)\n    consume_sub = defaultdict(float)\n    feasible = True\n\n    for leaf, d in leaf_demands.items():\n        remaining = float(d)\n        own_stock = float(inv_before.get(leaf, 0))\n        use_own = min(own_stock, remaining)\n        consume_own[leaf] = use_own\n        remaining -= use_own\n\n        if remaining <= 1e-12:\n            continue\n\n        for sub_id, ratio, rank in substitutes.get(leaf, []):\n            if remaining <= 1e-12:\n           "]
[636.005365, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[636.005427, "i", "     break\n            stock = float(inv_before.get(sub_id, 0))\n            if stock <= 0 or ratio <= 0:\n                continue\n            cover = int(math.floor(stock / ratio))\n            use_primary = min(float(cover), remaining)\n            if use_primary > 0:\n                consume_sub[sub_id] += use_primary * ratio\n                remaining -= use_primary\n\n        if remaining > 1e-12:\n            feasible = False\n\n    return feasible, consume_own, consume_sub\n\n\ndef is_feasible(plan, inv_before):\n    # Workcenter feasibility\n    for wc_id, hrs in plan['wc_req'].items():\n        if hrs > wc_avail.get(wc_id, 0.0) + 1e-12:\n            return False\n    feasible_leaves, _, _ = compute_leaf_usage(plan['leaf_demands'], inv_before)\n    return feasible_leaves\n\n\nreport_orders = []\n\nfor order in orders_by_priority:\n    oid = order['order_id']\n    product = order['product_part_id']\n    requested = order['requested_qty']\n    product_batch = batch_size.get(product, 1)\n\n    before_inv = dict(inv)\n    before_wc = d"]
[636.005463, "i", "ict(wc_avail)\n\n    max_q = 0\n    max_plan = None\n\n    # Test candidate production quantities in increasing order.\n    for q in range(0, requested + 1, product_batch):\n        plan = calc_plan(product, q, before_inv)\n        if is_feasible(plan, before_inv):\n            max_q = q\n            max_plan = plan\n        else:\n            break\n\n    shortfall = requested - max_q\n    limiting = None\n\n    if shortfall > 0:\n        next_q = max_q + product_batch\n        next_plan = calc_plan(product, next_q, before_inv)\n        ratios = {}\n\n        for leaf, gross in next_plan['leaf_demands'].items():\n            avail = leaf_equiv_available(leaf, before_inv)\n            ratios[leaf] = avail / float(gross)\n\n        for wc_id, gross in next_plan['wc_req'].items():\n            avail = before_wc.get(wc_id, 0.0)\n            ratios[wc_id] = avail / float(gross)\n\n        below_one = {res: ratio for res, ratio in ratios.items() if ratio < 1.0 - 1e-12}\n        if below_one:\n            limiting = min(below_one, key=lambda res:"]
[636.005531, "i", " (below_one[res], str(res)))\n        # If no ratio below 1, leave limiting as null as not expected.\n\n    # Commit the best feasible plan (if any quantity > 0)\n    if max_q > 0:\n        plan = max_plan\n        feasible_leaves, own_use, sub_use = compute_leaf_usage(plan['leaf_demands'], before_inv)\n\n        # Update leaf and substitute inventories.\n        leaf_usage = defaultdict(float)\n        for leaf, used in own_use.items():\n            leaf_usage[leaf] += used\n        for sub_id, used in sub_use.items():\n            leaf_usage[sub_id] += used\n\n        used_leaf_ids = set(leaf_usage.keys())\n        for part in list(plan['productions'].keys()) + list(used_leaf_ids):\n            pass  # just ensure all potentially affected parts are considered below\n\n        # Apply manufactured-part inventory changes first using before snapshot.\n        for part, prod in plan['productions'].items():\n            inv[part] = before_inv.get(part, 0.0) - prod['use'] + prod['extra']\n\n        # Apply leaf consumption using before"]
[636.005567, "i", " snapshot, overriding/additively for leaf ids.\n        for part in used_leaf_ids:\n            inv[part] = before_inv.get(part, 0.0) - leaf_usage.get(part, 0.0)\n\n        # Apply workcenter consumption.\n        for wc_id, hrs in plan['wc_req'].items():\n            wc_avail[wc_id] = wc_avail.get(wc_id, 0.0) - hrs\n\n    report_orders.append({\n        'order_id': oid,\n        'allocated_qty': max_q,\n        'shortfall_qty': shortfall,\n        'limiting_resource': limiting\n    })\n\nreport_orders_sorted = sorted(report_orders, key=lambda x: x['order_id'])\nreport = {'orders': report_orders_sorted}\n\nwith open('/app/report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(json.dumps(report, indent=2))\nconn.close()\nPY\npython3 /tmp/process_bom.py\n"]
