[636.027696, "o", "\u001b[?2004h> "]
[636.028155, "o", "        'requested_qty': r['requested_qty'],\r\n\u001b[?2004l\r"]
[636.028236, "o", "\u001b[?2004h> "]
[636.028608, "o", "        'priority': r['priority']\r\n\u001b[?2004l\r \u001b[?2004h"]
[636.028661, "o", "> "]
[636.028748, "o", "    })\r\n\u001b[?2004l\r"]
[636.02878, "o", "\u001b[?2004h> "]
[636.029651, "o", "orders_by_priority = sorted(orders, key=lambda o: (o['priority'], o['order_id']))\r\n\u001b[?2004l\r"]
[636.029682, "o", "\u001b[?2004h> "]
[636.029738, "o", "\r\n\u001b[?2004l\re"]
[636.029795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd"]
