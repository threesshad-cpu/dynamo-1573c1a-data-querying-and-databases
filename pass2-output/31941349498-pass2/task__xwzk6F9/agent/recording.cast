[75.21399, "i", "python3 - <<'PY'\nimport sqlite3\nconn=sqlite3.connect('/app/manufacturing.db')\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\nfor r in cur:\n    print(r['name'])\nprint('---SCHEMA---')\nfor table in ['parts','bom','workcenters','routing','substitutes','orders']:\n    print('\\nTABLE', table)\n    cur.execute(f\"SELECT sql FROM sqlite_master WHERE type='table' AND name='{table}'\")\n    row=cur.fetchone()\n    if row: print(row[0])\nconn.close()\nPY\n"]
