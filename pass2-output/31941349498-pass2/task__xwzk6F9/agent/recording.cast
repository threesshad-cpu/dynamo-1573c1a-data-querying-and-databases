[636.0304, "o", "def topological_manufactured_order(product_id):\r\n\u001b[?2004l\ruc\u001b[?2004h"]
[636.030482, "o", "> "]
[636.031242, "o", "    \"\"\"Return all parts reachable in this BOM sorted parents before children.\"\"\"\r\n\u001b[?2004l\r"]
[636.03127, "o", "\u001b[?2004h> "]
[636.031563, "o", "    dist = {product_id: 0}\r\n\u001b[?2004l\r"]
[636.031598, "o", "\u001b[?2004h> "]
[636.031832, "o", "    def dfs(p):\r\n\u001b[?2004l\rr\u001b[?2004h"]
[636.031862, "o", "> "]
[636.032398, "o", "        for child, *_ in bom_children.get(p, []):\r\n\u001b[?2004l\rq\u001b[?2004h"]
[636.032434, "o", "> "]
[636.032757, "o", "            nd = dist[p] + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.032851, "o", "> "]
[636.03324, "o", "            if nd > dist.get(child, -1):\r\n\u001b[?2004l\r"]
[636.033329, "o", "\u001b[?2004h> "]
[636.033666, "o", "                dist[child] = nd\r\n\u001b[?2004l\r if\u001b[?2004h"]
[636.033695, "o", "> "]
[636.033987, "o", "                dfs(child)\r\n\u001b[?2004l\r"]
[636.034077, "o", "\u001b[?2004h> "]
[636.034345, "o", "    dfs(product_id)\r\n\u001b[?2004l\rx\u001b[?2004h"]
[636.034375, "o", "> "]
[636.034929, "o", "    return sorted(dist.keys(), key=lambda p: dist[p])\r\n\u001b[?2004l\r \u001b[?2004h"]
[636.035023, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[636.035052, "o", "> \r\n\u001b[?2004l\r "]
[636.035135, "o", "\u001b[?2004h> "]
[636.035594, "o", "def calc_plan(product_id, qty, inv_before):\r\n\u001b[?2004l\rx_\u001b[?2004h"]
[636.035635, "o", "> "]
[636.036455, "o", "    \"\"\"Compute aggregate production plan and gross leaf demands for qty units.\"\"\"\r\n\u001b[?2004l\r"]
[636.036484, "o", "\u001b[?2004h> "]
[636.036862, "o", "    demand = defaultdict(float)\r\n\u001b[?2004l\r(\u001b[?2004h"]
[636.036891, "o", "> "]
[636.037301, "o", "    demand[product_id] += float(qty)\r\n\u001b[?2004l\r"]
[636.03733, "o", "\u001b[?2004h> "]
[636.037592, "o", "    productions = {}\r\n\u001b[?2004l\r"]
[636.037636, "o", "\u001b[?2004h> "]
[636.037981, "o", "    wc_req = defaultdict(float)\r\n\u001b[?2004l\r"]
[636.038102, "o", "\u001b[?2004h> "]
[636.038685, "o", "    topo_parts = topological_manufactured_order(product_id)\r\n\u001b[?2004l\r"]
[636.038714, "o", "\u001b[?2004h> "]
[636.038763, "o", "\r\n\u001b[?2004l\r"]
[636.038789, "o", "\u001b[?2004h> "]
[636.039097, "o", "    for part in topo_parts:\r\n\u001b[?2004l\r \u001b[?2004h"]
[636.039129, "o", "> "]
[636.039509, "o", "        d = demand.get(part, 0.0)\r\n\u001b[?2004l\r"]
[636.039539, "o", "\u001b[?2004h> "]
[636.039936, "o", "        if part not in bom_children:\r\n\u001b[?2004l\rne\u001b[?2004h"]
[636.039968, "o", "> "]
[636.040435, "o", "            continue  # leaf, no children\r\n\u001b[?2004l\r"]
[636.040467, "o", "\u001b[?2004h> "]
[636.040493, "o", "\r\n\u001b[?2004l\r"]
[636.040569, "o", "\u001b[?2004h> "]
[636.040822, "o", "        if d <= 1e-12:\r\n\u001b[?2004l\r"]
[636.04085, "o", "\u001b[?2004h> "]
[636.041296, "o", "            productions[part] = {\r\n\u001b[?2004l\r"]
[636.041365, "o", "\u001b[?2004h> "]
[636.041996, "o", "                'use': 0.0, 'build': 0.0, 'extra': 0.0,\r\n\u001b[?2004l\rf"]
[636.04209, "o", "\u001b[?2004h> "]
[636.042583, "o", "                'hours_by_wc': {}, 'rem': 0.0\r\n\u001b[?2004l\r"]
[636.042626, "o", "\u001b[?2004h> "]
[636.042819, "o", "            }\r\n\u001b[?2004l\r "]
[636.042855, "o", "\u001b[?2004h> "]
[636.043148, "o", "            continue\r\n\u001b[?2004l\r"]
[636.043218, "o", "\u001b[?2004h> \r\n"]
[636.051089, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[636.051634, "o", "        on_hand = float(inv_before.get(part, 0))\r\n\u001b[?2004l\r"]
[636.05167, "o", "\u001b[?2004h> "]
[636.053524, "o", "        use = min(on_hand, d)\r\n\u001b[?2004l\r\u001b[?2004h>         rem = d - use\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h>         if rem <= 1e-12:\r\n\u001b[?2004l\rs \u001b[?2004h>             productions[part] = {\r\n\u001b[?2004l\ri\u001b[?2004h>                 'use': use, 'build': 0.0, 'extra': 0.0,\r\n\u001b[?2004l\r ma"]
[636.053579, "o", "\u001b[?2004h> "]
[636.05407, "o", "                'hours_by_wc': {}, 'rem': rem\r\n\u001b[?2004l\r"]
[636.05416, "o", "\u001b[?2004h> "]
[636.054301, "o", "            }\r\n\u001b[?2004l\rw\u001b[?2004h"]
[636.054331, "o", "> "]
[636.054516, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.054545, "o", "> \r\n\u001b[?2004l\r"]
[636.054632, "o", "u\u001b[?2004h> "]
[636.054968, "o", "        bs = batch_size.get(part, 1)\r\n\u001b[?2004l\r, b\u001b[?2004h"]
[636.055002, "o", "> "]
[636.0554, "o", "        build = int(math.ceil(rem / bs)) * bs\r\n\u001b[?2004l\ritu\u001b[?2004h"]
[636.05543, "o", "> "]
[636.055718, "o", "        extra = float(build - rem)\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.055751, "o", "> \r\n\u001b[?2004l\r"]
[636.055808, "o", "=\u001b[?2004h"]
[636.055832, "o", "> "]
[636.056032, "o", "        hours_by_wc = {}\r\n\u001b[?2004l\r"]
[636.056061, "o", "\u001b[?2004h> "]
[636.056564, "o", "        for wc_id, setup_h, run_h in routing.get(part, []):\r\n\u001b[?2004l\rge\u001b[?2004h"]
[636.056595, "o", "> "]
[636.056941, "o", "            hrs = setup_h + run_h * build\r\n\u001b[?2004l\r"]
[636.056971, "o", "\u001b[?2004h> "]
[636.057305, "o", "            hours_by_wc[wc_id] = hrs\r\n\u001b[?2004l\rs"]
[636.05734, "o", "\u001b[?2004h> "]
[636.057604, "o", "            wc_req[wc_id] += hrs\r\n\u001b[?2004l\rd\u001b[?2004h"]
[636.057644, "o", "> \r\n\u001b[?2004l\r"]
[636.05769, "o", "_"]
[636.057762, "o", "\u001b[?2004h> "]
[636.057945, "o", "        productions[part] = {\r\n\u001b[?2004l\rys"]
[636.057979, "o", "\u001b[?2004h> "]
[636.058452, "o", "            'use': use, 'build': build, 'extra': extra,\r\n\u001b[?2004l\r"]
[636.058482, "o", "\u001b[?2004h> "]
[636.058948, "o", "            'hours_by_wc': hours_by_wc, 'rem': rem\r\n\u001b[?2004l\r"]
[636.058985, "o", "\u001b[?2004h> "]
[636.059073, "o", "        }\r\n\u001b[?2004l\r"]
[636.059104, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.059187, "o", "o"]
[636.059211, "o", "\u001b[?2004h> "]
[636.059773, "o", "        # Propagate child requirements based on actual build quantity.\r\n\u001b[?2004l\rt\u001b[?2004h"]
[636.059804, "o", "> "]
[636.060503, "o", "        for child, qty_per, scrap_pct, setup_scrap in bom_children.get(part, []):\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.060534, "o", "> "]
[636.060823, "o", "            base = qty_per * build\r\n\u001b[?2004l\r  \u001b[?2004h"]
[636.060851, "o", "> "]
[636.061527, "o", "            need = int(math.ceil(base * (1.0 + scrap_pct / 100.0))) + setup_scrap\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[636.061863, "o", "            demand[child] += need\r\n\u001b[?2004l\rng b\u001b[?2004h"]
[636.061893, "o", "> \r\n\u001b[?2004l\re"]
[636.061965, "o", "\u001b[?2004h> "]
[636.062747, "o", "    leaf_demands = {p: demand[p] for p in demand if p not in bom_children and demand[p] > 1e-12}\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.062774, "o", "> "]
[636.063512, "o", "    return {'leaf_demands': leaf_demands, 'productions': productions, 'wc_req': wc_req}\r\n\u001b[?2004l\rwork\u001b[?2004h"]
[636.063542, "o", "> "]
[636.063591, "o", "\r\n\u001b[?2004l\r"]
[636.063663, "o", "\u001b[?2004h"]
[636.063694, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[636.064061, "o", "def leaf_equiv_available(leaf, inv_before):\r\n\u001b[?2004l\r"]
[636.06409, "o", "\u001b[?2004h> "]
[636.064494, "o", "    total = float(inv_before.get(leaf, 0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.064523, "o", "> "]
[636.064998, "o", "    for sub_id, ratio, rank in substitutes.get(leaf, []):\r\n\u001b[?2004l\r"]
[636.065026, "o", "\u001b[?2004h> "]
[636.065483, "o", "        stock = float(inv_before.get(sub_id, 0))\r\n\u001b[?2004l\rall\u001b[?2004h"]
[636.065513, "o", "> "]
[636.065819, "o", "        if stock > 0 and ratio > 0:\r\n\u001b[?2004l\r"]
[636.06585, "o", "\u001b[?2004h> "]
[636.066335, "o", "            total += float(math.floor(stock / ratio))\r\n\u001b[?2004l\rt\u001b[?2004h"]
[636.066366, "o", "> "]
[636.066527, "o", "    return total\r\n\u001b[?2004l\ror\u001b[?2004h"]
[636.066556, "o", "> \r\n\u001b[?2004l\rt\u001b[?2004h"]
[636.066627, "o", "> \r\n\u001b[?2004l\r"]
[636.066707, "o", "\u001b[?2004h> "]
[636.067116, "o", "def compute_leaf_usage(leaf_demands, inv_before):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.067513, "o", "    consume_own = defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.067632, "o", "> "]
[636.067935, "o", "    consume_sub = defaultdict(float)\r\n\u001b[?2004l\rap\u001b[?2004h"]
[636.067963, "o", "> "]
[636.068141, "o", "    feasible = True\r\n\u001b[?2004l\rn', 'w')\u001b[?2004h"]
[636.068202, "o", "> \r\n\u001b[?2004l\r"]
[636.068238, "o", " \u001b[?2004h> "]
[636.068634, "o", "    for leaf, d in leaf_demands.items():\r\n\u001b[?2004l\r)\r\n"]
[636.068718, "o", "\u001b[?2004h> "]
[636.068918, "o", "        remaining = float(d)\r\n\u001b[?2004l\r"]
[636.068947, "o", "\u001b[?2004h> "]
[636.069457, "o", "        own_stock = float(inv_before.get(leaf, 0))\r\n\u001b[?2004l\rpy\u001b[?2004h> "]
[636.069787, "o", "        use_own = min(own_stock, remaining)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.070073, "o", "        consume_own[leaf] = use_own\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.070337, "o", "        remaining -= use_own\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.070369, "o", "\r\n\u001b[?2004l\r"]
[636.070439, "o", "\u001b[?2004h> "]
[636.070668, "o", "        if remaining <= 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.070698, "o", "> "]
[636.070861, "o", "            continue\r\n\u001b[?2004l\r"]
[636.070888, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.070996, "o", "\u001b[?2004h> "]
[636.071383, "o", "        for sub_id, ratio, rank in substitutes.get(leaf, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.071672, "o", "            if remaining <= 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.071857, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.071885, "o", "> "]
[636.072271, "o", "            stock = float(inv_before.get(sub_id, 0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.072585, "o", "            if stock <= 0 or ratio <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.072814, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.073215, "o", "            cover = int(math.floor(stock / ratio))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.073604, "o", "            use_primary = min(float(cover), remaining)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.073869, "o", "            if use_primary > 0:\r\n\u001b[?2004l\r"]
[636.073897, "o", "\u001b[?2004h> "]
[636.074323, "o", "                consume_sub[sub_id] += use_primary * ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.074641, "o", "                remaining -= use_primary\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.074674, "o", "> \r\n\u001b[?2004l\r"]
[636.074749, "o", "\u001b[?2004h"]
[636.074784, "o", "> "]
[636.074957, "o", "        if remaining > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.07499, "o", "> "]
[636.075207, "o", "            feasible = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.075301, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.075643, "o", "    return feasible, consume_own, consume_sub\r\n\u001b[?2004l\r"]
[636.075676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.075745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.075798, "o", "\u001b[?2004h> "]
[636.076046, "o", "def is_feasible(plan, inv_before):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.076309, "o", "    # Workcenter feasibility\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.076338, "o", "> "]
[636.076672, "o", "    for wc_id, hrs in plan['wc_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.077041, "o", "        if hrs > wc_avail.get(wc_id, 0.0) + 1e-12:\r\n\u001b[?2004l\r"]
[636.07707, "o", "\u001b[?2004h> "]
[636.07728, "o", "            return False\r\n\u001b[?2004l\r"]
[636.077315, "o", "\u001b[?2004h> "]
[636.077863, "o", "    feasible_leaves, _, _ = compute_leaf_usage(plan['leaf_demands'], inv_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078007, "o", "    return feasible_leaves\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[636.078033, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[636.078093, "o", "> "]
[636.078202, "o", "report_orders = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078344, "o", "for order in orders_by_priority:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078459, "o", "    oid = order['order_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078635, "o", "    product = order['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078783, "o", "    requested = order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.078955, "o", "    product_batch = batch_size.get(product, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[636.078991, "o", "> "]
[636.079115, "o", "    before_inv = dict(inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.079241, "o", "    before_wc = dict(wc_avail)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.079307, "o", "\u001b[?2004h> "]
[636.079376, "o", "    max_q = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.079402, "o", "> "]
[636.07949, "o", "    max_plan = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.079735, "o", "    # Test candidate production quantities in increasing order.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.079927, "o", "    for q in range(0, requested + 1, product_batch):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.080112, "o", "        plan = calc_plan(product, q, before_inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.08036, "o", "        if is_feasible(plan, before_inv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.080456, "o", "            max_q = q\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.080606, "o", "            max_plan = plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.080703, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.080785, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081023, "o", "    shortfall = requested - max_q\r\n\u001b[?2004l\r\u001b[?2004h>     limiting = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[636.081059, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081223, "o", "    if shortfall > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081382, "o", "        next_q = max_q + product_batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081597, "o", "        next_plan = calc_plan(product, next_q, before_inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081711, "o", "        ratios = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.081941, "o", "        for leaf, gross in next_plan['leaf_demands'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.082189, "o", "            avail = leaf_equiv_available(leaf, before_inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.082371, "o", "            ratios[leaf] = avail / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.082405, "o", "\u001b[?2004h> "]
[636.082638, "o", "        for wc_id, gross in next_plan['wc_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.082807, "o", "            avail = before_wc.get(wc_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.082998, "o", "            ratios[wc_id] = avail / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.08336, "o", "        below_one = {res: ratio for res, ratio in ratios.items() if ratio < 1.0 - 1e-12}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.08346, "o", "        if below_one:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.083746, "o", "            limiting = min(below_one, key=lambda res: (below_one[res], str(res)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.084002, "o", "        # If no ratio below 1, leave limiting as null as not expected.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.084271, "o", "    # Commit the best feasible plan (if any quantity > 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.084368, "o", "    if max_q > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.084465, "o", "        plan = max_plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.084817, "o", "        feasible_leaves, own_use, sub_use = compute_leaf_usage(plan['leaf_demands'], before_inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085037, "o", "        # Update leaf and substitute inventories.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085213, "o", "        leaf_usage = defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085377, "o", "        for leaf, used in own_use.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085528, "o", "            leaf_usage[leaf] += used\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085716, "o", "        for sub_id, used in sub_use.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.085856, "o", "            leaf_usage[sub_id] += used\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.085885, "o", "\u001b[?2004h> "]
[636.086073, "o", "        used_leaf_ids = set(leaf_usage.keys())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.086371, "o", "        for part in list(plan['productions'].keys()) + list(used_leaf_ids):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.086686, "o", "            pass  # just ensure all potentially affected parts are considered below\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.086997, "o", "        # Apply manufactured-part inventory changes first using before snapshot.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.087202, "o", "        for part, prod in plan['productions'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.087492, "o", "            inv[part] = before_inv.get(part, 0.0) - prod['use'] + prod['extra']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[636.087521, "o", "> "]
[636.087876, "o", "        # Apply leaf consumption using before snapshot, overriding/additively for leaf ids.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.088011, "o", "        for part in used_leaf_ids:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.088314, "o", "            inv[part] = before_inv.get(part, 0.0) - leaf_usage.get(part, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.088492, "o", "        # Apply workcenter consumption.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.088699, "o", "        for wc_id, hrs in plan['wc_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.088914, "o", "            wc_avail[wc_id] = wc_avail.get(wc_id, 0.0) - hrs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.08906, "o", "    report_orders.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.089209, "o", "        'order_id': oid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.089333, "o", "        'allocated_qty': max_q,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.089484, "o", "        'shortfall_qty': shortfall,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.089643, "o", "        'limiting_resource': limiting\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[636.089719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[636.089772, "o", "\u001b[?2004h> "]
[636.089997, "o", "report_orders_sorted = sorted(report_orders, key=lambda x: x['order_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.090189, "o", "report = {'orders': report_orders_sorted}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.090382, "o", "with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.09054, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[636.090579, "o", "> "]
[636.090743, "o", "print(json.dumps(report, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[636.090841, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[636.093605, "o", "\u001b[?2004hroot@0102c4b8-9cda-41a6-93d1-0e4969647718:/app# "]
[636.093746, "o", "python3 /tmp/process_bom.py\r\n\u001b[?2004l\r"]
[636.186283, "o", "{\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"O1\",\r\n      \"allocated_qty\": 12,\r\n      \"shortfall_qty\": 0,\r\n      \"limiting_resource\": null\r\n    },\r\n    {\r\n      \"order_id\": \"O2\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"L2\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3\",\r\n      \"allocated_qty\": 5,\r\n      \"shortfall_qty\": 5,\r\n      \"limiting_resource\": \"L3\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3b\",\r\n      \"allocated_qty\": 4,\r\n      \"shortfall_qty\": 6,\r\n      \"limiting_resource\": \"SUB_L3_B\"\r\n    },\r\n    {\r\n      \"order_id\": \"O4\",\r\n      \"allocated_qty\": 1,\r\n      \"shortfall_qty\": 4,\r\n      \"limiting_resource\": \"L4\"\r\n    },\r\n    {\r\n      \"order_id\": \"O5\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 100,\r\n      \"limiting_resource\": \"L4\"\r\n    }\r\n  ]\r\n}\r\n"]
[636.191894, "o", "\u001b[?2004hroot@0102c4b8-9cda-41a6-93d1-0e4969647718:/app# "]
[742.68601, "i", "python3 -m json.tool /app/report.json\n"]
[742.686636, "o", "python3 -m json.tool /app/report.json\r\n\u001b[?2004l\r"]
[742.744871, "o", "{\r\n    \"orders\": [\r\n        {\r\n            \"order_id\": \"O1\",\r\n            \"allocated_qty\": 12,\r\n            \"shortfall_qty\": 0,\r\n            \"limiting_resource\": null\r\n        },\r\n        {\r\n            \"order_id\": \"O2\",\r\n            \"allocated_qty\": 8,\r\n            \"shortfall_qty\": 2,\r\n            \"limiting_resource\": \"L2\"\r\n        },\r\n        {\r\n            \"order_id\": \"O3\",\r\n            \"allocated_qty\": 5,\r\n            \"shortfall_qty\": 5,\r\n            \"limiting_resource\": \"L3\"\r\n        },\r\n        {\r\n            \"order_id\": \"O3b\",\r\n            \"allocated_qty\": 4,\r\n            \"shortfall_qty\": 6,\r\n            "]
[742.744943, "o", "\"limiting_resource\": \"SUB_L3_B\"\r\n        },\r\n        {\r\n            \"order_id\": \"O4\",\r\n            \"allocated_qty\": 1,\r\n            \"shortfall_qty\": 4,\r\n            \"limiting_resource\": \"L4\"\r\n        },\r\n        {\r\n            \"order_id\": \"O5\",\r\n            \"allocated_qty\": 0,\r\n            \"shortfall_qty\": 100,\r\n            \"limiting_resource\": \"L4\""]
[742.744966, "o", "\r\n        }\r\n    "]
[742.745271, "o", "]\r\n}\r\n"]
[742.75199, "o", "\u001b[?2004hroot@0102c4b8-9cda-41a6-93d1-0e4969647718:/app# "]
