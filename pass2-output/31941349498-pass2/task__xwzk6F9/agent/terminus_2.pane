def calc_plan(product_id, qty, inv_before):
    """Calculate aggregate production plan and gross leaf demands for qty of product_id."""
    demand = defaultdict(float)
    demand[product_id] += qty
    productions = {}
    wc_req = defaultdict(float)
    order = topological_manufactured_order(product_id)
    if product_id not in order:
        order.insert(0, product_id)
    for part in order:
        d = demand.get(part, 0)
        if d <= 0:
            if part in bom_children:
                productions[part] = {'use': 0, 'build': 0, 'extra': 0, 'hours_by_wc': {}, 'rem': 0}
            continue
        if part not in bom_children:
            continue
        onh = inv_before.get(part, 0)
        use = min(onh, d)
        rem = d - use
        if rem <= 0:
            productions[part] = {'use': use, 'build': 0, 'extra': 0, 'hours_by_wc': {}, 'rem': rem}
            continue
        bs = batch_size.get(part, 1)
        build = int(math.ceil(rem / bs)) * bs
        extra = build - rem
        hours_by_wc = {}
        for wc, setup_h, run_h in routing.get(part, []):
            hours = setup_h + run_h * build
            hours_by_wc[wc] = hours
            wc_req[wc] += hours
        productions[part] = {'use': use, 'build': build, 'extra': extra, 'hours_by_wc': hours_by_wc, 'rem': rem}
        for child, qty_per, scrap_pct, setup_scrap in bom_children.get(part, []):
            base = qty_per * build
            child_need = int(math.ceil(base * (1.0 + scrap_pct / 100.0))) + setup_scrap
            demand[child] += child_need
    leaf_demands = {p: demand[p] for p in demand if p not in bom_children}
    return {'leaf_demands': leaf_demands, 'productions': productions, 'wc_req': wc_req}

