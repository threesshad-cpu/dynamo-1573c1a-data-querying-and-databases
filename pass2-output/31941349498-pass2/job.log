d, hrs in plan[\'wc_req\'].items():\n        if hrs > wc_avail.get(wc_id, 0.0) + 1e-12:\n            return False\n    feasible_leaves, _, _ = compute_leaf_usage(plan[\'leaf_demands\'], inv_before)\n    return feasible_leaves\n\n\nreport_orders = []\n\nfor order in orders_by_priority:\n    oid = order[\'order_id\']\n    product = order[\'product_part_id\']\n    requested = order[\'requested_qty\']\n    product_batch = batch_size.get(product, 1)\n\n    before_inv = dict(inv)\n    before_wc = dict(wc_avail)\n\n    max_q = 0\n    max_plan = None\n\n    # Test candidate production quantities in increasing order.\n    for q in range(0, requested + 1, product_batch):\n        plan = calc_plan(product, q, before_inv)\n        if is_feasible(plan, before_inv):\n            max_q = q\n            max_plan = plan\n        else:\n            break\n\n    shortfall = requested - max_q\n    limiting = None\n\n    if shortfall > 0:\n        next_q = max_q + product_batch\n        next_plan = calc_plan(product, next_q, before_inv)\n        ratios = {}\n\n        for leaf, gross in next_plan[\'leaf_demands\'].items():\n            avail = leaf_equiv_available(leaf, before_inv)\n            ratios[leaf] = avail / float(gross)\n\n        for wc_id, gross in next_plan[\'wc_req\'].items():\n            avail = before_wc.get(wc_id, 0.0)\n            ratios[wc_id] = avail / float(gross)\n\n        below_one = {res: ratio for res, ratio in ratios.items() if ratio < 1.0 - 1e-12}\n        if below_one:\n            limiting = min(below_one, key=lambda res: (below_one[res], str(res)))\n        # If no ratio below 1, leave limiting as null as not expected.\n\n    # Commit the best feasible plan (if any quantity > 0)\n    if max_q > 0:\n        plan = max_plan\n        feasible_leaves, own_use, sub_use = compute_leaf_usage(plan[\'leaf_demands\'], before_inv)\n\n        # Update leaf and substitute inventories.\n        leaf_usage = defaultdict(float)\n        for leaf, used in own_use.items():\n            leaf_usage[leaf] += used\n        for sub_id, used in sub_use.items():\n            leaf_usage[sub_id] += used\n\n        used_leaf_ids = set(leaf_usage.keys())\n        for part in list(plan[\'productions\'].keys()) + list(used_leaf_ids):\n            pass  # just ensure all potentially affected parts are considered below\n\n        # Apply manufactured-part inventory changes first using before snapshot.\n        for part, prod in plan[\'productions\'].items():\n            inv[part] = before_inv.get(part, 0.0) - prod[\'use\'] + prod[\'extra\']\n\n        # Apply leaf consumption using before snapshot, overriding/additively for leaf ids.\n        for part in used_leaf_ids:\n            inv[part] = before_inv.get(part, 0.0) - leaf_usage.get(part, 0.0)\n\n        # Apply workcenter consumption.\n        for wc_id, hrs in plan[\'wc_req\'].items():\n            wc_avail[wc_id] = wc_avail.get(wc_id, 0.0) - hrs\n\n    report_orders.append({\n        \'order_id\': oid,\n        \'allocated_qty\': max_q,\n        \'shortfall_qty\': shortfall,\n        \'limiting_resource\': limiting\n    })\n\nreport_orders_sorted = sorted(report_orders, key=lambda x: x[\'order_id\'])\nreport = {\'orders\': report_orders_sorted}\n\nwith open(\'/app/report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint(json.dumps(report, indent=2))\nconn.close()\nPY\npython3 /tmp/process_bom.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
