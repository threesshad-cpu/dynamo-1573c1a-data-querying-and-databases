children.get(part, []):\n            base = qty_per * build\n            child_need = int(math.ceil(base * (1.0 + scrap_pct / 100.0))) + setup_scrap\n            demand[child] += child_need\n    leaf_demands = {p: demand[p] for p in demand if p not in bom_children}\n    return {\'leaf_demands\': leaf_demands, \'productions\': productions, \'wc_req\': wc_req}\n\ndef leaf_equivalent_available(leaf, inv_before):\n    total = inv_before.get(leaf, 0)\n    for sub_id, ratio, rank in substitutes.get(leaf, []):\n        stock = inv_before.get(sub_id, 0)\n        if stock > 0 and ratio > 0:\n            total += int(stock // ratio)\n    return total\n\ndef compute_leaf_usage(leaf_demands, inv_before):\n    consume_own = defaultdict(float)\n    consume_sub = defaultdict(float)\n    feasible = True\n    for leaf, demand in leaf_demands.items():\n        if demand <= 0:\n            continue\n        own = inv_before.get(leaf, 0)\n        use_own = min(own, demand)\n        consume_own[leaf] = use_own\n        remaining = demand - use_own\n        if remaining <= 0:\n            continue\n        for sub_id, ratio, rank in substitutes.get(leaf, []):\n            if remaining <= 1e-12:\n                break\n            stock = inv_before.get(sub_id, 0)\n            if stock <= 0 or ratio <= 0:\n                continue\n            cover = int(stock // ratio)\n            use_primary = int(min(remaining, cover))\n            if use_primary > 0:\n                consume_sub[sub_id] = consume_sub.get(sub_id, 0) + use_primary * ratio\n                remaining -= use_primary\n        if remaining > 1e-12:\n            feasible = False\n    return feasible, consume_own, consume_sub\n\ndef is_feasible(plan, inv_before):\n    # Workcenter feasibility\n    for wc_id, hrs in plan[\'wc_req\'].items():\n        avail = wc_avail.get(wc_id, 0)\n        if hrs > avail + 1e-12:\n            return False\n    # Leaf feasibility\n    feasible, *_ = compute_leaf_usage(plan[\'leaf_demands\'], i