Sending keys: ['python3 <<\'PY\'\nimport sqlite3, math, json\nfrom collections import defaultdict\n\nDB=\'/app/manufacturing.db\'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts = {}\ncur.execute(\'SELECT * FROM parts\')\nfor r in cur:\n    parts[r[\'part_id\']] = {\'name\': r[\'name\'], \'on_hand_qty\': r[\'on_hand_qty\'], \'batch_size\': r[\'batch_size\']}\n\ninv = {pid: parts[pid][\'on_hand_qty\'] for pid in parts}\nbatch_size = {pid: parts[pid][\'batch_size\'] for pid in parts}\n\nbom_children = defaultdict(list)\ncur.execute(\'SELECT * FROM bom\')\nfor r in cur:\n    bom_children[r[\'parent_part_id\']].append((r[\'child_part_id\'], r[\'qty_per\'], r[\'scrap_rate_pct\'], r[\'setup_scrap_qty\']))\n\nrouting = defaultdict(list)\ncur.execute(\'SELECT * FROM routing\')\nfor r in cur:\n    routing[r[\'parent_part_id\']].append((r[\'workcenter_id\'], r[\'setup_hours\'], r[\'run_hours_per_unit\']))\n\nworkcenters = {}\ncur.execute(\'SELECT * FROM workcenters\')\nfor r in cur:\n    workcenters[r[\'workcenter_id\']] = {\'name\': r[\'name\'], \'available_hours\': r[\'available_hours\']}\n\nwc_avail = {wid: workcenters[wid][\'available_hours\'] for wid in workcenters}\n\nsubstitutes = defaultdict(list)\ncur.execute(\'SELECT * FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id\')\nfor r in cur:\n    substitutes[r[\'primary_part_id\']].append((r[\'substitute_part_id\'], r[\'qty_ratio\'], r[\'preference_rank\']))\n\norders = []\ncur.execute(\'SELECT * FROM orders\')\nfor r in cur:\n    orders.append({\'order_id\': r[\'order_id\'], \'product_part_id\': r[\'product_part_id\'], \'requested_qty\': r[\'requested_qty\'], \'priority\': r[\'priority\']})\norders_sorted_by_priority = sorted(orders, key=lambda o: (o[\'priority\'], o[\'order_id\']))\n\nprint(\'Initial inventory:\', inv)\nprint(\'Initial WC:\', wc_avail)\nprint(\'Orders by priority:\', [(o[\'order_id\'], o[\'product_part_id\'], o[\'requested_qty\']) for o in