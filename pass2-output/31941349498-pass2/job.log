Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, math, json\nfrom collections import defaultdict\n\nconn=sqlite3.connect(\'/app/manufacturing.db\')\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\nfor r in cur.execute(\'SELECT * FROM parts\').fetchall():\n    parts[r[\'part_id\']]={\'name\':r[\'name\'],\'on_hand_qty\':int(r[\'on_hand_qty\']),\'batch_size\':int(r[\'batch_size\'])}\n\nbom_rows=[]\nfor r in cur.execute(\'SELECT * FROM bom\').fetchall():\n    bom_rows.append({\'parent\':r[\'parent_part_id\'],\'child\':r[\'child_part_id\'],\'qty_per\':int(r[\'qty_per\']),\'scrap_rate_pct\':float(r[\'scrap_rate_pct\']),\'setup_scrap_qty\':int(r[\'setup_scrap_qty\'])})\n\nrouting={}\nfor r in cur.execute(\'SELECT * FROM routing\').fetchall():\n    routing.setdefault(r[\'parent_part_id\'],[]).append({\'wc\':r[\'workcenter_id\'],\'setup\':float(r[\'setup_hours\']),\'run\':float(r[\'run_hours_per_unit\'])})\n\nworkcenters={}\nfor r in cur.execute(\'SELECT * FROM workcenters\').fetchall():\n    workcenters[r[\'workcenter_id\']]={\'name\':r[\'name\'],\'available_hours\':float(r[\'available_hours\'])}\n\nsubs=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM substitutes\').fetchall():\n    subs[r[\'primary_part_id\']].append({\'sub\':r[\'substitute_part_id\'],\'ratio\':float(r[\'qty_ratio\']),\'rank\':int(r[\'preference_rank\'])})\nfor k in subs:\n    subs[k].sort(key=lambda x:(x[\'rank\'], x[\'sub\']))\n\norders=[]\nfor r in cur.execute(\'SELECT * FROM orders\').fetchall():\n    orders.append({\'order_id\':r[\'order_id\'],\'product_part_id\':r[\'product_part_id\'],\'requested_qty\':int(r[\'requested_qty\']),\'priority\':int(r[\'priority\'])})\norders.sort(key=lambda x:x[\'priority\'])\nconn.close()\n\n# low-level codes: longest path from top-level parts\nlevel={p:0 for p in parts}\nchanged=True\nwhile changed:\n    changed=False\n    for b in bom_rows:\n        nl=level[b[\'parent\']]+1\n        if level[b[\'child\']]<nl:\n            level[b[\'child\']]=nl\n            changed=True\nsorted_parts=sorted(parts.keys(), key=lambda p:(level[p], p))\n\nbom_children=defaultdict(list)\nfor b in bom_rows:\n    bom_children[b[\'parent\']].append(b)\n\nmanufactured=set(routing.keys())\n\ndef explode(product_id, order_qty, inv):\n    """Compute MRP explosion for candidate order qty.\n    Returns demand_all, build, work_usage, projected_inv after manufactured parts."""\n    demand=defaultdict(int)\n    demand[product_id]=order_qty\n    build={}\n    work_usage=defaultdict(float)\n    proj=dict(inv)\n    for p in sorted_parts:\n        if p not in manufactured:\n            continue\n        d=demand.get(p,0)\n        if d<=0:\n            continue\n        oh=proj.get(p,0)\n        net=d-oh\n        b=0\n        if net>0:\n            batch=parts[p][\'batch_size\']\n            b=math.ceil(net/batch)*batch\n        build[p]=b\n        # workcenter use\n        if b>0:\n            for rr in routing.get(p,[]):\n                work_usage[rr[\'wc\']]+=rr[\'setup\'] + b*rr[\'run\']\n        # child demands\n        if b>0:\n            for ch in bom_children.get(p,[]):\n                base=b*ch[\'qty_per\']\n                child_req=int(math.ceil(base*(1.0+ch[\'scrap_rate_pct\']/100.0))) + ch[\'setup_scrap_qty\']\n                demand[ch[\'child\']]+=child_req\n        # update projected inventory for this manufactured part\n        proj[p]=proj.get(p,0)-d+b\n    return dict(demand), build, dict(work_usage), proj\n\ndef leaf_available(leaf, inv):\n    avail=inv.get(leaf,0)\n    for s in subs.get(leaf,[]):\n        st=inv.get(s[\'sub\'],0)\n        if s[\'ratio\']>0:\n            avail += math.floor(st/s[\'ratio\'])\n    return avail\n\ndef leaf_consumption(leaf_demand, inv):\n    """Return consumed primary and substitute dicts, or None if infeasible."""\n    consumed_primary={}\n    consumed_sub=defaultdict(float)\n    for leaf,d in leaf_demand.items():\n        if d<=0: continue\n        rem=d\n        use=min(rem, inv.get(leaf,0))\n        if use>0:\n            consumed_primary[leaf]=use\n            rem-=use\n        if rem>0:\n            for s in subs.get(leaf,[]):\n                st=inv.get(s[\'sub\'],0)\n                if s[\'ratio\']<=0 or st<=0: continue\n                equiv=math.floor(st/s[\'ratio\'])\n                use=min(rem, equiv)\n                if use>0:\n                    consumed_sub[s[\'sub\']]+=use*s[\'ratio\']\n                    rem-=use\n            if rem>0:\n                return None\n    return {\'primary\':consumed_primary,\'subs\':dict(consumed_sub)}\n\ncurrent_parts={p:parts[p][\'on_hand_qty\'] for p in parts}\ncurrent_wc={wc:workcenters[wc][\'available_hours\'] for wc in workcenters}\n\nresults=[]\nfor o in orders:\n    oid=o[\'order_id\']; prod=o[\'product_part_id\']; req=o[\'requested_qty\']; batch=parts[prod][\'batch_size\']\n    candidates=[req]\n    q=req\n    # include all multiples below request for search\n    while q-batch >= 0:\n        q-=batch\n        if q not in candidates:\n            candidates.append(q)\n    # Ensure descending: sorted descending by quantity\n    candidates=sorted(set(candidates), reverse=True)\n    selected=None; selected_demand=None; selected_build=None; selected_work=None; selected_proj=None\n    for cand in candidates:\n        inv_test=dict(current_parts)\n        demand_all,build,work_use,proj=explode(prod,cand,inv_test)\n        leaf_demand={p:d for p,d in demand_all.items() if p not in manufactured}\n        # check work centers\n        infeasible=False\n        for wc,u in work_use.items():\n            if u>current_wc[wc]+1e-9:\n                infeasible=True; break\n        if not infeasible:\n            # check leaves\n            cons=leaf_consumption(leaf_demand, inv_test)\n            if cons is not None:\n                selected=cand\n                selected_demand=demand_all\n                selected_build=build\n                selected_work=work_use\n                selected_proj=proj\n                selected_cons=cons\n                break\n    if selected is None:\n        selected=0\n        inv_test=dict(current_parts)\n        # for allocated zero, use fake no build; later limit calc uses one batch independently\n        selected_demand,selected_build,selected_work,selected_proj=explode(prod,0,inv_test)\n        selected_cons={\'primary\':{},\'subs\':{}}\n    # limiting resource if shortfall\n    limiting=None\n    if selected < req:\n        try_qty=selected+batch\n        inv_test=dict(current_parts)\n        dem_all,build_lim,work_lim,proj_lim=explode(prod,try_qty,inv_test)\n        leaf_demand={p:d for p,d in dem_all.items() if p not in manufactured and d>0}\n        ratios=[]\n        for leaf,d in leaf_demand.items():\n            avail=leaf_available(leaf, current_parts)\n            ratio=avail/d\n            if ratio < 1.0-1e-9:\n                ratios.append((ratio,leaf))\n        for wc,u in work_lim.items():\n            if u>0:\n                ratio=current_wc[wc]/u\n                if ratio <1.0-1e-9:\n                    ratios.append((ratio,wc))\n        if ratios:\n            ratios.sort(key=lambda x:(x[0], x[1]))\n            limiting=ratios[0][1]\n    results.append({\'order_id\':oid,\'allocated_qty\':selected,\'shortfall_qty\':req-selected,\'limiting_resource\':limiting})\n    # commit selected\n    current_parts=dict(selected_proj)  # manufactured projections, but leaves still current\n    # apply leaf consumption to current parts\n    for leaf,qty in selected_cons[\'primary\'].items():\n        current_parts[leaf]=current_parts.get(leaf,0)-qty\n    for sub,qty in selected_cons[\'subs\'].items():\n        current_parts[sub]=current_parts.get(sub,0)-qty\n    for wc,u in selected_work.items():\n        current_wc[wc]=current_wc[wc]-u\n    print(\'--- order\', oid, \'---\')\n    print(\'selected\', selected, \'shortfall\', req-selected, \'limit\', limiting)\n    print(\'leaf_demand before commit:\', {p:d for p,d in selected_demand.items() if p not in manufactured and d>0})\n    print(\'build\', selected_build)\n    print(\'work_use\', selected_work)\n    print(\'parts after\', current_parts)\n    print(\'wc after\', current_wc)\n\nresults_sorted=sorted(results, key=lambda x:x[\'order_id\'])\nprint(\'REPORT\', json.dumps({\'orders\':results_sorted}, indent=2))\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
