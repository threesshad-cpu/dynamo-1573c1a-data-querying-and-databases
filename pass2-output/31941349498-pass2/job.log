priority\': r[\'priority\']\n    })\norders_by_priority = sorted(orders, key=lambda o: (o[\'priority\'], o[\'order_id\']))\n\n\ndef topological_manufactured_order(product_id):\n    """Return all parts reachable in this BOM sorted parents before children."""\n    dist = {product_id: 0}\n    def dfs(p):\n        for child, *_ in bom_children.get(p, []):\n            nd = dist[p] + 1\n            if nd > dist.get(child, -1):\n                dist[child] = nd\n                dfs(child)\n    dfs(product_id)\n    return sorted(dist.keys(), key=lambda p: dist[p])\n\n\ndef calc_plan(product_id, qty, inv_before):\n    """Compute aggregate production plan and gross leaf demands for qty units."""\n    demand = defaultdict(float)\n    demand[product_id] += float(qty)\n    productions = {}\n    wc_req = defaultdict(float)\n    topo_parts = topological_manufactured_order(product_id)\n\n    for part in topo_parts:\n        d = demand.get(part, 0.0)\n        if part not in bom_children:\n            continue  # leaf, no children\n\n        if d <= 1e-12:\n            productions[part] = {\n                \'use\': 0.0, \'build\': 0.0, \'extra\': 0.0,\n                \'hours_by_wc\': {}, \'rem\': 0.0\n            }\n            continue\n\n        on_hand = float(inv_before.get(part, 0))\n        use = min(on_hand, d)\n        rem = d - use\n\n        if rem <= 1e-12:\n            productions[part] = {\n                \'use\': use, \'build\': 0.0, \'extra\': 0.0,\n                \'hours_by_wc\': {}, \'rem\': rem\n            }\n            continue\n\n        bs = batch_size.get(part, 1)\n        build = int(math.ceil(rem / bs)) * bs\n        extra = float(build - rem)\n\n        hours_by_wc = {}\n        for wc_id, setup_h, run_h in routing.get(part, []):\n            hrs = setup_h + run_h * build\n            hours_by_wc[wc_id] = hrs\n            wc_req[wc_id] += hrs\n\n        productions[part] = {\n            \'use\': use, \'build\': build, \'extra\': extra,\n            \'