[330.460168, "o", "def leaf_consumption(leaf_demand, inv):\r\n\u001b[?2004l\r"]
[330.460269, "o", "\u001b[?2004h> "]
[330.460989, "o", "    \"\"\"Return consumed primary and substitute dicts, or None if infeasible.\"\"\"\r\n\u001b[?2004l\r"]
[330.461018, "o", "\u001b[?2004h> "]
[330.461341, "o", "    consumed_primary={}\r\n\u001b[?2004l\r"]
[330.461374, "o", "\u001b[?2004h> "]
[330.461741, "o", "    consumed_sub=defaultdict(float)\r\n\u001b[?2004l\r"]
[330.461845, "o", "\u001b[?2004h> "]
[330.462262, "o", "    for leaf,d in leaf_demand.items():\r\n\u001b[?2004l\r"]
[330.462291, "o", "\u001b[?2004h> "]
[330.462565, "o", "        if d<=0: continue\r\n\u001b[?2004l\r"]
[330.462594, "o", "\u001b[?2004h> "]
[330.462771, "o", "        rem=d\r\n\u001b[?2004l\r"]
[330.462806, "o", "\u001b[?2004h> "]
[330.463229, "o", "        use=min(rem, inv.get(leaf,0))\r\n\u001b[?2004l\r"]
[330.463315, "o", "\u001b[?2004h> "]
[330.463537, "o", "        if use>0:\r\n\u001b[?2004l\r"]
[330.463623, "o", "\u001b[?2004h> "]
[330.464135, "o", "            consumed_primary[leaf]=use\r\n\u001b[?2004l\r"]
[330.464171, "o", "\u001b[?2004h> "]
[330.464496, "o", "            rem-=use\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.46457, "o", "> "]
[330.464712, "o", "        if rem>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.464746, "o", "> "]
[330.465079, "o", "            for s in subs.get(leaf,[]):\r\n\u001b[?2004l\r"]
[330.465138, "o", "\u001b[?2004h> "]
[330.465489, "o", "                st=inv.get(s['sub'],0)\r\n\u001b[?2004l\r"]
[330.465518, "o", "\u001b[?2004h> "]
[330.465986, "o", "                if s['ratio']<=0 or st<=0: continue\r\n\u001b[?2004l\r"]
[330.466018, "o", "\u001b[?2004h"]
[330.466079, "o", "> "]
[330.466493, "o", "                equiv=math.floor(st/s['ratio'])\r\n\u001b[?2004l\r"]
[330.466522, "o", "\u001b[?2004h> "]
[330.466845, "o", "                use=min(rem, equiv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.466875, "o", "> "]
[330.467118, "o", "                if use>0:\r\n\u001b[?2004l\r"]
[330.467146, "o", "\u001b[?2004h"]
[330.467198, "o", "> "]
[330.46767, "o", "                    consumed_sub[s['sub']]+=use*s['ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.467701, "o", "> "]
[330.467966, "o", "                    rem-=use\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.467993, "o", "> "]
[330.468225, "o", "            if rem>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.468268, "o", "> "]
[330.468528, "o", "                return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.468559, "o", "> "]
[330.469123, "o", "    return {'primary':consumed_primary,'subs':dict(consumed_sub)}\r\n\u001b[?2004l\r"]
[330.46915, "o", "\u001b[?2004h> "]
[330.469229, "o", "\r\n\u001b[?2004l\r"]
[330.46928, "o", "\u001b[?2004h"]
[330.469351, "o", "> "]
[330.469803, "o", "current_parts={p:parts[p]['on_hand_qty'] for p in parts}\r\n\u001b[?2004l\r"]
[330.469832, "o", "\u001b[?2004h> "]
