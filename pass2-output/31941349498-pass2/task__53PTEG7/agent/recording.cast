[330.397553, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict\n\nconn=sqlite3.connect('/app/manufacturing.db')\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\nfor r in cur.execute('SELECT * FROM parts').fetchall():\n    parts[r['part_id']]={'name':r['name'],'on_hand_qty':int(r['on_hand_qty']),'batch_size':int(r['batch_size'])}\n\nbom_rows=[]\nfor r in cur.execute('SELECT * FROM bom').fetchall():\n    bom_rows.append({'parent':r['parent_part_id'],'child':r['child_part_id'],'qty_per':int(r['qty_per']),'scrap_rate_pct':float(r['scrap_rate_pct']),'setup_scrap_qty':int(r['setup_scrap_qty'])})\n\nrouting={}\nfor r in cur.execute('SELECT * FROM routing').fetchall():\n    routing.setdefault(r['parent_part_id'],[]).append({'wc':r['workcenter_id'],'setup':float(r['setup_hours']),'run':float(r['run_hours_per_unit'])})\n\nworkcenters={}\nfor r in cur.execute('SELECT * FROM workcenters').fetchall():\n    workcenters[r['workcenter_id']]={'name':r['name'],'available_hours':float(r['available_hours'])}\n\nsubs=defa"]
[330.397617, "i", "ultdict(list)\nfor r in cur.execute('SELECT * FROM substitutes').fetchall():\n    subs[r['primary_part_id']].append({'sub':r['substitute_part_id'],'ratio':float(r['qty_ratio']),'rank':int(r['preference_rank'])})\nfor k in subs:\n    subs[k].sort(key=lambda x:(x['rank'], x['sub']))\n\norders=[]\nfor r in cur.execute('SELECT * FROM orders').fetchall():\n    orders.append({'order_id':r['order_id'],'product_part_id':r['product_part_id'],'requested_qty':int(r['requested_qty']),'priority':int(r['priority'])})\norders.sort(key=lambda x:x['priority'])\nconn.close()\n\n# low-level codes: longest path from top-level parts\nlevel={p:0 for p in parts}\nchanged=True\nwhile changed:\n    changed=False\n    for b in bom_rows:\n        nl=level[b['parent']]+1\n        if level[b['child']]<nl:\n            level[b['child']]=nl\n            changed=True\nsorted_parts=sorted(parts.keys(), key=lambda p:(level[p], p))\n\nbom_children=defaultdict(list)\nfor b in bom_rows:\n    bom_children[b['parent']].append(b)\n\nmanufactured=set(routing.keys())\n\ndef explo"]
[330.397784, "i", "de(product_id, order_qty, inv):\n    \"\"\"Compute MRP explosion for candidate order qty.\n    Returns demand_all, build, work_usage, projected_inv after manufactured parts.\"\"\"\n    demand=defaultdict(int)\n    demand[product_id]=order_qty\n    build={}\n    work_usage=defaultdict(float)\n    proj=dict(inv)\n    for p in sorted_parts:\n        if p not in manufactured:\n            continue\n        d=demand.get(p,0)\n        if d<=0:\n            continue\n        oh=proj.get(p,0)\n        net=d-oh\n        b=0\n        if net>0:\n            batch=parts[p]['batch_size']\n            b=math.ceil(net/batch)*batch\n        build[p]=b\n        # workcenter use\n        if b>0:\n            for rr in routing.get(p,[]):\n                work_usage[rr['wc']]+=rr['setup'] + b*rr['run']\n        # child demands\n        if b>0:\n            for ch in bom_children.get(p,[]):\n                base=b*ch['qty_per']\n                child_req=int(math.ceil(base*(1.0+ch['scrap_rate_pct']/100.0))) + ch['setup_scrap_qty']\n                demand[ch['child'"]
[330.39787, "i", "]]+=child_req\n        # update projected inventory for this manufactured part\n        proj[p]=proj.get(p,0)-d+b\n    return dict(demand), build, dict(work_usage), proj\n\ndef leaf_available(leaf, inv):\n    avail=inv.get(leaf,0)\n    for s in subs.get(leaf,[]):\n        st=inv.get(s['sub'],0)\n        if s['ratio']>0:\n            avail += math.floor(st/s['ratio'])\n    return avail\n\ndef leaf_consumption(leaf_demand, inv):\n    \"\"\"Return consumed primary and substitute dicts, or None if infeasible.\"\"\"\n    consumed_primary={}\n    consumed_sub=defaultdict(float)\n    for leaf,d in leaf_demand.items():\n        if d<=0: continue\n        rem=d\n        use=min(rem, inv.get(leaf,0))\n        if use>0:\n            consumed_primary[leaf]=use\n            rem-=use\n        if rem>0:\n            for s in subs.get(leaf,[]):\n                st=inv.get(s['sub'],0)\n                if s['ratio']<=0 or st<=0: continue\n                equiv=math.floor(st/s['ratio'])\n                use=min(rem, equiv)\n                if use>0:\n             "]
