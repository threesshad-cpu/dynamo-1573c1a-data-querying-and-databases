[513.122244, "i", "ntinue\n            consumed_sub_qty = use * cand['ratio']\n            sub_consumed[cand['sub']] += consumed_sub_qty\n            remaining[cand['sub']] = stock - consumed_sub_qty\n            rem -= use\n\n        if rem > 0:\n            return None\n\n    return {\n        'primary': dict(primary_consumed),\n        'subs': dict(sub_consumed)\n    }\n\n\ncurrent_parts = {p: parts[p]['on_hand_qty'] for p in parts}\ncurrent_wc = {wc: workcenters[wc]['available_hours'] for wc in workcenters}\nreport_orders = []\nEPS = 1e-9\n\nfor o in orders:\n    oid = o['order_id']\n    product = o['product_part_id']\n    req = o['requested_qty']\n    batch = parts[product]['batch_size']\n\n    max_multiple = (req // batch) * batch\n    candidates = list(range(max_multiple, -1, -batch))\n    if 0 not in candidates:\n        candidates.append(0)\n\n    selected = None\n    selected_demand = None\n    selected_build = None\n    selected_work = None\n    selected_proj = None\n    selected_cons = None\n\n    for cand in candidates:\n        dem_all, build, work_use"]
