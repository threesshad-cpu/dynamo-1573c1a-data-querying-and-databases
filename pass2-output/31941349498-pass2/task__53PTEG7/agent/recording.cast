[330.458344, "o", "> def leaf_available(leaf, inv):\r\n\u001b[?2004l\r_w\u001b[?2004h>     avail=inv.get(leaf,0)\r\n\u001b[?2004l\rre\u001b[?2004h>     for s in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
