[513.121677, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict\n\nDB_PATH = '/app/manufacturing.db'\nconn = sqlite3.connect(DB_PATH)\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nparts = {}\nfor r in cur.execute('SELECT part_id, name, on_hand_qty, batch_size FROM parts'):\n    parts[r['part_id']] = {\n        'name': r['name'],\n        'on_hand_qty': int(r['on_hand_qty']),\n        'batch_size': int(r['batch_size'])\n    }\n\nbom_rows = []\nfor r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n    bom_rows.append({\n        'parent': r['parent_part_id'],\n        'child': r['child_part_id'],\n        'qty_per': int(r['qty_per']),\n        'scrap_rate_pct': float(r['scrap_rate_pct']),\n        'setup_scrap_qty': int(r['setup_scrap_qty'])\n    })\n\nrouting = defaultdict(list)\nfor r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\n    routing[r['parent_part_id']].append({\n        'wc': r['workcent"]
[513.121756, "i", "er_id'],\n        'setup': float(r['setup_hours']),\n        'run': float(r['run_hours_per_unit'])\n    })\n\nworkcenters = {}\nfor r in cur.execute('SELECT workcenter_id, name, available_hours FROM workcenters'):\n    workcenters[r['workcenter_id']] = {\n        'name': r['name'],\n        'available_hours': float(r['available_hours'])\n    }\n\nsubs = defaultdict(list)\nfor r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes'):\n    subs[r['primary_part_id']].append({\n        'sub': r['substitute_part_id'],\n        'ratio': float(r['qty_ratio']),\n        'rank': int(r['preference_rank'])\n    })\nfor k in subs:\n    subs[k].sort(key=lambda x: (x['rank'], x['sub']))\n\norders = []\nfor r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders'):\n    orders.append({\n        'order_id': r['order_id'],\n        'product_part_id': r['product_part_id'],\n        'requested_qty': int(r['requested_qty']),\n        'priority': int(r['priority'])\n    })\ncon"]
[513.121922, "i", "n.close()\n\norders.sort(key=lambda x: (x['priority'], x['order_id']))\n\nmanufactured = set(routing.keys()) | {b['parent'] for b in bom_rows}\nchildren_by_parent = defaultdict(list)\nfor b in bom_rows:\n    children_by_parent[b['parent']].append(b)\n\n# Low-level codes: longest path from top-level parts; higher level means closer to final product.\nlevel = {p: 0 for p in parts}\nchanged = True\nwhile changed:\n    changed = False\n    for b in bom_rows:\n        nl = level[b['parent']] + 1\n        if level[b['child']] < nl:\n            level[b['child']] = nl\n            changed = True\n# Highest level first, then by part_id for determinism.\nsorted_parts = sorted(parts.keys(), key=lambda p: (level[p], p))\n\n\ndef explode(product_id, order_qty, inv):\n    \"\"\"Return total gross leaf demand, build quantities, workcenter usage,\n       and projected inventory after applying builds.\n    \"\"\"\n    demand = defaultdict(int)\n    demand[product_id] = order_qty\n    build = {}\n    work_usage = defaultdict(float)\n    proj = dict(inv)\n\n    for"]
[513.122003, "i", " p in sorted_parts:\n        if p not in manufactured:\n            continue\n        d = demand.get(p, 0)\n        if d <= 0:\n            continue\n        on_hand = proj.get(p, 0)\n        net = d - on_hand\n        b = 0\n        if net > 0:\n            batch = parts[p]['batch_size']\n            b = math.ceil(net / batch) * batch\n        build[p] = b\n\n        if b > 0:\n            for rr in routing.get(p, []):\n                work_usage[rr['wc']] += rr['setup'] + b * rr['run']\n            for child in children_by_parent.get(p, []):\n                base = b * child['qty_per']\n                child_req = int(math.ceil(base * (1.0 + child['scrap_rate_pct'] / 100.0))) + child['setup_scrap_qty']\n                demand[child['child']] += child_req\n\n        proj[p] = proj.get(p, 0) - d + b\n\n    return dict(demand), build, dict(work_usage), proj\n\n\ndef available_leaf_units(leaf, inv):\n    avail = inv.get(leaf, 0)\n    for s in subs.get(leaf, []):\n        st = inv.get(s['sub'], 0)\n        if st > 0 and s['ratio'] > 0:\n      "]
