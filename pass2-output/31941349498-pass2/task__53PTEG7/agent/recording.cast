[330.431346, "o", "> "]
[330.431741, "o", "            for rr in routing.get(p,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.432272, "o", "                work_usage[rr['wc']]+=rr['setup'] + b*rr['run']\r\n\u001b[?2004l\rr\u001b[?2004h"]
[330.432303, "o", "> "]
[330.432521, "o", "        # child demands\r\n\u001b[?2004l\rted,\u001b[?2004h"]
[330.432555, "o", "> "]
[330.432682, "o", "        if b>0:\r\n\u001b[?2004l\rr\u001b[?2004h"]
[330.432711, "o", "> "]
