[330.43054, "o", "\u001b[?2004h> "]
[330.43067, "o", "        build[p]=b\r\n\u001b[?2004l\r"]
[330.4307, "o", "\u001b[?2004h> "]
[330.431008, "o", "        # workcenter use\r\n\u001b[?2004l\rl\u001b[?2004h"]
