[330.426516, "o", "\u001b[?2004h> "]
[330.426804, "o", "    for p in sorted_parts:\r\n\u001b[?2004l\r"]
[330.426832, "o", "\u001b[?2004h> "]
[330.427199, "o", "        if p not in manufactured:\r\n\u001b[?2004l\r"]
[330.427227, "o", "\u001b[?2004h> "]
[330.427502, "o", "            continue\r\n\u001b[?2004l\r \u001b[?2004h"]
[330.427537, "o", "> "]
[330.427772, "o", "        d=demand.get(p,0)\r\n\u001b[?2004l\r"]
[330.427802, "o", "\u001b[?2004h> "]
[330.427986, "o", "        if d<=0:\r\n\u001b[?2004l\r"]
[330.428075, "o", "\u001b[?2004h> "]
[330.428324, "o", "            continue\r\n\u001b[?2004l\r"]
[330.428437, "o", "\u001b[?2004h> "]
[330.42866, "o", "        oh=proj.get(p,0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.42869, "o", "> "]
[330.428885, "o", "        net=d-oh\r\n\u001b[?2004l\r"]
[330.428971, "o", "\u001b[?2004h> "]
[330.42911, "o", "        b=0\r\n\u001b[?2004l\r"]
[330.42919, "o", "\u001b[?2004h> "]
[330.429442, "o", "        if net>0:\r\n\u001b[?2004l\r   "]
