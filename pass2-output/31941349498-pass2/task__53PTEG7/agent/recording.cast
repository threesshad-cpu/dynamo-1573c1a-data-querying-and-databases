[330.433429, "o", "\u001b[?2004h> "]
[330.434223, "o", "                child_req=int(math.ceil(base*(1.0+ch['scrap_rate_pct']/100.0))) + ch['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.434262, "o", "> "]
[330.434673, "o", "                demand[ch['child']]+=child_req\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.434721, "o", "> "]
