[513.122189, "i", "      avail += math.floor(st / s['ratio'])\n    return avail\n\n\ndef consume_leaves(leaf_demand, inv):\n    \"\"\"Return consumption dict or None if leaf/substitute inventory is insufficient.\"\"\"\n    remaining = dict(inv)\n    primary_consumed = defaultdict(int)\n    sub_consumed = defaultdict(float)\n\n    for leaf, dem in sorted(leaf_demand.items()):\n        if dem <= 0:\n            continue\n        rem = dem\n\n        # Primary stock first.\n        use = min(rem, remaining.get(leaf, 0))\n        if use > 0:\n            primary_consumed[leaf] += use\n            remaining[leaf] = remaining.get(leaf, 0) - use\n            rem -= use\n\n        if rem <= 0:\n            continue\n\n        for cand in subs.get(leaf, []):\n            if rem <= 0:\n                break\n            stock = remaining.get(cand['sub'], 0)\n            if stock <= 0 or cand['ratio'] <= 0:\n                continue\n            equiv_units = math.floor(stock / cand['ratio'])\n            use = min(rem, equiv_units)\n            if use <= 0:\n                co"]
