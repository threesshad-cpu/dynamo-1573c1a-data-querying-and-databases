[330.470859, "o", "\u001b[?2004h> "]
[330.470991, "o", "for o in orders:\r\n\u001b[?2004l\r"]
[330.47102, "o", "\u001b[?2004h> "]
[330.471951, "o", "    oid=o['order_id']; prod=o['product_part_id']; req=o['requested_qty']; batch=parts[prod]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.472185, "o", "    candidates=[req]\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.472286, "o", "> "]
[330.472363, "o", "    q=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.472394, "o", "> "]
[330.472898, "o", "    # include all multiples below request for search\r\n\u001b[?2004l\r"]
[330.472926, "o", "\u001b[?2004h> "]
[330.473211, "o", "    while q-batch >= 0:\r\n\u001b[?2004l\r"]
