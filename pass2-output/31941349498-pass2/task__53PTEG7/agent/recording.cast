[513.172983, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.173065, "o", "\u001b[?2004h> "]
[513.173506, "o", "def available_leaf_units(leaf, inv):\r\n\u001b[?2004l\ro\u001b[?2004h"]
[513.173532, "o", "> "]
[513.173838, "o", "    avail = inv.get(leaf, 0)\r\n\u001b[?2004l\rp\u001b[?2004h"]
[513.173956, "o", "> "]
[513.174276, "o", "    for s in subs.get(leaf, []):\r\n\u001b[?2004l\r"]
[513.174383, "o", "\u001b[?2004h> "]
[513.174711, "o", "        st = inv.get(s['sub'], 0)\r\n\u001b[?2004l\rt"]
[513.174739, "o", "\u001b[?2004h> "]
[513.175151, "o", "        if st > 0 and s['ratio'] > 0:\r\n\u001b[?2004l\r"]
[513.175176, "o", "\u001b[?2004h> "]
[513.175621, "o", "            avail += math.floor(st / s['ratio'])\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[513.175746, "o", "    return avail\r\n\u001b[?2004l\r"]
[513.175776, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.175868, "o", "o"]
[513.175894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.176254, "o", "def consume_leaves(leaf_demand, inv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.176937, "o", "    \"\"\"Return consumption dict or None if leaf/substitute inventory is insufficient.\"\"\"\r\n\u001b[?2004l\r"]
[513.176963, "o", "\u001b[?2004h> "]
[513.17721, "o", "    remaining = dict(inv)\r\n\u001b[?2004l\r"]
[513.177318, "o", "\u001b[?2004h> "]
[513.177613, "o", "    primary_consumed = defaultdict(int)\r\n\u001b[?2004l\r"]
[513.177644, "o", "\u001b[?2004h> "]
[513.177982, "o", "    sub_consumed = defaultdict(float)\r\n\u001b[?2004l\r"]
[513.178009, "o", "\u001b[?2004h> "]
[513.178154, "o", "\r\n\u001b[?2004l\rt\u001b[?2004h"]
[513.178181, "o", "> "]
[513.178537, "o", "    for leaf, dem in sorted(leaf_demand.items()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.17877, "o", "        if dem <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.1788, "o", "> "]
[513.178979, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.179008, "o", "> "]
[513.179211, "o", "        rem = dem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.179235, "o", "\r\n\u001b[?2004l\r"]
[513.179342, "o", "\u001b[?2004h> "]
[513.179538, "o", "        # Primary stock first.\r\n\u001b[?2004l\r"]
[513.179663, "o", "\u001b[?2004h> "]
[513.179949, "o", "        use = min(rem, remaining.get(leaf, 0))\r\n\u001b[?2004l\re\u001b[?2004h"]
[513.179973, "o", "> "]
[513.180199, "o", "        if use > 0:\r\n\u001b[?2004l\rey\u001b[?2004h"]
[513.180326, "o", "> "]
[513.180598, "o", "            primary_consumed[leaf] += use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.181049, "o", "            remaining[leaf] = remaining.get(leaf, 0) - use\r\n\u001b[?2004l\r'w"]
[513.181072, "o", "\u001b[?2004h> "]
[513.181305, "o", "            rem -= use\r\n\u001b[?2004l\rp(\u001b[?2004h"]
[513.18133, "o", "> \r\n\u001b[?2004l\r"]
[513.181433, "o", "r\u001b[?2004h> "]
[513.181584, "o", "        if rem <= 0:\r\n\u001b[?2004l\r \u001b[?2004h"]
[513.18168, "o", "> "]
[513.181796, "o", "            continue\r\n\u001b[?2004l\ri\u001b[?2004h"]
[513.181821, "o", "> \r\n\u001b[?2004l\r"]
[513.181837, "o", "n\u001b[?2004h"]
[513.181959, "o", "> "]
[513.182247, "o", "        for cand in subs.get(leaf, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.182467, "o", "            if rem <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.182493, "o", "> "]
[513.182669, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.182699, "o", "> "]
[513.183061, "o", "            stock = remaining.get(cand['sub'], 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.183444, "o", "            if stock <= 0 or cand['ratio'] <= 0:\r\n\u001b[?2004l\r"]
[513.18347, "o", "\u001b[?2004h> "]
[513.183646, "o", "                continue\r\n\u001b[?2004l\r"]
[513.183671, "o", "\u001b[?2004h> "]
[513.184075, "o", "            equiv_units = math.floor(stock / cand['ratio'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.184181, "o", "> "]
[513.184417, "o", "            use = min(rem, equiv_units)\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.184443, "o", "> "]
[513.184629, "o", "            if use <= 0:\r\n\u001b[?2004l\r"]
[513.184655, "o", "\u001b[?2004h> "]
[513.184847, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.184879, "o", "> "]
[513.185186, "o", "            consumed_sub_qty = use * cand['ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.185402, "o", "            sub_consumed[cand['sub']] += consumed_sub_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.185627, "o", "            remaining[cand['sub']] = stock - consumed_sub_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.185722, "o", "            rem -= use\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.185748, "o", "\u001b[?2004h> "]
[513.185863, "o", "        if rem > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.185958, "o", "            return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.185994, "o", "> "]
[513.186107, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.186238, "o", "        'primary': dict(primary_consumed),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.186388, "o", "        'subs': dict(sub_consumed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.186413, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.186497, "o", "> \r\n"]
[513.186562, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.186731, "o", "current_parts = {p: parts[p]['on_hand_qty'] for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187015, "o", "current_wc = {wc: workcenters[wc]['available_hours'] for wc in workcenters}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187138, "o", "report_orders = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187213, "o", "EPS = 1e-9\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.187233, "o", "> "]
[513.187292, "o", "for o in orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187423, "o", "    oid = o['order_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187555, "o", "    product = o['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187667, "o", "    req = o['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.187835, "o", "    batch = parts[product]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.187859, "o", "\u001b[?2004h> "]
[513.188041, "o", "    max_multiple = (req // batch) * batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188271, "o", "    candidates = list(range(max_multiple, -1, -batch))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188378, "o", "    if 0 not in candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188504, "o", "        candidates.append(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.188536, "o", "> "]
[513.188631, "o", "    selected = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188762, "o", "    selected_demand = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188862, "o", "    selected_build = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.188982, "o", "    selected_work = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.189104, "o", "    selected_proj = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.189215, "o", "    selected_cons = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.189242, "o", "> "]
[513.189383, "o", "    for cand in candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.189654, "o", "        dem_all, build, work_use, proj = explode(product, cand, current_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.189968, "o", "        leaf_demand = {p: d for p, d in dem_all.items() if p not in manufactured and d > 0}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.190061, "o", "\u001b[?2004h> "]
[513.190207, "o", "        feasible = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.190312, "o", "        for wc, usage in work_use.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.190484, "o", "            if usage > current_wc[wc] + EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.190616, "o", "                feasible = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.190732, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19083, "o", "        if feasible:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.191075, "o", "            cons = consume_leaves(leaf_demand, current_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19121, "o", "            if cons is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.191352, "o", "                feasible = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.191381, "o", "> "]
[513.191494, "o", "        if feasible:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.191614, "o", "            selected = cand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.191768, "o", "            selected_demand = dem_all\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.191911, "o", "            selected_build = build\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19206, "o", "            selected_work = work_use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.192208, "o", "            selected_proj = proj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.192353, "o", "            selected_cons = cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.192469, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.192574, "o", "    if selected is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19266, "o", "        selected = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.192916, "o", "        _, _, _, proj_zero = explode(product, 0, current_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.193018, "o", "        selected_demand = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.193173, "o", "        selected_build = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.193303, "o", "        selected_work = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.193442, "o", "        selected_proj = proj_zero\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.193645, "o", "        selected_cons = {'primary': {}, 'subs': {}}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.193676, "o", "> "]
[513.193933, "o", "    # Determine limiting resource when order is not fully satisfied.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.194046, "o", "    limiting = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.194176, "o", "    if selected < req:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.194329, "o", "        try_qty = selected + batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.194578, "o", "        dem_all_lim, _, work_use_lim, _ = explode(product, try_qty, current_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.194907, "o", "        leaf_gross = {p: d for p, d in dem_all_lim.items() if p not in manufactured and d > 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19499, "o", "        ratios = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.195009, "o", "\u001b[?2004h> "]
[513.195221, "o", "        for leaf, d in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.195348, "o", "            if d <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.195471, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.195654, "o", "            avail = available_leaf_units(leaf, current_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.195783, "o", "            ratio = avail / d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.195921, "o", "            if ratio < 1.0 - EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.196118, "o", "                ratios.append((ratio, leaf))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.19615, "o", "> "]
[513.196338, "o", "        for wc, usage in work_use_lim.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.196426, "o", "            if usage <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[513.19645, "o", "> "]
[513.196546, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.196712, "o", "            ratio = current_wc[wc] / usage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.196853, "o", "            if ratio < 1.0 - EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.197019, "o", "                ratios.append((ratio, wc))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[513.197045, "o", "\u001b[?2004h> "]
[513.197209, "o", "        if ratios:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.197366, "o", "            ratios.sort(key=lambda x: (x[0], x[1]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.197504, "o", "            limiting = ratios[0][1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.197535, "o", "> "]
[513.197658, "o", "    report_orders.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.197767, "o", "        'order_id': oid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.19792, "o", "        'allocated_qty': int(selected),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.198125, "o", "        'shortfall_qty': int(req - selected),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.198269, "o", "        'limiting_resource': limiting\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n"]
[513.198295, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[513.198399, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.198516, "o", "    # Commit the selected production.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.198658, "o", "    current_parts = dict(selected_proj)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.198862, "o", "    for leaf, qty in selected_cons['primary'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.199104, "o", "        current_parts[leaf] = current_parts.get(leaf, 0) - qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.199292, "o", "    for sub, qty in selected_cons['subs'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.199505, "o", "        current_parts[sub] = current_parts.get(sub, 0) - qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.199674, "o", "    for wc, usage in selected_work.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.199847, "o", "        current_wc[wc] = current_wc[wc] - usage\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.199879, "o", "> "]
[513.200147, "o", "report_orders_sorted = sorted(report_orders, key=lambda x: x['order_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.20033, "o", "report = {'orders': report_orders_sorted}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.200361, "o", "> "]
[513.200535, "o", "with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.200678, "o", "    json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[513.20076, "o", "    f.write('\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[513.200827, "o", "> "]
