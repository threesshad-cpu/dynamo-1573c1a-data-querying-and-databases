[1375.473311, "o", "\u001b[?2004h> "]
[1375.473572, "o", "    subs_by_primary.setdefault(s['primary_part_id'], []).append(s)\r\n\u001b[?2004l\r"]
[1375.473581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1375.4736, "o", " \u001b[?2004h> "]
[1375.473798, "o", "# manufactured parts: have BOM or routing (or both)\r\n\u001b[?2004l\r \u001b[?2004h"]
[1375.473808, "o", "> "]
[1375.473982, "o", "mfg = set(bom_parents) | set(routing_parents)\r\n\u001b[?2004l\r"]
[1375.474003, "o", "\u001b[?2004h> "]
[1375.474025, "o", "\r\n\u001b[?2004l\rt\u001b[?2004h"]
[1375.474034, "o", "> "]
[1375.47408, "o", "# compute levels\r\n\u001b[?2004l\r"]
[1375.474104, "o", "\u001b[?2004h> "]
[1375.474145, "o", "levels = {}\r\n\u001b[?2004l\r"]
[1375.474193, "o", "\u001b[?2004h> "]
[1375.474323, "o", "def compute_level(pid, stack=None):\r\n\u001b[?2004l\r  \u001b[?2004h"]
[1375.474333, "o", "> "]
[1375.474428, "o", "    if stack is None:\r\n\u001b[?2004l\r"]
[1375.474438, "o", "\u001b[?2004h> "]
[1375.474517, "o", "        stack = []\r\n\u001b[?2004l\r "]
[1375.474527, "o", "\u001b[?2004h> "]
[1375.474616, "o", "    if pid in levels:\r\n\u001b[?2004l\r"]
[1375.474643, "o", "\u001b[?2004h> "]
[1375.474739, "o", "        return levels[pid]\r\n\u001b[?2004l\r"]
[1375.474771, "o", "\u001b[?2004h> "]
[1375.474863, "o", "    if pid not in levels:\r\n\u001b[?2004l\r "]
[1375.474872, "o", "\u001b[?2004h> "]
[1375.474966, "o", "        levels[pid] = 0\r\n\u001b[?2004l\r"]
[1375.474976, "o", "\u001b[?2004h> "]
[1375.475044, "o", "    maxc = 0\r\n\u001b[?2004l\r"]
[1375.475053, "o", "\u001b[?2004h> "]
[1375.475219, "o", "    for b in bom_children.get(pid, []):\r\n\u001b[?2004l\r"]
[1375.475229, "o", "\u001b[?2004h> "]
[1375.475379, "o", "        child = b['child_part_id']\r\n\u001b[?2004l\rs"]
[1375.475388, "o", "\u001b[?2004h> "]
[1375.475493, "o", "        if child in stack:\r\n\u001b[?2004l\r"]
[1375.475504, "o", "\u001b[?2004h> "]
[1375.475593, "o", "            continue\r\n\u001b[?2004l\ru"]
[1375.475602, "o", "\u001b[?2004h> "]
[1375.475855, "o", "        maxc = max(maxc, compute_level(child, stack + [pid]) + 1)\r\n\u001b[?2004l\r"]
[1375.475864, "o", "\u001b[?2004h> "]
[1375.475953, "o", "    levels[pid] = maxc\r\n\u001b[?2004l\r"]
[1375.475975, "o", "\u001b[?2004h> "]
[1375.476042, "o", "    return maxc\r\n\u001b[?2004l\r"]
[1375.47606, "o", "\u001b[?2004h> "]
[1375.47607, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.476093, "o", "> "]
[1375.47615, "o", "for pid in parts:\r\n\u001b[?2004l\r"]
[1375.47617, "o", "\u001b[?2004h> "]
[1375.476268, "o", "    compute_level(pid)\r\n\u001b[?2004l\r"]
[1375.476279, "o", "\u001b[?2004h> "]
[1375.476288, "o", "\r\n\u001b[?2004l\r"]
[1375.476312, "o", "\u001b[?2004h> "]
[1375.476573, "o", "sorted_parts_by_level = sorted(parts.keys(), key=lambda p: -levels[p])\r\n\u001b[?2004l\r"]
[1375.476582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1375.476604, "o", " \u001b[?2004h> "]
[1375.476911, "o", "print('Sorted parts by level:', [(p, levels[p]) for p in sorted_parts_by_level])\r\n\u001b[?2004l\r"]
[1375.476921, "o", "\u001b[?2004h> "]
[1375.476938, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.476946, "o", "> "]
[1375.477009, "o", "# Process orders\r\n\u001b[?2004l\r"]
[1375.477017, "o", "\u001b[?2004h> "]
[1375.477078, "o", "results = []\r\n\u001b[?2004l\r"]
[1375.477087, "o", "\u001b[?2004h> "]
[1375.477098, "o", "\r\n\u001b[?2004l\r "]
[1375.477108, "o", "\u001b[?2004h"]
[1375.477131, "o", "> "]
[1375.477218, "o", "for order in orders_raw:\r\n\u001b[?2004l\r"]
[1375.477249, "o", "\u001b[?2004h> "]
[1375.477359, "o", "    order_id = order['order_id']\r\n\u001b[?2004l\r"]
[1375.477386, "o", "\u001b[?2004h> "]
[1375.477521, "o", "    product = order['product_part_id']\r\n\u001b[?2004l\r"]
[1375.47753, "o", "\u001b[?2004h"]
[1375.477547, "o", "> "]
[1375.477693, "o", "    requested_qty = order['requested_qty']\r\n\u001b[?2004l\r"]
[1375.477715, "o", "\u001b[?2004h> "]
[1375.477829, "o", "    priority = order['priority']\r\n\u001b[?2004l\r"]
[1375.47785, "o", "\u001b[?2004h> "]
[1375.478017, "o", "    batch_size = parts[product]['batch_size']\r\n\u001b[?2004l\r"]
[1375.478025, "o", "\u001b[?2004h> "]
[1375.478054, "o", "    \r\n\u001b[?2004l\r"]
[1375.478079, "o", "\u001b[?2004h> "]
[1375.478511, "o", "    print(f'\\n=== Processing order {order_id} for product {product} qty {requested_qty} batch {batch_size} ===')\r\n\u001b[?2004l\r"]
[1375.478521, "o", "\u001b[?2004h> "]
[1375.478554, "o", "    \r\n\u001b[?2004l\r"]
[1375.478574, "o", "\u001b[?2004h> "]
[1375.478861, "o", "    # We'll search for max feasible Q multiple of batch_size <= requested_qty\r\n\u001b[?2004l\r"]
[1375.47887, "o", "\u001b[?2004h> "]
[1375.47896, "o", "    def state_copy():\r\n\u001b[?2004l\r"]
[1375.478969, "o", "\u001b[?2004h> "]
[1375.479037, "o", "        s = {\r\n\u001b[?2004l\r b"]
[1375.479047, "o", "\u001b[?2004h> "]
[1375.479295, "o", "            'parts': {pid: dict(d) for pid, d in parts.items()},\r\n\u001b[?2004l\r"]
[1375.479304, "o", "\u001b[?2004h"]
[1375.479324, "o", "> "]
[1375.479549, "o", "            'wcs': {wid: dict(d) for wid, d in wcs.items()}\r\n\u001b[?2004l\r"]
[1375.479559, "o", "\u001b[?2004h> "]
[1375.479602, "o", "        }\r\n\u001b[?2004l\r"]
[1375.479621, "o", "\u001b[?2004h> "]
[1375.479735, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.479838, "o", "    def feasible(Q, state):\r\n\u001b[?2004l\r"]
[1375.479848, "o", "\u001b[?2004h> "]
[1375.480057, "o", "        # state is mutated in-place; returns True/False\r\n\u001b[?2004l\r"]
[1375.480077, "o", "\u001b[?2004h> "]
[1375.480262, "o", "        gross_req = {pid: 0.0 for pid in parts}\r\n\u001b[?2004l\r"]
[1375.480271, "o", "\u001b[?2004h> "]
[1375.480416, "o", "        gross_req[product] = float(Q)\r\n\u001b[?2004l\r"]
[1375.480428, "o", "\u001b[?2004h> "]
[1375.48047, "o", "        \r\n\u001b[?2004l\r"]
[1375.480495, "o", "\u001b[?2004h> "]
[1375.480645, "o", "        for pid in sorted_parts_by_level:\r\n\u001b[?2004l\r"]
[1375.480654, "o", "\u001b[?2004h> "]
[1375.480838, "o", "            if gross_req.get(pid, 0.0) <= 0:\r\n\u001b[?2004l\r"]
[1375.480848, "o", "\u001b[?2004h> "]
[1375.480944, "o", "                continue\r\n\u001b[?2004l\r"]
[1375.480964, "o", "\u001b[?2004h> "]
[1375.481098, "o", "            demand = gross_req[pid]\r\n\u001b[?2004l\r"]
[1375.48112, "o", "\u001b[?2004h> "]
[1375.481234, "o", "            if pid in mfg:\r\n\u001b[?2004l\r"]
[1375.481265, "o", "\u001b[?2004h> "]
[1375.481435, "o", "                pdata = state['parts'][pid]\r\n\u001b[?2004l\r"]
[1375.481443, "o", "\u001b[?2004h> "]
[1375.481616, "o", "                avail = pdata['on_hand_qty']\r\n\u001b[?2004l\r"]
[1375.481646, "o", "\u001b[?2004h> "]
[1375.481834, "o", "                consumed = min(avail, demand)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.481843, "o", "> "]
[1375.481998, "o", "                net = demand - consumed\r\n\u001b[?2004l\r"]
[1375.482033, "o", "\u001b[?2004h> "]
[1375.482141, "o", "                if net > 0:\r\n\u001b[?2004l\r\r\n"]
[1375.48215, "o", "\u001b[?2004h> "]
[1375.482358, "o", "                    batch = pdata['batch_size']\r\n\u001b[?2004l\r"]
[1375.482368, "o", "\u001b[?2004h"]
[1375.482387, "o", "> "]
[1375.482594, "o", "                    prod = math.ceil(net / batch) * batch\r\n\u001b[?2004l\r"]
[1375.482617, "o", "\u001b[?2004h> "]
[1375.482695, "o", "                else:\r\n\u001b[?2004l\r"]
[1375.482716, "o", "\u001b[?2004h> "]
[1375.482819, "o", "                    prod = 0\r\n\u001b[?2004l\r"]
[1375.482851, "o", "\u001b[?2004h> "]
[1375.482973, "o", "                # check workcenters\r\n\u001b[?2004l\r"]
[1375.482996, "o", "\u001b[?2004h> "]
[1375.48322, "o", "                for r in routing_by_parent.get(pid, []):\r\n\u001b[?2004l\r"]
[1375.483244, "o", "\u001b[?2004h> "]
[1375.48343, "o", "                    wc_id = r['workcenter_id']\r\n\u001b[?2004l\r"]
[1375.483463, "o", "\u001b[?2004h> "]
[1375.483765, "o", "                    hours_needed = r['setup_hours'] + prod * r['run_hours_per_unit']\r\n\u001b[?2004l\r"]
[1375.483785, "o", "\u001b[?2004h> "]
[1375.484071, "o", "                    if state['wcs'][wc_id]['available_hours'] < hours_needed:\r\n\u001b[?2004l\r"]
[1375.484105, "o", "\u001b[?2004h> "]
[1375.484253, "o", "                        return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.484431, "o", "                # add demands to children\r\n\u001b[?2004l\r"]
[1375.484445, "o", "\u001b[?2004h> "]
[1375.484663, "o", "                for b in bom_children.get(pid, []):\r\n\u001b[?2004l\r"]
[1375.484694, "o", "\u001b[?2004h> "]
[1375.484892, "o", "                    child = b['child_part_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.484906, "o", "> "]
[1375.485041, "o", "                    if prod > 0:\r\n\u001b[?2004l\r"]
[1375.485077, "o", "\u001b[?2004h> "]
[1375.485535, "o", "                        add = math.ceil(prod * b['qty_per'] * (1 + b['scrap_rate_pct'] / 100.0)) + b['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[1375.485552, "o", "\u001b[?2004h> "]
[1375.485687, "o", "                    else:\r\n\u001b[?2004l\r"]
[1375.48572, "o", "\u001b[?2004h"]
[1375.485751, "o", "> "]
[1375.48583, "o", "                        add = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.485843, "o", "> "]
[1375.486108, "o", "                    gross_req[child] = gross_req.get(child, 0.0) + add\r\n\u001b[?2004l\r"]
[1375.486123, "o", "\u001b[?2004h> "]
[1375.486253, "o", "                # update state\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.486268, "o", "> "]
[1375.486607, "o", "                pdata['on_hand_qty'] = pdata['on_hand_qty'] - consumed + (prod - net)\r\n\u001b[?2004l\r"]
[1375.48662, "o", "\u001b[?2004h> "]
[1375.48683, "o", "                for r in routing_by_parent.get(pid, []):\r\n\u001b[?2004l\r"]
[1375.486844, "o", "\u001b[?2004h> "]
[1375.487025, "o", "                    wc_id = r['workcenter_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.487057, "o", "> "]
[1375.487381, "o", "                    hours_needed = r['setup_hours'] + prod * r['run_hours_per_unit']\r\n\u001b[?2004l\r"]
[1375.487394, "o", "\u001b[?2004h> "]
[1375.487682, "o", "                    state['wcs'][wc_id]['available_hours'] -= hours_needed\r\n\u001b[?2004l\r"]
[1375.487695, "o", "\u001b[?2004h> "]
[1375.487772, "o", "            else:\r\n\u001b[?2004l\r"]
[1375.487786, "o", "\u001b[?2004h> "]
[1375.487881, "o", "                # leaf\r\n\u001b[?2004l\r"]
[1375.487922, "o", "\u001b[?2004h> "]
[1375.488065, "o", "                pdata = state['parts'][pid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.488301, "o", "                avail_own = pdata['on_hand_qty']\r\n\u001b[?2004l\r"]
[1375.488315, "o", "\u001b[?2004h> "]
[1375.488546, "o", "                consume_own = min(avail_own, demand)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.488565, "o", "> "]
[1375.488729, "o", "                demand -= consume_own\r\n\u001b[?2004l\r"]
[1375.488772, "o", "\u001b[?2004h> "]
[1375.488959, "o", "                pdata['on_hand_qty'] -= consume_own\r\n\u001b[?2004l\r"]
[1375.488976, "o", "\u001b[?2004h"]
[1375.489019, "o", "> "]
[1375.489109, "o", "                if demand > 0:\r\n\u001b[?2004l\rem\u001b[?2004h"]
[1375.489125, "o", "> "]
[1375.489369, "o", "                    subs = subs_by_primary.get(pid, [])\r\n\u001b[?2004l\rs\u001b[?2004h"]
[1375.489385, "o", "> "]
[1375.489815, "o", "                    subs_sorted = sorted(subs, key=lambda x: (x['preference_rank'], x['substitute_part_id']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.489829, "o", "> "]
[1375.489992, "o", "                    for s in subs_sorted:\r\n\u001b[?2004l\r \u001b[?2004h"]
[1375.490006, "o", "> "]
[1375.490165, "o", "                        if demand <= 0:\r\n\u001b[?2004l\r"]
[1375.490203, "o", "\u001b[?2004h> "]
[1375.490328, "o", "                            break\r\n\u001b[?2004l\r"]
[1375.490343, "o", "\u001b[?2004h> "]
[1375.490571, "o", "                        sub_id = s['substitute_part_id']\r\n\u001b[?2004l\r"]
[1375.490584, "o", "\u001b[?2004h> "]
[1375.490822, "o", "                        sub_data = state['parts'][sub_id]\r\n\u001b[?2004l\r"]
[1375.490836, "o", "\u001b[?2004h> "]
[1375.491063, "o", "                        sub_avail = sub_data['on_hand_qty']\r\n\u001b[?2004l\r"]
[1375.491076, "o", "\u001b[?2004h> "]
[1375.491255, "o", "                        if sub_avail <= 0:\r\n\u001b[?2004l\r"]
[1375.49127, "o", "\u001b[?2004h> "]
[1375.491425, "o", "                            continue\r\n\u001b[?2004l\r"]
[1375.49144, "o", "\u001b[?2004h> "]
[1375.491628, "o", "                        ratio = s['qty_ratio']\r\n\u001b[?2004l\r"]
[1375.491642, "o", "\u001b[?2004h> "]
[1375.491899, "o", "                        equiv_units = int(sub_avail // ratio)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.491912, "o", "> "]
[1375.492087, "o", "                        if equiv_units <= 0:\r\n\u001b[?2004l\r"]
[1375.492101, "o", "\u001b[?2004h> "]
[1375.492244, "o", "                            continue\r\n\u001b[?2004l\r"]
[1375.492259, "o", "\u001b[?2004h> "]
[1375.492584, "o", "                        use_equiv = min(equiv_units, int(math.ceil(demand)))\r\n\u001b[?2004l\r"]
[1375.492597, "o", "\u001b[?2004h> "]
[1375.492938, "o", "                        # demand may be fractional? currently integer; but just in case\r\n\u001b[?2004l\r"]
[1375.492952, "o", "\u001b[?2004h> "]
[1375.493143, "o", "                        use_equiv = int(use_equiv)\r\n\u001b[?2004l\r"]
[1375.493157, "o", "\u001b[?2004h> "]
[1375.493392, "o", "                        consume_sub = use_equiv * ratio\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.493405, "o", "> "]
[1375.493632, "o", "                        sub_data['on_hand_qty'] -= consume_sub\r\n\u001b[?2004l\r"]
[1375.493646, "o", "\u001b[?2004h> "]
[1375.493821, "o", "                        demand -= use_equiv\r\n\u001b[?2004l\r"]
[1375.493834, "o", "\u001b[?2004h> "]
[1375.493973, "o", "                    if demand > 0:\r\n\u001b[?2004l\rts own pr\u001b[?2004h"]
[1375.493986, "o", "> "]
[1375.494125, "o", "                        return False\r\n\u001b[?2004l\r"]
[1375.49414, "o", "\u001b[?2004h> "]
[1375.494257, "o", "        return True\r\n\u001b[?2004l\r"]
[1375.49429, "o", "\u001b[?2004h> "]
[1375.494322, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.494359, "o", "> "]
[1375.494423, "o", "    # Find max feasible Q\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.494438, "o", "> "]
[1375.494527, "o", "    max_feasible = 0\r\n\u001b[?2004l\r"]
[1375.49454, "o", "\u001b[?2004h> "]
[1375.49458, "o", "    k = 0\r\n\u001b[?2004l\r"]
[1375.494594, "o", "\u001b[?2004h> "]
[1375.494763, "o", "    while k * batch_size <= requested_qty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.494777, "o", "> "]
[1375.494886, "o", "        Q = k * batch_size\r\n\u001b[?2004l\r "]
[1375.4949, "o", "\u001b[?2004h> "]
[1375.495002, "o", "        st = state_copy()\r\n\u001b[?2004l\r"]
[1375.495016, "o", "\u001b[?2004h> "]
[1375.49513, "o", "        if feasible(Q, st):\r\n\u001b[?2004l\r"]
[1375.495162, "o", "\u001b[?2004h> "]
[1375.495284, "o", "            max_feasible = Q\r\n\u001b[?2004l\r "]
[1375.495299, "o", "\u001b[?2004h> "]
[1375.495382, "o", "            k += 1\r\n\u001b[?2004l\r"]
[1375.495395, "o", "\u001b[?2004h> "]
[1375.495455, "o", "        else:\r\n\u001b[?2004l\r"]
[1375.495487, "o", "\u001b[?2004h> "]
[1375.495555, "o", "            break\r\n\u001b[?2004l\r"]
[1375.495569, "o", "\u001b[?2004h> "]
[1375.49561, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.495957, "o", "    print(f'Max feasible Q = {max_feasible}, shortfall = {requested_qty - max_feasible}')\r\n\u001b[?2004l\r"]
[1375.495971, "o", "\u001b[?2004h> "]
[1375.495999, "o", "    \r\n\u001b[?2004l\r"]
[1375.496013, "o", "\u001b[?2004h> "]
[1375.496187, "o", "    # Limiting resource if shortfall > 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.4962, "o", "> "]
[1375.496319, "o", "    limiting_resource = None\r\n\u001b[?2004l\rg\u001b[?2004h"]
[1375.496334, "o", "> "]
[1375.49648, "o", "    if max_feasible < requested_qty:\r\n\u001b[?2004l\rn\u001b[?2004h"]
[1375.496494, "o", "> "]
[1375.496673, "o", "        next_batch = max_feasible + batch_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.496954, "o", "        print(f'Checking limiting resource for next batch Q = {next_batch}')\r\n\u001b[?2004l\r"]
[1375.49697, "o", "\u001b[?2004h> "]
[1375.497259, "o", "        # compute gross requirements using original state (before this order)\r\n\u001b[?2004l\r"]
[1375.497296, "o", "\u001b[?2004h> "]
[1375.497415, "o", "        orig_state = state_copy()\r\n\u001b[?2004l\ri\u001b[?2004h"]
[1375.497429, "o", "> "]
[1375.497466, "o", "        \r\n\u001b[?2004l\r"]
[1375.497479, "o", "\u001b[?2004h> "]
[1375.497631, "o", "        def compute_gross(Q, state):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.497646, "o", "> "]
[1375.497802, "o", "            # returns leaf_gross, wc_hours\r\n\u001b[?2004l\r"]
[1375.497816, "o", "\u001b[?2004h> "]
[1375.498196, "o", "            # mutates state for netting sub-assemblies (but we don't care about leaf consumption)\r\n\u001b[?2004l\r"]
[1375.498209, "o", "\u001b[?2004h> "]
[1375.498322, "o", "            leaf_gross = {}\r\n\u001b[?2004l\r"]
[1375.498356, "o", "\u001b[?2004h> "]
[1375.498461, "o", "            wc_hours = {}\r\n\u001b[?2004l\rp\u001b[?2004h"]
[1375.498491, "o", "> "]
[1375.49866, "o", "            gross_req = {pid: 0.0 for pid in parts}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.498689, "o", "> "]
[1375.498827, "o", "            gross_req[product] = float(Q)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.498856, "o", "> "]
[1375.49901, "o", "            for pid in sorted_parts_by_level:\r\n\u001b[?2004l\r"]
[1375.499039, "o", "\u001b[?2004h> "]
[1375.499221, "o", "                if gross_req.get(pid, 0.0) <= 0:\r\n\u001b[?2004l\r"]
[1375.499235, "o", "\u001b[?2004h> "]
[1375.499366, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.499398, "o", "> "]
[1375.499536, "o", "                demand = gross_req[pid]\r\n\u001b[?2004l\r"]
[1375.499548, "o", "\u001b[?2004h> "]
[1375.499665, "o", "                if pid in mfg:\r\n\u001b[?2004l\r"]
[1375.49968, "o", "\u001b[?2004h> "]
[1375.49987, "o", "                    pdata = state['parts'][pid]\r\n\u001b[?2004l\r"]
[1375.499884, "o", "\u001b[?2004h> "]
[1375.500084, "o", "                    avail = pdata['on_hand_qty']\r\n\u001b[?2004l\r"]
[1375.500098, "o", "\u001b[?2004h> "]
[1375.50028, "o", "                    consumed = min(avail, demand)\r\n\u001b[?2004l\r"]
[1375.500295, "o", "\u001b[?2004h> "]
[1375.500468, "o", "                    net = demand - consumed\r\n\u001b[?2004l\r"]
[1375.500483, "o", "\u001b[?2004h> "]
[1375.500612, "o", "                    if net > 0:\r\n\u001b[?2004l\r"]
[1375.500625, "o", "\u001b[?2004h> "]
[1375.500822, "o", "                        batch = pdata['batch_size']\r\n\u001b[?2004l\r"]
[1375.500835, "o", "\u001b[?2004h> "]
[1375.501076, "o", "                        prod = math.ceil(net / batch) * batch\r\n\u001b[?2004l\r"]
[1375.501092, "o", "\u001b[?2004h> "]
[1375.501207, "o", "                    else:\r\n\u001b[?2004l\r"]
[1375.501239, "o", "\u001b[?2004h> "]
[1375.501354, "o", "                        prod = 0\r\n\u001b[?2004l\r"]
[1375.501368, "o", "\u001b[?2004h> "]
[1375.501529, "o", "                    # accumulate WC hours\r\n\u001b[?2004l\r"]
[1375.501545, "o", "\u001b[?2004h> "]
[1375.501783, "o", "                    for r in routing_by_parent.get(pid, []):\r\n\u001b[?2004l\r"]
[1375.501797, "o", "\u001b[?2004h> "]
[1375.501997, "o", "                        wc_id = r['workcenter_id']\r\n\u001b[?2004l\r"]
[1375.502011, "o", "\u001b[?2004h> "]
[1375.50236, "o", "                        hours_needed = r['setup_hours'] + prod * r['run_hours_per_unit']\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.502374, "o", "> "]
[1375.50268, "o", "                        wc_hours[wc_id] = wc_hours.get(wc_id, 0.0) + hours_needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.502854, "o", "                    # children demands\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.502869, "o", "> "]
[1375.503089, "o", "                    for b in bom_children.get(pid, []):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.503103, "o", "> "]
[1375.503304, "o", "                        child = b['child_part_id']\r\n\u001b[?2004l\r"]
[1375.503338, "o", "\u001b[?2004h> "]
[1375.503472, "o", "                        if prod > 0:\r\n\u001b[?2004l\r"]
[1375.5035, "o", "\u001b[?2004h> "]
[1375.503957, "o", "                            add = math.ceil(prod * b['qty_per'] * (1 + b['scrap_rate_pct'] / 100.0)) + b['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[1375.50397, "o", "\u001b[?2004h> "]
[1375.504088, "o", "                        else:\r\n\u001b[?2004l\r"]
[1375.504101, "o", "\u001b[?2004h> "]
[1375.504244, "o", "                            add = 0\r\n\u001b[?2004l\r"]
[1375.504278, "o", "\u001b[?2004h> "]
[1375.504576, "o", "                        gross_req[child] = gross_req.get(child, 0.0) + add\r\n\u001b[?2004l\r"]
[1375.504589, "o", "\u001b[?2004h> "]
[1375.504892, "o", "                    # update state for sub-assembly netting (but not leaves)\r\n\u001b[?2004l\r"]
[1375.504906, "o", "\u001b[?2004h> "]
[1375.505256, "o", "                    pdata['on_hand_qty'] = pdata['on_hand_qty'] - consumed + (prod - net)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.505356, "o", "                else:\r\n\u001b[?2004l\r"]
[1375.505371, "o", "\u001b[?2004h> "]
[1375.505611, "o", "                    # leaf: accumulate gross requirement, do NOT net stock\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.505625, "o", "> "]
[1375.505844, "o", "                    leaf_gross[pid] = leaf_gross.get(pid, 0.0) + demand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.505978, "o", "            return leaf_gross, wc_hours\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.506011, "o", "> "]
[1375.506041, "o", "        \r\n\u001b[?2004l\r"]
[1375.506069, "o", "\u001b[?2004h> "]
[1375.506266, "o", "        leaf_gross, wc_hours = compute_gross(next_batch, orig_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.506282, "o", "> "]
[1375.506448, "o", "        print('Leaf gross requirements:', leaf_gross)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.506464, "o", "> "]
[1375.506613, "o", "        print('WC hours requirements:', wc_hours)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.506648, "o", "> "]
[1375.506681, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.506753, "o", "        # compute ratios\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.506767, "o", "> "]
[1375.506838, "o", "        ratios = {}\r\n\u001b[?2004l\r"]
[1375.506866, "o", "\u001b[?2004h> "]
[1375.507005, "o", "        for leaf_id, gross in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.507019, "o", "> "]
[1375.507108, "o", "            if gross <= 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.507122, "o", "> "]
[1375.507247, "o", "                continue\r\n\u001b[?2004l\r"]
[1375.507263, "o", "\u001b[?2004h> "]
[1375.507491, "o", "            total_avail = parts[leaf_id]['on_hand_qty']  # original stock\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.507507, "o", "> "]
[1375.507629, "o", "            # add substitutes equivalent\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.507778, "o", "            if leaf_id in subs_by_primary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.507811, "o", "> "]
[1375.508049, "o", "                # but leaf_id as primary; its substitutes contribute to its available\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.508082, "o", "> "]
[1375.508357, "o", "                # Actually the primary is leaf_id; we need to add equivalent from substitutes\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.508372, "o", "> "]
[1375.508526, "o", "                for s in subs_by_primary[leaf_id]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.508559, "o", "> "]
[1375.508696, "o", "                    sub_id = s['substitute_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.508893, "o", "                    sub_stock = parts[sub_id]['on_hand_qty']\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.508907, "o", "> "]
[1375.509053, "o", "                    ratio_sub = s['qty_ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.509245, "o", "                    equiv = int(sub_stock // ratio_sub)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.509261, "o", "> "]
[1375.5094, "o", "                    total_avail += equiv\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.509415, "o", "> "]
[1375.509542, "o", "            if leaf_id in subs_by_primary:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.509576, "o", "> "]
[1375.509808, "o", "                # leaf_id might also be a substitute for another? Not relevant here.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.509894, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.509908, "o", "> "]
[1375.510287, "o", "            # Also, leaf_id might itself be a substitute for another primary; its stock is already counted in its own primary?\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.510302, "o", "> "]
[1375.510538, "o", "            # For ratio, only count stock of the primary and its substitutes.\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.510551, "o", "> "]
[1375.510672, "o", "            ratio = total_avail / gross\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.510864, "o", "            ratios[leaf_id] = (ratio, total_avail, gross)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.511039, "o", "        for wc_id, hours_needed in wc_hours.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.511162, "o", "            if hours_needed <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.511282, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.511438, "o", "            avail = wcs[wc_id]['available_hours']\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.511448, "o", "> "]
[1375.511578, "o", "            ratio = avail / hours_needed\r\n\u001b[?2004l\r"]
[1375.511587, "o", "\u001b[?2004h> "]
[1375.511762, "o", "            ratios[wc_id] = (ratio, avail, hours_needed)\r\n\u001b[?2004l\r"]
[1375.511783, "o", "\u001b[?2004h> "]
[1375.511857, "o", "        print('Ratios:')\r\n\u001b[?2004l\r"]
[1375.511878, "o", "\u001b[?2004h> "]
[1375.51201, "o", "        for rid, (r, a, g) in ratios.items():\r\n\u001b[?2004l\r"]
[1375.51202, "o", "\u001b[?2004h> "]
[1375.512219, "o", "            print(f'  {rid}: {r:.4f} (avail={a}, gross={g})')\r\n\u001b[?2004l\r"]
[1375.512229, "o", "\u001b[?2004h> "]
[1375.512309, "o", "        # Find limiting\r\n\u001b[?2004l\r"]
[1375.51233, "o", "\u001b[?2004h> "]
[1375.512416, "o", "        min_ratio = None\r\n\u001b[?2004l\r"]
[1375.512427, "o", "\u001b[?2004h> "]
[1375.51257, "o", "        for rid, (r, a, g) in ratios.items():\r\n\u001b[?2004l\r"]
[1375.512579, "o", "\u001b[?2004h"]
[1375.512602, "o", "> "]
[1375.512661, "o", "            if r < 1.0:\r\n\u001b[?2004l\r"]
[1375.51267, "o", "\u001b[?2004h> "]
[1375.513012, "o", "                if min_ratio is None or r < min_ratio[0] or (abs(r - min_ratio[0]) < 1e-12 and rid < min_ratio[1]):\r\n\u001b[?2004l\r"]
[1375.513021, "o", "\u001b[?2004h> "]
[1375.513153, "o", "                    min_ratio = (r, rid)\r\n\u001b[?2004l\r"]
[1375.513162, "o", "\u001b[?2004h"]
[1375.513206, "o", "> "]
[1375.513246, "o", "        if min_ratio:\r\n\u001b[?2004l\r"]
[1375.513255, "o", "\u001b[?2004h> "]
[1375.513405, "o", "            limiting_resource = min_ratio[1]\r\n\u001b[?2004l\r"]
[1375.513414, "o", "\u001b[?2004h"]
[1375.513432, "o", "> "]
[1375.513601, "o", "            print(f'Limiting resource: {limiting_resource}')\r\n\u001b[?2004l\r"]
[1375.51361, "o", "\u001b[?2004h> "]
[1375.513667, "o", "        else:\r\n\u001b[?2004l\r"]
[1375.513676, "o", "\u001b[?2004h"]
[1375.513695, "o", "> "]
[1375.513874, "o", "            print('No limiting resource found (all ratios >= 1)')\r\n\u001b[?2004l\r"]
[1375.513883, "o", "\u001b[?2004h> "]
[1375.513908, "o", "    \r\n\u001b[?2004l\r"]
[1375.513917, "o", "\u001b[?2004h> "]
[1375.514005, "o", "    # Cancellation check\r\n\u001b[?2004l\r"]
[1375.514014, "o", "\u001b[?2004h> "]
[1375.514164, "o", "    shortfall = requested_qty - max_feasible\r\n\u001b[?2004l\r"]
[1375.514173, "o", "\u001b[?2004h> "]
[1375.51429, "o", "    allocated_qty = max_feasible\r\n\u001b[?2004l\r"]
[1375.5143, "o", "\u001b[?2004h> "]
[1375.514515, "o", "    if max_feasible / requested_qty < 0.5 or (shortfall % 2 == 1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.514546, "o", "> "]
[1375.514817, "o", "        print(f'CANCELED: ratio={max_feasible/requested_qty:.2f}, shortfall_odd={shortfall%2==1}')\r\n\u001b[?2004l\r"]
[1375.514826, "o", "\u001b[?2004h"]
[1375.514854, "o", "> "]
[1375.514914, "o", "        allocated_qty = 0\r\n\u001b[?2004l\r"]
[1375.514933, "o", "\u001b[?2004h> "]
[1375.515044, "o", "        shortfall_qty = requested_qty\r\n\u001b[?2004l\r"]
[1375.515064, "o", "\u001b[?2004h> "]
[1375.515165, "o", "        # don't consume resources\r\n\u001b[?2004l\r"]
[1375.542292, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         shortfall_qty = shortfall\r\n\u001b[?2004l\r\u001b[?2004h>         # commit the feasible plan to actual state\r\n\u001b[?2004l\r\u001b[?2004h>         st = state_copy()\r\n\u001b[?2004l\r\u001b[?2004h>         ok = feasible(allocated_qty, st)\r\n\u001b[?2004l\r\u001b[?2004h>         if not ok:\r\n\u001b[?2004l\r\u001b[?2004h>             print('ERROR: feasible returned False on known feasible Q')\r\n\u001b[?2004l\r\u001b[?2004h>             sys.exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         # update actual parts and wcs\r\n\u001b[?2004l\r\u001b[?2004h>         for pid in parts:\r\n\u001b[?2004l\r\u001b[?2004h>             parts[pid]['on_hand_qty'] = st['parts'][pid]['on_hand_qty']\r\n\u001b[?2004l\r\u001b[?2004h>         for wid in wcs:\r\n\u001b[?2004l\r\u001b[?2004h>             wcs[wid]['available_hours'] = st['wcs'][wid]['available_hours']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.54251, "o", "        print(f'Committed. New inventory: { {p: parts[p][\"on_hand_qty\"] for p in parts if parts[p][\"on_hand_qty\"]!=0} }')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1375.542753, "o", "        print(f'Workcenters: { {w: wcs[w][\"available_hours\"] for w in wcs} }')\r\n\u001b[?2004l\r"]
[1375.542767, "o", "\u001b[?2004h> "]
[1375.542799, "o", "    \r\n\u001b[?2004l\r"]
[1375.542813, "o", "\u001b[?2004h> "]
[1375.542876, "o", "    results.append({\r\n\u001b[?2004l\r"]
[1375.54289, "o", "\u001b[?2004h> "]
[1375.542987, "o", "        'order_id': order_id,\r\n\u001b[?2004l\r"]
[1375.543001, "o", "\u001b[?2004h> "]
[1375.54314, "o", "        'allocated_qty': int(allocated_qty),\r\n\u001b[?2004l\r"]
[1375.543155, "o", "\u001b[?2004h> "]
[1375.543313, "o", "        'shortfall_qty': int(shortfall_qty),\r\n\u001b[?2004l\r"]
[1375.543326, "o", "\u001b[?2004h> "]
[1375.543476, "o", "        'limiting_resource': limiting_resource\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.54349, "o", "> "]
[1375.543517, "o", "    })\r\n\u001b[?2004l\r"]
[1375.54353, "o", "\u001b[?2004h> "]
[1375.543649, "o", "    print(f'Result: {results[-1]}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1375.543661, "o", "> \r\n\u001b[?2004l\r"]
[1375.543685, "o", "\u001b[?2004h> "]
[1375.54377, "o", "# Sort results by order_id\r\n\u001b[?2004l\r"]
[1375.543784, "o", "\u001b[?2004h"]
[1375.543813, "o", "> "]
[1375.54391, "o", "results.sort(key=lambda r: r['order_id'])\r\n\u001b[?2004l\r"]
[1375.543924, "o", "\u001b[?2004h> "]
[1375.544031, "o", "print('\\n=== FINAL RESULTS ===')\r\n\u001b[?2004l\r"]
[1375.544044, "o", "\u001b[?2004h> "]
[1375.544108, "o", "for r in results:\r\n\u001b[?2004l\r"]
[1375.544122, "o", "\u001b[?2004h"]
