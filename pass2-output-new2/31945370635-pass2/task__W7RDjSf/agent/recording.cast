[1375.466136, "i", "python3 - <<'PY'\nimport sqlite3, math, copy, json, sys\nDB='/app/manufacturing.db'\n\ndef load_data():\n    conn=sqlite3.connect(DB)\n    conn.row_factory=sqlite3.Row\n    cur=conn.cursor()\n    parts_raw=[dict(r) for r in cur.execute('SELECT * FROM parts')]\n    bom_raw=[dict(r) for r in cur.execute('SELECT * FROM bom')]\n    wc_raw=[dict(r) for r in cur.execute('SELECT * FROM workcenters')]\n    routing_raw=[dict(r) for r in cur.execute('SELECT * FROM routing')]\n    subs_raw=[dict(r) for r in cur.execute('SELECT * FROM substitutes')]\n    orders_raw=[dict(r) for r in cur.execute('SELECT * FROM orders ORDER BY priority, order_id')]\n    conn.close()\n    return parts_raw, bom_raw, wc_raw, routing_raw, subs_raw, orders_raw\n\nparts_raw, bom_raw, wc_raw, routing_raw, subs_raw, orders_raw = load_data()\n\n# build lookup dicts\nparts = {}\nfor p in parts_raw:\n    parts[p['part_id']] = {\n        'name': p['name'],\n        'on_hand_qty': float(p['on_hand_qty']),\n        'batch_size': p['batch_size']\n    }\n\nwcs = {}\nfor w in wc_raw:\n"]
