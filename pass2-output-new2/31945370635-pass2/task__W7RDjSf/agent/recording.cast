[1375.466438, "i", "c = max(maxc, compute_level(child, stack + [pid]) + 1)\n    levels[pid] = maxc\n    return maxc\n\nfor pid in parts:\n    compute_level(pid)\n\nsorted_parts_by_level = sorted(parts.keys(), key=lambda p: -levels[p])\n\nprint('Sorted parts by level:', [(p, levels[p]) for p in sorted_parts_by_level])\n\n# Process orders\nresults = []\n\nfor order in orders_raw:\n    order_id = order['order_id']\n    product = order['product_part_id']\n    requested_qty = order['requested_qty']\n    priority = order['priority']\n    batch_size = parts[product]['batch_size']\n    \n    print(f'\\n=== Processing order {order_id} for product {product} qty {requested_qty} batch {batch_size} ===')\n    \n    # We'll search for max feasible Q multiple of batch_size <= requested_qty\n    def state_copy():\n        s = {\n            'parts': {pid: dict(d) for pid, d in parts.items()},\n            'wcs': {wid: dict(d) for wid, d in wcs.items()}\n        }\n        return s\n    \n    def feasible(Q, state):\n        # state is mutated in-place; returns True/False\n     "]
