Sending keys: ["python3 - <<'PY'\nimport sqlite3, math, copy\nDB='/app/manufacturing.db'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\ndef load():\n    data={}\n    data['parts']=[]\n    for r in cur.execute('SELECT * FROM parts'):\n        data['parts'].append({'part_id':r['part_id'],'name':r['name'],'on_hand_qty':r['on_hand_qty'],'batch_size':r['batch_size']})\n    data['bom']=[dict(r) for r in cur.execute('SELECT * FROM bom')]\n    data['wc']=[dict(r) for r in cur.execute('SELECT * FROM workcenters')]\n    data['routing']=[dict(r) for r in cur.execute('SELECT * FROM routing')]\n    data['subs']=[dict(r) for r in cur.execute('SELECT * FROM substitutes')]\n    data['orders']=[dict(r) for r in cur.execute('SELECT * FROM orders ORDER BY priority, order_id')]\n    return data\n\ndata=load()\nparts = {p['part_id']: p for p in data['parts']}\nbom_children={}\nbom_parents=set()\nfor b in data['bom']:\n    bom_children.setdefault(b['parent_part_id'], []).append(b)\n    bom_parents.add(b['parent_part_id'])\nrouting_by_parent={}\nrouting_parents=set()\nfor r in data['routing']:\n    routing_by_parent.setdefault(r['parent_part_id'], []).append(r)\n    routing_parents.add(r['parent_part_id'])\nsubs_by_primary={}\nfor s in data['subs']:\n    subs_by_primary.setdefault(s['primary_part_id'], []).append(s)\n\ndef is_mfg(pid): return pid in bom_parents or pid in routing_parents\n\ndef compute_levels():\n    levels={}\n    all_parts=list(parts.keys())\n    def rec(pid, stack):\n        if pid in levels: return levels[pid]\n        if pid not in levels: levels[pid]=0\n        maxchild=0\n        for ch in bom_children.get(pid,[]):\n            maxchild=max(maxchild, rec(ch['child_part_id'], stack+[pid])+1)\n        levels[pid]=maxchild\n        return levels[pid]\n    for pid in all_parts:\n        rec(pid,[])\n    return levels\nlevels=compute_levels()\nordered_mfg_parts=sorted([pid for pid in parts if is_mfg(pid)], key=lambda p:-levels[p])\nprint('levels', levels)\nprint('mfg order', ordered_mfg_parts)\n\n# leaves that have substitutes\nfor pid in parts:\n    if not is_mfg(pid):\n        ss=subs_by_primary.get(pid,[])\n        ss=sorted(ss, key=lambda x:(x['preference_rank'], x['substitute_part_id']))\n        print('leaf/subs', pid, [(s['substitute_part_id'],s['qty_ratio'],s['preference_rank']) for s in ss])\nconn.close()\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
