Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, math, copy, json, sys\nDB=\'/app/manufacturing.db\'\n\ndef load_data():\n    conn=sqlite3.connect(DB)\n    conn.row_factory=sqlite3.Row\n    cur=conn.cursor()\n    parts_raw=[dict(r) for r in cur.execute(\'SELECT * FROM parts\')]\n    bom_raw=[dict(r) for r in cur.execute(\'SELECT * FROM bom\')]\n    wc_raw=[dict(r) for r in cur.execute(\'SELECT * FROM workcenters\')]\n    routing_raw=[dict(r) for r in cur.execute(\'SELECT * FROM routing\')]\n    subs_raw=[dict(r) for r in cur.execute(\'SELECT * FROM substitutes\')]\n    orders_raw=[dict(r) for r in cur.execute(\'SELECT * FROM orders ORDER BY priority, order_id\')]\n    conn.close()\n    return parts_raw, bom_raw, wc_raw, routing_raw, subs_raw, orders_raw\n\nparts_raw, bom_raw, wc_raw, routing_raw, subs_raw, orders_raw = load_data()\n\n# build lookup dicts\nparts = {}\nfor p in parts_raw:\n    parts[p[\'part_id\']] = {\n        \'name\': p[\'name\'],\n        \'on_hand_qty\': float(p[\'on_hand_qty\']),\n        \'batch_size\': p[\'batch_size\']\n    }\n\nwcs = {}\nfor w in wc_raw:\n    wcs[w[\'workcenter_id\']] = {\n        \'name\': w[\'name\'],\n        \'available_hours\': float(w[\'available_hours\'])\n    }\n\nbom_children = {}\nbom_parents = set()\nfor b in bom_raw:\n    bom_children.setdefault(b[\'parent_part_id\'], []).append(b)\n    bom_parents.add(b[\'parent_part_id\'])\n\nrouting_by_parent = {}\nrouting_parents = set()\nfor r in routing_raw:\n    routing_by_parent.setdefault(r[\'parent_part_id\'], []).append(r)\n    routing_parents.add(r[\'parent_part_id\'])\n\nsubs_by_primary = {}\nfor s in subs_raw:\n    subs_by_primary.setdefault(s[\'primary_part_id\'], []).append(s)\n\n# manufactured parts: have BOM or routing (or both)\nmfg = set(bom_parents) | set(routing_parents)\n\n# compute levels\nlevels = {}\ndef compute_level(pid, stack=None):\n    if stack is None:\n        stack = []\n    if pid in levels:\n        return levels[pid]\n    if pid not in levels:\n        levels[pid] = 0\n    maxc = 0\n    for b in bom_children.get(pid, []):\n        child = b[\'child_part_id\']\n        if child in stack:\n            continue\n        maxc = max(maxc, compute_level(child, stack + [pid]) + 1)\n    levels[pid] = maxc\n    return maxc\n\nfor pid in parts:\n    compute_level(pid)\n\nsorted_parts_by_level = sorted(parts.keys(), key=lambda p: -levels[p])\n\nprint(\'Sorted parts by level:\', [(p, levels[p]) for p in sorted_parts_by_level])\n\n# Process orders\nresults = []\n\nfor order in orders_raw:\n    order_id = order[\'order_id\']\n    product = order[\'product_part_id\']\n    requested_qty = order[\'requested_qty\']\n    priority = order[\'priority\']\n    batch_size = parts[product][\'batch_size\']\n    \n    print(f\'\\n=== Processing order {order_id} for product {product} qty {requested_qty} batch {batch_size} ===\')\n    \n    # We\'ll search for max feasible Q multiple of batch_size <= requested_qty\n    def state_copy():\n        s = {\n            \'parts\': {pid: dict(d) for pid, d in parts.items()},\n            \'wcs\': {wid: dict(d) for wid, d in wcs.items()}\n        }\n        return s\n    \n    def feasible(Q, state):\n        # state is mutated in-place; returns True/False\n        gross_req = {pid: 0.0 for pid in parts}\n        gross_req[product] = float(Q)\n        \n        for pid in sorted_parts_by_level:\n            if gross_req.get(pid, 0.0) <= 0:\n                continue\n            demand = gross_req[pid]\n            if pid in mfg:\n                pdata = state[\'parts\'][pid]\n                avail = pdata[\'on_hand_qty\']\n                consumed = min(avail, demand)\n                net = demand - consumed\n                if net > 0:\n                    batch = pdata[\'batch_size\']\n                    prod = math.ceil(net / batch) * batch\n                else:\n                    prod = 0\n                # check workcenters\n                for r in routing_by_parent.get(pid, []):\n                    wc_id = r[\'workcenter_id\']\n                    hours_needed = r[\'setup_hours\'] + prod * r[\'run_hours_per_unit\']\n                    if state[\'wcs\'][wc_id][\'available_hours\'] < hours_needed:\n                        return False\n                # add demands to children\n                for b in bom_children.get(pid, []):\n                    child = b[\'child_part_id\']\n                    if prod > 0:\n                        add = math.ceil(prod * b[\'qty_per\'] * (1 + b[\'scrap_rate_pct\'] / 100.0)) + b[\'setup_scrap_qty\']\n                    else:\n                        add = 0\n                    gross_req[child] = gross_req.get(child, 0.0) + add\n                # update state\n                pdata[\'on_hand_qty\'] = pdata[\'on_hand_qty\'] - consumed + (prod - net)\n                for r in routing_by_parent.get(pid, []):\n                    wc_id = r[\'workcenter_id\']\n                    hours_needed = r[\'setup_hours\'] + prod * r[\'run_hours_per_unit\']\n                    state[\'wcs\'][wc_id][\'available_hours\'] -= hours_needed\n            else:\n                # leaf\n                pdata = state[\'parts\'][pid]\n                avail_own = pdata[\'on_hand_qty\']\n                consume_own = min(avail_own, demand)\n                demand -= consume_own\n                pdata[\'on_hand_qty\'] -= consume_own\n                if demand > 0:\n                    subs = subs_by_primary.get(pid, [])\n                    subs_sorted = sorted(subs, key=lambda x: (x[\'preference_rank\'], x[\'substitute_part_id\']))\n                    for s in subs_sorted:\n                        if demand <= 0:\n                            break\n                        sub_id = s[\'substitute_part_id\']\n                        sub_data = state[\'parts\'][sub_id]\n                        sub_avail = sub_data[\'on_hand_qty\']\n                        if sub_avail <= 0:\n                            continue\n                        ratio = s[\'qty_ratio\']\n                        equiv_units = int(sub_avail // ratio)\n                        if equiv_units <= 0:\n                            continue\n                        use_equiv = min(equiv_units, int(math.ceil(demand)))\n                        # demand may be fractional? currently integer; but just in case\n                        use_equiv = int(use_equiv)\n                        consume_sub = use_equiv * ratio\n                        sub_data[\'on_hand_qty\'] -= consume_sub\n                        demand -= use_equiv\n                    if demand > 0:\n                        return False\n        return True\n    \n    # Find max feasible Q\n    max_feasible = 0\n    k = 0\n    while k * batch_size <= requested_qty:\n        Q = k * batch_size\n        st = state_copy()\n        if feasible(Q, st):\n            max_feasible = Q\n            k += 1\n        else:\n            break\n    \n    print(f\'Max feasible Q = {max_feasible}, shortfall = {requested_qty - max_feasible}\')\n    \n    # Limiting resource if shortfall > 0\n    limiting_resource = None\n    if max_feasible < requested_qty:\n        next_batch = max_feasible + batch_size\n        print(f\'Checking limiting resource for next batch Q = {next_batch}\')\n        # compute gross requirements using original state (before this order)\n        orig_state = state_copy()\n        \n        def compute_gross(Q, state):\n            # returns leaf_gross, wc_hours\n            # mutates state for netting sub-assemblies (but we don\'t care about leaf consumption)\n            leaf_gross = {}\n            wc_hours = {}\n            gross_req = {pid: 0.0 for pid in parts}\n            gross_req[product] = float(Q)\n            for pid in sorted_parts_by_level:\n                if gross_req.get(pid, 0.0) <= 0:\n                    continue\n                demand = gross_req[pid]\n                if pid in mfg:\n                    pdata = state[\'parts\'][pid]\n                    avail = pdata[\'on_hand_qty\']\n                    consumed = min(avail, demand)\n                    net = demand - consumed\n                    if net > 0:\n                        batch = pdata[\'batch_size\']\n                        prod = math.ceil(net / batch) * batch\n                    else:\n                        prod = 0\n                    # accumulate WC hours\n                    for r in routing_by_parent.get(pid, []):\n                        wc_id = r[\'workcenter_id\']\n                        hours_needed = r[\'setup_hours\'] + prod * r[\'run_hours_per_unit\']\n                        wc_hours[wc_id] = wc_hours.get(wc_id, 0.0) + hours_needed\n                    # children demands\n                    for b in bom_children.get(pid, []):\n                        child = b[\'child_part_id\']\n                        if prod > 0:\n                            add = math.ceil(prod * b[\'qty_per\'] * (1 + b[\'scrap_rate_pct\'] / 100.0)) + b[\'setup_scrap_qty\']\n                        else:\n                            add = 0\n                        gross_req[child] = gross_req.get(child, 0.0) + add\n                    # update state for sub-assembly netting (but not leaves)\n                    pdata[\'on_hand_qty\'] = pdata[\'on_hand_qty\'] - consumed + (prod - net)\n                else:\n                    # leaf: accumulate gross requirement, do NOT net stock\n                    leaf_gross[pid] = leaf_gross.get(pid, 0.0) + demand\n            return leaf_gross, wc_hours\n        \n        leaf_gross, wc_hours = compute_gross(next_batch, orig_state)\n        print(\'Leaf gross requirements:\', leaf_gross)\n        print(\'WC hours requirements:\', wc_hours)\n        \n        # compute ratios\n        ratios = {}\n        for leaf_id, gross in leaf_gross.items():\n            if gross <= 0:\n                continue\n            total_avail = parts[leaf_id][\'on_hand_qty\']  # original stock\n            # add substitutes equivalent\n            if leaf_id in subs_by_primary:\n                # but leaf_id as primary; its substitutes contribute to its available\n                # Actually the primary is leaf_id; we need to add equivalent from substitutes\n                for s in subs_by_primary[leaf_id]:\n                    sub_id = s[\'substitute_part_id\']\n                    sub_stock = parts[sub_id][\'on_hand_qty\']\n                    ratio_sub = s[\'qty_ratio\']\n                    equiv = int(sub_stock // ratio_sub)\n                    total_avail += equiv\n            if leaf_id in subs_by_primary:\n                # leaf_id might also be a substitute for another? Not relevant here.\n                pass\n            # Also, leaf_id might itself be a substitute for another primary; its stock is already counted in its own primary?\n            # For ratio, only count stock of the primary and its substitutes.\n            ratio = total_avail / gross\n            ratios[leaf_id] = (ratio, total_avail, gross)\n        for wc_id, hours_needed in wc_hours.items():\n            if hours_needed <= 0:\n                continue\n            avail = wcs[wc_id][\'available_hours\']\n            ratio = avail / hours_needed\n            ratios[wc_id] = (ratio, avail, hours_needed)\n        print(\'Ratios:\')\n        for rid, (r, a, g) in ratios.items():\n            print(f\'  {rid}: {r:.4f} (avail={a}, gross={g})\')\n        # Find limiting\n        min_ratio = None\n        for rid, (r, a, g) in ratios.items():\n            if r < 1.0:\n                if min_ratio is None or r < min_ratio[0] or (abs(r - min_ratio[0]) < 1e-12 and rid < min_ratio[1]):\n                    min_ratio = (r, rid)\n        if min_ratio:\n            limiting_resource = min_ratio[1]\n            print(f\'Limiting resource: {limiting_resource}\')\n        else:\n            print(\'No limiting resource found (all ratios >= 1)\')\n    \n    # Cancellation check\n    shortfall = requested_qty - max_feasible\n    allocated_qty = max_feasible\n    if max_feasible / requested_qty < 0.5 or (shortfall % 2 == 1):\n        print(f\'CANCELED: ratio={max_feasible/requested_qty:.2f}, shortfall_odd={shortfall%2==1}\')\n        allocated_qty = 0\n        shortfall_qty = requested_qty\n        # don\'t consume resources\n    else:\n        shortfall_qty = shortfall\n        # commit the feasible plan to actual state\n        st = state_copy()\n        ok = feasible(allocated_qty, st)\n        if not ok:\n            print(\'ERROR: feasible returned False on known feasible Q\')\n            sys.exit(1)\n        # update actual parts and wcs\n        for pid in parts:\n            parts[pid][\'on_hand_qty\'] = st[\'parts\'][pid][\'on_hand_qty\']\n        for wid in wcs:\n            wcs[wid][\'available_hours\'] = st[\'wcs\'][wid][\'available_hours\']\n        print(f\'Committed. New inventory: { {p: parts[p]["on_hand_qty"] for p in parts if parts[p]["on_hand_qty"]!=0} }\')\n        print(f\'Workcenters: { {w: wcs[w]["available_hours"] for w in wcs} }\')\n    \n    results.append({\n        \'order_id\': order_id,\n        \'allocated_qty\': int(allocated_qty),\n        \'shortfall_qty\': int(shortfall_qty),\n        \'limiting_resource\': limiting_resource\n    })\n    print(f\'Result: {results[-1]}\')\n\n# Sort results by order_id\nresults.sort(key=lambda r: r[\'order_id\'])\nprint(\'\\n=== FINAL RESULTS ===\')\nfor r in results:\n    print(r)\n\n# Write report\nwith open(\'/app/report.json\', \'w\') as f:\n    json.dump({\'orders\': results}, f, indent=2)\nprint(\'\\nWritten to /app/report.json\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
