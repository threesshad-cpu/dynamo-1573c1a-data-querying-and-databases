Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\n\nDB=\'/app/manufacturing.db\'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\nfor r in cur.execute(\'SELECT * FROM parts\'):\n    parts[r[\'part_id\']]={\'name\':r[\'name\'],\'on_hand\':float(r[\'on_hand_qty\']),\'batch_size\':r[\'batch_size\']}\norders=[]\nfor r in cur.execute(\'SELECT * FROM orders ORDER BY priority ASC, order_id ASC\'):\n    orders.append({\'order_id\':r[\'order_id\'],\'product_part_id\':r[\'product_part_id\'],\'requested_qty\':r[\'requested_qty\'],\'priority\':r[\'priority\']})\nworkcenters={}\nfor r in cur.execute(\'SELECT * FROM workcenters\'):\n    workcenters[r[\'workcenter_id\']]={\'name\':r[\'name\'],\'available_hours\':float(r[\'available_hours\'])}\nrouting=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM routing\'):\n    routing[r[\'parent_part_id\']].append({\'workcenter_id\':r[\'workcenter_id\'],\'setup_hours\':float(r[\'setup_hours\']),\'run_hours_per_unit\':float(r[\'run_hours_per_unit\'])})\nbom=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM bom\'):\n    bom[r[\'parent_part_id\']].append({\'child_part_id\':r[\'child_part_id\'],\'qty_per\':r[\'qty_per\'],\'scrap_rate_pct\':float(r[\'scrap_rate_pct\']),\'setup_scrap_qty\':r[\'setup_scrap_qty\']})\nsubstitutes=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM substitutes\'):\n    substitutes[r[\'primary_part_id\']].append({\'substitute_part_id\':r[\'substitute_part_id\'],\'qty_ratio\':float(r[\'qty_ratio\']),\'preference_rank\':r[\'preference_rank\']})\nfor k in substitutes:\n    substitutes[k].sort(key=lambda x: (x[\'preference_rank\'], x[\'substitute_part_id\']))\n\nnon_leaves=set(bom.keys()) | set(routing.keys())\nindegree={p:0 for p in non_leaves}\ngraph={p:set() for p in non_leaves}\nfor p in non_leaves:\n    for b in bom.get(p,[]):\n        c=b[\'child_part_id\']\n        if c in non_leaves:\n            graph[p].add(c)\nfor p,ch in graph.items():\n    for c in ch:\n        indegree[c]+=1\nq=deque([p for p in non_leaves if indegree[p]==0])\ntopo=[]\nwhile q:\n    p=q.popleft(); topo.append(p)\n    for c in graph[p]:\n        indegree[c]-=1\n        if indegree[c]==0:\n            q.append(c)\n\n# ensure parent before child by running order of roots first, though Kahn should.\nprint(\'non_leaves\', non_leaves)\nprint(\'topo\', topo)\n\ninv={p:parts[p][\'on_hand\'] for p in parts}\nwc={w:workcenters[w][\'available_hours\'] for w in workcenters}\n\ndef valid_floor_div_or_maybe_capacity(stock, ratio):\n    if ratio<=0:\n        return 0\n    return math.floor(stock / ratio)\n\ndef leaf_total_available(leaf, inv):\n    avail=float(inv[leaf])\n    for sub in substitutes.get(leaf,[]):\n        stock=float(inv.get(sub[\'substitute_part_id\'],0))\n        avail += float(valid_floor_div_or_maybe_capacity(stock, sub[\'qty_ratio\']))\n    return avail\n\ndef compute_requirements(product, qty, inv_state, wc_state):\n    """Return leaf_gross, wc_gross, productions plan for building qty of product.\n    Subassembly netting is performed; leaf inventory is NOT checked or netted here.\n    """\n    demand=defaultdict(float)\n    demand[product]+=qty\n    leaf_gross=defaultdict(float)\n    wc_gross=defaultdict(float)\n    prod={}\n    for p in topo:\n        d=demand.get(p,0.0)\n        if d <= 1e-9:\n            continue\n        stock=float(inv_state.get(p,0.0))\n        consumed=min(stock,d)\n        remaining=d-consumed\n        if remaining > 1e-9:\n            batch=parts[p][\'batch_size\']\n            runs=math.ceil(remaining/batch - 1e-9)\n            run_qty=float(runs*batch)\n            prod[p]=(run_qty,consumed)\n            for route in routing.get(p,[]):\n                hrs=route[\'setup_hours\']+route[\'run_hours_per_unit\']*run_qty\n                wc_gross[route[\'workcenter_id\']]+=hrs\n            for b in bom.get(p,[]):\n                child=b[\'child_part_id\']\n                base=b[\'qty_per\']*run_qty*(1.0 + b[\'scrap_rate_pct\']/100.0)\n                req=math.ceil(base - 1e-9)+b[\'setup_scrap_qty\']\n                if child in non_leaves:\n                    demand[child]+=req\n                else:\n                    leaf_gross[child]+=req\n        else:\n            prod[p]=(0.0,consumed)\n    return dict(leaf_gross), dict(wc_gross), prod\n\ndef feasible(product, qty, inv_state, wc_state):\n    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\n    # check leaves\n    for leaf,g in leaf_gross.items():\n        if g > leaf_total_available(leaf, inv_state) + 1e-9:\n            return False, leaf_gross, wc_gross, prod\n    # check wc\n    for wid,g in wc_gross.items():\n        if g > wc_state.get(wid,0.0) + 1e-9:\n            return False, leaf_gross, wc_gross, prod\n    return True, leaf_gross, wc_gross, prod\n\ndef consume_feasible(product, qty, inv_state, wc_state):\n    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\n    inv_after=dict(inv_state)\n    wc_after=dict(wc_state)\n    # consume leaf materials\n    for leaf,g in leaf_gross.items():\n        rem=g\n        own=inv_after.get(leaf,0.0)\n        use=min(own, rem)\n        inv_after[leaf]-=use\n        rem-=use\n        for sub in substitutes.get(leaf,[]):\n            if rem <= 1e-9:\n                break\n            stock=inv_after.get(sub[\'substitute_part_id\'],0.0)\n            cap=valid_floor_div_or_maybe_capacity(stock, sub[\'qty_ratio\'])\n            use_prim=min(rem, float(cap))\n            consume_sub=use_prim * sub[\'qty_ratio\']\n            inv_after[sub[\'substitute_part_id\']]-=consume_sub\n            rem-=use_prim\n        if rem > 1e-9:\n            raise Exception(f\'infeasible leaf consumption {leaf}: {rem}\')\n    # consume/restock manufactured parts\n    for p,(run_qty,consumed) in prod.items():\n        inv_after[p] = inv_after.get(p,0.0) - consumed + run_qty\n    for wid,g in wc_gross.items():\n        wc_after[wid] -= g\n        if wc_after[wid] < -1e-9:\n            raise Exception(f\'infeasible workcenter consumption {wid}\')\n    return inv_after, wc_after, prod, leaf_gross, wc_gross\n\ndef compute_limit_resource(product, q_alloc, batch, inv_state, wc_state):\n    qplus=q_alloc+batch\n    leaf_gross, wc_gross, *_ = compute_requirements(product, qplus, inv_state, wc_state)\n    ratios={}\n    for leaf,g in leaf_gross.items():\n        if g>1e-9:\n            av=leaf_total_available(leaf, inv_state)\n            ratios[leaf]=av/g\n    for wid,g in wc_gross.items():\n        if g>1e-9:\n            av=wc_state.get(wid,0.0)\n            ratios[wid]=av/g\n    best=None\n    bestratio=None\n    for rid, r in ratios.items():\n        if r < 1.0 - 1e-9:\n            if bestratio is None or r < bestratio-1e-12 or (abs(r-bestratio)<=1e-12 and rid<best):\n                best=rid\n                bestratio=r\n    return best, bestratio, ratios\n\nresults=[]\nfor order in orders:\n    oid=order[\'order_id\']; prod_id=order[\'product_part_id\']; req=order[\'requested_qty\']\n    b=parts[prod_id][\'batch_size\']\n    inv_before=dict(inv); wc_before=dict(wc)\n    max_i=req//b\n    max_alloc=0\n    last_feas=None\n    for k in range(max_i,-1,-1):\n        cand=k*b\n        ok, leaf_g, wc_g, prod = feasible(prod_id,cand,inv_before,wc_before)\n        if ok:\n            max_alloc=cand\n            last_feas=(leaf_g,wc_g,prod)\n            break\n    shortfall=req-max_alloc\n    lim=None\n    limratio=None\n    limratios=None\n    if shortfall>0:\n        lim,limratio,limratios=compute_limit_resource(prod_id,max_alloc,b,inv_before,wc_before)\n    canceled=False\n    if max_alloc/req < 0.5:\n        canceled=True\n    elif shortfall % 2 == 1:\n        canceled=True\n    if canceled:\n        allocated=0\n        shortfall=req\n        inv_after=dict(inv_before)\n        wc_after=dict(wc_before)\n        # limiting resource still orig