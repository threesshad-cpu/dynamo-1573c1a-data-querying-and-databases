Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, json, math, copy\nfrom collections import defaultdict, deque\n\nDB=\'/app/manufacturing.db\'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\nfor r in cur.execute(\'SELECT * FROM parts\'):\n    parts[r[\'part_id\']]={\'name\':r[\'name\'],\'on_hand\':float(r[\'on_hand_qty\']),\'batch_size\':r[\'batch_size\']}\norders=[]\nfor r in cur.execute(\'SELECT * FROM orders ORDER BY priority ASC, order_id ASC\'):\n    orders.append({\'order_id\':r[\'order_id\'],\'product_part_id\':r[\'product_part_id\'],\'requested_qty\':r[\'requested_qty\'],\'priority\':r[\'priority\']})\nworkcenters={}\nfor r in cur.execute(\'SELECT * FROM workcenters\'):\n    workcenters[r[\'workcenter_id\']]={\'name\':r[\'name\'],\'available_hours\':float(r[\'available_hours\'])}\nrouting=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM routing\'):\n    routing[r[\'parent_part_id\']].append({\'workcenter_id\':r[\'workcenter_id\'],\'setup_hours\':float(r[\'setup_hours\']),\'run_hours_per_unit\':float(r[\'run_hours_per_unit\'])})\nbom=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM bom\'):\n    bom[r[\'parent_part_id\']].append({\'child_part_id\':r[\'child_part_id\'],\'qty_per\':r[\'qty_per\'],\'scrap_rate_pct\':float(r[\'scrap_rate_pct\']),\'setup_scrap_qty\':r[\'setup_scrap_qty\']})\nsubstitutes=defaultdict(list)\nfor r in cur.execute(\'SELECT * FROM substitutes\'):\n    substitutes[r[\'primary_part_id\']].append({\'substitute_part_id\':r[\'substitute_part_id\'],\'qty_ratio\':float(r[\'qty_ratio\']),\'preference_rank\':r[\'preference_rank\']})\nfor k in substitutes:\n    substitutes[k].sort(key=lambda x: (x[\'preference_rank\'], x[\'substitute_part_id\']))\n\nnon_leaves=set(bom.keys()) | set(routing.keys())\n# all parts that have routing or BOM are manufactured; leaves are the rest\n# topological order of non-leaf BOM graph (parent before children)\nindegree={p:0 for p in non_leaves}\ngraph={p:set() for p in non_leaves}\nfor p in non_leaves:\n    for b in bom.get(p,[]):\n        c=b[\'child_part_id\']\n        if c in non_leaves:\n            graph[p].add(c)\nfor p,ch in graph.items():\n    for c in ch:\n        indegree[c]+=1\nq=deque([p for p in non_leaves if indegree[p]==0])\ntopo=[]\nwhile q:\n    p=q.popleft(); topo.append(p)\n    for c in graph[p]:\n        indegree[c]-=1\n        if indegree[c]==0:\n            q.append(c)\nprint(\'topo\',topo)\nprint(\'bom keys\', list(bom.keys()))\nprint(\'routing keys\', list(routing.keys()))\n\n\ndef explosive_plan(product, qty, inv, wc_avail=None):\n    """Return production plan, leaf gross requirements, wc gross requirements.\n       inv and wc_avail are used only for subassembly availability when netting.\n       Leaves are not subtracted in this function.\n    """\n    inv=dict(inv)\n    # demand of all parts, initialized to product qty\n    demand=defaultdict(float)\n    demand[product]+=qty\n    production={}  # p -> (run_qty, consumed_stock)\n    leaf_gross=defaultdict(float)\n    wc_gross=defaultdict(float)\n    # process non-leaves in topo order; demand may be added by parents before child is reached\n    for p in topo:\n        d=demand.get(p,0)\n        if d<=0:\n            continue\n        stock=inv.get(p,0)\n        consumed=min(float(stock), float(d))\n        remaining=d-consumed\n        if remaining>1e-9:\n            batch=parts.get(p,{}).get(\'batch_size\',1)\n            runs=math.ceil(remaining/batch)\n            run_qty=runs*batch\n            production[p]=(run_qty, consumed)\n            # add route hours for this run\n            for route in routing.get(p,[]):\n                hrs=route[\'setup_hours\']+route[\'run_hours_per_unit\']*run_qty\n                wc_gross[route[\'workcenter_id\']]+=hrs\n            # add child gross requirements using run_qty\n            for b in bom.get(p,[]):\n                child=b[\'child_part_id\']\n                base=b[\'qty_per\']*run_qty*(1+b[\'scrap_rate_pct\']/100.0)\n                req=math.ceil(base - 1e-9) + b[\'setup_scrap_qty\']\n                if child in non_leaves:\n                    demand[child]+=req\n                else:\n                    leaf_gross[child]+=req\n        else:\n            # no production, just consume stock for that subassembly demand; not represented here for later inv update\n            production[p]=None  # mark consumed only? No need\n            pass\n    return dict(production), dict(leaf_gross), dict(wc_gross)\n\nprint(\'\\n--- Test O1 plan ---\')\ninv0={p:parts[p][\'on_hand\'] for p in parts}\nwc0={w:workcenters[w][\'available_hours\'] for w in workcenters}\nprod,leaf,wc=explosive_plan(\'P1\',12,inv0,wc0)\nprint(\'prod\',prod)\nprint(\'leaf\',leaf)\nprint(\'wc\',wc)\nprint(\'\\n--- Test O2 plans ---\')\n# apply O1 to state for testing O2 maybe manual simulate; use later full simulation\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
