[235.842096, "o", "topo ['P5', 'P2', 'P1', 'P4', 'P3', 'P_B', 'SA2', 'SA1']\r\nbom keys ['P1', 'SA1', 'P2', 'SA2', 'P3', 'P4', 'P5', 'P_B']\r\nrouting keys ['SA1', 'SA2', 'P1', 'P2', 'P3', 'P4', 'P5', 'P_B']\r\n\r\n--- Test O1 plan ---\r\nprod {'P1': (12, 0.0), 'SA1': (10, 3.0)}\r\nleaf {'L1': 44.0}\r\nwc {'WC1': 23.0}\r\n\r\n--- Test O2 plans ---\r\n"]
[235.845617, "o", "\u001b[?2004hroot@d8ffe34a-dd2c-4b81-8594-af1965f2438f:/app# "]
[350.618023, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\n\nDB='/app/manufacturing.db'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\nfor r in cur.execute('SELECT * FROM parts'):\n    parts[r['part_id']]={'name':r['name'],'on_hand':float(r['on_hand_qty']),'batch_size':r['batch_size']}\norders=[]\nfor r in cur.execute('SELECT * FROM orders ORDER BY priority ASC, order_id ASC'):\n    orders.append({'order_id':r['order_id'],'product_part_id':r['product_part_id'],'requested_qty':r['requested_qty'],'priority':r['priority']})\nworkcenters={}\nfor r in cur.execute('SELECT * FROM workcenters'):\n    workcenters[r['workcenter_id']]={'name':r['name'],'available_hours':float(r['available_hours'])}\nrouting=defaultdict(list)\nfor r in cur.execute('SELECT * FROM routing'):\n    routing[r['parent_part_id']].append({'workcenter_id':r['workcenter_id'],'setup_hours':float(r['setup_hours']),'run_hours_per_unit':float(r['run_hours_per_unit'])})\nbom=defaultdict(list)\nfor r in "]
[350.618146, "i", "cur.execute('SELECT * FROM bom'):\n    bom[r['parent_part_id']].append({'child_part_id':r['child_part_id'],'qty_per':r['qty_per'],'scrap_rate_pct':float(r['scrap_rate_pct']),'setup_scrap_qty':r['setup_scrap_qty']})\nsubstitutes=defaultdict(list)\nfor r in cur.execute('SELECT * FROM substitutes'):\n    substitutes[r['primary_part_id']].append({'substitute_part_id':r['substitute_part_id'],'qty_ratio':float(r['qty_ratio']),'preference_rank':r['preference_rank']})\nfor k in substitutes:\n    substitutes[k].sort(key=lambda x: (x['preference_rank'], x['substitute_part_id']))\n\nnon_leaves=set(bom.keys()) | set(routing.keys())\nindegree={p:0 for p in non_leaves}\ngraph={p:set() for p in non_leaves}\nfor p in non_leaves:\n    for b in bom.get(p,[]):\n        c=b['child_part_id']\n        if c in non_leaves:\n            graph[p].add(c)\nfor p,ch in graph.items():\n    for c in ch:\n        indegree[c]+=1\nq=deque([p for p in non_leaves if indegree[p]==0])\ntopo=[]\nwhile q:\n    p=q.popleft(); topo.append(p)\n    for c in graph[p]:\n       "]
[350.618366, "i", " indegree[c]-=1\n        if indegree[c]==0:\n            q.append(c)\n\n# ensure parent before child by running order of roots first, though Kahn should.\nprint('non_leaves', non_leaves)\nprint('topo', topo)\n\ninv={p:parts[p]['on_hand'] for p in parts}\nwc={w:workcenters[w]['available_hours'] for w in workcenters}\n\ndef valid_floor_div_or_maybe_capacity(stock, ratio):\n    if ratio<=0:\n        return 0\n    return math.floor(stock / ratio)\n\ndef leaf_total_available(leaf, inv):\n    avail=float(inv[leaf])\n    for sub in substitutes.get(leaf,[]):\n        stock=float(inv.get(sub['substitute_part_id'],0))\n        avail += float(valid_floor_div_or_maybe_capacity(stock, sub['qty_ratio']))\n    return avail\n\ndef compute_requirements(product, qty, inv_state, wc_state):\n    \"\"\"Return leaf_gross, wc_gross, productions plan for building qty of product.\n    Subassembly netting is performed; leaf inventory is NOT checked or netted here.\n    \"\"\"\n    demand=defaultdict(float)\n    demand[product]+=qty\n    leaf_gross=defaultdict(float)\n  "]
[350.6184, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[350.618537, "i", "  wc_gross=defaultdict(float)\n    prod={}\n    for p in topo:\n        d=demand.get(p,0.0)\n        if d <= 1e-9:\n            continue\n        stock=float(inv_state.get(p,0.0))\n        consumed=min(stock,d)\n        remaining=d-consumed\n        if remaining > 1e-9:\n            batch=parts[p]['batch_size']\n            runs=math.ceil(remaining/batch - 1e-9)\n            run_qty=float(runs*batch)\n            prod[p]=(run_qty,consumed)\n            for route in routing.get(p,[]):\n                hrs=route['setup_hours']+route['run_hours_per_unit']*run_qty\n                wc_gross[route['workcenter_id']]+=hrs\n            for b in bom.get(p,[]):\n                child=b['child_part_id']\n                base=b['qty_per']*run_qty*(1.0 + b['scrap_rate_pct']/100.0)\n                req=math.ceil(base - 1e-9)+b['setup_scrap_qty']\n                if child in non_leaves:\n                    demand[child]+=req\n                else:\n                    leaf_gross[child]+=req\n        else:\n            prod[p]=(0.0,consumed)\n    retu"]
