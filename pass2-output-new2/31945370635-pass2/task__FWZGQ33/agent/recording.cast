[350.625512, "o", "\u001b[?2004h> "]
[350.626853, "o", "    orders.append({'order_id':r['order_id'],'product_part_id':r['product_part_id'],'requested_qty':r['requested_qty'],'priority':r['priority']})\r\n\u001b[?2004l\r"]
[350.626883, "o", "\u001b[?2004h> "]
