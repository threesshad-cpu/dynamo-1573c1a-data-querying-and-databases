[350.618642, "i", "rn dict(leaf_gross), dict(wc_gross), prod\n\ndef feasible(product, qty, inv_state, wc_state):\n    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\n    # check leaves\n    for leaf,g in leaf_gross.items():\n        if g > leaf_total_available(leaf, inv_state) + 1e-9:\n            return False, leaf_gross, wc_gross, prod\n    # check wc\n    for wid,g in wc_gross.items():\n        if g > wc_state.get(wid,0.0) + 1e-9:\n            return False, leaf_gross, wc_gross, prod\n    return True, leaf_gross, wc_gross, prod\n\ndef consume_feasible(product, qty, inv_state, wc_state):\n    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\n    inv_after=dict(inv_state)\n    wc_after=dict(wc_state)\n    # consume leaf materials\n    for leaf,g in leaf_gross.items():\n        rem=g\n        own=inv_after.get(leaf,0.0)\n        use=min(own, rem)\n        inv_after[leaf]-=use\n        rem-=use\n        for sub in substitutes.get(leaf,[]):\n            if rem <= 1e-9:\n             "]
