[350.635984, "o", "for r in cur.execute('SELECT * FROM substitutes'):\r\n\u001b[?2004l\r"]
[350.63602, "o", "\u001b[?2004h> "]
[350.638229, "o", "    substitutes[r['primary_part_id']].append({'substitute_part_id':r['substitute_part_id'],'qty_ratio':float(r['qty_ratio']),'preference_rank':r['preference_rank']})\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.638362, "o", "> "]
[350.638565, "o", "for k in substitutes:\r\n\u001b[?2004l\r_\u001b[?2004h"]
[350.638662, "o", "> "]
[350.639545, "o", "    substitutes[k].sort(key=lambda x: (x['preference_rank'], x['substitute_part_id']))\r\n\u001b[?2004l\rmed +\u001b[?2004h"]
[350.639652, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[350.639719, "o", "> "]
[350.640215, "o", "non_leaves=set(bom.keys()) | set(routing.keys())\r\n\u001b[?2004l\r"]
[350.640254, "o", "\u001b[?2004h> "]
[350.640686, "o", "indegree={p:0 for p in non_leaves}\r\n\u001b[?2004l\r"]
[350.640791, "o", "\u001b[?2004h> "]
[350.641177, "o", "graph={p:set() for p in non_leaves}\r\n\u001b[?2004l\r"]
[350.641206, "o", "\u001b[?2004h"]
[350.641276, "o", "> "]
[350.641452, "o", "for p in non_leaves:\r\n\u001b[?2004l\r"]
[350.641547, "o", "\u001b[?2004h> "]
[350.641813, "o", "    for b in bom.get(p,[]):\r\n\u001b[?2004l\r"]
[350.64184, "o", "\u001b[?2004h> "]
[350.642174, "o", "        c=b['child_part_id']\r\n\u001b[?2004l\r"]
[350.642202, "o", "\u001b[?2004h> "]
[350.642532, "o", "        if c in non_leaves:\r\n\u001b[?2004l\r"]
[350.642565, "o", "\u001b[?2004h> "]
[350.642872, "o", "            graph[p].add(c)\r\n\u001b[?2004l\r_\u001b[?2004h"]
[350.6429, "o", "> "]
[350.643217, "o", "for p,ch in graph.items():\r\n\u001b[?2004l\rc, \u001b[?2004h"]
[350.643246, "o", "> "]
[350.643457, "o", "    for c in ch:\r\n\u001b[?2004l\r,\u001b[?2004h"]
[350.643555, "o", "> "]
[350.643741, "o", "        indegree[c]+=1\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.643768, "o", "> "]
[350.644342, "o", "q=deque([p for p in non_leaves if indegree[p]==0])\r\n\u001b[?2004l\r"]
[350.644465, "o", "\u001b[?2004h> "]
[350.644576, "o", "topo=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.644709, "o", "while q:\r\n\u001b[?2004l\r"]
[350.644737, "o", "\u001b[?2004h> "]
[350.64511, "o", "    p=q.popleft(); topo.append(p)\r\n\u001b[?2004l\r\r\n"]
[350.645141, "o", "\u001b[?2004h> "]
[350.645388, "o", "    for c in graph[p]:\r\n\u001b[?2004l\r"]
[350.645443, "o", "\u001b[?2004h"]
[350.645468, "o", "> "]
[350.645712, "o", "        indegree[c]-=1\r\n\u001b[?2004l\rte"]
[350.645741, "o", "\u001b[?2004h> "]
[350.646054, "o", "        if indegree[c]==0:\r\n\u001b[?2004l\r \u001b[?2004h"]
[350.646082, "o", "> "]
[350.646338, "o", "            q.append(c)\r\n\u001b[?2004l\r"]
[350.646366, "o", "\u001b[?2004h> "]
[350.646484, "o", "\r\n\u001b[?2004l\r"]
[350.646513, "o", "\u001b[?2004h> "]
[350.647331, "o", "# ensure parent before child by running order of roots first, though Kahn should.\r\n\u001b[?2004l\r"]
[350.647359, "o", "\u001b[?2004h> "]
[350.647878, "o", "print('non_leaves', non_leaves)\r\n\u001b[?2004l\r"]
[350.647905, "o", "\u001b[?2004h> "]
[350.648262, "o", "print('topo', topo)\r\n\u001b[?2004l\r"]
[350.648369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[350.648397, "o", "\u001b[?2004h> "]
[350.649169, "o", "inv={p:parts[p]['on_hand'] for p in parts}\r\n\u001b[?2004l\r"]
[350.64929, "o", "\u001b[?2004h> "]
