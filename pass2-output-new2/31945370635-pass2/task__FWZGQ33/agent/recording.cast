[504.757095, "i", " indegree[c]-=1\n        if indegree[c]==0:\n            q.append(c)\n\ninv={p:parts[p]['on_hand'] for p in parts}\nwc={w:workcenters[w]['available_hours'] for w in workcenters}\n\ndef subs_avail(leaf, inv_state):\n    avail=float(inv_state.get(leaf,0.0))\n    for s in substitutes.get(leaf,[]):\n        stock=float(inv_state.get(s['substitute_part_id'],0.0))\n        if s['qty_ratio']>0:\n            avail += math.floor(stock / s['qty_ratio'])\n    return avail\n\ndef compute_reqs(product, qty, inv_state):\n    demand=defaultdict(float)\n    demand[product]+=qty\n    leaf_gross=defaultdict(float)\n    wc_gross=defaultdict(float)\n    prod={}\n    for p in topo:\n        d=demand.get(p,0.0)\n        if d<=1e-9:\n            continue\n        stock=float(inv_state.get(p,0.0))\n        consumed=min(stock,d)\n        remaining=d-consumed\n        if remaining>1e-9:\n            batch=parts[p]['batch_size']\n            run_qty=math.ceil(remaining/batch - 1e-12)*batch\n            prod[p]=(float(run_qty),consumed)\n            for r in routing.g"]
