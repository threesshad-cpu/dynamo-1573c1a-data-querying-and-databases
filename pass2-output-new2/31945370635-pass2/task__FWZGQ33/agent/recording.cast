[350.629728, "o", "\u001b[?2004h> "]
[350.631469, "o", "    routing[r['parent_part_id']].append({'workcenter_id':r['workcenter_id'],'setup_hours':float(r['setup_hours']),'run_hours_per_unit':float(r['run_hours_per_unit'])})\r\n\u001b[?2004l\r"]
[350.631598, "o", "\u001b[?2004h> "]
