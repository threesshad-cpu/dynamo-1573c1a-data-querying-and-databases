[350.632503, "o", "for r in cur.execute('SELECT * FROM bom'):\r\n\u001b[?2004l\rf\u001b[?2004h"]
[350.632598, "o", "> "]
[350.634882, "o", "    bom[r['parent_part_id']].append({'child_part_id':r['child_part_id'],'qty_per':r['qty_per'],'scrap_rate_pct':float(r['scrap_rate_pct']),'setup_scrap_qty':r['setup_scrap_qty']})\r\n\u001b[?2004l\r"]
[350.634917, "o", "\u001b[?2004h> "]
