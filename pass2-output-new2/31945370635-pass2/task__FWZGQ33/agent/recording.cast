[350.790372, "o", "IE': 10.0, 'SUB_L3_A': 12.0, 'SUB_L3_B': 0.0, 'SA1': 14.0, 'SA2': 16.0, 'P1': 12.0, 'P2': 8.0, 'P3': 0.0, 'P4': 0.0, 'P5': 0.0, 'P_B': 8.0}\r\n  workcenter after= {'WC1': 189.0, 'WC2': 58.0, 'WC_TIE': 10.0}\r\n\r\nOrder O4 product P4 req 5 batch 1\r\n  max_alloc_before_cancel= 1 shortfall_pre= 4\r\n  lim= L4 lim_ratio= 0.5 ratios= {'L4': 0.5, 'L_TIE': 0.5, 'WC_TIE': 0.5}\r\n  canceled= True alloc= 0 short= 5\r\n  leaf_last_feas g= {'L4': 10.0, 'L_TIE': 10.0}\r\n  wc_last_feas g= {'WC_TIE': 10.0}\r\n  prod_last_feas= {'P4': (1.0, 0.0)}\r\n  inventory after= {'L1': 95.0, 'L2': 1.0, 'L3': 15.0, 'L4': 10.0, 'L_TIE': 10.0, 'SUB_L3_A': 12.0, 'SUB_L3_B': 0.0, 'SA1': 14.0, 'SA2': 16.0, 'P1': 12.0, 'P2': 8.0, 'P3': 0.0, 'P4': 0.0, 'P5': 0.0, 'P_B': 8.0}\r\n  workcenter after= {'WC1': 189.0, 'WC2': 58.0, 'WC_TIE': 10.0}\r\n\r\nOrder O5 product P5 req 15 batch 1\r\n  max_alloc_before_cancel= 10 shortfall_pre= 5\r\n  lim= L4 lim_ratio= 0.9090909090909091 ratios= {'L4': 0.9090909090909091, 'WC1': 17.181818181818183}\r\n  canceled= True alloc= 0 short= 1"]
