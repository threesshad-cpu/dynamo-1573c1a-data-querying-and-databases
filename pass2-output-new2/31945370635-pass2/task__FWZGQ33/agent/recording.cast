[350.650143, "o", "\u001b[?2004h> "]
[350.650225, "o", "\r\n\u001b[?2004l\r)\u001b[?2004h> "]
[350.650804, "o", "def valid_floor_div_or_maybe_capacity(stock, ratio):\r\n\u001b[?2004l\r"]
[350.650832, "o", "\u001b[?2004h> "]
[350.651063, "o", "    if ratio<=0:\r\n\u001b[?2004l\r"]
[350.651095, "o", "\u001b[?2004h"]
[350.651194, "o", "> "]
[350.651292, "o", "        return 0\r\n\u001b[?2004l\r"]
[350.651374, "o", "\u001b[?2004h> "]
[350.65177, "o", "    return math.floor(stock / ratio)\r\n\u001b[?2004l\rs\u001b[?2004h"]
[350.651867, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.652275, "o", "def leaf_total_available(leaf, inv):\r\n\u001b[?2004l\r \u001b[?2004h"]
[350.652362, "o", "> "]
[350.652622, "o", "    avail=float(inv[leaf])\r\n\u001b[?2004l\ru\u001b[?2004h"]
[350.652703, "o", "> "]
[350.653095, "o", "    for sub in substitutes.get(leaf,[]):\r\n\u001b[?2004l\rfo\u001b[?2004h"]
[350.653126, "o", "> "]
[350.653763, "o", "        stock=float(inv.get(sub['substitute_part_id'],0))\r\n\u001b[?2004l\r"]
[350.653849, "o", "\u001b[?2004h> "]
[350.654654, "o", "        avail += float(valid_floor_div_or_maybe_capacity(stock, sub['qty_ratio']))\r\n\u001b[?2004l\r"]
[350.654691, "o", "\u001b[?2004h> "]
[350.654888, "o", "    return avail\r\n\u001b[?2004l\r"]
[350.65498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[350.655074, "o", "\u001b[?2004h> "]
[350.655812, "o", "def compute_requirements(product, qty, inv_state, wc_state):\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[350.655842, "o", "> "]
[350.656705, "o", "    \"\"\"Return leaf_gross, wc_gross, productions plan for building qty of product.\r\n\u001b[?2004l\r"]
[350.656745, "o", "\u001b[?2004h> "]
[350.657622, "o", "    Subassembly netting is performed; leaf inventory is NOT checked or netted here.\r\n\u001b[?2004l\r  \u001b[?2004h"]
[350.657654, "o", "> "]
[350.657755, "o", "    \"\"\"\r\n\u001b[?2004l\r m\u001b[?2004h"]
[350.657851, "o", "> "]
[350.65811, "o", "    demand=defaultdict(float)\r\n\u001b[?2004l\rt"]
[350.658141, "o", "\u001b[?2004h> "]
[350.658475, "o", "    demand[product]+=qty\r\n\u001b[?2004l\r"]
[350.658569, "o", "\u001b[?2004h> "]
[350.658836, "o", "    leaf_gross=defaultdict(float)\r\n\u001b[?2004l\r"]
[350.65887, "o", "\u001b[?2004h> "]
[350.659272, "o", "    wc_gross=defaultdict(float)\r\n\u001b[?2004l\r"]
[350.6593, "o", "\u001b[?2004h> "]
[350.659468, "o", "    prod={}\r\n\u001b[?2004l\r "]
[350.659501, "o", "\u001b[?2004h> "]
[350.659731, "o", "    for p in topo:\r\n\u001b[?2004l\r"]
[350.659759, "o", "\u001b[?2004h> "]
[350.660104, "o", "        d=demand.get(p,0.0)\r\n\u001b[?2004l\r l\u001b[?2004h"]
[350.660139, "o", "> "]
[350.66045, "o", "        if d <= 1e-9:\r\n\u001b[?2004l\r"]
[350.660479, "o", "\u001b[?2004h"]
[350.660605, "o", "> "]
[350.660834, "o", "            continue\r\n\u001b[?2004l\r"]
[350.660915, "o", "\u001b[?2004h> "]
[350.66145, "o", "        stock=float(inv_state.get(p,0.0))\r\n\u001b[?2004l\r"]
[350.661542, "o", "\u001b[?2004h> "]
[350.661859, "o", "        consumed=min(stock,d)\r\n\u001b[?2004l\r"]
[350.661941, "o", "\u001b[?2004h> "]
[350.66224, "o", "        remaining=d-consumed\r\n\u001b[?2004l\r"]
[350.662268, "o", "\u001b[?2004h> "]
[350.662635, "o", "        if remaining > 1e-9:\r\n\u001b[?2004l\rl"]
[350.662667, "o", "\u001b[?2004h"]
[350.662721, "o", "> "]
[350.66311, "o", "            batch=parts[p]['batch_size']\r\n\u001b[?2004l\r"]
[350.663206, "o", "\u001b[?2004h> "]
[350.663719, "o", "            runs=math.ceil(remaining/batch - 1e-9)\r\n\u001b[?2004l\r"]
[350.663794, "o", "\u001b[?2004h> "]
[350.664199, "o", "            run_qty=float(runs*batch)\r\n\u001b[?2004l\r \u001b[?2004h"]
[350.664286, "o", "> "]
[350.664683, "o", "            prod[p]=(run_qty,consumed)\r\n\u001b[?2004l\r \u001b[?2004h"]
[350.664714, "o", "> "]
[350.665157, "o", "            for route in routing.get(p,[]):\r\n\u001b[?2004l\r"]
[350.665192, "o", "\u001b[?2004h> "]
[350.666028, "o", "                hrs=route['setup_hours']+route['run_hours_per_unit']*run_qty\r\n\u001b[?2004l\r"]
[350.666063, "o", "\u001b[?2004h> "]
[350.666698, "o", "                wc_gross[route['workcenter_id']]+=hrs\r\n\u001b[?2004l\rb\u001b[?2004h"]
[350.666729, "o", "> "]
[350.667132, "o", "            for b in bom.get(p,[]):\r\n\u001b[?2004l\r"]
[350.667212, "o", "\u001b[?2004h> "]
[350.667651, "o", "                child=b['child_part_id']\r\n\u001b[?2004l\rr_\u001b[?2004h"]
[350.667681, "o", "> "]
[350.668555, "o", "                base=b['qty_per']*run_qty*(1.0 + b['scrap_rate_pct']/100.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.669074, "o", "                req=math.ceil(base - 1e-9)+b['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[350.669101, "o", "\u001b[?2004h> "]
[350.669445, "o", "                if child in non_leaves:\r\n\u001b[?2004l\r"]
[350.669533, "o", "\u001b[?2004h> "]
[350.669827, "o", "                    demand[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.669854, "o", "> "]
[350.67007, "o", "                else:\r\n\u001b[?2004l\rr\u001b[?2004h"]
[350.670098, "o", "> "]
[350.670469, "o", "                    leaf_gross[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.670502, "o", "> "]
[350.670575, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.670605, "o", "> "]
[350.670776, "o", "            prod[p]=(0.0,consumed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.671, "o", "    return dict(leaf_gross), dict(wc_gross), prod\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[350.671028, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[350.671276, "o", "def feasible(product, qty, inv_state, wc_state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.671654, "o", "    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.671745, "o", "    # check leaves\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.671948, "o", "    for leaf,g in leaf_gross.items():\r\n\u001b[?2004l\r \u001b[?2004h> "]
[350.672244, "o", "        if g > leaf_total_available(leaf, inv_state) + 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.672495, "o", "            return False, leaf_gross, wc_gross, prod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.672571, "o", "    # check wc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.672758, "o", "    for wid,g in wc_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.672993, "o", "        if g > wc_state.get(wid,0.0) + 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.673234, "o", "            return False, leaf_gross, wc_gross, prod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.673448, "o", "    return True, leaf_gross, wc_gross, prod\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[350.673476, "o", "> "]
[350.673777, "o", "def consume_feasible(product, qty, inv_state, wc_state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.674177, "o", "    leaf_gross, wc_gross, prod = compute_requirements(product, qty, inv_state, wc_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.674309, "o", "    inv_after=dict(inv_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.674468, "o", "    wc_after=dict(wc_state)\r\n\u001b[?2004l\re"]
[350.674494, "o", "n\u001b[?2004h"]
[350.674589, "o", "> "]
[350.674648, "o", "    # consume leaf materials\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.674834, "o", "    for leaf,g in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.674917, "o", "        rem=g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675062, "o", "        own=inv_after.get(leaf,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675164, "o", "        use=min(own, rem)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675301, "o", "        inv_after[leaf]-=use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675445, "o", "        rem-=use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675578, "o", "        for sub in substitutes.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675724, "o", "            if rem <= 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.675807, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.676034, "o", "            stock=inv_after.get(sub['substitute_part_id'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.676298, "o", "            cap=valid_floor_div_or_maybe_capacity(stock, sub['qty_ratio'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.676481, "o", "            use_prim=min(rem, float(cap))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.67672, "o", "            consume_sub=use_prim * sub['qty_ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.676747, "o", "> "]
[350.676992, "o", "            inv_after[sub['substitute_part_id']]-=consume_sub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.677124, "o", "            rem-=use_prim\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.677228, "o", "        if rem > 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.677595, "o", "            raise Exception(f'infeasible leaf consumption {leaf}: {rem}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.677743, "o", "    # consume/restock manufactured parts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.677939, "o", "    for p,(run_qty,consumed) in prod.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.678217, "o", "        inv_after[p] = inv_after.get(p,0.0) - consumed + run_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.67838, "o", "    for wid,g in wc_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.678524, "o", "        wc_after[wid] -= g\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.678552, "o", "> "]
[350.678685, "o", "        if wc_after[wid] < -1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.678983, "o", "            raise Exception(f'infeasible workcenter consumption {wid}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.679223, "o", "    return inv_after, wc_after, prod, leaf_gross, wc_gross\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[350.679255, "o", "\u001b[?2004h> "]
[350.679585, "o", "def compute_limit_resource(product, q_alloc, batch, inv_state, wc_state):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.679689, "o", "    qplus=q_alloc+batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680059, "o", "    leaf_gross, wc_gross, *_ = compute_requirements(product, qplus, inv_state, wc_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680148, "o", "    ratios={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680279, "o", "    for leaf,g in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680397, "o", "        if g>1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680621, "o", "            av=leaf_total_available(leaf, inv_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680749, "o", "            ratios[leaf]=av/g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.680892, "o", "    for wid,g in wc_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.68099, "o", "        if g>1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.681149, "o", "            av=wc_state.get(wid,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.68129, "o", "            ratios[wid]=av/g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.681379, "o", "    best=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.681495, "o", "    bestratio=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.681594, "o", "    for rid, r in ratios.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.681726, "o", "        if r < 1.0 - 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.682079, "o", "            if bestratio is None or r < bestratio-1e-12 or (abs(r-bestratio)<=1e-12 and rid<best):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.682179, "o", "                best=rid\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.682208, "o", "> "]
[350.682299, "o", "                bestratio=r\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.682326, "o", "> "]
[350.682444, "o", "    return best, bestratio, ratios\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[350.682472, "o", "\u001b[?2004h> "]
[350.68256, "o", "results=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.682662, "o", "for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.682689, "o", "> "]
[350.682987, "o", "    oid=order['order_id']; prod_id=order['product_part_id']; req=order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683134, "o", "    b=parts[prod_id]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683304, "o", "    inv_before=dict(inv); wc_before=dict(wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683391, "o", "    max_i=req//b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683477, "o", "    max_alloc=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683565, "o", "    last_feas=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683701, "o", "    for k in range(max_i,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.683785, "o", "        cand=k*b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684066, "o", "        ok, leaf_g, wc_g, prod = feasible(prod_id,cand,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684153, "o", "        if ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684274, "o", "            max_alloc=cand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.68445, "o", "            last_feas=(leaf_g,wc_g,prod)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684483, "o", "            break\r\n"]
[350.684582, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[350.684617, "o", "    shortfall=req-max_alloc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684711, "o", "    lim=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.684826, "o", "    limratio=None\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.684853, "o", "> "]
[350.684906, "o", "    limratios=None\r\n\u001b[?2004l\r"]
[350.684929, "o", "\u001b[?2004h> "]
[350.685046, "o", "    if shortfall>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.685403, "o", "        lim,limratio,limratios=compute_limit_resource(prod_id,max_alloc,b,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.685498, "o", "    canceled=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.685634, "o", "    if max_alloc/req < 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.685735, "o", "        canceled=True\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.685768, "o", "> "]
[350.685845, "o", "    elif shortfall % 2 == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.685983, "o", "        canceled=True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686069, "o", "    if canceled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686157, "o", "        allocated=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686236, "o", "        shortfall=req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.6864, "o", "        inv_after=dict(inv_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686537, "o", "        wc_after=dict(wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686704, "o", "        # limiting resource still original\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686804, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.686886, "o", "        allocated=max_alloc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687307, "o", "        inv_after, wc_after, prod_commit, lc, wcg = consume_feasible(prod_id,max_alloc,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687463, "o", "    inv=inv_after\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687564, "o", "    wc=wc_after\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687609, "o", "    results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687691, "o", "        'order_id':oid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687786, "o", "        'requested':req,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687913, "o", "        'product':prod_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.687972, "o", "        'batch':b,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.688191, "o", "        'max_alloc_before_cancel':max_alloc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.688318, "o", "        'allocated_qty':allocated,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.688458, "o", "        'shortfall_qty':shortfall,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.73482, "o", "        'limit_resource':lim,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.735141, "o", "        'limit_ratio':limratio,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.735409, "o", "        'canceled':canceled\r\n\u001b[?2004l\r\u001b[?2004h"]
[350.735536, "o", "> "]
[350.735634, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.736037, "o", "    print('\\nOrder',oid, 'product',prod_id,'req',req,'batch',b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.736604, "o", "    print('  max_alloc_before_cancel=',max_alloc, 'shortfall_pre=',req-max_alloc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.73683, "o", "    print('  lim=',lim,'lim_ratio=',limratio,'ratios=',limratios)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.737135, "o", "    print('  canceled=',canceled,'alloc=',allocated,'short=',shortfall)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.737371, "o", "    print('  leaf_last_feas g=', last_feas[0] if last_feas else None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.737646, "o", "    print('  wc_last_feas g=', last_feas[1] if last_feas else None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.737873, "o", "    print('  prod_last_feas=', last_feas[2] if last_feas else None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.738039, "o", "    print('  inventory after=', inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.738214, "o", "    print('  workcenter after=', wc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.738341, "o", "print('\\nFINAL RESULTS JSON:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.738921, "o", "final=[{'order_id':r['order_id'],'allocated_qty':r['allocated_qty'],'shortfall_qty':r['shortfall_qty'],'limiting_resource':r['limit_resource']} for r in results]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.739134, "o", "print(json.dumps({'orders':final}, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.73917, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[350.739243, "o", "PY\r\n\u001b[?2004l\r"]
