[235.759259, "o", "while q:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759398, "o", "    p=q.popleft(); topo.append(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759511, "o", "    for c in graph[p]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759634, "o", "        indegree[c]-=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759747, "o", "        if indegree[c]==0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759834, "o", "            q.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.759973, "o", "print('topo',topo)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.760101, "o", "print('bom keys', list(bom.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.760258, "o", "print('routing keys', list(routing.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.76036, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.760539, "o", "def explosive_plan(product, qty, inv, wc_avail=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.760826, "o", "    \"\"\"Return production plan, leaf gross requirements, wc gross requirements.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761139, "o", "       inv and wc_avail are used only for subassembly availability when netting.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761301, "o", "       Leaves are not subtracted in this function.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761389, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761519, "o", "    inv=dict(inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761683, "o", "    # demand of all parts, initialized to product qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761771, "o", "    demand=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.761912, "o", "    demand[product]+=qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762096, "o", "    production={}  # p -> (run_qty, consumed_stock)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762241, "o", "    leaf_gross=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762378, "o", "    wc_gross=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762703, "o", "    # process non-leaves in topo order; demand may be added by parents before child is reached\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762802, "o", "    for p in topo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.762911, "o", "        d=demand.get(p,0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.763008, "o", "        if d<=0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.7631, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.763192, "o", "        stock=inv.get(p,0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.763416, "o", "        consumed=min(float(stock), float(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.76351, "o", "        remaining=d-consumed\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.763573, "o", "> "]
[235.763635, "o", "        if remaining>1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.763886, "o", "            batch=parts.get(p,{}).get('batch_size',1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.763997, "o", "            runs=math.ceil(remaining/batch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.764148, "o", "            run_qty=runs*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.764322, "o", "            production[p]=(run_qty, consumed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.764518, "o", "            # add route hours for this run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.764674, "o", "            for route in routing.get(p,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.764937, "o", "                hrs=route['setup_hours']+route['run_hours_per_unit']*run_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.765145, "o", "                wc_gross[route['workcenter_id']]+=hrs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.765337, "o", "            # add child gross requirements using run_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.765502, "o", "            for b in bom.get(p,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.7657, "o", "                child=b['child_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.765926, "o", "                base=b['qty_per']*run_qty*(1+b['scrap_rate_pct']/100.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.766176, "o", "                req=math.ceil(base - 1e-9) + b['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.766323, "o", "                if child in non_leaves:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.766503, "o", "                    demand[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.76661, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.766764, "o", "                    leaf_gross[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.766838, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.767241, "o", "            # no production, just consume stock for that subassembly demand; not represented here for later inv update\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.767478, "o", "            production[p]=None  # mark consumed only? No need\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.767598, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.767793, "o", "    return dict(production), dict(leaf_gross), dict(wc_gross)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[235.76782, "o", "> "]
[235.767962, "o", "print('\\n--- Test O1 plan ---')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768141, "o", "inv0={p:parts[p]['on_hand'] for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768363, "o", "wc0={w:workcenters[w]['available_hours'] for w in workcenters}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768553, "o", "prod,leaf,wc=explosive_plan('P1',12,inv0,wc0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768653, "o", "print('prod',prod)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768745, "o", "print('leaf',leaf)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768829, "o", "print('wc',wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.768947, "o", "print('\\n--- Test O2 plans ---')\r\n\u001b[?2004l\r\u001b[?2004h> "]
