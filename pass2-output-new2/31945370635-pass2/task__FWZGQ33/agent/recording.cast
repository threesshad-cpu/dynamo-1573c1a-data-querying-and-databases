[350.627822, "o", "\u001b[?2004h> "]
[350.628823, "o", "    workcenters[r['workcenter_id']]={'name':r['name'],'available_hours':float(r['available_hours'])}\r\n\u001b[?2004l\r"]
[350.628878, "o", "\u001b[?2004h> "]
