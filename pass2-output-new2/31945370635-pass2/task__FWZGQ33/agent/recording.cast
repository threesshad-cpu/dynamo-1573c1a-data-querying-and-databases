[350.621626, "o", "DB='/app/manufacturing.db'\r\n\u001b[?2004l\rro\u001b[?2004h> "]
[350.62192, "o", "conn=sqlite3.connect(DB)\r\n\u001b[?2004l\rr\u001b[?2004h> "]
