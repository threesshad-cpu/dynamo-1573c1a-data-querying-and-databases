[504.795694, "o", "        if remaining>1e-9:\r\n\u001b[?2004l\r"]
[504.795726, "o", "\u001b[?2004h> "]
[504.796246, "o", "            batch=parts[p]['batch_size']\r\n\u001b[?2004l\r"]
[504.796285, "o", "\u001b[?2004h> "]
[504.796942, "o", "            run_qty=math.ceil(remaining/batch - 1e-12)*batch\r\n\u001b[?2004l\r"]
[504.796979, "o", "\u001b[?2004h> "]
[504.834622, "o", "            prod[p]=(float(run_qty),consumed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.834998, "o", "            for r in routing.get(p,[]):\r\n\u001b[?2004l\r"]
[504.835116, "o", "\u001b[?2004h> "]
[504.83608, "o", "                wc_gross[r['workcenter_id']]+=r['setup_hours']+r['run_hours_per_unit']*run_qty\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.836126, "o", "> "]
[504.836462, "o", "            for b in bom.get(p,[]):\r\n\u001b[?2004l\r"]
[504.836559, "o", "\u001b[?2004h> "]
[504.836889, "o", "                child=b['child_part_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.836961, "o", "> "]
[504.837583, "o", "                base=b['qty_per']*run_qty*(1.0+b['scrap_rate_pct']/100.0)\r\n\u001b[?2004l\r"]
[504.837617, "o", "\u001b[?2004h> "]
[504.838163, "o", "                req=math.ceil(base - 1e-9)+b['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.838192, "o", "> "]
[504.838616, "o", "                if child in non_leaves:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.838975, "o", "                    demand[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.839013, "o", "> "]
[504.839219, "o", "                else:\r\n\u001b[?2004l\r"]
[504.839309, "o", "\u001b[?2004h> "]
[504.839691, "o", "                    leaf_gross[child]+=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.839777, "o", "> "]
[504.839879, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.839917, "o", "> "]
[504.840234, "o", "            prod[p]=(0.0,consumed)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.840755, "o", "    return dict(leaf_gross), dict(wc_gross), prod\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.840797, "o", "> \r\n\u001b[?2004l\r"]
[504.840873, "o", "\u001b[?2004h> "]
[504.841286, "o", "def feasible(product, qty, inv_state, wc_state):\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.841384, "o", "> "]
[504.841937, "o", "    leaf_gross, wc_gross, _ = compute_reqs(product, qty, inv_state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.842354, "o", "    for leaf,gross in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.842407, "o", "> "]
[504.84288, "o", "        if gross > subs_avail(leaf, inv_state) + 1e-9:\r\n\u001b[?2004l\r"]
[504.84291, "o", "\u001b[?2004h> "]
[504.843365, "o", "            return False, leaf_gross, wc_gross\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.843757, "o", "    for wid,gross in wc_gross.items():\r\n\u001b[?2004l\r"]
[504.843792, "o", "\u001b[?2004h> "]
[504.844224, "o", "        if gross > wc_state.get(wid,0.0) + 1e-9:\r\n\u001b[?2004l\r"]
[504.844254, "o", "\u001b[?2004h> "]
[504.844702, "o", "            return False, leaf_gross, wc_gross\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.844731, "o", "> "]
[504.845076, "o", "    return True, leaf_gross, wc_gross\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.845162, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[504.845192, "o", "> "]
[504.845686, "o", "def max_feasible(product, req, inv_state, wc_state):\r\n\u001b[?2004l\r"]
[504.845721, "o", "\u001b[?2004h"]
[504.845783, "o", "> "]
[504.84609, "o", "    batch=parts[product]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.846118, "o", "> "]
[504.846277, "o", "    max_alloc=0\r\n\u001b[?2004l\r"]
[504.846305, "o", "\u001b[?2004h> "]
[504.846746, "o", "    for k in range(req//batch, -1, -1):\r\n\u001b[?2004l\r"]
[504.846775, "o", "\u001b[?2004h> "]
[504.847003, "o", "        cand=k*batch\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.847038, "o", "> "]
[504.8476, "o", "        ok,_,_=feasible(product,cand,inv_state,wc_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.847694, "o", "> "]
[504.847799, "o", "        if ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.848058, "o", "            return cand\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.848145, "o", "> "]
[504.848301, "o", "    return max_alloc\r\n\u001b[?2004l\r"]
[504.84833, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[504.848452, "o", "\u001b[?2004h> "]
[504.849018, "o", "def find_limiting(product, allocated, batch, inv_state, wc_state):\r\n\u001b[?2004l\r"]
[504.849052, "o", "\u001b[?2004h> "]
[504.849305, "o", "    qplus=allocated+batch\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.849406, "o", "> "]
[504.849936, "o", "    leaf_gross,wc_gross,_=compute_reqs(product,qplus,inv_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.849964, "o", "> "]
[504.850111, "o", "    ratios={}\r\n\u001b[?2004l\r"]
[504.850145, "o", "\u001b[?2004h"]
[504.850206, "o", "> "]
[504.850575, "o", "    for leaf,gross in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.850609, "o", "> "]
[504.850812, "o", "        if gross>1e-9:\r\n\u001b[?2004l\r"]
[504.850849, "o", "\u001b[?2004h> "]
[504.851335, "o", "            ratios[leaf]=subs_avail(leaf,inv_state)/gross\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.851369, "o", "> "]
[504.851772, "o", "    for wid,gross in wc_gross.items():\r\n\u001b[?2004l\r"]
[504.851808, "o", "\u001b[?2004h> "]
[504.852022, "o", "        if gross>1e-9:\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.852056, "o", "> "]
[504.85254, "o", "            ratios[wid]=wc_state.get(wid,0.0)/gross\r\n\u001b[?2004l\r"]
[504.852569, "o", "\u001b[?2004h> "]
[504.852852, "o", "    best=None; best_val=None\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.85288, "o", "> "]
[504.853196, "o", "    for rid,val in ratios.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.853281, "o", "> "]
[504.853535, "o", "        if val < 1.0 - 1e-9:\r\n\u001b[?2004l\r"]
[504.85357, "o", "\u001b[?2004h> "]
[504.854403, "o", "            if best is None or val < best_val - 1e-12 or (abs(val-best_val)<=1e-12 and rid < best):\r\n\u001b[?2004l\r"]
[504.854502, "o", "\u001b[?2004h> "]
[504.854803, "o", "                best=rid; best_val=val\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.854833, "o", "> "]
[504.855016, "o", "    return best\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.855093, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[504.855146, "o", "> "]
[504.855675, "o", "def commit_order(product, allocated, inv_state, wc_state):\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.85571, "o", "> "]
[504.856311, "o", "    leaf_gross,wc_gross,prod=compute_reqs(product, allocated, inv_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.856345, "o", "> "]
[504.856658, "o", "    inv_after=dict(inv_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.856692, "o", "> "]
[504.856951, "o", "    wc_after=dict(wc_state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.856985, "o", "> "]
[504.857362, "o", "    for leaf,gross in leaf_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.857406, "o", "> "]
[504.857631, "o", "        rem=gross\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.857959, "o", "        own=inv_after.get(leaf,0.0)\r\n\u001b[?2004l\r"]
[504.857995, "o", "\u001b[?2004h> "]
[504.858267, "o", "        use=min(own, rem)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.858295, "o", "> "]
[504.858666, "o", "        inv_after[leaf]=own-use\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.858846, "o", "        rem-=use\r\n\u001b[?2004l\r"]
[504.858875, "o", "\u001b[?2004h> "]
[504.859267, "o", "        for s in substitutes.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.859296, "o", "> "]
[504.859642, "o", "            if rem<=1e-9: break\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.859677, "o", "> "]
[504.860192, "o", "            stock=inv_after.get(s['substitute_part_id'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.860225, "o", "> "]
[504.860898, "o", "            cap=math.floor(stock/s['qty_ratio']) if s['qty_ratio']>0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.861021, "o", "> "]
[504.86127, "o", "            prim=min(rem,float(cap))\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.861304, "o", "> "]
[504.861973, "o", "            inv_after[s['substitute_part_id']]=stock - prim*s['qty_ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.862007, "o", "> "]
[504.862213, "o", "            rem-=prim\r\n\u001b[?2004l\r"]
[504.862242, "o", "\u001b[?2004h> "]
[504.862719, "o", "    product_run = prod.get(product,(0.0,0.0))[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.862748, "o", "> "]
[504.86339, "o", "    inv_after[product]=inv_state.get(product,0.0) + product_run - allocated\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.863466, "o", "> "]
[504.863787, "o", "    for p,(run,cons) in prod.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.863815, "o", "> "]
[504.864041, "o", "        if p!=product:\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.864069, "o", "> "]
[504.864677, "o", "            inv_after[p]=inv_state.get(p,0.0) - cons + run\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.865001, "o", "    for wid,gross in wc_gross.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.865115, "o", "> "]
[504.865503, "o", "        wc_after[wid]=wc_state.get(wid,0.0)-gross\r\n\u001b[?2004l\r"]
[504.865588, "o", "\u001b[?2004h> "]
[504.865841, "o", "    return inv_after, wc_after\r\n\u001b[?2004l\r"]
[504.86588, "o", "\u001b[?2004h"]
[504.865908, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[504.866009, "o", "> "]
[504.866101, "o", "results=[]\r\n\u001b[?2004l\r"]
[504.866151, "o", "\u001b[?2004h> "]
[504.866399, "o", "for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.866472, "o", "> "]
[504.866724, "o", "    oid=order['order_id']\r\n\u001b[?2004l\r"]
[504.866764, "o", "\u001b[?2004h> "]
[504.867134, "o", "    product=order['product_part_id']\r\n\u001b[?2004l\r"]
[504.867166, "o", "\u001b[?2004h"]
[504.867248, "o", "> "]
[504.867515, "o", "    req=order['requested_qty']\r\n\u001b[?2004l\r"]
[504.867552, "o", "\u001b[?2004h> "]
[504.867933, "o", "    batch=parts[product]['batch_size']\r\n\u001b[?2004l\r"]
[504.867972, "o", "\u001b[?2004h> "]
[504.868207, "o", "    inv_before=dict(inv)\r\n\u001b[?2004l\r"]
[504.868241, "o", "\u001b[?2004h> "]
[504.868503, "o", "    wc_before=dict(wc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.868546, "o", "> "]
[504.869033, "o", "    max_alloc=max_feasible(product,req,inv_before,wc_before)\r\n\u001b[?2004l\r"]
[504.869068, "o", "\u001b[?2004h> "]
[504.869304, "o", "    short=req-max_alloc\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.869344, "o", "> "]
[504.869576, "o", "    limiting=None\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.869631, "o", "> "]
[504.869838, "o", "    if req-max_alloc>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.870393, "o", "        limiting=find_limiting(product,max_alloc,batch,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.870608, "o", "    canceled=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.870827, "o", "    if max_alloc/req < 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.871037, "o", "        canceled=True\r\n\u001b[?2004l\r\u001b[?2004h"]
[504.871074, "o", "> "]
[504.871324, "o", "    elif (req-max_alloc) % 2 == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.871564, "o", "        canceled=True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.871745, "o", "    if canceled:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.871887, "o", "        allocated=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.871923, "o", "        shortfall_qty=req\r\n"]
[504.871985, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[504.872192, "o", "        inv=dict(inv_before); wc=dict(wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.872223, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.872411, "o", "        allocated=max_alloc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.872489, "o", "        shortfall_qty=short\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.87275, "o", "        inv,wc=commit_order(product,allocated,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873209, "o", "    results.append({'order_id':oid,'allocated_qty':allocated,'shortfall_qty':shortfall_qty,'limiting_resource':limiting})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873447, "o", "results=sorted(results,key=lambda x:x['order_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873559, "o", "with open('/app/report.json','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873746, "o", "    json.dump({'orders':results},f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873925, "o", "print(json.dumps({'orders':results},indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[504.873958, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[504.952149, "o", "{\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"O1\",\r\n      \"allocated_qty\": 12,\r\n      \"shortfall_qty\": 0,\r\n      \"limiting_resource\": null\r\n    },\r\n    {\r\n      \"order_id\": \"O2\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"L2\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 10,\r\n      \"limiting_resource\": \"L3\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3b\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"SUB_L3_B\"\r\n    },\r\n    {\r\n      \"order_id\": \"O4\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 5,\r\n      \"limiting_resource\": \"L4\"\r\n    },\r\n    {\r\n      \"order_id\": \"O5\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 15,\r\n      \"limiting_resource\": \"L4\"\r\n    }\r\n  ]\r\n}\r\n"]
[504.955203, "o", "\u001b[?2004hroot@d8ffe34a-dd2c-4b81-8594-af1965f2438f:/app# "]
[504.955505, "o", "cat /app/report.json\r\n\u001b[?2004l\r"]
[504.956768, "o", "{\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"O1\",\r\n      \"allocated_qty\": 12,\r\n      \"shortfall_qty\": 0,\r\n      \"limiting_resource\": null\r\n    },\r\n    {\r\n      \"order_id\": \"O2\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"L2\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 10,\r\n      \"limiting_resource\": \"L3\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3b\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"SUB_L3_B\"\r\n    },\r\n    {\r\n      \"order_id\": \"O4\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 5,\r\n      \"limiting_resource\": \"L4\"\r\n    },\r\n    {\r\n      \"order_id\": \"O5\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 15,\r\n      \"limiting_resource\": \"L4\"\r\n    }\r\n  ]\r\n}"]
[504.957017, "o", "\u001b[?2004hroot@d8ffe34a-dd2c-4b81-8594-af1965f2438f:/app# "]
[733.946554, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\nDB='/app/manufacturing.db'\nconn=sqlite3.connect(DB); conn.row_factory=sqlite3.Row; cur=conn.cursor()\nparts={r['part_id']:{'qty':r['on_hand_qty'],'batch':r['batch_size']} for r in cur.execute('SELECT * FROM parts')}\norders=sorted([dict(r) for r in cur.execute('SELECT * FROM orders')], key=lambda x:(x['priority'],x['order_id']))\nwork={r['workcenter_id']:r['available_hours'] for r in cur.execute('SELECT * FROM workcenters')}\nroute=defaultdict(list)\nfor r in cur.execute('SELECT * FROM routing'): route[r['parent_part_id']].append((r['workcenter_id'],r['setup_hours'],r['run_hours_per_unit']))\nbom=defaultdict(list)\nfor r in cur.execute('SELECT * FROM bom'): bom[r['parent_part_id']].append((r['child_part_id'],r['qty_per'],r['scrap_rate_pct'],r['setup_scrap_qty']))\nsubs=defaultdict(list)\nfor r in cur.execute('SELECT * FROM substitutes'): subs[r['primary_part_id']].append((r['substitute_part_id'],r['qty_ratio'],r['preference_rank']))"]
[733.946627, "i", "\nfor k in subs: subs[k].sort(key=lambda x:(x[2],x[0]))\nnon=set(bom)|set(route)\nind={p:0 for p in non}; g={p:[] for p in non}\nfor p in non:\n    for c,_,_,_ in bom.get(p,[]):\n        if c in non: g[p].append(c); ind[c]+=1\nq=deque([p for p in non if ind[p]==0]); topo=[]\nwhile q:\n    p=q.popleft(); topo.append(p)\n    for c in g[p]:\n        ind[c]-=1\n        if ind[c]==0: q.append(c)\ninv={p:parts[p]['qty'] for p in parts}; wc=dict(work)\n\ndef avail_leaf(l,inv):\n    a=inv.get(l,0)\n    for sid,ratio,_ in subs.get(l,[]):\n        a += math.floor(inv.get(sid,0)/ratio) if ratio else 0\n    return a\n\ndef reqs(product,quantity,inv_state):\n    dem=defaultdict(float); dem[product]+=quantity\n    leaves=defaultdict(float); hours=defaultdict(float); prod={}\n    for p in topo:\n        d=dem.get(p,0.0)\n        if d<=1e-9: continue\n        stock=inv_state.get(p,0.0); cons=min(stock,d); rem=d-cons\n        if rem>1e-9:\n            rq=math.ceil(rem/parts[p]['batch']-1e-10)*parts[p]['batch']\n            prod[p]=(rq,cons)\n            fo"]
[733.946659, "i", "r wid,s,r in route.get(p,[]): hours[wid]+=s+r*rq\n            for c,qty,scrap,setq in bom.get(p,[]):\n                req=math.ceil(qty*rq*(1+scrap/100.0)-1e-10)+setq\n                if c in non: dem[c]+=req\n                else: leaves[c]+=req\n        else: prod[p]=(0.0,cons)\n    return leaves,hours,prod\n\ndef limit_resources(product,alloc,batch,inv_state,wc_state):\n    leaves,hours,_=reqs(product,alloc+batch,inv_state)\n    ratios={}\n    for l,g_ in leaves.items(): ratios[l]=avail_leaf(l,inv_state)/g_\n    for w,g_ in hours.items(): ratios[w]=wc_state.get(w,0)/g_\n    print('  limiting calculation for alloc+batch=',alloc+batch)\n    print('   ratios=',ratios)\n    best=None; bv=None\n    for rid,r in ratios.items():\n        if r<1-1e-9:\n            if best is None or r<bv-1e-12 or (abs(r-bv)<=1e-12 and rid<best): best=rid; bv=r\n    return best\n\ndef consume(product,alloc,inv_state,wc_state):\n    leaves,hours,prod=reqs(product,alloc,inv_state)\n    inv=dict(inv_state); w=dict(wc_state)\n    for l,g_ in leaves.items():\n "]
[733.946889, "i", "       rem=g_; use=min(inv.get(l,0),rem); inv[l]=inv.get(l,0)-use; rem-=use\n        for sid,ratio,_ in subs.get(l,[]):\n            if rem<=1e-9: break\n            prim=min(rem,math.floor(inv.get(sid,0)/ratio) if ratio else 0); inv[sid]-=prim*ratio; rem-=prim\n    prod_run=prod.get(product,(0.0,0.0))[0]\n    inv[product]=inv_state.get(product,0)+prod_run-alloc\n    for p,(run,cons) in prod.items():\n        if p!=product: inv[p]=inv_state.get(p,0)-cons+run\n    for wid,h in hours.items(): w[wid]-=h\n    return inv,w\n\ncomputed=[]\nfor o in orders:\n    oid=o['order_id']; product=o['product_part_id']; req=o['requested_qty']; batch=parts[product]['batch']\n    inv_before=dict(inv); wc_before=dict(wc)\n    max_alloc=0\n    for k in range(req//batch,-1,-1):\n        cand=k*batch; leaves,hours,_=reqs(product,cand,inv_before)\n        if all(g_<=avail_leaf(l,inv_before)+1e-9 for l,g_ in leaves.items()) and all(h<=wc_before[w]+1e-9 for w,h in hours.items()):\n            max_alloc=cand; break\n    lim=limit_resources(product,max_all"]
[733.946973, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.947019, "i", "oc,batch,inv_before,wc_before) if req-max_alloc>0 else None\n    canceled=(max_alloc/req<0.5) or ((req-max_alloc)%2==1)\n    alloc=0 if canceled else max_alloc; short=req if canceled else req-max_alloc\n    if not canceled: inv,wc=consume(product,alloc,inv_before,wc_before)\n    computed.append({'order_id':oid,'allocated_qty':alloc,'shortfall_qty':short,'limiting_resource':lim})\n    print('\\nOrder',oid,'max=',max_alloc,'lim=',lim,'canceled=',canceled,'alloc=',alloc,'short=',short)\nprint('\\nComputed JSON:')\nprint(json.dumps({'orders':sorted(computed,key=lambda x:x['order_id'])},indent=2))\nPY\n"]
