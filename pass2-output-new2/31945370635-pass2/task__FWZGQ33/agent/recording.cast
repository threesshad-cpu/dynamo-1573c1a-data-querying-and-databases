[733.985692, "o", "            max_alloc=cand; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.986054, "o", "    lim=limit_resources(product,max_alloc,batch,inv_before,wc_before) if req-max_alloc>0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.986268, "o", "    canceled=(max_alloc/req<0.5) or ((req-max_alloc)%2==1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.986564, "o", "    alloc=0 if canceled else max_alloc; short=req if canceled else req-max_alloc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.986816, "o", "    if not canceled: inv,wc=consume(product,alloc,inv_before,wc_before)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.987197, "o", "    computed.append({'order_id':oid,'allocated_qty':alloc,'shortfall_qty':short,'limiting_resource':lim})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.987555, "o", "    print('\\nOrder',oid,'max=',max_alloc,'lim=',lim,'canceled=',canceled,'alloc=',alloc,'short=',short)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.987662, "o", "print('\\nComputed JSON:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[733.987976, "o", "print(json.dumps({'orders':sorted(computed,key=lambda x:x['order_id'])},indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[734.073768, "o", "\r\nOrder O1 max= 12 lim= None canceled= False alloc= 12 short= 0\r\n"]
[734.074046, "o", "  limiting calculation for alloc+batch= 9\r\n   ratios= {'L2': 0.819672131147541, 'L1': 1.813953488372093, 'WC1': 6.135135135135135, 'WC2': 2.0}\r\n\r\nOrder O2 max= 8 lim= L2 canceled= False alloc= 8 short= 2\r\n"]
[734.07421, "o", "  limiting calculation for alloc+batch= 6\r\n   ratios= {'L3': 0.9666666666666667, 'WC2': 8.285714285714286}\r\n\r\nOrder"]
[734.074244, "o", " O3 max= 5 lim= L3 canceled= True alloc= 0 short= 10\r\n"]
[734.074367, "o", "  limiting calculation for alloc+batch= 9\r\n   ratios= {'SUB_L3_B': 0.8888888888888888, 'WC1': 21.88888888888889}\r\n"]
[734.07447, "o", "\r\nOrder O3b max= 8 lim= SUB_L3_B canceled= False alloc= 8 short= 2\r\n"]
[734.074588, "o", "  limiting calculation for alloc+batch= 2\r\n   ratios= {'L4': 0.5, 'L_TIE': 0.5, 'WC_TIE': 0.5}\r\n\r\nOrder O4 max= 1 lim= L4 canceled= True alloc= 0 short= 5\r\n"]
[734.07475, "o", "  limiting calculation for alloc+batch= 11\r\n   ratios= {'L4': 0.9090909090909091, 'WC1': 17.181818181818183}\r\n\r\nOrder"]
[734.07483, "o", " O5 max= 10 lim= L4 canceled= True alloc= 0 short= 15\r\n\r\nComputed JSON:\r\n"]
[734.074976, "o", "{\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"O1\",\r\n      \"allocated_qty\": 12,\r\n      \"shortfall_qty\": 0,\r\n      \"limiting_resource\": null\r\n    },\r\n    {\r\n      \"order_id\": \"O2\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"L2\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 10,\r\n      \"limiting_resource\": \"L3\"\r\n    },\r\n    {\r\n      \"order_id\": \"O3b\",\r\n      \"allocated_qty\": 8,\r\n      \"shortfall_qty\": 2,\r\n      \"limiting_resource\": \"SUB_L3_B\"\r\n    },\r\n    {\r\n      \"order_id\": \"O4\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 5,\r\n      \"limiting_resource\": \"L4\"\r\n    },\r\n    {\r\n      \"order_id\": \"O5\",\r\n      \"allocated_qty\": 0,\r\n      \"shortfall_qty\": 15,\r\n      \"limiting_resource\": \"L4\"\r\n    }\r\n  ]\r\n}"]
