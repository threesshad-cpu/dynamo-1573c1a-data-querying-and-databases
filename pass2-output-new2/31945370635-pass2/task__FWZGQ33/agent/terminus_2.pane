def feasible(product, qty, inv_state, wc_state):
    leaf_gross, wc_gross, _ = compute_reqs(product, qty, inv_state)
    for leaf,gross in leaf_gross.items():
        if gross > subs_avail(leaf, inv_state) + 1e-9:
            return False, leaf_gross, wc_gross
    for wid,gross in wc_gross.items():
        if gross > wc_state.get(wid,0.0) + 1e-9:
            return False, leaf_gross, wc_gross
    return True, leaf_gross, wc_gross

