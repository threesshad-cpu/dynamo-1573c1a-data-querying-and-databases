[?2004l[?2004h>                 while needed_qty > 0:
[?2004l
[?2004h>                     # Try to get 'ratio' units of substitute to cover 1 primary unit
[?2004la[?2004h>                     # We need to check if we can get 'ratio' units of sub_id
[?2004l[?2004h>                     # But ratio may be float; we need to attempt to consume exactly 'ratio' units
[?2004l[?2004h>                     # Save state for rollback if demand fails
[?2004l[?2004h>                     saved_inv = deepcopy(inv)
[?2004l[?2004h>                     saved_wc = deepcopy(wc)
[?2004l[?2004h>                     if demand(sub_id, ratio, saved_inv, saved_wc, batch_sizes):
[?2004l[?2004h>                         # success: commit the change
[?2004l[?2004h>                         inv.update(saved_inv)
[?2004l[?2004h>                         wc.update(saved_wc)
[?2004l[?2004h>                         needed_qty -= 1
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         break  # no more from this sub
[?2004l[?2004h>         # If still needed, fail
[?2004l[?2004h>         return needed_qty == 0
[?2004l[?2004h>     
[?2004l[?2004h>     # 3. Has BOM - manufacture
[?2004l[?2004h>     batch = batch_sizes.get(part_id, 1)
[?2004l[?2004h>     # round up to batch multiple
[?2004l[?2004h>     num_batches = (needed_qty + batch - 1) // batch
[?2004l[?2004h>     build_qty = num_batches * batch
[?2004l[?2004h>     
[?2004l[?2004h>     # Check workcenter capacity
[?2004l[?2004h>     if part_id in routing:
