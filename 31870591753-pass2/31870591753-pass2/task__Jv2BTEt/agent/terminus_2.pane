[?2004l[?2004h> import sqlite3
[?2004l['batch_size']

# Function to compute required child quantity given parent build qty and BOM edge
def child_req(build_qty, qty_per, scrap_rate_pct, setup_scrap_qty):
    base = build_qty * qty_per
    # apply running scrap: multiply by (1 + scrap_rate_pct/100) and round UP
    adj = math.ceil(base * (1 + scrap_rate_pct / 100.0))
    return adj + setup_scrap_qty

# Recursive demand function that modifies state (inv, wc). Returns True if qty can be satisfied.
# It consumes stock, manufactures, adds excess.
def demand(part_id, needed_qty, inv, wc, batch_sizes):
    if needed_qty <= 0:
        return True
    
    # 1. Consume from own stock
    avail_own = inv.get(part_id, 0)
    take = min(needed_qty, avail_own)
    needed_qty -= take
    inv[part_id] = avail_own - take
    
    if needed_qty == 0:
        return True
    
    # 2. If leaf (no BOM), try substitutes
    if part_id not in bom:
        # Try substitutes
        if part_id in substitutes:
            for sub_id, ratio, rank in substitutes[part_id]:
                while needed_qty > 0:
                    # Try to get 'ratio' units of substitute to cover 1 primary unit
                    # We need to check if we can get 'ratio' units of sub_id
                    # But ratio may be float; we need to attempt to consume exactly 'ratio' units
                    # Save state for rollback if demand fails
                    saved_inv = deepcopy(inv)
                    saved_wc = deepcopy(wc)
                    if demand(sub_id, ratio, saved_inv, saved_wc, batch_sizes):
                        # success: commit the change
                        inv.update(saved_inv)
                        wc.update(saved_wc)
                        needed_qty -= 1
                    else:
                        break  # no more from this sub
        # If still needed, fail
        return needed_qty == 0
    
    # 3. Has BOM - manufacture
    batch = batch_sizes.get(part_id, 1)
    # round up to batch multiple
    num_batches = (needed_qty + batch - 1) // batch
    build_qty = num_batches * batch
    
    # Che[?2004h> import json
