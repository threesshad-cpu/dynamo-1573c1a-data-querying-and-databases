[?2004l[?2004h>             if wc.get(wc_id, 0) < hours:
[?2004l[?2004h>                 return False
[?2004l[?2004h>     
[?2004l[?2004h>     # Check child components feasibility before committing
[?2004l[?2004h>     # Save state
[?2004l[?2004h>     saved_inv = deepcopy(inv)
[?2004l[?2004h>     saved_wc = deepcopy(wc)
[?2004l[?2004h>     
