[?2004l[?2004h> 
[?2004l=[?2004h> # Load data
[?2004l[?2004h> cur.execute("SELECT part_id, name, on_hand_qty, batch_size FROM parts")
[?2004l[?2004h> parts_init = {}
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     parts_init[row[0]] = {'name': row[1], 'on_hand': row[2], 'batch_size': row[3]}
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom")
[?2004l[?2004h> bom = {}
[?2004lr[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     parent, child, qty_per, scrap_rate, setup_scrap = row
[?2004l[?2004h>     if parent not in bom:
[?2004l[?2004h>         bom[parent] = []
[?2004l[?2004h>     bom[parent].append((child, qty_per, scrap_rate, setup_scrap))
[?2004l[?2004h> 
[?2004l [?2004h> cur.execute("SELECT workcenter_id, name, available_hours FROM workcenters")
[?2004l[?2004h> workcenters_init = {}
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     workcenters_init[row[0]] = {'name': row[1], 'available': row[2]}
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing")
[?2004l[?2004h> routing = {}
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     parent, wc, setup, run = row
[?2004l[?2004h>     if parent not in routing:
[?2004l[?2004h>         routing[parent] = []
[?2004l [?2004h>     routing[parent].append((wc, setup, run))
[?2004l[?2004h> 
[?2004l[?2004h> cur.execute("SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank")
[?2004l[?2004h> substitutes = {}
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     primary, sub, ratio, rank = row
[?2004l[?2004h>     if primary not in substitutes:
[?2004l[?2004h>         substitutes[primary] = []
[?2004l[?2004h>     substitutes[primary].append((sub, ratio, rank))
[?2004l[?2004h> 
[?2004ld[?2004h> cur.execute("SELECT order_id, product_part_id, requested_qty, priority FROM orders")
[?2004l[?2004h> orders_raw = []
[?2004l[?2004h> for row in cur.fetchall():
[?2004l[?2004h>     orders_raw.append({'order_id': row[0], 'product': row[1], 'requested_qty': row[2], 'priority': row[3]})
[?2004l[?2004h> 
[?2004l[?2004h> conn.close()
