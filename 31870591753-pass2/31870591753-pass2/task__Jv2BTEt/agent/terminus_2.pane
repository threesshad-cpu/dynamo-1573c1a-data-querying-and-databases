[?2004l[?2004h> # Sort orders: priority ASC, ties by order_id DESC
[?2004l[?2004h> orders_sorted = sorted(orders_raw, key=lambda x: x['order_id'], reverse=True)
[?2004l[?2004h> orders_sorted = sorted(orders_sorted, key=lambda x: x['priority'])
[?2004l[?2004h> 
[?2004l[?2004h> # Helper: get batch size for a part
[?2004l[?2004h> def get_batch(part_id):
[?2004l[?2004h>     return parts_init[part_id]['batch_size']
[?2004l[?2004h> 
[?2004l[?2004h> # Function to compute required child quantity given parent build qty and BOM edge
[?2004l[?2004h> def child_req(build_qty, qty_per, scrap_rate_pct, setup_scrap_qty):
[?2004l[?2004h>     base = build_qty * qty_per
[?2004l[?2004h>     # apply running scrap: multiply by (1 + scrap_rate_pct/100) and round UP
[?2004l[?2004h>     adj = math.ceil(base * (1 + scrap_rate_pct / 100.0))
[?2004l[?2004h>     return adj + setup_scrap_qty
[?2004ld[?2004h> 
[?2004le[?2004h> # Recursive demand function that modifies state (inv, wc). Returns True if qty can be satisfied.
[?2004l[?2004h> # It consumes stock, manufactures, adds excess.
[?2004l[?2004h> def demand(part_id, needed_qty, inv, wc, batch_sizes):
[?2004l[?2004h>     if needed_qty <= 0:
[?2004l[?2004h>         return True
[?2004l[?2004h>     
[?2004lh[?2004h>     # 1. Consume from own stock
[?2004l[?2004h>     avail_own = inv.get(part_id, 0)
[?2004l[?2004h>     take = min(needed_qty, avail_own)
[?2004l[?2004h>     needed_qty -= take
[?2004l[?2004h>     inv[part_id] = avail_own - take
[?2004l[?2004h>     
[?2004l[?2004h>     if needed_qty == 0:
[?2004l[?2004h>         return True
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. If leaf (no BOM), try substitutes
