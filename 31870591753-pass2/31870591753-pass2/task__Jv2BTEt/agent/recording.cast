[40.546799, "i", "python3 << 'EOF'\nimport sqlite3\nconn = sqlite3.connect('/app/manufacturing.db')\ncur = conn.cursor()\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\ntables = [r[0] for r in cur.fetchall()]\nprint(\"Tables:\", tables)\nfor t in tables:\n    print(f\"\\n=== {t} ===\")\n    cur.execute(f\"PRAGMA table_info({t})\")\n    cols = cur.fetchall()\n    print(\"Columns:\", [(c[1], c[2]) for c in cols])\n    cur.execute(f\"SELECT * FROM {t}\")\n    rows = cur.fetchall()\n    for r in rows:\n        print(r)\nconn.close()\nEOF\n"]
