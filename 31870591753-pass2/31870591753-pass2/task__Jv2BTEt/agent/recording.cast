[298.388778, "i", " hours\n    \n    # Add excess production to inventory\n    excess = build_qty - needed_qty\n    if excess > 0:\n        inv[part_id] = inv.get(part_id, 0) + excess\n    \n    return True\n\n# Now process orders\ninv_current = {pid: parts_init[pid]['on_hand'] for pid in parts_init}\nwc_current = {wid: workcenters_init[wid]['available'] for wid in workcenters_init}\nbatch_sizes = {pid: parts_init[pid]['batch_size'] for pid in parts_init}\n\nresults = []\n\nfor order in orders_sorted:\n    oid = order['order_id']\n    product = order['product']\n    requested = order['requested_qty']\n    batch = get_batch(product)\n    \n    # Save state before this order for limiting resource calculation\n    state_before_inv = deepcopy(inv_current)\n    state_before_wc = deepcopy(wc_current)\n    \n    # Determine max allocatable qty (multiple of batch_size)\n    max_k = 0\n    # Try candidates from highest down? Or linear from 0 up.\n    # Since requested could be up to maybe 30, we can try all multiples.\n    for k in range(0, requested + 1, batch):\n  "]
