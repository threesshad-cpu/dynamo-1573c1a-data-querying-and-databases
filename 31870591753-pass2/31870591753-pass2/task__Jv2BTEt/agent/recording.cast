[298.408559, "o", "        # If still needed, fail\r\n\u001b[?2004l\r"]
[298.408591, "o", "\u001b[?2004h> "]
[298.40873, "o", "        return needed_qty == 0\r\n\u001b[?2004l\r"]
[298.408813, "o", "\u001b[?2004h> "]
[298.408851, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.408979, "o", "    # 3. Has BOM - manufacture\r\n\u001b[?2004l\r"]
[298.409008, "o", "\u001b[?2004h> "]
[298.40917, "o", "    batch = batch_sizes.get(part_id, 1)\r\n\u001b[?2004l\r"]
[298.409212, "o", "\u001b[?2004h> "]
[298.409356, "o", "    # round up to batch multiple\r\n\u001b[?2004l\r"]
[298.409393, "o", "\u001b[?2004h> "]
[298.40959, "o", "    num_batches = (needed_qty + batch - 1) // batch\r\n\u001b[?2004l\r"]
[298.409619, "o", "\u001b[?2004h> "]
[298.409781, "o", "    build_qty = num_batches * batch\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.409803, "o", "> "]
[298.409843, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.409994, "o", "    # Check workcenter capacity\r\n\u001b[?2004l\r"]
[298.410022, "o", "\u001b[?2004h> "]
[298.41014, "o", "    if part_id in routing:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.410172, "o", "> "]
[298.41037, "o", "        for wc_id, setup, run in routing[part_id]:\r\n\u001b[?2004l\r"]
[298.410394, "o", "\u001b[?2004h"]
[298.41043, "o", "> "]
[298.410584, "o", "            hours = setup + build_qty * run\r\n\u001b[?2004l\r"]
[298.410598, "o", "\u001b[?2004h"]
[298.410635, "o", "> "]
[298.410772, "o", "            if wc.get(wc_id, 0) < hours:\r\n\u001b[?2004l\r"]
[298.410785, "o", "\u001b[?2004h"]
[298.41082, "o", "> "]
[298.410921, "o", "                return False\r\n\u001b[?2004l\r"]
[298.41095, "o", "\u001b[?2004h> "]
[298.410987, "o", "    \r\n\u001b[?2004l\r"]
[298.411021, "o", "\u001b[?2004h> "]
[298.411265, "o", "    # Check child components feasibility before committing\r\n\u001b[?2004l\r"]
[298.411295, "o", "\u001b[?2004h> "]
[298.411368, "o", "    # Save state\r\n\u001b[?2004l\r"]
[298.411396, "o", "\u001b[?2004h> "]
[298.411526, "o", "    saved_inv = deepcopy(inv)\r\n\u001b[?2004l\r"]
[298.411555, "o", "\u001b[?2004h> "]
[298.411692, "o", "    saved_wc = deepcopy(wc)\r\n\u001b[?2004l\r"]
[298.41172, "o", "\u001b[?2004h> "]
[298.411758, "o", "    \r\n\u001b[?2004l\r"]
[298.411799, "o", "\u001b[?2004h> "]
[298.412016, "o", "    # For each child, compute required quantity and demand it\r\n\u001b[?2004l\r"]
[298.412046, "o", "\u001b[?2004h> "]
[298.412304, "o", "    for child, qty_per, scrap_rate, setup_scrap in bom[part_id]:\r\n\u001b[?2004l\r"]
[298.412337, "o", "\u001b[?2004h> "]
[298.412612, "o", "        req = child_req(build_qty, qty_per, scrap_rate, setup_scrap)\r\n\u001b[?2004l\r"]
[298.412646, "o", "\u001b[?2004h> "]
[298.412854, "o", "        if not demand(child, req, inv, wc, batch_sizes):\r\n\u001b[?2004l\r"]
[298.41289, "o", "\u001b[?2004h> "]
[298.413011, "o", "            # Rollback\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.413126, "o", "            inv.clear()\r\n\u001b[?2004l\r"]
[298.413166, "o", "\u001b[?2004h"]
[298.413197, "o", "> "]
[298.41332, "o", "            inv.update(saved_inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.413428, "o", "            wc.clear()\r\n\u001b[?2004l\r"]
[298.413456, "o", "\u001b[?2004h> "]
[298.413597, "o", "            wc.update(saved_wc)\r\n\u001b[?2004l\r"]
[298.413626, "o", "\u001b[?2004h> "]
[298.413738, "o", "            return False\r\n\u001b[?2004l\r"]
[298.413767, "o", "\u001b[?2004h> "]
[298.413804, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.413824, "o", "> "]
[298.414035, "o", "    # Deduct workcenter hours (after children success)\r\n\u001b[?2004l\r"]
[298.414066, "o", "\u001b[?2004h"]
[298.414102, "o", "> "]
[298.414188, "o", "    if part_id in routing:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.414235, "o", "> "]
[298.414414, "o", "        for wc_id, setup, run in routing[part_id]:\r\n\u001b[?2004l\r"]
[298.414444, "o", "\u001b[?2004h> "]
[298.414628, "o", "            hours = setup + build_qty * run\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.414664, "o", "> "]
[298.414786, "o", "            wc[wc_id] -= hours\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.414816, "o", "> "]
[298.414853, "o", "    \r\n\u001b[?2004l\r"]
[298.414873, "o", "\u001b[?2004h> "]
[298.415035, "o", "    # Add excess production to inventory\r\n\u001b[?2004l\r"]
[298.415064, "o", "\u001b[?2004h> "]
[298.415211, "o", "    excess = build_qty - needed_qty\r\n\u001b[?2004l\r"]
[298.415243, "o", "\u001b[?2004h> "]
[298.415326, "o", "    if excess > 0:\r\n\u001b[?2004l\r"]
[298.41537, "o", "\u001b[?2004h> "]
[298.41557, "o", "        inv[part_id] = inv.get(part_id, 0) + excess\r\n\u001b[?2004l\r"]
[298.415604, "o", "\u001b[?2004h> "]
[298.41564, "o", "    \r\n\u001b[?2004l\r"]
[298.415669, "o", "\u001b[?2004h> "]
[298.415736, "o", "    return True\r\n\u001b[?2004l\r"]
[298.415776, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[298.41581, "o", "\u001b[?2004h> "]
[298.415897, "o", "# Now process orders\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.415925, "o", "> "]
[298.416187, "o", "inv_current = {pid: parts_init[pid]['on_hand'] for pid in parts_init}\r\n\u001b[?2004l\r"]
[298.416233, "o", "\u001b[?2004h> "]
[298.416596, "o", "wc_current = {wid: workcenters_init[wid]['available'] for wid in workcenters_init}\r\n\u001b[?2004l\r"]
[298.416626, "o", "\u001b[?2004h> "]
[298.417, "o", "batch_sizes = {pid: parts_init[pid]['batch_size'] for pid in parts_init}\r\n\u001b[?2004l\r"]
[298.417019, "o", "\u001b[?2004h> \r\n"]
[298.417044, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[298.417119, "o", "results = []\r\n\u001b[?2004l\r"]
[298.417155, "o", "\u001b[?2004h> "]
[298.417176, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[298.417325, "o", "for order in orders_sorted:\r\n\u001b[?2004l\r"]
[298.417353, "o", "\u001b[?2004h> "]
[298.41748, "o", "    oid = order['order_id']\r\n\u001b[?2004l\r"]
[298.417518, "o", "\u001b[?2004h> "]
[298.41765, "o", "    product = order['product']\r\n\u001b[?2004l\r"]
[298.41768, "o", "\u001b[?2004h> "]
[298.417863, "o", "    requested = order['requested_qty']\r\n\u001b[?2004l\r"]
[298.417893, "o", "\u001b[?2004h> "]
[298.418028, "o", "    batch = get_batch(product)\r\n\u001b[?2004l\r"]
[298.418068, "o", "\u001b[?2004h"]
[298.4181, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.41838, "o", "    # Save state before this order for limiting resource calculation\r\n\u001b[?2004l\r"]
[298.418416, "o", "\u001b[?2004h> "]
[298.418598, "o", "    state_before_inv = deepcopy(inv_current)\r\n\u001b[?2004l\r"]
[298.418627, "o", "\u001b[?2004h> "]
[298.418797, "o", "    state_before_wc = deepcopy(wc_current)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.418827, "o", "> "]
[298.418863, "o", "    \r\n\u001b[?2004l\r"]
[298.418898, "o", "\u001b[?2004h> "]
[298.419122, "o", "    # Determine max allocatable qty (multiple of batch_size)\r\n\u001b[?2004l\r"]
[298.419152, "o", "\u001b[?2004h> "]
[298.419244, "o", "    max_k = 0\r\n\u001b[?2004l\re\u001b[?2004h"]
[298.419279, "o", "> "]
[298.419557, "o", "    # Try candidates from highest down? Or linear from 0 up.\r\n\u001b[?2004l\r"]
[298.419593, "o", "\u001b[?2004h> "]
[298.41987, "o", "    # Since requested could be up to maybe 30, we can try all multiples.\r\n\u001b[?2004l\r"]
[298.419884, "o", "\u001b[?2004h> "]
[298.420075, "o", "    for k in range(0, requested + 1, batch):\r\n\u001b[?2004l\r"]
[298.420089, "o", "\u001b[?2004h> "]
[298.420197, "o", "        if k == 0:\r\n\u001b[?2004l\rr\u001b[?2004h"]
[298.420233, "o", "> "]
[298.420335, "o", "            max_k = 0\r\n\u001b[?2004l\r"]
[298.42037, "o", "\u001b[?2004h> "]
[298.420465, "o", "            continue\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[298.420499, "o", "> "]
[298.420713, "o", "        # Test feasibility with a copy of current state\r\n\u001b[?2004l\r"]
[298.420755, "o", "\u001b[?2004h"]
[298.420793, "o", "> "]
[298.420897, "o", "        test_inv = deepcopy(inv_current)\r\n\u001b[?2004l\r"]
[298.420933, "o", "\u001b[?2004h> "]
[298.421056, "o", "        test_wc = deepcopy(wc_current)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.421086, "o", "> "]
[298.421292, "o", "        if demand(product, k, test_inv, test_wc, batch_sizes):\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.421328, "o", "> "]
[298.421399, "o", "            max_k = k\r\n\u001b[?2004l\r"]
[298.421434, "o", "\u001b[?2004h"]
[298.421455, "o", "> "]
[298.421487, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.421525, "o", "> "]
[298.422806, "o", "            break  # larger k won't be feasible either (since more demand can't be easier? Actually rounding might cause non-monotonic? But generally more demand is harder. However, due to batch rounding, it's possible that k=4 is infeasible but k=8 is feasible? Unlikely but possible if batch_size causes different child quantities? But we break early for efficiency; to be safe we could test all, but breaking is typical.\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.422856, "o", "> "]
[298.422893, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.422962, "o", "    # Now commit max_k\r\n\u001b[?2004l\r"]
[298.423004, "o", "\u001b[?2004h> "]
[298.423123, "o", "    shortfall = requested - max_k\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.423153, "o", ">     "]
[298.42321, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.423241, "o", "> "]
[298.423311, "o", "    # Commit allocation\r\n\u001b[?2004l\r"]
[298.423349, "o", "\u001b[?2004h"]
[298.423375, "o", "> "]
[298.423408, "o", "    if max_k > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.423444, "o", "> "]
[298.423695, "o", "        success = demand(product, max_k, inv_current, wc_current, batch_sizes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.423725, "o", "> "]
[298.423805, "o", "        if not success:\r\n\u001b[?2004l\r"]
[298.423834, "o", "\u001b[?2004h> "]
[298.42406, "o", "            print(f\"ERROR: Could not commit {max_k} for order {oid}\")\r\n\u001b[?2004l\r"]
[298.424076, "o", "\u001b[?2004h> "]
[298.424165, "o", "            max_k = 0\r\n\u001b[?2004l\r"]
[298.424186, "o", "\u001b[?2004h> "]
[298.42432, "o", "            shortfall = requested\r\n\u001b[?2004l\r"]
[298.424336, "o", "\u001b[?2004h> "]
[298.424362, "o", "    \r\n\u001b[?2004l\r"]
[298.424408, "o", "\u001b[?2004h> "]
[298.424563, "o", "    # Determine limiting resource if shortfall > 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.424579, "o", "> "]
[298.424652, "o", "    limiting = None\r\n\u001b[?2004l\r"]
[298.424683, "o", "\u001b[?2004h> "]
[298.424745, "o", "    if shortfall > 0:\r\n\u001b[?2004l\r"]
[298.424783, "o", "\u001b[?2004h> "]
[298.424878, "o", "        target_qty = max_k + batch\r\n\u001b[?2004l\r"]
[298.424909, "o", "\u001b[?2004h> "]
[298.425088, "o", "        # Simulate explosion for target_qty from state_before\r\n\u001b[?2004l\r"]
[298.425118, "o", "\u001b[?2004h> "]
[298.425259, "o", "        test_inv = deepcopy(state_before_inv)\r\n\u001b[?2004l\r"]
[298.425297, "o", "\u001b[?2004h> "]
[298.425418, "o", "        test_wc = deepcopy(state_before_wc)\r\n\u001b[?2004l\r"]
[298.425448, "o", "\u001b[?2004h> "]
[298.425484, "o", "        \r\n\u001b[?2004l\r"]
[298.425521, "o", "\u001b[?2004h> "]
[298.42568, "o", "        # We need to compute required for each resource.\r\n\u001b[?2004l\r"]
[298.425717, "o", "\u001b[?2004h> "]
[298.425943, "o", "        # We'll run a modified explosion that tracks requirements vs available.\r\n\u001b[?2004l\r"]
[298.425974, "o", "\u001b[?2004h> "]
[298.426211, "o", "        # We need to get required amounts of leaf components and workcenters.\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.426242, "o", "> "]
[298.426348, "o", "        # Let's compute recursively.\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.426383, "o", "> "]
[298.426418, "o", "        \r\n\u001b[?2004l\r"]
[298.426449, "o", "\u001b[?2004h> "]
[298.426637, "o", "        # We'll define a function that, given target qty, returns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.426653, "o", "> "]
[298.426788, "o", "        # - required hours per workcenter\r\n\u001b[?2004l\r"]
[298.426825, "o", "\u001b[?2004h> "]
[298.427012, "o", "        # - required qty per leaf component (gross after netting)\r\n\u001b[?2004l\r"]
[298.427047, "o", "\u001b[?2004h> "]
[298.427258, "o", "        # - available qty per leaf component (including substitutes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.427308, "o", "> "]
[298.427518, "o", "        # We'll run a non-mutating version that just computes these numbers.\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.427555, "o", "> "]
[298.427572, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.427613, "o", "> "]
[298.427842, "o", "        # Actually, we can run the demand on a copy and track what was consumed.\r\n\u001b[?2004l\r"]
[298.42788, "o", "\u001b[?2004h> "]
[298.428161, "o", "        # But the requirement for limiting resource is: what would be needed to build target_qty,\r\n\u001b[?2004l\r"]
[298.428208, "o", "\u001b[?2004h> "]
[298.428384, "o", "        # not necessarily what the current state can satisfy.\r\n\u001b[?2004l\r"]
[298.4284, "o", "\u001b[?2004h> "]
[298.428552, "o", "        # The ratio is available / required.\r\n\u001b[?2004l\r"]
[298.428569, "o", "\u001b[?2004h> "]
[298.428782, "o", "        # \"required\" is gross req after netting of sub-assemblies.\r\n\u001b[?2004l\r"]
[298.42882, "o", "\u001b[?2004h> "]
[298.429045, "o", "        # \"available\" for leaf components includes its own stock + substitutes.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.429101, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.429138, "o", "> "]
[298.429384, "o", "        # Let's implement a function that computes, for a given demand of a part,\r\n\u001b[?2004l\r"]
[298.42942, "o", "\u001b[?2004h> "]
[298.429657, "o", "        # the required leaf components and workcenter hours, assuming we consume\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.429672, "o", "> "]
[298.429952, "o", "        # available stock of that part and its sub-assemblies (but not necessarily leaves? \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.429987, "o", "> "]
[298.430211, "o", "        # Actually we net ALL available stock before computing requirements.\r\n\u001b[?2004l\r"]
[298.430228, "o", "\u001b[?2004h> "]
[298.430526, "o", "        # So we need to run the netting process: start with demand of target_qty of product.\r\n\u001b[?2004l\r"]
[298.430543, "o", "\u001b[?2004h> "]
[298.430674, "o", "        # Recursively, for each part:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.430803, "o", "        # - Consume from its stock.\r\n\u001b[?2004l\r"]
[298.430837, "o", "\u001b[?2004h> "]
[298.431139, "o", "        # - If net > 0, we need to manufacture. This generates child requirements and workcenter hours.\r\n\u001b[?2004l\r"]
[298.431172, "o", "\u001b[?2004h> "]
[298.432747, "o", "        # - The \"required\" for a leaf component is the net amount needed after consuming its stock (but before substitutes? The spec says \"include available substitute stock in the available supply\" for leaves, so for leaves, available = own stock + substitute stock; required = what's needed after consuming all available stock? Actually \"required\" is the gross requirement after netting out available stock of parent sub-assemblies. For leaf components, we compare available to required. If required > available, ratio < 1.\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.432763, "o", "> "]
[298.43334, "o", "        # So we compute required amount of each leaf (the amount we would need to consume from that leaf's stock + substitutes). Then available = leaf own stock + available from substitutes.\r\n\u001b[?2004l\r"]
[298.433354, "o", "\u001b[?2004h> "]
[298.433394, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.433415, "o", "> "]
[298.433616, "o", "        pass  # placeholder for now; we'll implement properly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[298.433657, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[298.433673, "o", "> "]
[298.433755, "o", "    results.append({\r\n\u001b[?2004l\r"]
[298.433775, "o", "\u001b[?2004h> "]
[298.433851, "o", "        'order_id': oid,\r\n\u001b[?2004l\r"]
[298.433865, "o", "\u001b[?2004h> "]
[298.433975, "o", "        'allocated_qty': max_k,\r\n\u001b[?2004l\r"]
[298.434009, "o", "\u001b[?2004h> "]
[298.434109, "o", "        'shortfall_qty': shortfall,\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.434123, "o", "> "]
[298.434259, "o", "        'limiting_resource': limiting\r\n\u001b[?2004l\r"]
[298.434273, "o", "\u001b[?2004h> "]
[298.434314, "o", "    })\r\n\u001b[?2004l\r"]
[298.434348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[298.434382, "o", "\u001b[?2004h> "]
[298.434474, "o", "# Sort results by order_id ascending\r\n\u001b[?2004l\r"]
[298.434511, "o", "\u001b[?2004h"]
[298.434545, "o", "> "]
[298.434634, "o", "results.sort(key=lambda x: x['order_id'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.434668, "o", "> \r\n\u001b[?2004l\r"]
[298.434701, "o", "\u001b[?2004h> "]
[298.434812, "o", "with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[298.434826, "o", "\u001b[?2004h> "]
[298.434987, "o", "    json.dump({'orders': results}, f, indent=2)\r\n\u001b[?2004l\r"]
[298.435021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[298.435055, "o", "\u001b[?2004h> "]
[298.435083, "o", "print(\"Done\")\r\n\u001b[?2004l\r"]
[298.435117, "o", "\u001b[?2004h> "]
[298.435165, "o", "for r in results:\r\n\u001b[?2004l\r"]
[298.435178, "o", "\u001b[?2004h> "]
[298.455568, "o", "    print(r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[298.455582, "o", "> "]
[298.455617, "o", "PYEOF\r\n\u001b[?2004l\r"]
[298.457571, "o", "\u001b[?2004hroot@ea82b326-ba51-4f3b-918d-1fc23a9e41c2:/app# "]
[298.457699, "o", "echo \"Script written. Now running...\"\r\n\u001b[?2004l\r"]
