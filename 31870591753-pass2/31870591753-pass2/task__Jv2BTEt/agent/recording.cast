[152.085301, "i", "cat > /app/solve.py << 'PYEOF'\nimport sqlite3\nimport json\nimport math\nfrom copy import deepcopy\n\n# Connect to DB\nconn = sqlite3.connect('/app/manufacturing.db')\ncur = conn.cursor()\n\n# Load data into dictionaries\ndef load_data():\n    cur.execute(\"SELECT part_id, name, on_hand_qty, batch_size FROM parts\")\n    parts = {}\n    for row in cur.fetchall():\n        parts[row[0]] = {'name': row[1], 'on_hand': row[2], 'batch_size': row[3]}\n    \n    cur.execute(\"SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom\")\n    bom = {}  # parent -> list of (child, qty_per, scrap_rate, setup_scrap)\n    for row in cur.fetchall():\n        parent, child, qty_per, scrap_rate, setup_scrap = row\n        if parent not in bom:\n            bom[parent] = []\n        bom[parent].append((child, qty_per, scrap_rate, setup_scrap))\n    \n    cur.execute(\"SELECT workcenter_id, name, available_hours FROM workcenters\")\n    workcenters = {}\n    for row in cur.fetchall():\n        workcenters[row[0]] = {'name': row[1"]
[152.085446, "i", "], 'available': row[2]}\n    \n    cur.execute(\"SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing\")\n    routing = {}  # parent -> list of (wc_id, setup_hours, run_hours_per_unit)\n    for row in cur.fetchall():\n        parent, wc, setup, run = row\n        if parent not in routing:\n            routing[parent] = []\n        routing[parent].append((wc, setup, run))\n    \n    cur.execute(\"SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank\")\n    substitutes = {}  # primary -> list of (sub, qty_ratio, rank)\n    for row in cur.fetchall():\n        primary, sub, ratio, rank = row\n        if primary not in substitutes:\n            substitutes[primary] = []\n        substitutes[primary].append((sub, ratio, rank))\n    \n    cur.execute(\"SELECT order_id, product_part_id, requested_qty, priority FROM orders\")\n    orders = []\n    for row in cur.fetchall():\n        orders.append({'order_id': row[0], 'product': row[1], 're"]
[152.08549, "o", "cat > /app/solve.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[152.085511, "i", "quested_qty': row[2], 'priority': row[3]})\n    \n    return parts, bom, workcenters, routing, substitutes, orders\n\nparts, bom, workcenters, routing, substitutes, orders = load_data()\n\n# Sort orders: priority ASC, then order_id DESC for ties\norders_sorted = sorted(orders, key=lambda x: (x['priority'], -hash(x['order_id'])))\n# Actually need order_id DESCENDING string comparison? Let's sort by priority ASC, then by order_id string DESCENDING\norders_sorted = sorted(orders, key=lambda x: (x['priority'], [-ord(c) for c in x['order_id']]))\n# Better: Python's sort is stable, we can sort by order_id descending first, then by priority ascending\norders_sorted = sorted(orders, key=lambda x: x['order_id'], reverse=True)\norders_sorted = sorted(orders_sorted, key=lambda x: x['priority'])\n\nprint(\"Orders in processing order:\")\nfor o in orders_sorted:\n    print(f\"  {o['order_id']}: product={o['product']}, qty={o['requested_qty']}, priority={o['priority']}\")\n\nconn.close()\nPYEOF\npython3 /app/solve.py\n"]
