[298.388296, "i", "cat > /app/solve.py << 'PYEOF'\nimport sqlite3\nimport json\nimport math\nfrom copy import deepcopy\n\nconn = sqlite3.connect('/app/manufacturing.db')\ncur = conn.cursor()\n\n# Load data\ncur.execute(\"SELECT part_id, name, on_hand_qty, batch_size FROM parts\")\nparts_init = {}\nfor row in cur.fetchall():\n    parts_init[row[0]] = {'name': row[1], 'on_hand': row[2], 'batch_size': row[3]}\n\ncur.execute(\"SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom\")\nbom = {}\nfor row in cur.fetchall():\n    parent, child, qty_per, scrap_rate, setup_scrap = row\n    if parent not in bom:\n        bom[parent] = []\n    bom[parent].append((child, qty_per, scrap_rate, setup_scrap))\n\ncur.execute(\"SELECT workcenter_id, name, available_hours FROM workcenters\")\nworkcenters_init = {}\nfor row in cur.fetchall():\n    workcenters_init[row[0]] = {'name': row[1], 'available': row[2]}\n\ncur.execute(\"SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing\")\nrouting = {}\nfor row in cur.fetchall():"]
[298.388495, "i", "\n    parent, wc, setup, run = row\n    if parent not in routing:\n        routing[parent] = []\n    routing[parent].append((wc, setup, run))\n\ncur.execute(\"SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank\")\nsubstitutes = {}\nfor row in cur.fetchall():\n    primary, sub, ratio, rank = row\n    if primary not in substitutes:\n        substitutes[primary] = []\n    substitutes[primary].append((sub, ratio, rank))\n\ncur.execute(\"SELECT order_id, product_part_id, requested_qty, priority FROM orders\")\norders_raw = []\nfor row in cur.fetchall():\n    orders_raw.append({'order_id': row[0], 'product': row[1], 'requested_qty': row[2], 'priority': row[3]})\n\nconn.close()\n\n# Sort orders: priority ASC, ties by order_id DESC\norders_sorted = sorted(orders_raw, key=lambda x: x['order_id'], reverse=True)\norders_sorted = sorted(orders_sorted, key=lambda x: x['priority'])\n\n# Helper: get batch size for a part\ndef get_batch(part_id):\n    return parts_init[part_id]"]
[298.38854, "o", "cat > /app/solve.py << 'PYEOF'\r\n\u001b[?2004l\r"]
[298.388578, "i", "['batch_size']\n\n# Function to compute required child quantity given parent build qty and BOM edge\ndef child_req(build_qty, qty_per, scrap_rate_pct, setup_scrap_qty):\n    base = build_qty * qty_per\n    # apply running scrap: multiply by (1 + scrap_rate_pct/100) and round UP\n    adj = math.ceil(base * (1 + scrap_rate_pct / 100.0))\n    return adj + setup_scrap_qty\n\n# Recursive demand function that modifies state (inv, wc). Returns True if qty can be satisfied.\n# It consumes stock, manufactures, adds excess.\ndef demand(part_id, needed_qty, inv, wc, batch_sizes):\n    if needed_qty <= 0:\n        return True\n    \n    # 1. Consume from own stock\n    avail_own = inv.get(part_id, 0)\n    take = min(needed_qty, avail_own)\n    needed_qty -= take\n    inv[part_id] = avail_own - take\n    \n    if needed_qty == 0:\n        return True\n    \n    # 2. If leaf (no BOM), try substitutes\n    if part_id not in bom:\n        # Try substitutes\n        if part_id in substitutes:\n            for sub_id, ratio, rank in substitutes[part_id]:"]
[298.388613, "o", "\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r['batch_size']\r\n"]
[298.388645, "i", "\n                while needed_qty > 0:\n                    # Try to get 'ratio' units of substitute to cover 1 primary unit\n                    # We need to check if we can get 'ratio' units of sub_id\n                    # But ratio may be float; we need to attempt to consume exactly 'ratio' units\n                    # Save state for rollback if demand fails\n                    saved_inv = deepcopy(inv)\n                    saved_wc = deepcopy(wc)\n                    if demand(sub_id, ratio, saved_inv, saved_wc, batch_sizes):\n                        # success: commit the change\n                        inv.update(saved_inv)\n                        wc.update(saved_wc)\n                        needed_qty -= 1\n                    else:\n                        break  # no more from this sub\n        # If still needed, fail\n        return needed_qty == 0\n    \n    # 3. Has BOM - manufacture\n    batch = batch_sizes.get(part_id, 1)\n    # round up to batch multiple\n    num_batches = (needed_qty + batch - 1) // batch\n    b"]
[298.388661, "o", "\r\n# Function to compute required child quantity given parent build qty and BOM edge\r\ndef child_req(build_qty, qty_per, scrap_rate_pct, setup_scrap_qty):\r\n    base = build_qty * qty_per\r\n    # apply running scrap: multiply by (1 + scrap_rate_pct/100) and round UP\r\n    a"]
[298.388709, "i", "uild_qty = num_batches * batch\n    \n    # Check workcenter capacity\n    if part_id in routing:\n        for wc_id, setup, run in routing[part_id]:\n            hours = setup + build_qty * run\n            if wc.get(wc_id, 0) < hours:\n                return False\n    \n    # Check child components feasibility before committing\n    # Save state\n    saved_inv = deepcopy(inv)\n    saved_wc = deepcopy(wc)\n    \n    # For each child, compute required quantity and demand it\n    for child, qty_per, scrap_rate, setup_scrap in bom[part_id]:\n        req = child_req(build_qty, qty_per, scrap_rate, setup_scrap)\n        if not demand(child, req, inv, wc, batch_sizes):\n            # Rollback\n            inv.clear()\n            inv.update(saved_inv)\n            wc.clear()\n            wc.update(saved_wc)\n            return False\n    \n    # Deduct workcenter hours (after children success)\n    if part_id in routing:\n        for wc_id, setup, run in routing[part_id]:\n            hours = setup + build_qty * run\n            wc[wc_id] -="]
