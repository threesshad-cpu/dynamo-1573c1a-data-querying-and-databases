OM orders")\n    orders = []\n    for row in cur.fetchall():\n        orders.append({\'order_id\': row[0], \'product\': row[1], \'requested_qty\': row[2], \'priority\': row[3]})\n    \n    return parts, bom, workcenters, routing, substitutes, orders\n\nparts, bom, workcenters, routing, substitutes, orders = load_data()\n\n# Sort orders: priority ASC, then order_id DESC for ties\norders_sorted = sorted(orders, key=lambda x: (x[\'priority\'], -hash(x[\'order_id\'])))\n# Actually need order_id DESCENDING string comparison? Let\'s sort by priority ASC, then by order_id string DESCENDING\norders_sorted = sorted(orders, key=lambda x: (x[\'priority\'], [-ord(c) for c in x[\'order_id\']]))\n# Better: Python\'s sort is stable, we can sort by order_id descending first, then by priority ascending\norders_sorted = sorted(orders, key=lambda x: x[\'order_id\'], reverse=True)\norders_sorted = sorted(orders_sorted, key=lambda x: x[\'priority\'])\n\nprint("Orders in processing order:")\nfor o in orders_sorted:\n    print(f"  {o[\'order_id\']}: product={o[\'product\']}, qty={o[\'requested_qty\']}, priority={o[\'priority\']}")\n\nconn.close()\nPYEOF\npython3 /app/solve.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
