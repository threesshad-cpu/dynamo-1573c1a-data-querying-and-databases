[88.228909, "i", "python3 - <<'PY'\nimport sqlite3\nconn=sqlite3.connect('/app/manufacturing.db')\ncur=conn.cursor()\nfor table in ['parts','bom','workcenters','routing','substitutes','orders']:\n    cur.execute(f'SELECT COUNT(*) FROM {table}')\n    print(f'COUNT {table}:', cur.fetchone()[0])\nprint('\\nALL PARTS')\ncur.execute('SELECT * FROM parts ORDER BY part_id')\nfor r in cur.fetchall():\n    print(r)\nprint('\\nALL BOM')\ncur.execute('SELECT * FROM bom ORDER BY parent_part_id,child_part_id')\nfor r in cur.fetchall():\n    print(r)\nprint('\\nALL WORKCENTERS')\ncur.execute('SELECT * FROM workcenters ORDER BY workcenter_id')\nfor r in cur.fetchall():\n    print(r)\nprint('\\nALL ROUTING')\ncur.execute('SELECT * FROM routing ORDER BY parent_part_id,workcenter_id')\nfor r in cur.fetchall():\n    print(r)\nprint('\\nALL SUBSTITUTES')\ncur.execute('SELECT * FROM substitutes ORDER BY primary_part_id,preference_rank,substitute_part_id')\nfor r in cur.fetchall():\n    print(r)\nprint('\\nALL ORDERS')\ncur.execute('SELECT * FROM orders ORDER BY priority, order_id "]
[88.228988, "i", "DESC')\nfor r in cur.fetchall():\n    print(r)\n# detect child parts not in parts\ncur.execute('SELECT DISTINCT child_part_id FROM bom')\nchildren={r[0] for r in cur.fetchall()}\ncur.execute('SELECT part_id FROM parts')\npart_ids={r[0] for r in cur.fetchall()}\nprint('\\nBOM children missing from parts:', sorted(children-part_ids))\ncur.execute('SELECT DISTINCT parent_part_id FROM bom')\nparents={r[0] for r in cur.fetchall()}\nprint('BOM parents missing from parts:', sorted(parents-part_ids))\ncur.execute('SELECT DISTINCT substitute_part_id FROM substitutes')\nsubs={r[0] for r in cur.fetchall()}\nprint('Substitutes missing from parts:', sorted(subs-part_ids))\ncur.execute('SELECT DISTINCT primary_part_id FROM substitutes')\nprims={r[0] for r in cur.fetchall()}\nprint('Sub primary missing from parts:', sorted(prims-part_ids))\nconn.close()\nPY\n"]
