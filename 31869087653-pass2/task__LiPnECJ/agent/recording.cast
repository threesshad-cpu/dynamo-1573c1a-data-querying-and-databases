[459.506305, "i", "python3 - <<'PY'\nimport sqlite3, math, copy\nfrom collections import defaultdict\n\nDB='/app/manufacturing.db'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts={}\ncur.execute('SELECT * FROM parts')\nfor r in cur.fetchall():\n    d=dict(r); parts[d['part_id']]=dict(d)\n\nbom=defaultdict(list)\ncur.execute('SELECT * FROM bom')\nfor r in cur.fetchall():\n    d=dict(r); bom[d['parent_part_id']].append(d)\n\nworkcenters={}\ncur.execute('SELECT * FROM workcenters')\nfor r in cur.fetchall():\n    d=dict(r); workcenters[d['workcenter_id']]=float(d['available_hours'])\n\nrouting=defaultdict(list)\ncur.execute('SELECT * FROM routing')\nfor r in cur.fetchall():\n    d=dict(r); routing[d['parent_part_id']].append(d)\n\nsubs=defaultdict(list)\ncur.execute('SELECT * FROM substitutes ORDER BY primary_part_id,preference_rank,substitute_part_id')\nfor r in cur.fetchall():\n    d=dict(r); subs[d['primary_part_id']].append(d)\n\norders=[]\ncur.execute('SELECT * FROM orders ORDER BY priority ASC, order_id DESC')\nfor r in cur.f"]
[459.506371, "i", "etchall():\n    d=dict(r); orders.append(d)\nconn.close()\n\n# topological order parent-before-child\nindeg={p:0 for p in parts}\ngraph=defaultdict(set)\nfor p, edges in bom.items():\n    for e in edges:\n        child=e['child_part_id']\n        graph[p].add(child)\nfor p in parts:\n    for c in graph.get(p,[]):\n        indeg[c]+=1\nqueue=sorted([p for p in parts if indeg[p]==0])\ntopo=[]\nwhile queue:\n    p=queue.pop(0)\n    topo.append(p)\n    for c in sorted(graph.get(p,[])):\n        indeg[c]-=1\n        if indeg[c]==0:\n            queue.append(c)\n            queue.sort()\nprint('topo len',len(topo), 'parts',len(parts))\nprint('topo first 15', topo[:15])\n\ndef simulate_build(product, target, init_inv, init_wc):\n    inv=dict(init_inv)\n    wc=dict(init_wc)\n    demands=defaultdict(int)\n    demands[product]=target\n    for p in topo:\n        qty=demands.get(p,0)\n        if qty<=0:\n            continue\n        demands[p]=0\n        avail=inv[p]\n        consume=min(qty,avail)\n        inv[p]=avail-consume\n        rem=qty-consume\n     "]
[459.506521, "i", "   if rem<=0:\n            continue\n        if p in bom:\n            batch=parts[p]['batch_size']\n            build_qty=math.ceil(rem/batch - 1e-12)*batch\n            # routing\n            for rt in routing[p]:\n                wid=rt['workcenter_id']\n                hrs=rt['setup_hours'] + build_qty*rt['run_hours_per_unit']\n                if hrs > wc[wid] + 1e-9:\n                    return None\n                wc[wid] -= hrs\n            # child reqs\n            for b in bom[p]:\n                child=b['child_part_id']\n                base=b['qty_per']*build_qty\n                adj=math.ceil(base*(1.0 + b['scrap_rate_pct']/100.0) - 1e-12) + b['setup_scrap_qty']\n                demands[child] += adj\n            if build_qty > rem:\n                inv[p] += build_qty - rem\n        else:\n            for s in subs.get(p,[]):\n                sub_id=s['substitute_part_id']\n                ratio=s['qty_ratio']\n                if ratio <= 0:\n                    continue\n                cover=int(inv[sub_id] // ratio) "]
[459.50658, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[459.506654, "i", "if inv[sub_id] >= 0 else 0\n                take=min(rem,cover)\n                if take<=0:\n                    continue\n                inv[sub_id] -= take*ratio\n                rem -= take\n                if rem<=0:\n                    break\n            if rem > 1e-12:\n                return None\n    for p in topo:\n        if demands[p] > 1e-12:\n            return None\n    return (inv,wc)\n\ncurrent_inv={p: float(parts[p]['on_hand_qty']) for p in parts}\ncurrent_wc=dict(workcenters)\nfor order in orders:\n    product=order['product_part_id']\n    req=order['requested_qty']\n    batch=parts[product]['batch_size']\n    max_k=req//batch\n    init_inv, init_wc=dict(current_inv), dict(current_wc)\n    allocated=0; res_inv=init_inv; res_wc=init_wc\n    if req>0 and batch>0:\n        for k in range(max_k, -1, -1):\n            target=k*batch\n            if target==0:\n                allocated=0; res_inv=dict(init_inv); res_wc=dict(init_wc); break\n            out=simulate_build(product, target, init_inv, init_wc)\n            if "]
[459.506811, "o", "\u001b[?2004h> import sqlite3, math, copy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.506883, "i", "out is not None:\n                allocated=target\n                res_inv,res_wc=out\n                break\n    short=req-allocated\n    print(f'{order[\"order_id\"]:8s} prod={product:4s} req={req:3d} batch={batch} alloc={allocated:3d} short={short:3d}')\n    current_inv=res_inv\n    current_wc=res_wc\nprint('\\nFinal workcenter hours:')\nfor w in sorted(current_wc): print(w,current_wc[w])\nprint('\\nFinal inventory nonzero/negative:')\nfor p in sorted(current_inv):\n    if current_inv[p] != 0:\n        print(p, current_inv[p])\nPY\n"]
