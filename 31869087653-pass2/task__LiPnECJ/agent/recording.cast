[314.484064, "o", "            for rt in routing[p]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.484092, "o", "> "]
[314.484402, "o", "                wc = rt['workcenter_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.48497, "o", "                hrs = rt['setup_hours'] + build_qty * rt['run_hours_per_unit']\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.484996, "o", "> "]
[314.485312, "o", "                if hrs > wcav[wc] + 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.48559, "o", "                    return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.485616, "o", "> "]
[314.485864, "o", "                wcav[wc] -= hrs\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.485893, "o", "> "]
[314.486134, "o", "            # child requirements\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.486167, "o", "> "]
[314.486387, "o", "            for b in bom[p]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.486688, "o", "                child=b['child_part_id']\r\n\u001b[?2004l\r"]
[314.486722, "o", "\u001b[?2004h> "]
[314.487069, "o", "                base=b['qty_per'] * build_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.487801, "o", "                adj = math.ceil(base * (1.0 + b['scrap_rate_pct']/100.0) - 1e-12) + b['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.487834, "o", "> "]
[314.488145, "o", "                demands[child] += adj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.488341, "o", "            # excess credit\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.488375, "o", "> "]
[314.488597, "o", "            if build_qty > rem:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.488625, "o", "> "]
[314.488954, "o", "                inv[p] += build_qty - rem\r\n\u001b[?2004l\r"]
[314.489038, "o", "\u001b[?2004h> "]
[314.489113, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.48914, "o", "> "]
[314.489457, "o", "            # leaf; use substitutes for rem\r\n\u001b[?2004l\r"]
[314.489484, "o", "\u001b[?2004h> "]
[314.489702, "o", "            for s in subs[p]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.489797, "o", "> "]
[314.490078, "o", "                sub_id=s['substitute_part_id']\r\n\u001b[?2004l\r"]
[314.490121, "o", "\u001b[?2004h> "]
[314.4904, "o", "                ratio=s['qty_ratio']\r\n\u001b[?2004l\r"]
[314.490429, "o", "\u001b[?2004h> "]
[314.490708, "o", "                sub_inv=inv[sub_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.490827, "o", "> "]
[314.491234, "o", "                cover=int(sub_inv // ratio) if ratio>0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.491271, "o", "> "]
[314.491526, "o", "                take=min(rem, cover)\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.491554, "o", "> "]
[314.491779, "o", "                if take<=0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.491807, "o", "> "]
[314.492071, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.492369, "o", "                inv[sub_id] -= take * ratio\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.492456, "o", "> "]
[314.492661, "o", "                rem -= take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.492899, "o", "                if rem <= 1e-12:\r\n\u001b[?2004l\r"]
[314.49293, "o", "\u001b[?2004h> "]
[314.49316, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.493402, "o", "            if rem > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.493641, "o", "                return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.494093, "o", "    # Check leftover demands not processed (shouldn't happen)\r\n\u001b[?2004l\r"]
[314.494141, "o", "\u001b[?2004h> "]
[314.494399, "o", "    for p,qty in demands.items():\r\n\u001b[?2004l\r"]
[314.494432, "o", "\u001b[?2004h> "]
[314.494608, "o", "        if qty > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.494787, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.494894, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49507, "o", "def limiting_resource_for_order(order, state_inv, state_wc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.495232, "o", "    product=order['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49542, "o", "    batch=parts[product]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.495741, "o", "    target=allocated_qty + batch  # must be computed after allocated; but this function later\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.495828, "o", "    pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49593, "o", "# temporary processing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.496184, "o", "current_inv={p: float(parts[p]['on_hand_qty']) for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.496395, "o", "current_wc={w: float(workcenters[w]) for w in workcenters}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[314.496475, "o", "> "]
[314.496552, "o", "for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.496701, "o", "    product=order['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.496819, "o", "    req=order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497009, "o", "    batch=parts[product]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497067, "o", "    max_k=req//batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497307, "o", "    init_inv, init_wc = deep_copy_state(current_inv, current_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497398, "o", "    allocated=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497524, "o", "    chosen_inv=None; chosen_wc=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497688, "o", "    for k in range(max_k, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.497775, "o", "        target=k*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49799, "o", "        t_inv,t_wc=deep_copy_state(init_inv, init_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498074, "o", "        ok=True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498156, "o", "        if target>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498374, "o", "            ok=attempt_build(product,target,t_inv,t_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498462, "o", "        if ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498556, "o", "            allocated=target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49875, "o", "            chosen_inv=t_inv; chosen_wc=t_wc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498837, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.498933, "o", "    shortfall=req-allocated\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.499003, "o", "> "]
[314.49938, "o", "    print(f'{order[\"order_id\"]} p={product} req={req} batch={batch} alloc={allocated} short={shortfall}')\r\n\u001b[?2004l\r\u001b[?2004h>     if shortfall>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[314.499407, "o", "> "]
[314.499554, "o", "        # compute limiting later\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.499645, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.499733, "o", "    # update state\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.499849, "o", "    current_inv=chosen_inv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[314.49995, "o", "    current_wc=chosen_wc\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
