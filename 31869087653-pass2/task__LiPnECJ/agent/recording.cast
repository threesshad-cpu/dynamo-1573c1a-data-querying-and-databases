[459.509873, "o", "> \r\n\u001b[?2004l\r"]
[459.509917, "o", "\u001b[?2004h> "]
[459.509983, "o", "routing=defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.510152, "o", "cur.execute('SELECT * FROM routing')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.510226, "o", "for r in cur.fetchall():\r\n\u001b[?2004l\r"]
[459.510256, "o", "\u001b[?2004h> "]
[459.51044, "o", "    d=dict(r); routing[d['parent_part_id']].append(d)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[459.510485, "o", "> "]
[459.510577, "o", "subs=defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.510947, "o", "cur.execute('SELECT * FROM substitutes ORDER BY primary_part_id,preference_rank,substitute_part_id')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.511052, "o", "for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.511256, "o", "    d=dict(r); subs[d['primary_part_id']].append(d)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[459.5113, "o", "\u001b[?2004h> "]
[459.511358, "o", "orders=[]\r\n\u001b[?2004l\r"]
[459.511406, "o", "\u001b[?2004h> "]
[459.511637, "o", "cur.execute('SELECT * FROM orders ORDER BY priority ASC, order_id DESC')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.511765, "o", "for r in cur.fetchall():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.511885, "o", "    d=dict(r); orders.append(d)\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.511934, "o", "> "]
[459.511986, "o", "conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[459.512031, "o", "\u001b[?2004h> "]
[459.512165, "o", "# topological order parent-before-child\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.512197, "o", "> "]
[459.512299, "o", "indeg={p:0 for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.512409, "o", "graph=defaultdict(set)\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.512441, "o", "> "]
[459.512522, "o", "for p, edges in bom.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.512605, "o", "    for e in edges:\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.51265, "o", "> "]
[459.512778, "o", "        child=e['child_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.512882, "o", "        graph[p].add(child)\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.512917, "o", "> "]
[459.512985, "o", "for p in parts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.513077, "o", "    for c in graph.get(p,[]):\r\n\u001b[?2004l\r"]
[459.51311, "o", "\u001b[?2004h> "]
[459.513156, "o", "        indeg[c]+=1\r\n\u001b[?2004l\r"]
[459.513216, "o", "\u001b[?2004h> "]
[459.513371, "o", "queue=sorted([p for p in parts if indeg[p]==0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.513428, "o", "topo=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.513497, "o", "> while queue:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.51356, "o", "    p=queue.pop(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.513592, "o", "> "]
[459.513693, "o", "    topo.append(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.513853, "o", "    for c in sorted(graph.get(p,[])):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.513933, "o", "        indeg[c]-=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.514059, "o", "        if indeg[c]==0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.514175, "o", "            queue.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.514317, "o", "            queue.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.514449, "o", "print('topo len',len(topo), 'parts',len(parts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.51448, "o", "> "]
[459.514597, "o", "print('topo first 15', topo[:15])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[459.514703, "o", "\u001b[?2004h> "]
[459.514864, "o", "def simulate_build(product, target, init_inv, init_wc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.514934, "o", "    inv=dict(init_inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.51506, "o", "    wc=dict(init_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.515199, "o", "    demands=defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.51528, "o", "    demands[product]=target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.515373, "o", "    for p in topo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.515504, "o", "        qty=demands.get(p,0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.515581, "o", "        if qty<=0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.51569, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.515752, "o", "> "]
[459.515795, "o", "        demands[p]=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.515888, "o", "        avail=inv[p]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516062, "o", "        consume=min(qty,avail)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516148, "o", "        inv[p]=avail-consume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516251, "o", "        rem=qty-consume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516345, "o", "        if rem<=0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516446, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516538, "o", "        if p in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516736, "o", "            batch=parts[p]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516912, "o", "            build_qty=math.ceil(rem/batch - 1e-12)*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.516992, "o", "            # routing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.51718, "o", "            for rt in routing[p]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.517315, "o", "                wid=rt['workcenter_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.517581, "o", "                hrs=rt['setup_hours'] + build_qty*rt['run_hours_per_unit']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.517751, "o", "                if hrs > wc[wid] + 1e-9:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.517861, "o", "                    return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.517985, "o", "                wc[wid] -= hrs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.518096, "o", "            # child reqs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.518228, "o", "            for b in bom[p]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.518378, "o", "                child=b['child_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.518545, "o", "                base=b['qty_per']*build_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.518889, "o", "                adj=math.ceil(base*(1.0 + b['scrap_rate_pct']/100.0) - 1e-12) + b['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519069, "o", "                demands[child] += adj\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519189, "o", "            if build_qty > rem:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519357, "o", "                inv[p] += build_qty - rem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519437, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519578, "o", "            for s in subs.get(p,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519737, "o", "                sub_id=s['substitute_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.519907, "o", "                ratio=s['qty_ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520051, "o", "                if ratio <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520141, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520407, "o", "                cover=int(inv[sub_id] // ratio) if inv[sub_id] >= 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520558, "o", "                take=min(rem,cover)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520658, "o", "                if take<=0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520825, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.520967, "o", "                inv[sub_id] -= take*ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.52107, "o", "                rem -= take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521208, "o", "                if rem<=0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521335, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521427, "o", "            if rem > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521554, "o", "                return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521709, "o", "    for p in topo:\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.521799, "o", "> "]
[459.521855, "o", "        if demands[p] > 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521909, "o", "            return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.521975, "o", "    return (inv,wc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522244, "o", "current_inv={p: float(parts[p]['on_hand_qty']) for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522347, "o", "current_wc=dict(workcenters)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522447, "o", "for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522605, "o", "    product=order['product_part_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.52272, "o", "    req=order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522886, "o", "    batch=parts[product]['batch_size']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.522935, "o", "    max_k=req//batch\r\n\u001b[?2004l\r"]
[459.523019, "o", "\u001b[?2004h> "]
[459.523185, "o", "    init_inv, init_wc=dict(current_inv), dict(current_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.523375, "o", "    allocated=0; res_inv=init_inv; res_wc=init_wc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.52346, "o", "    if req>0 and batch>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[459.523491, "o", "> "]
[459.523621, "o", "        for k in range(max_k, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.523781, "o", "            target=k*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.523875, "o", "            if target==0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524161, "o", "                allocated=0; res_inv=dict(init_inv); res_wc=dict(init_wc); break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524385, "o", "            out=simulate_build(product, target, init_inv, init_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524513, "o", "            if out is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524647, "o", "                allocated=target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524799, "o", "                res_inv,res_wc=out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.524902, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.525022, "o", "    short=req-allocated\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.525429, "o", "    print(f'{order[\"order_id\"]:8s} prod={product:4s} req={req:3d} batch={batch} alloc={allocated:3d} short={short:3d}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.525513, "o", "    current_inv=res_inv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.525635, "o", "    current_wc=res_wc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.525804, "o", "print('\\nFinal workcenter hours:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.526009, "o", "for w in sorted(current_wc): print(w,current_wc[w])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.526165, "o", "print('\\nFinal inventory nonzero/negative:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.526276, "o", "for p in sorted(current_inv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.526413, "o", "    if current_inv[p] != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[459.526536, "o", "        print(p, current_inv[p])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
