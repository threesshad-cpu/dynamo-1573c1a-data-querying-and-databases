[32.626197, "i", "python3 - <<'PY'\nimport sqlite3, json\nconn=sqlite3.connect('/app/manufacturing.db')\ncur=conn.cursor()\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\nprint('TABLES', cur.fetchall())\nfor table in ['parts','bom','workcenters','routing','substitutes','orders']:\n    print('\\nSCHEMA FOR', table)\n    cur.execute(f\"SELECT sql FROM sqlite_master WHERE type='table' AND name='{table}'\")\n    print(cur.fetchone())\n    print('DATA', table)\n    cur.execute(f'SELECT * FROM {table} ORDER BY 1 LIMIT 50')\n    cols=[d[0] for d in cur.description]\n    print(cols)\n    for row in cur.fetchall():\n        print(row)\nconn.close()\nPY\n"]
