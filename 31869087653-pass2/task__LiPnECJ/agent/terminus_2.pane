for p in sorted(all_part_ids, key=lambda x:(level[x],x)):
    print(f'{p}: {level[p]}')
print('Topo len', len(topo))

sorted_parts_by_level=[p for p in sorted(all_part_ids, key=lambda x:(level[x], x))]

def deep_copy_state(inv, wcav):
    return (dict(inv), dict(wcav))

def attempt_build(product_id, total_qty, state_inv, state_wc):
    # state_inv and state_wc are mutated; returns bool success
    inv = state_inv
    wcav = state_wc
    demands = defaultdict(float)
    demands[product_id] += total_qty
    for p in sorted_parts_by_level:
        qty = demands.get(p, 0.0)
        if qty <= 1e-12:
            continue
        # consume primary stock
        avail = inv[p]
        consume = min(qty, avail)
        inv[p] = avail - consume
        rem = qty - consume
        if rem <= 1e-12:
            continue
        if p in parents or p in routing:
            # manufactured part
            batch = parts[p]['batch_size']
            build_qty = int(math.ceil(rem / batch - 1e-12)) * batch
            # route hours
            for rt in routing[p]:
                wc = rt['workcenter_id']
                hrs = rt['setup_hours'] + build_qty * rt['run_hours_per_unit']
                if hrs > wcav[wc] + 1e-9:
                    return False
                wcav[wc] -= hrs
            # child requirements
            for b in bom[p]:
                child=b['child_part_id']
                base=b['qty_per'] * build_qty
                adj = math.ceil(base * (1.0 + b['scrap_rate_pct']/100.0) - 1e-12) + b['setup_scrap_qty']
                demands[child] += adj
            # excess credit
            if build_qty > rem:
                inv[p] += build_qty - rem
        else:
            # leaf; use substitutes for rem
            for s in subs[p]:
                sub_id=s['substitute_part_id']
                ratio=s['qty_ratio']
                sub_inv=inv[sub_id]
                cover=int(sub_inv // ratio) if ratio>0 else 0
                take=min(rem, cover)
                if take<=0:
                    continue
