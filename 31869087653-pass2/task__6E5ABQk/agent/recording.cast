[390.337865, "o", "> "]
[390.338036, "o", "        p=stack.pop()\r\n\u001b[?2004l\r"]
[390.338065, "o", "\u001b[?2004h> "]
[390.338411, "o", "        if p in desc: continue\r\n\u001b[?2004l\ru\u001b[?2004h"]
[390.338446, "o", "> "]
[390.33869, "o", "        desc.add(p)\r\n\u001b[?2004l\r"]
[390.33872, "o", "\u001b[?2004h> "]
[390.339125, "o", "        for c in children.get(p,[]):\r\n\u001b[?2004l\rb\u001b[?2004h"]
[390.339157, "o", "> "]
[390.339648, "o", "            if c not in desc: stack.append(c)\r\n\u001b[?2004l\r"]
[390.339677, "o", "\u001b[?2004h> "]
[390.339993, "o", "    indeg={n:0 for n in desc}\r\n\u001b[?2004l\r"]
[390.340025, "o", "\u001b[?2004h> "]
[390.340246, "o", "    for p in desc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.340348, "o", "> "]
[390.340678, "o", "        for c in children.get(p,[]):\r\n\u001b[?2004l\r"]
[390.340714, "o", "\u001b[?2004h> "]
[390.341122, "o", "            if c in desc: indeg[c]+=1\r\n\u001b[?2004l\r"]
[390.341157, "o", "\u001b[?2004h> "]
[390.341666, "o", "    q=deque([n for n in desc if indeg[n]==0]); top=[]\r\n\u001b[?2004l\rot\u001b[?2004h"]
[390.341694, "o", "> "]
[390.341816, "o", "    while q:\r\n\u001b[?2004l\rea\u001b[?2004h"]
[390.341929, "o", "> "]
[390.342159, "o", "        n=q.popleft(); top.append(n)\r\n\u001b[?2004l\rt\u001b[?2004h"]
[390.34219, "o", "> "]
[390.342478, "o", "        for c in children.get(n,[]):\r\n\u001b[?2004l\r"]
[390.342511, "o", "\u001b[?2004h> "]
[390.342763, "o", "            indeg[c]-=1\r\n\u001b[?2004l\rta\u001b[?2004h"]
[390.342885, "o", "> "]
[390.343143, "o", "            if indeg[c]==0: q.append(c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.343171, "o", "> "]
[390.343344, "o", "    return desc,top\r\n\u001b[?2004l\r  \u001b[?2004h"]
[390.343375, "o", "> \r\n\u001b[?2004l\r"]
[390.343427, "o", "p\u001b[?2004h"]
[390.34346, "o", "> "]
[390.343674, "o", "def ceil_to_batch(s,b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.343704, "o", "> "]
[390.34385, "o", "    s=max(0.0,s)\r\n\u001b[?2004l\r"]
[390.343878, "o", "\u001b[?2004h> "]
[390.34411, "o", "    if s<=EPS: return 0\r\n\u001b[?2004l\rwc\u001b[?2004h"]
[390.344145, "o", "> "]
[390.344441, "o", "    return int(math.ceil(s/b-EPS)*b)\r\n\u001b[?2004l\rds\u001b[?2004h> "]
[390.344527, "o", "\r\n\u001b[?2004l\r=\u001b[?2004h> "]
[390.344852, "o", "def try_build(root,qty,stock,work):\r\n\u001b[?2004l\r"]
[390.344887, "o", "\u001b[?2004h> "]
[390.345266, "o", "    if qty<=0: return dict(stock),dict(work)\r\n\u001b[?2004l\re\u001b[?2004h"]
[390.345296, "o", "> "]
[390.345795, "o", "    ls=dict(stock); lw=dict(work); _,top=topo(root,children)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.346252, "o", "    gross=defaultdict(float); gross[root]=float(qty)\r\n\u001b[?2004l\r"]
[390.346281, "o", "\u001b[?2004h> "]
[390.346478, "o", "    for part in top:\r\n\u001b[?2004l\rg\u001b[?2004h"]
[390.346507, "o", "> "]
[390.346804, "o", "        demand=gross.get(part,0.0)\r\n\u001b[?2004l\r \u001b[?2004h"]
[390.346839, "o", "> "]
[390.347106, "o", "        if demand<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.34714, "o", "> "]
[390.347355, "o", "        if part in bom:\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.347384, "o", "> "]
[390.348123, "o", "            on_hand=ls.get(part,0.0); consume=min(on_hand,demand); ls[part]=on_hand-consume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.348447, "o", "            shortage=demand-consume\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.348474, "o", "> "]
[390.348825, "o", "            if shortage<=EPS: continue\r\n\u001b[?2004l\r\r\n  \u001b[?2004h"]
[390.348854, "o", "> "]
[390.34937, "o", "            b=parts[part]['batch']; build=ceil_to_batch(shortage,b)\r\n\u001b[?2004l\r \u001b[?2004h"]
[390.349402, "o", "> "]
[390.349771, "o", "            for rt in routing.get(part,[]):\r\n\u001b[?2004l\r  "]
[390.349801, "o", "\u001b[?2004h> "]
[390.350167, "o", "                h=rt['setup']+build*rt['run']\r\n\u001b[?2004l\r \u001b[?2004h"]
[390.350287, "o", "> "]
[390.350714, "o", "                if lw.get(rt['wc'],0.0)+EPS < h: return None\r\n\u001b[?2004l\ri\u001b[?2004h"]
[390.350744, "o", "> "]
[390.351033, "o", "                lw[rt['wc']]-=h\r\n\u001b[?2004l\rt('"]
[390.351064, "o", "\u001b[?2004h> "]
[390.351281, "o", "            for b in bom[part]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.351505, "o", "                base=b['qty_per']*build\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.351798, "o", "                running=math.ceil(base*(1+b['scrap']/100.0)-EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.35212, "o", "                gross[b['child']]+=running+b['setup_scrap']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.352326, "o", "            ls[part]+=(build-shortage)\r\n\u001b[?2004l\rif r"]
[390.364725, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[390.364881, "o", "\u001b[?2004h> "]
[390.365072, "o", "            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.365217, "o", "            if short<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.365381, "o", "            for su in subs.get(part,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.365666, "o", "                sa=ls.get(su['sub'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.365849, "o", "                if sa<=EPS or su['ratio']<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.366522, "o", "                cover=int(sa//su['ratio'])\r\n\u001b[?2004l\r\u001b[?2004h>                 need=int(math.ceil(short-EPS))\r\n\u001b[?2004l\r\u001b[?2004h>                 take=min(cover,need)\r\n\u001b[?2004l\r\u001b[?2004h>                 if take<=0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.366741, "o", "                ls[su['sub']]=sa-take*su['ratio']; short-=take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.366904, "o", "                if short<=EPS: break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.366958, "o", "            if short>EPS: return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.367038, "o", "    return ls,lw\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[390.367124, "o", "> "]
[390.367208, "o", "def req_res(root,qty,stock):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.367429, "o", "    req={'leaves':defaultdict(float),'wc':defaultdict(float)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.36758, "o", "    if qty<=0: return req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.367851, "o", "    _,top=topo(root,children); gross=defaultdict(float); gross[root]=float(qty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.367982, "o", "    for part in top:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.368079, "o", "        demand=gross.get(part,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.36823, "o", "        if demand<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.368377, "o", "        if part in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.368623, "o", "            on=stock.get(part,0.0); cons=min(on,demand); short=demand-cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.368784, "o", "            if short<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.369022, "o", "            b=parts[part]['batch']; build=ceil_to_batch(short,b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.369124, "o", "            for rt in routing.get(part,[]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[390.369158, "o", "> "]
[390.369406, "o", "                req['wc'][rt['wc']]+=rt['setup']+build*rt['run']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.369523, "o", "            for b in bom[part]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.369685, "o", "                base=b['qty_per']*build\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.369954, "o", "                running=math.ceil(base*(1+b['scrap']/100.0)-EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.370163, "o", "                gross[b['child']]+=running+b['setup_scrap']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.37019, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.37037, "o", "            req['leaves'][part]+=demand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.370492, "o", "    return req\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.370708, "o", "parts,bom,children,routing,wc,subs,orders=load_db()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.370861, "o", "# Sort order same as before\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.370936, "o", "for o in orders: o['_p']=o['priority']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.371131, "o", "orders.sort(key=lambda o:o['priority'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.371246, "o", "from itertools import groupby\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.3713, "o", "sorted_orders=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.371583, "o", "for prio,group in groupby(orders,key=lambda o:o['priority']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.371894, "o", "    grp=list(group); grp.sort(key=lambda o:o['order_id'], reverse=True); sorted_orders.extend(grp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.372107, "o", "stock={p:parts[p]['on_hand'] for p in parts}; work=dict(wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.372253, "o", "for o in sorted_orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.372954, "o", "    if o['order_id'] in ['O00_A','O00_B','O00_C','O00_D','O00_E','O00_F','O00_G','O00_H','O00_I','O00_J','O00_K','O00_L','O00_M','O00_N','O00_O','O00_P','O00_Q','O00_R1','O00_R2','O00_S2','O01','O02','O03','O04']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.373363, "o", "        print('\\n==== BEFORE', o['order_id'], 'product', o['product'], 'req', o['requested'], 'batch',parts[o['product']]['batch'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.374028, "o", "        print('stock select', {k:stock.get(k) for k in sorted(stock) if stock.get(k) and k in ['L3','SUB_L3','SA1','SA2','L5','L6','SUB_L6','SA3','L4','L7','L8','SA4','L1','L2','L13','SA8','L30','SA30']})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.374316, "o", "        print('wc', {k:work.get(k) for k in sorted(work) if work.get(k) is not None})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.374588, "o", "        batch=parts[o['product']]['batch']; maxb=o['requested']//batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.374675, "o", "        feasible=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.374782, "o", "        for n in range(maxb,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.375048, "o", "            r=try_build(o['product'], n*batch, stock, work)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.375155, "o", "            if r:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.37523, "o", "                feasible=n*batch; break\r\n\u001b[?2004l\r"]
[390.375252, "o", "\u001b[?2004h> "]
[390.375424, "o", "        print('feasible', feasible)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.375689, "o", "        if feasible is not None and feasible < o['requested']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.375869, "o", "            target=feasible+batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.375994, "o", "            req=req_res(o['product'], target, stock)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.376157, "o", "            print('TARGET',target)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.376348, "o", "            print('req leaves', dict(req['leaves']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.376509, "o", "            print('req wc', dict(req['wc']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.376742, "o", "            cands=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.376906, "o", "            for leaf,needed in req['leaves'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377042, "o", "                if needed<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377132, "o", "                avail=stock.get(leaf,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377359, "o", "                for s in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377537, "o", "                    subo=stock.get(s['sub'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377754, "o", "                    if subo>EPS and s['ratio']>EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.377969, "o", "                        avail+=math.floor(subo/s['ratio']+EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.378113, "o", "                ratio=avail/needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.378405, "o", "                print('LEAFCAND', leaf, 'needed', needed, 'avail', avail, 'ratio', ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.378659, "o", "                if ratio<1-EPS: cands.append((ratio,leaf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.378828, "o", "            for wcname,needed in req['wc'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379003, "o", "                if needed<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379131, "o", "                avail=work.get(wcname,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379281, "o", "                ratio=avail/needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379612, "o", "                print('WCCAND', wcname, 'needed', needed, 'avail', avail, 'ratio', ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379845, "o", "                if ratio<1-EPS: cands.append((ratio,wcname))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.379978, "o", "            print('cands', cands)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.380218, "o", "        r=try_build(o['product'], feasible or 0, stock, work)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[390.380314, "o", "        if r: stock,work=r\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[390.468658, "o", "\r\n==== BEFORE O00_A product P5 req 3 batch 2\r\n"]
[390.468943, "o", "stock select {'L1': 350.0, 'L13': 25.0, 'L2': 300.0, 'L3': 55.0, 'L30': 109.0, 'L4': 150.0, 'L5': 12.0, 'L6': 58.0, 'L7': 30.0, 'L8': 40.0, 'SA1': 2.0, 'SA2': 2.0, 'SA4': 2.0, 'SUB_L3': 18.0, 'SUB_L6': 10.0}\r\nwc {'WC1': 50.0, 'WC10': 2.0, 'WC11': 4.0, 'WC2': 21.0, 'WC3': 18.0, 'WC30': 33.0, 'WC31': 100.0, 'WC4': 2.75, 'WC40': 0.3, 'WC5': 10.0, 'WC6': 8.2, 'WC70': 15.0}\r\nfeasible 0\r\n"]
[390.468999, "o", "TARGET 2\r\nreq leaves {'L10': 20.0, 'L11': 10.0, 'L12': 10.0}\r\n"]
[390.469022, "o", "req wc {'WC4': 12.5}\r\n"]
[390.469165, "o", "LEAFCAND L10 needed 20.0 avail 1.0 ratio 0.05\r\nLEAFCAND L11 needed 10.0 avail 100.0 ratio 10.0\r\nLEAFCAND L12 needed 10.0 avail 13.0 ratio 1.3\r\n"]
[390.469246, "o", "WCCAND WC4 needed 12.5 avail 2.75 ratio 0.22\r\ncands [(0.05, 'L10'), (0.22, 'WC4')]\r\n\r\n==== BEFORE O00_B product P6 req 10 batch 1\r\n"]
[390.469329, "o", "stock select {'L1': 350.0, 'L13': 25.0, 'L2': 300.0, 'L3': 55.0, 'L30': 109.0, 'L4': 150.0, 'L5': 12.0, 'L6': 58.0, 'L7': 30.0, 'L8': 40.0, 'SA1': 2.0, 'SA2': 2.0, 'SA4': 2.0, 'SUB_L3': 18.0, 'SUB_L6': 10.0}\r\n"]
[390.469373, "o", "wc {'WC1': 50.0, 'WC10': 2.0, 'WC11': 4.0, 'WC2': 21.0, 'WC3': 18.0, 'WC30': 33.0, 'WC31': 100.0, 'WC4': 2.75, 'WC40': 0.3, 'WC5': 10.0, 'WC6': 8.2, 'WC70': 15.0}\r\n"]
[390.469487, "o", "feasible 10\r\n"]
[390.469658, "o", "\r\n==== BEFORE O00_C product P7 req 3 batch 1\r\nstock select {'L1': 350.0, 'L13': 25.0, 'L2': 300.0, 'L3': 55.0, 'L30': 109.0, 'L4': 150.0, 'L5': 12.0, 'L6': 58.0, 'L7': 30.0, 'L8': 40.0, 'SA1': 2.0, 'SA2': 2.0, 'SA4': 2.0, 'SUB_L3': 18.0, 'SUB_L6': 10.0}\r\n"]
[390.469697, "o", "wc {'WC1': 50.0, 'WC10': 2.0, 'WC11': 4.0, 'WC2': 21.0, 'WC3': 18.0, 'WC30': 33.0, 'WC31': 100.0, 'WC4': 2.75, 'WC40': 0.3, 'WC5': 10.0, 'WC6': 8.2, 'WC70': 15.0}\r\n"]
