[225.782335, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\n\nDB='/app/manufacturing.db'\nEPS=1e-9\n\ndef load_db():\n    conn=sqlite3.connect(DB)\n    conn.row_factory=sqlite3.Row\n    cur=conn.cursor()\n    data={}\n    data['parts']={}\n    for r in cur.execute('SELECT part_id, on_hand_qty, batch_size FROM parts'):\n        data['parts'][r['part_id']]={'on_hand':float(r['on_hand_qty']), 'batch':int(r['batch_size'])}\n    data['bom']=defaultdict(list)\n    data['children']=defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n        row={\n            'child': r['child_part_id'],\n            'qty_per': int(r['qty_per']),\n            'scrap': float(r['scrap_rate_pct']),\n            'setup_scrap': int(r['setup_scrap_qty'])\n        }\n        data['bom'][r['parent_part_id']].append(row)\n        data['children'][r['parent_part_id']].append(r['child_part_id'])\n    data['routing']=defaultdict(list)\n    for r in cur.execu"]
[225.7827, "i", "te('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\n        data['routing'][r['parent_part_id']].append({\n            'wc': r['workcenter_id'],\n            'setup': float(r['setup_hours']),\n            'run': float(r['run_hours_per_unit'])\n        })\n    data['wc']={}\n    for r in cur.execute('SELECT workcenter_id, available_hours FROM workcenters'):\n        data['wc'][r['workcenter_id']]=float(r['available_hours'])\n    data['subs']=defaultdict(list)\n    for r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id'):\n        data['subs'][r['primary_part_id']].append({\n            'sub': r['substitute_part_id'],\n            'ratio': float(r['qty_ratio'])\n        })\n    data['orders']=[]\n    for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders'):\n        data['orders'].append({\n            'order_id': r['order_id'],\n          "]
