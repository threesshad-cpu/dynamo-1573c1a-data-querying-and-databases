[353.026942, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\n\nDB = '/app/manufacturing.db'\nEPS = 1e-9\n\ndef load_db():\n    conn = sqlite3.connect(DB)\n    conn.row_factory = sqlite3.Row\n    cur = conn.cursor()\n\n    parts = {}\n    for r in cur.execute('SELECT part_id, on_hand_qty, batch_size FROM parts'):\n        parts[r['part_id']] = {\n            'on_hand': float(r['on_hand_qty']),\n            'batch': int(r['batch_size']),\n        }\n\n    bom_by_parent = defaultdict(list)\n    children = defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n        row = {\n            'child': r['child_part_id'],\n            'qty_per': int(r['qty_per']),\n            'scrap_rate_pct': float(r['scrap_rate_pct']),\n            'setup_scrap_qty': int(r['setup_scrap_qty']),\n        }\n        bom_by_parent[r['parent_part_id']].append(row)\n        children[r['parent_part_id']].append(r['child_part_id'])\n\n    routing_by_parent = de"]
[353.026981, "i", "faultdict(list)\n    for r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\n        routing_by_parent[r['parent_part_id']].append({\n            'wc': r['workcenter_id'],\n            'setup': float(r['setup_hours']),\n            'run': float(r['run_hours_per_unit']),\n        })\n\n    workcenters = {}\n    for r in cur.execute('SELECT workcenter_id, available_hours FROM workcenters'):\n        workcenters[r['workcenter_id']] = float(r['available_hours'])\n\n    subs = defaultdict(list)\n    for r in cur.execute(\n        'SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank '\n        'FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id'\n    ):\n        subs[r['primary_part_id']].append({\n            'sub': r['substitute_part_id'],\n            'ratio': float(r['qty_ratio']),\n        })\n\n    orders = []\n    for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders'):\n        orders.append({\n "]
[353.026991, "i", "           'order_id': r['order_id'],\n            'product': r['product_part_id'],\n            'requested': int(r['requested_qty']),\n            'priority': int(r['priority']),\n        })\n    conn.close()\n    return parts, bom_by_parent, children, routing_by_parent, workcenters, subs, orders\n\n\ndef topo_for_part(root, children):\n    desc = set()\n    stack = [root]\n    while stack:\n        p = stack.pop()\n        if p in desc:\n            continue\n        desc.add(p)\n        for c in children.get(p, []):\n            if c not in desc:\n                stack.append(c)\n\n    indeg = {n: 0 for n in desc}\n    for p in desc:\n        for c in children.get(p, []):\n            if c in desc:\n                indeg[c] += 1\n    q = deque([n for n in desc if indeg[n] == 0])\n    topo = []\n    while q:\n        n = q.popleft()\n        topo.append(n)\n        for c in children.get(n, []):\n            if c in desc:\n                indeg[c] -= 1\n                if indeg[c] == 0:\n                    q.append(c)\n    if len(topo) != len"]
[353.026999, "i", "(desc):\n        for n in desc:\n            if n not in topo:\n                topo.append(n)\n    return desc, topo\n\n\ndef ceil_to_batch(shortage, batch):\n    shortage = max(0.0, shortage)\n    if shortage <= EPS:\n        return 0\n    if batch <= 0:\n        batch = 1\n    return int(math.ceil(shortage / batch - EPS) * batch)\n\n\ndef try_build(root, qty, stock, work, children, parts, bom_by_parent, routing_by_parent, subs):\n    if qty <= 0:\n        return dict(stock), dict(work)\n\n    local_stock = dict(stock)\n    local_work = dict(work)\n    _, topo = topo_for_part(root, children)\n    gross = defaultdict(float)\n    gross[root] = float(qty)\n\n    for part in topo:\n        demand = gross.get(part, 0.0)\n        if demand <= EPS:\n            continue\n\n        # Non-leaf part\n        if part in bom_by_parent:\n            on_hand = local_stock.get(part, 0.0)\n            consume = min(on_hand, demand)\n            local_stock[part] = on_hand - consume\n            shortage = demand - consume\n            if shortage <= EPS:\n    "]
[353.027042, "i", "            continue\n\n            batch = parts[part]['batch']\n            build_qty = ceil_to_batch(shortage, batch)\n\n            for route in routing_by_parent.get(part, []):\n                hours = route['setup'] + build_qty * route['run']\n                if local_work.get(route['wc'], 0.0) + EPS < hours:\n                    return None\n                local_work[route['wc']] -= hours\n\n            for b in bom_by_parent[part]:\n                base = b['qty_per'] * build_qty\n                running = math.ceil(base * (1.0 + b['scrap_rate_pct'] / 100.0) - EPS)\n                child_req = running + b['setup_scrap_qty']\n                gross[b['child']] += child_req\n\n            # credit excess produced over net shortage\n            local_stock[part] += (build_qty - shortage)\n\n        else:\n            # Leaf part: satisfy from primary stock, then substitutes\n            on_hand = local_stock.get(part, 0.0)\n            consume = min(on_hand, demand)\n            local_stock[part] = on_hand - consume\n          "]
[353.027244, "i", "  shortage = demand - consume\n            if shortage <= EPS:\n                continue\n\n            for sub in subs.get(part, []):\n                sub_onhand = local_stock.get(sub['sub'], 0.0)\n                if sub_onhand <= EPS or sub['ratio'] <= EPS:\n                    continue\n                cover = int(math.floor(sub_onhand / sub['ratio'] + EPS))\n                if cover <= 0:\n                    continue\n                need = int(math.ceil(shortage - EPS))\n                take = min(cover, need)\n                if take <= 0:\n                    continue\n                local_stock[sub['sub']] = sub_onhand - take * sub['ratio']\n                shortage -= take\n                if shortage <= EPS:\n                    break\n\n            if shortage > EPS:\n                return None\n\n    return local_stock, local_work\n\n\ndef calculate_required_resources(root, qty, stock, children, parts, bom_by_parent, routing_by_parent):\n    required = {'leaves': defaultdict(float), 'workcenters': defaultdict(float)}\n   "]
[353.027342, "i", " if qty <= 0:\n        return required\n\n    _, topo = topo_for_part(root, children)\n    gross = defaultdict(float)\n    gross[root] = float(qty)\n\n    for part in topo:\n        demand = gross.get(part, 0.0)\n        if demand <= EPS:\n            continue\n\n        if part in bom_by_parent:\n            on_hand = stock.get(part, 0.0)\n            consume = min(on_hand, demand)\n            shortage = demand - consume\n            if shortage <= EPS:\n                continue\n\n            batch = parts[part]['batch']\n            build_qty = ceil_to_batch(shortage, batch)\n\n            for route in routing_by_parent.get(part, []):\n                required['workcenters'][route['wc']] += route['setup'] + build_qty * route['run']\n\n            for b in bom_by_parent[part]:\n                base = b['qty_per'] * build_qty\n                running = math.ceil(base * (1.0 + b['scrap_rate_pct'] / 100.0) - EPS)\n                child_req = running + b['setup_scrap_qty']\n                gross[b['child']] += child_req\n        else:\n    "]
[353.027362, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[353.027382, "i", "        required['leaves'][part] += demand\n\n    return required\n\n\ndef main():\n    parts, bom_by_parent, children, routing_by_parent, workcenters, subs, orders = load_db()\n\n    # Sort orders by priority ascending, then order_id descending within same priority.\n    for o in orders:\n        o['_priority_key'] = o['priority']\n    orders.sort(key=lambda o: (o['priority'],), reverse=False)\n    from itertools import groupby\n    sorted_orders = []\n    for prio, group in groupby(orders, key=lambda o: o['priority']):\n        grp = list(group)\n        grp.sort(key=lambda o: o['order_id'], reverse=True)\n        sorted_orders.extend(grp)\n\n    current_stock = {p: parts[p]['on_hand'] for p in parts}\n    current_work = dict(workcenters)\n    report = []\n\n    for order in sorted_orders:\n        before_stock = dict(current_stock)\n        before_work = dict(current_work)\n\n        product = order['product']\n        requested = order['requested']\n        batch = parts[product]['batch']\n        max_batches = requested // batch\n\n   "]
[353.027499, "o", "\u001b[?2004h> "]
[353.027522, "i", "     chosen_qty = 0\n        chosen_stock = None\n        chosen_work = None\n\n        for k in range(max_batches, -1, -1):\n            qty = k * batch\n            result = try_build(\n                product, qty, current_stock, current_work, children,\n                parts, bom_by_parent, routing_by_parent, subs,\n            )\n            if result is not None:\n                chosen_qty = qty\n                chosen_stock, chosen_work = result\n                break\n\n        allocated_qty = chosen_qty\n        shortfall_qty = requested - allocated_qty\n        limiting = None\n\n        if shortfall_qty > 0:\n            target_qty = allocated_qty + batch\n            req = calculate_required_resources(\n                product, target_qty, before_stock, children, parts, bom_by_parent, routing_by_parent,\n            )\n            candidates = []\n\n            for leaf, needed in req['leaves'].items():\n                if needed <= EPS:\n                    continue\n                avail = before_stock.get(leaf, 0.0)\n     "]
[353.027538, "i", "           for sub in subs.get(leaf, []):\n                    sub_onhand = before_stock.get(sub['sub'], 0.0)\n                    if sub_onhand > EPS and sub['ratio'] > EPS:\n                        avail += math.floor(sub_onhand / sub['ratio'] + EPS)\n                ratio = avail / needed\n                if ratio < 1.0 - EPS:\n                    candidates.append((ratio, leaf))\n\n            for wc, needed in req['workcenters'].items():\n                if needed <= EPS:\n                    continue\n                avail = before_work.get(wc, 0.0)\n                ratio = avail / needed\n                if ratio < 1.0 - EPS:\n                    candidates.append((ratio, wc))\n\n            if candidates:\n                candidates.sort(key=lambda x: (x[0], x[1]))\n                limiting = candidates[0][1]\n\n        if chosen_stock is not None:\n            current_stock = chosen_stock\n            current_work = chosen_work\n\n        report.append({\n            'order_id': order['order_id'],\n            'allocated_qty'"]
[353.027729, "i", ": allocated_qty,\n            'shortfall_qty': shortfall_qty,\n            'limiting_resource': limiting,\n        })\n\n    report.sort(key=lambda x: x['order_id'])\n    output = {'orders': report}\n    print(json.dumps(output, indent=2))\n\n    with open('/app/report.json', 'w') as f:\n        json.dump(output, f, indent=2)\n        f.write('\\n')\n\nif __name__ == '__main__':\n    main()\nPY\n"]
