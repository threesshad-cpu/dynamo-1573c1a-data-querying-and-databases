[225.783042, "i", "  'product': r['product_part_id'],\n            'requested': int(r['requested_qty']),\n            'priority': int(r['priority'])\n        })\n    conn.close()\n    return data\n\ndef descendants_and_topo(root, children):\n    desc=set()\n    stack=[root]\n    while stack:\n        p=stack.pop()\n        if p in desc:\n            continue\n        desc.add(p)\n        for c in children.get(p,[]):\n            if c not in desc:\n                stack.append(c)\n    indeg={n:0 for n in desc}\n    for p in desc:\n        for c in children.get(p,[]):\n            if c in desc:\n                indeg[c]=indeg.get(c,0)+1\n    q=deque([n for n in desc if indeg.get(n,0)==0])\n    topo=[]\n    while q:\n        n=q.popleft()\n        topo.append(n)\n        for c in children.get(n,[]):\n            if c in indeg:\n                indeg[c]-=1\n                if indeg[c]==0:\n                    q.append(c)\n    # fallback if graph has cycle; should not happen\n    if len(topo)!=len(desc):\n        # Add remaining in arbitrary desc order\n        for n "]
