[390.306821, "i", "python3 - <<'PY'\nimport sqlite3, math\nfrom collections import defaultdict, deque\n\nDB='/app/manufacturing.db'\nEPS=1e-9\n\ndef load_db():\n    conn=sqlite3.connect(DB); conn.row_factory=sqlite3.Row; cur=conn.cursor()\n    parts={}\n    for r in cur.execute('SELECT part_id,on_hand_qty,batch_size FROM parts'):\n        parts[r['part_id']]={'on_hand':float(r['on_hand_qty']),'batch':int(r['batch_size'])}\n    bom=defaultdict(list); children=defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id,child_part_id,qty_per,scrap_rate_pct,setup_scrap_qty FROM bom'):\n        bom[r['parent_part_id']].append({'child':r['child_part_id'],'qty_per':int(r['qty_per']),'scrap':float(r['scrap_rate_pct']),'setup_scrap':int(r['setup_scrap_qty'])})\n        children[r['parent_part_id']].append(r['child_part_id'])\n    routing=defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id,workcenter_id,setup_hours,run_hours_per_unit FROM routing'):\n        routing[r['parent_part_id']].append({'wc':r['workcenter_id'],'setup':float(r"]
[390.306899, "i", "['setup_hours']),'run':float(r['run_hours_per_unit'])})\n    wc={}\n    for r in cur.execute('SELECT workcenter_id,available_hours FROM workcenters'):\n        wc[r['workcenter_id']]=float(r['available_hours'])\n    subs=defaultdict(list)\n    for r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id'):\n        subs[r['primary_part_id']].append({'sub':r['substitute_part_id'],'ratio':float(r['qty_ratio'])})\n    orders=[]\n    for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders'):\n        orders.append({'order_id':r['order_id'],'product':r['product_part_id'],'requested':int(r['requested_qty']),'priority':int(r['priority'])})\n    conn.close(); return parts,bom,children,routing,wc,subs,orders\n\ndef topo(root, children):\n    desc=set(); stack=[root]\n    while stack:\n        p=stack.pop()\n        if p in desc: continue\n        desc.add(p)\n        for c in children.get(p,"]
[390.307135, "i", "[]):\n            if c not in desc: stack.append(c)\n    indeg={n:0 for n in desc}\n    for p in desc:\n        for c in children.get(p,[]):\n            if c in desc: indeg[c]+=1\n    q=deque([n for n in desc if indeg[n]==0]); top=[]\n    while q:\n        n=q.popleft(); top.append(n)\n        for c in children.get(n,[]):\n            indeg[c]-=1\n            if indeg[c]==0: q.append(c)\n    return desc,top\n\ndef ceil_to_batch(s,b):\n    s=max(0.0,s)\n    if s<=EPS: return 0\n    return int(math.ceil(s/b-EPS)*b)\n\ndef try_build(root,qty,stock,work):\n    if qty<=0: return dict(stock),dict(work)\n    ls=dict(stock); lw=dict(work); _,top=topo(root,children)\n    gross=defaultdict(float); gross[root]=float(qty)\n    for part in top:\n        demand=gross.get(part,0.0)\n        if demand<=EPS: continue\n        if part in bom:\n            on_hand=ls.get(part,0.0); consume=min(on_hand,demand); ls[part]=on_hand-consume\n            shortage=demand-consume\n            if shortage<=EPS: continue\n            b=parts[part]['batch']; build=cei"]
