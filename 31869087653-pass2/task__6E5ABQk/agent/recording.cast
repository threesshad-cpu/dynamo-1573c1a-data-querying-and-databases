[225.819967, "o", "        for c in children.get(n,[]):\r\n\u001b[?2004l\rre\u001b[?2004h"]
[225.819997, "o", "> "]
[225.820269, "o", "            if c in indeg:\r\n\u001b[?2004l\rlo\u001b[?2004h> "]
[225.820467, "o", "                indeg[c]-=1\r\n\u001b[?2004l\r"]
[225.820502, "o", "\u001b[?2004h> "]
[225.820866, "o", "                if indeg[c]==0:\r\n\u001b[?2004l\rn\u001b[?2004h"]
[225.820894, "o", "> "]
[225.821202, "o", "                    q.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.821697, "o", "    # fallback if graph has cycle; should not happen\r\n\u001b[?2004l\r"]
[225.821728, "o", "\u001b[?2004h> "]
[225.822026, "o", "    if len(topo)!=len(desc):\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.822056, "o", "> "]
[225.822441, "o", "        # Add remaining in arbitrary desc order\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.822472, "o", "> "]
[225.822735, "o", "        for n in desc:\r\n\u001b[?2004l\rrs.\u001b[?2004h"]
[225.822763, "o", "> "]
[225.82304, "o", "            if n not in topo:\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.823069, "o", "> "]
[225.823317, "o", "                topo.append(n)\r\n\u001b[?2004l\r"]
[225.82335, "o", "\u001b[?2004h> "]
[225.823538, "o", "    return desc, topo\r\n\u001b[?2004l\r"]
[225.823588, "o", "\u001b[?2004h> "]
[225.823684, "o", "\r\n\u001b[?2004l\r"]
[225.823717, "o", "\u001b[?2004h> "]
[225.824414, "o", "def simulate_bom(parts, children, routing, wc_avail, subs, root, qty, enforce=True):\r\n\u001b[?2004l\ra\u001b[?2004h"]
[225.824444, "o", "> "]
[225.864952, "o", "    local_on_hand={p: parts[p]['on_hand'] for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.86525, "o", "    local_wc=dict(wc_avail)\r\n\u001b[?2004l\revers\u001b[?2004h> "]
[225.865649, "o", "    desc, topo = descendants_and_topo(root, children)\r\n\u001b[?2004l\r"]
[225.86577, "o", "\u001b[?2004h> "]
[225.865983, "o", "    gross=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.866014, "o", "> "]
[225.866231, "o", "    gross[root]=float(qty)\r\n\u001b[?2004l\r"]
[225.866266, "o", "\u001b[?2004h"]
[225.866294, "o", "> "]
[225.866446, "o", "    leaf_req={}\r\n\u001b[?2004l\r \u001b[?2004h"]
[225.866523, "o", "> "]
[225.866796, "o", "    wc_req=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.866909, "o", "> "]
[225.867039, "o", "    manufactured={}\r\n\u001b[?2004l\r"]
[225.867121, "o", "\u001b[?2004h> "]
[225.867284, "o", "    success=True\r\n\u001b[?2004l\r(c\u001b[?2004h"]
[225.867318, "o", "> "]
[225.867587, "o", "    for part in topo:\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.867686, "o", "> "]
[225.868088, "o", "        demand=gross.get(part,0.0)\r\n\u001b[?2004l\r"]
[225.86812, "o", "\u001b[?2004h> "]
[225.868403, "o", "        if demand <= EPS:\r\n\u001b[?2004l\r'ba\u001b[?2004h"]
[225.868443, "o", "> "]
[225.868738, "o", "            continue\r\n\u001b[?2004l\r"]
[225.868776, "o", "\u001b[?2004h> "]
[225.869117, "o", "        if part in children:\r\n\u001b[?2004l\r"]
[225.86915, "o", "\u001b[?2004h> "]
[225.869699, "o", "            # non-leaf: consume current stock\r\n\u001b[?2004l\r"]
[225.869776, "o", "\u001b[?2004h> "]
[225.870255, "o", "            on_hand=local_on_hand.get(part,0.0)\r\n\u001b[?2004l\r"]
[225.870284, "o", "\u001b[?2004h> "]
[225.870839, "o", "            consumed=min(on_hand, demand)\r\n\u001b[?2004l\r"]
[225.870872, "o", "\u001b[?2004h"]
[225.870927, "o", "> "]
[225.871317, "o", "            local_on_hand[part]-=consumed\r\n\u001b[?2004l\r"]
[225.871345, "o", "\u001b[?2004h> "]
[225.871814, "o", "            shortage=demand-consumed\r\n\u001b[?2004l\r"]
[225.871843, "o", "\u001b[?2004h> "]
[225.872214, "o", "            if shortage <= EPS:\r\n\u001b[?2004l\r"]
[225.872243, "o", "\u001b[?2004h> "]
[225.872696, "o", "                manufactured[part]=0\r\n\u001b[?2004l\r \u001b[?2004h"]
[225.872724, "o", "> "]
[225.873016, "o", "                continue\r\n\u001b[?2004l\r"]
[225.873134, "o", "\u001b[?2004h> "]
[225.873463, "o", "            batch=parts[part]['batch']\r\n\u001b[?2004l\r"]
[225.873493, "o", "\u001b[?2004h> "]
[225.873889, "o", "            if batch <= 0:\r\n\u001b[?2004l\r"]
[225.874023, "o", "\u001b[?2004h> "]
[225.874205, "o", "                batch=1\r\n\u001b[?2004l\re"]
[225.874232, "o", "\u001b[?2004h"]
[225.874311, "o", "> "]
[225.874921, "o", "            M=math.ceil(shortage/batch - EPS)*batch\r\n\u001b[?2004l\r"]
[225.874957, "o", "\u001b[?2004h> "]
[225.875339, "o", "            manufactured[part]=M\r\n\u001b[?2004l\r"]
[225.875374, "o", "\u001b[?2004h> "]
[225.875898, "o", "            # capacity consume / record\r\n\u001b[?2004l\ry"]
[225.875926, "o", "\u001b[?2004h> "]
[225.876397, "o", "            for route in routing.get(part,[]):\r\n\u001b[?2004l\r"]
[225.876485, "o", "\u001b[?2004h> "]
[225.877075, "o", "                hours=route['setup'] + M*route['run']\r\n\u001b[?2004l\rpa\u001b[?2004h"]
[225.877103, "o", "> "]
[225.877589, "o", "                wc_req[route['wc']] += hours\r\n\u001b[?2004l\r"]
[225.877677, "o", "\u001b[?2004h> "]
[225.877995, "o", "                if enforce:\r\n\u001b[?2004l\r \u001b[?2004h"]
[225.878024, "o", "> "]
[225.878784, "o", "                    if hours > local_wc.get(route['wc'],0.0) + EPS:\r\n\u001b[?2004l\r"]
[225.878818, "o", "\u001b[?2004h> "]
[225.879323, "o", "                        success=False\r\n\u001b[?2004l\r \u001b[?2004h"]
[225.879353, "o", "> "]
[225.879743, "o", "                        break\r\n\u001b[?2004l\r"]
[225.879842, "o", "\u001b[?2004h> "]
[225.88036, "o", "                    local_wc[route['wc']] -= hours\r\n\u001b[?2004l\r"]
[225.880402, "o", "\u001b[?2004h> "]
[225.880807, "o", "                else:\r\n\u001b[?2004l\r"]
[225.880844, "o", "\u001b[?2004h> "]
[225.881473, "o", "                    local_wc[route['wc']] -= hours\r\n\u001b[?2004l\r"]
[225.881509, "o", "\u001b[?2004h"]
[225.881605, "o", "> "]
[225.882027, "o", "            if enforce and not success:\r\n\u001b[?2004l\r"]
[225.882058, "o", "\u001b[?2004h> "]
[225.882494, "o", "                return {'success':False}\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.882577, "o", "> "]
[225.883033, "o", "            # propagate child demands\r\n\u001b[?2004l\r"]
[225.883063, "o", "\u001b[?2004h> "]
[225.883921, "o", "            for b in children.get(part,[]): # not used; we need bom rows\r\n\u001b[?2004l\r"]
[225.883958, "o", "\u001b[?2004h> "]
[225.884214, "o", "                pass\r\n\u001b[?2004l\r"]
[225.884246, "o", "\u001b[?2004h> "]
[225.884887, "o", "            # Wait, need bom rows not children list.\r\n\u001b[?2004l\r"]
[225.884917, "o", "\u001b[?2004h> "]
[225.885759, "o", "            # Re-fetch bom rows from a bom_by_parent dictionary passed in.\r\n\u001b[?2004l\re\u001b[?2004h"]
[225.885789, "o", "> "]
[225.886334, "o", "            for b in bom_by_parent.get(part,[]):\r\n\u001b[?2004l\r"]
[225.886454, "o", "\u001b[?2004h> "]
[225.886945, "o", "                base=b['qty_per']*M\r\n\u001b[?2004l\r"]
[225.88706, "o", "\u001b[?2004h> "]
[225.887953, "o", "                running=math.ceil(base*(1+b['scrap']/100.0) - EPS)\r\n\u001b[?2004l\r"]
[225.888069, "o", "\u001b[?2004h> "]
[225.888507, "o", "                child_req=running + b['setup_scrap']\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.888628, "o", "> "]
[225.889031, "o", "                gross[b['child']] += child_req\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.88906, "o", "> "]
[225.889579, "o", "            # credit excess into inventory for later orders\r\n\u001b[?2004l\r limi"]
[225.889692, "o", "\u001b[?2004h> "]
[225.890172, "o", "            local_on_hand[part] += (M - shortage)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.890205, "o", "> "]
[225.890347, "o", "        else:\r\n\u001b[?2004l\rloc\u001b[?2004h> "]
[225.891034, "o", "            # leaf: record gross requirement before netting\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.891066, "o", "> "]
[225.891391, "o", "            leaf_req[part]=demand\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.891426, "o", "> "]
[225.891901, "o", "            # consume primary stock first\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.89242, "o", "            on_hand=local_on_hand.get(part,0.0)\r\n\u001b[?2004l\ra"]
[225.892448, "o", "\u001b[?2004h> "]
[225.892959, "o", "            consumed=min(on_hand, demand)\r\n\u001b[?2004l\rfa\u001b[?2004h"]
[225.893167, "o", "> "]
[225.893495, "o", "            local_on_hand[part]-=consumed\r\n\u001b[?2004l\re\u001b[?2004h> "]
[225.893839, "o", "            shortage=demand-consumed\r\n\u001b[?2004l\r"]
[225.893872, "o", "\u001b[?2004h> "]
[225.894162, "o", "            if shortage > EPS:\r\n\u001b[?2004l\r"]
[225.894193, "o", "\u001b[?2004h> "]
[225.894633, "o", "                for s in subs.get(part,[]):\r\n\u001b[?2004l\rd}\u001b[?2004h"]
[225.894681, "o", "> "]
[225.895191, "o", "                    avail_sub=local_on_hand.get(s['sub'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.895222, "o", "> "]
[225.895629, "o", "                    if avail_sub <= EPS or s['ratio'] <= 0:\r\n"]
[225.89572, "o", "\u001b[?2004l\r\u001b[?2004h"]
[225.89579, "o", "> "]
[225.896, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.896461, "o", "                    cover=math.floor(avail_sub / s['ratio'] + EPS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.896492, "o", "> "]
[225.896817, "o", "                    if cover <= 0:\r\n\u001b[?2004l\r"]
[225.896845, "o", "\u001b[?2004h> "]
[225.897081, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899048, "o", "                    take=min(cover, math.ceil(shortage - EPS)) # cover units in primary units; but \"shortage\" may not be integer? Demand should be integer after scrap? Scrap is integer; but could be float? Setup scrap int, running ceil int. So shortage may be integer. Still use numeric.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899227, "o", "                    consume_sub=take*s['ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899523, "o", "                    local_on_hand[s['sub']] = local_on_hand.get(s['sub'],0.0) - consume_sub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899706, "o", "                    shortage -= take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899868, "o", "                    if shortage <= EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.899975, "o", "                        break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900174, "o", "                if enforce and shortage > EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900317, "o", "                    success=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900417, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900536, "o", "    if enforce and not success:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900702, "o", "        return {'success':False}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900818, "o", "    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.900911, "o", "        'success':success,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901036, "o", "        'new_on_hand':local_on_hand,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901137, "o", "        'new_wc':local_wc,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901306, "o", "        'leaf_req':dict(leaf_req),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901395, "o", "        'wc_req':dict(wc_req),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901579, "o", "        'manufactured':manufactured\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n"]
[225.901607, "o", "\u001b[?2004l\r\u001b[?2004h"]
[225.901701, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> D=load_db()"]
[225.90173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901871, "o", "parts=D['parts']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.901966, "o", "children=D['children']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902053, "o", "bom_by_parent=D['bom']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902146, "o", "routing=D['routing']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.90218, "o", "subs=D['subs']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902315, "o", "wc_avail=D['wc']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902604, "o", "orders=sorted(D['orders'], key=lambda o:(o['priority'], o['order_id']), reverse=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902767, "o", "# tie: order_id descending\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.902921, "o", "orders.sort(key=lambda o:o['priority'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.903081, "o", "# stable grouping by priority desc order_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.903167, "o", "orders_sorted=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.90326, "o", "from itertools import groupby\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.90351, "o", "for prio, group in groupby(orders, key=lambda o:o['priority']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.903626, "o", "    grp=list(group)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.903847, "o", "    grp.sort(key=lambda o:o['order_id'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.903957, "o", "    orders_sorted.extend(grp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.903987, "o", "\u001b[?2004h> "]
[225.904211, "o", "cur_parts={p:parts[p]['on_hand'] for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904295, "o", "cur_wc=dict(wc_avail)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904324, "o", "report=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904473, "o", "for o in orders_sorted:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904636, "o", "    prev_parts=dict(cur_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904756, "o", "    prev_wc=dict(cur_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904855, "o", "    product=o['product']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.904958, "o", "    req=o['requested']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905047, "o", "    batch=parts[product]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905184, "o", "    max_batches=req//batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905315, "o", "    allocated_batches=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905411, "o", "    alloc_state=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.90557, "o", "    for n in range(max_batches, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905646, "o", "        qty=n*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.905991, "o", "        res=simulate_bom(parts, children, routing, cur_wc, subs, product, qty, enforce=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.906108, "o", "        if res['success']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.906215, "o", "            allocated_batches=n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.906399, "o", "            alloc_state=res\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.906442, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.9066, "o", "    if allocated_batches is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.906759, "o", "        allocated_batches=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907096, "o", "        alloc_state=simulate_bom(parts, children, routing, cur_wc, subs, product, 0, enforce=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907256, "o", "    allocated_qty=allocated_batches*batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907368, "o", "    shortfall=req-allocated_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907458, "o", "    limiting=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907596, "o", "    if shortfall>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.907762, "o", "        target=allocated_qty+batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.908106, "o", "        sim=simulate_bom(parts, children, routing, prev_wc, subs, product, target, enforce=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
