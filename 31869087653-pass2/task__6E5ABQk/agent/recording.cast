[225.783215, "i", "tch - EPS)*batch\n            manufactured[part]=M\n            # capacity consume / record\n            for route in routing.get(part,[]):\n                hours=route['setup'] + M*route['run']\n                wc_req[route['wc']] += hours\n                if enforce:\n                    if hours > local_wc.get(route['wc'],0.0) + EPS:\n                        success=False\n                        break\n                    local_wc[route['wc']] -= hours\n                else:\n                    local_wc[route['wc']] -= hours\n            if enforce and not success:\n                return {'success':False}\n            # propagate child demands\n            for b in children.get(part,[]): # not used; we need bom rows\n                pass\n            # Wait, need bom rows not children list.\n            # Re-fetch bom rows from a bom_by_parent dictionary passed in.\n            for b in bom_by_parent.get(part,[]):\n                base=b['qty_per']*M\n                running=math.ceil(base*(1+b['scrap']/100.0) - EPS)\n       "]
