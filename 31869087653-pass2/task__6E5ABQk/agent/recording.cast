[353.093789, "o", "                sub_onhand = local_stock.get(sub['sub'], 0.0)\r\n\u001b[?2004l\r          \u001b[?2004h> "]
[353.094091, "o", "                if sub_onhand <= EPS or sub['ratio'] <= EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094238, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094576, "o", "                cover = int(math.floor(sub_onhand / sub['ratio'] + EPS))\r\n\u001b[?2004l\r"]
[353.094665, "o", "\u001b[?2004h> "]
[353.094784, "o", "                if cover <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094913, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.095178, "o", "                need = int(math.ceil(shortage - EPS))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.095361, "o", "                take = min(cover, need)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.095519, "o", "                if take <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.095678, "o", "                    continue\r\n\u001b[?2004l\r  r\u001b[?2004h> "]
[353.096048, "o", "                local_stock[sub['sub']] = sub_onhand - take * sub['ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.096201, "o", "                shortage -= take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.096371, "o", "                if shortage <= EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.096512, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.096627, "o", "> "]
[353.096748, "o", "            if shortage > EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.096956, "o", "                return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h"]
[353.096997, "o", "> "]
[353.097159, "o", "    return local_stock, local_work\r\n\u001b[?2004l\rtoc\u001b[?2004h> \r\n\u001b[?2004l\rk\u001b[?2004h> "]
[353.097196, "o", "\r\n\u001b[?2004l\r \u001b[?2004h"]
[353.097263, "o", "> "]
[353.097727, "o", "def calculate_required_resources(root, qty, stock, children, parts, bom_by_parent, routing_by_parent):\r\n\u001b[?2004l\r r\u001b[?2004h> "]
[353.098125, "o", "    required = {'leaves': defaultdict(float), 'workcenters': defaultdict(float)}\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.098155, "o", "> "]
[353.098228, "o", "    if qty <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.098348, "o", "        return required\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rl"]
[353.098379, "o", "\u001b[?2004h> "]
[353.098614, "o", "    _, topo = topo_for_part(root, children)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.098768, "o", "    gross = defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.098953, "o", "    gross[root] = float(qty)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.098982, "o", "\u001b[?2004h> "]
[353.09908, "o", "    for part in topo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.09928, "o", "        demand = gross.get(part, 0.0)\r\n\u001b[?2004l\rint(\u001b[?2004h> "]
[353.099422, "o", "        if demand <= EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.099539, "o", "            continue\r\n\u001b[?2004l\r/"]
[353.099597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.099798, "o", "        if part in bom_by_parent:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.100001, "o", "            on_hand = stock.get(part, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.100211, "o", "            consume = min(on_hand, demand)\r\n\u001b[?2004l\r\r\n   \u001b[?2004h> "]
[353.100399, "o", "            shortage = demand - consume\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.100488, "o", "            if shortage <= EPS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.100656, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.100733, "o", "> "]
[353.100886, "o", "            batch = parts[part]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.101088, "o", "            build_qty = ceil_to_batch(shortage, batch)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.101321, "o", "            for route in routing_by_parent.get(part, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.101661, "o", "                required['workcenters'][route['wc']] += route['setup'] + build_qty * route['run']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.101704, "o", "\u001b[?2004h> "]
[353.101897, "o", "            for b in bom_by_parent[part]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.102077, "o", "                base = b['qty_per'] * build_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.102365, "o", "                running = math.ceil(base * (1.0 + b['scrap_rate_pct'] / 100.0) - EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.102597, "o", "                child_req = running + b['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.102805, "o", "                gross[b['child']] += child_req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.102846, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.102896, "o", "> "]
[353.103045, "o", "            required['leaves'][part] += demand\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.103085, "o", "> "]
[353.103147, "o", "    return required\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.103185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.103246, "o", "\u001b[?2004h> "]
[353.103328, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.103618, "o", "    parts, bom_by_parent, children, routing_by_parent, workcenters, subs, orders = load_db()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.10371, "o", "\u001b[?2004h> "]
[353.10401, "o", "    # Sort orders by priority ascending, then order_id descending within same priority.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.104125, "o", "    for o in orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.104253, "o", "        o['_priority_key'] = o['priority']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.104486, "o", "    orders.sort(key=lambda o: (o['priority'],), reverse=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.104643, "o", "    from itertools import groupby\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.104758, "o", "    sorted_orders = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.105015, "o", "    for prio, group in groupby(orders, key=lambda o: o['priority']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.105125, "o", "        grp = list(group)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.105326, "o", "        grp.sort(key=lambda o: o['order_id'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.105465, "o", "        sorted_orders.extend(grp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.105503, "o", "> "]
[353.105761, "o", "    current_stock = {p: parts[p]['on_hand'] for p in parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.10591, "o", "    current_work = dict(workcenters)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.105995, "o", "    report = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.10616, "o", "    for order in sorted_orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.106313, "o", "        before_stock = dict(current_stock)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.106471, "o", "        before_work = dict(current_work)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.106674, "o", "        product = order['product']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.106843, "o", "        requested = order['requested']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.107007, "o", "        batch = parts[product]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.107166, "o", "        max_batches = requested // batch\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.10721, "o", "> "]
[353.107308, "o", "        chosen_qty = 0\r\n\u001b[?2004l\r"]
[353.107344, "o", "\u001b[?2004h> "]
[353.107442, "o", "        chosen_stock = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.107574, "o", "        chosen_work = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.10761, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.107791, "o", "        for k in range(max_batches, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.107918, "o", "            qty = k * batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108058, "o", "            result = try_build(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108305, "o", "                product, qty, current_stock, current_work, children,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108521, "o", "                parts, bom_by_parent, routing_by_parent, subs,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108625, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108779, "o", "            if result is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.108936, "o", "                chosen_qty = qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.109118, "o", "                chosen_stock, chosen_work = result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.109233, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.109378, "o", "        allocated_qty = chosen_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.109579, "o", "        shortfall_qty = requested - allocated_qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.109704, "o", "        limiting = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.109742, "o", "\u001b[?2004h> "]
[353.109901, "o", "        if shortfall_qty > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.110074, "o", "            target_qty = allocated_qty + batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.110242, "o", "            req = calculate_required_resources(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.110583, "o", "                product, target_qty, before_stock, children, parts, bom_by_parent, routing_by_parent,\r\n\u001b[?2004l\r"]
[353.110658, "o", "\u001b[?2004h"]
[353.111847, "o", "> "]
[353.11197, "o", "            )\r\n\u001b[?2004l\r"]
[353.112071, "o", "\u001b[?2004h> "]
[353.112275, "o", "            candidates = []\r\n\u001b[?2004l\r"]
[353.112396, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.164309, "o", "\u001b[?2004h> "]
[353.16495, "o", "            for leaf, needed in req['leaves'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.165344, "o", "                if needed <= EPS:\r\n\u001b[?2004l\r"]
[353.165382, "o", "\u001b[?2004h> "]
[353.165823, "o", "                    continue\r\n\u001b[?2004l\r"]
[353.165938, "o", "\u001b[?2004h> "]
[353.166507, "o", "                avail = before_stock.get(leaf, 0.0)\r\n\u001b[?2004l\r"]
[353.166641, "o", "\u001b[?2004h> "]
[353.167195, "o", "                for sub in subs.get(leaf, []):\r\n\u001b[?2004l\r"]
[353.167239, "o", "\u001b[?2004h> "]
[353.168076, "o", "                    sub_onhand = before_stock.get(sub['sub'], 0.0)\r\n\u001b[?2004l\r"]
[353.168115, "o", "\u001b[?2004h> "]
[353.168914, "o", "                    if sub_onhand > EPS and sub['ratio'] > EPS:\r\n\u001b[?2004l\r"]
[353.169033, "o", "\u001b[?2004h> "]
[353.169898, "o", "                        avail += math.floor(sub_onhand / sub['ratio'] + EPS)\r\n\u001b[?2004l\r"]
[353.169994, "o", "\u001b[?2004h> "]
[353.170449, "o", "                ratio = avail / needed\r\n\u001b[?2004l\r"]
[353.170493, "o", "\u001b[?2004h> "]
[353.171026, "o", "                if ratio < 1.0 - EPS:\r\n\u001b[?2004l\r"]
[353.171065, "o", "\u001b[?2004h> "]
[353.17174, "o", "                    candidates.append((ratio, leaf))\r\n\u001b[?2004l\r"]
[353.171782, "o", "\u001b[?2004h> \r\n"]
[353.171848, "o", "\u001b[?2004l\r"]
[353.171893, "o", "\u001b[?2004h> "]
[353.172606, "o", "            for wc, needed in req['workcenters'].items():\r\n\u001b[?2004l\r"]
[353.17272, "o", "\u001b[?2004h> "]
[353.173115, "o", "                if needed <= EPS:\r\n\u001b[?2004l\r"]
[353.17316, "o", "\u001b[?2004h> "]
[353.173528, "o", "                    continue\r\n\u001b[?2004l\r"]
[353.173617, "o", "\u001b[?2004h> "]
[353.174228, "o", "                avail = before_work.get(wc, 0.0)\r\n\u001b[?2004l\r"]
[353.174354, "o", "\u001b[?2004h> "]
[353.174805, "o", "                ratio = avail / needed\r\n\u001b[?2004l\r"]
[353.174848, "o", "\u001b[?2004h"]
[353.174959, "o", "> "]
[353.175409, "o", "                if ratio < 1.0 - EPS:\r\n\u001b[?2004l\r"]
[353.175453, "o", "\u001b[?2004h> "]
[353.176132, "o", "                    candidates.append((ratio, wc))\r\n\u001b[?2004l\r"]
[353.176169, "o", "\u001b[?2004h> \r\n"]
[353.176268, "o", "\u001b[?2004l\r"]
[353.176365, "o", "\u001b[?2004h> "]
[353.176643, "o", "            if candidates:\r\n\u001b[?2004l\r"]
[353.176752, "o", "\u001b[?2004h> "]
[353.177444, "o", "                candidates.sort(key=lambda x: (x[0], x[1]))\r\n\u001b[?2004l\r"]
[353.177587, "o", "\u001b[?2004h> "]
[353.178103, "o", "                limiting = candidates[0][1]\r\n\u001b[?2004l\r"]
[353.178141, "o", "\u001b[?2004h> "]
[353.178208, "o", "\r\n\u001b[?2004l\r"]
[353.178246, "o", "\u001b[?2004h> "]
[353.178763, "o", "        if chosen_stock is not None:\r\n\u001b[?2004l\r"]
[353.178801, "o", "\u001b[?2004h> "]
[353.17933, "o", "            current_stock = chosen_stock\r\n\u001b[?2004l\r"]
[353.179372, "o", "\u001b[?2004h> "]
[353.179898, "o", "            current_work = chosen_work\r\n\u001b[?2004l\r"]
[353.18001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.180101, "o", "\u001b[?2004h> "]
[353.180374, "o", "        report.append({\r\n\u001b[?2004l\r"]
[353.180486, "o", "\u001b[?2004h> "]
[353.181019, "o", "            'order_id': order['order_id'],\r\n\u001b[?2004l\r"]
[353.181058, "o", "\u001b[?2004h> "]
[353.181607, "o", "            'allocated_qty': allocated_qty,\r\n\u001b[?2004l\r"]
[353.181714, "o", "\u001b[?2004h> "]
[353.18221, "o", "            'shortfall_qty': shortfall_qty,\r\n\u001b[?2004l\r"]
[353.182322, "o", "\u001b[?2004h> "]
[353.182836, "o", "            'limiting_resource': limiting,\r\n\u001b[?2004l\r"]
[353.18289, "o", "\u001b[?2004h> "]
[353.183087, "o", "        })\r\n\u001b[?2004l\r"]
[353.183125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.183256, "o", "\u001b[?2004h> "]
[353.183812, "o", "    report.sort(key=lambda x: x['order_id'])\r\n\u001b[?2004l\r"]
[353.183899, "o", "\u001b[?2004h> "]
[353.184307, "o", "    output = {'orders': report}\r\n\u001b[?2004l\r"]
[353.184344, "o", "\u001b[?2004h> "]
[353.184885, "o", "    print(json.dumps(output, indent=2))\r\n\u001b[?2004l\r"]
[353.184927, "o", "\u001b[?2004h> "]
[353.184991, "o", "\r\n\u001b[?2004l\r"]
[353.185101, "o", "\u001b[?2004h> "]
[353.185627, "o", "    with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[353.185757, "o", "\u001b[?2004h> "]
[353.186211, "o", "        json.dump(output, f, indent=2)\r\n\u001b[?2004l\r"]
[353.186247, "o", "\u001b[?2004h> "]
[353.186614, "o", "        f.write('\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.18671, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.186796, "o", "> "]
[353.187043, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
