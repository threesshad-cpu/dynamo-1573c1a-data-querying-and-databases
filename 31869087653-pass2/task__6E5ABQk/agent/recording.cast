[473.256063, "o", "            if c in desc: indeg[c]+=1\r\n\u001b[?2004l\r w"]
[473.256086, "o", "\u001b[?2004h"]
[473.256206, "o", "> "]
[473.256677, "o", "    q=deque([n for n in desc if indeg[n]==0]); top=[]\r\n\u001b[?2004l\r"]
[473.256705, "o", "\u001b[?2004h> "]
[473.256894, "o", "    while q:\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.256923, "o", "> "]
[473.257301, "o", "        n=q.popleft(); top.append(n)\r\n\u001b[?2004l\r"]
[473.257409, "o", "\u001b[?2004h> "]
[473.257725, "o", "        for c in children.get(n,[]):\r\n\u001b[?2004l\r"]
[473.257756, "o", "\u001b[?2004h> "]
[473.25808, "o", "            if c in desc:\r\n\u001b[?2004l\r"]
[473.258111, "o", "\u001b[?2004h> "]
[473.258384, "o", "                indeg[c]-=1\r\n\u001b[?2004l\r"]
[473.258415, "o", "\u001b[?2004h> "]
[473.258903, "o", "                if indeg[c]==0: q.append(c)\r\n\u001b[?2004l\r"]
[473.258933, "o", "\u001b[?2004h> "]
[473.259117, "o", "    return top\r\n\u001b[?2004l\r"]
[473.259203, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[473.259288, "o", "\u001b[?2004h> "]
[473.259446, "o", "def ceilb(s,b):\r\n\u001b[?2004l\r   \u001b[?2004h"]
[473.259538, "o", "> "]
[473.259733, "o", "    if s<=EPS: return 0\r\n\u001b[?2004l\r"]
[473.259764, "o", "\u001b[?2004h> "]
[473.260161, "o", "    return int(math.ceil(s/b-EPS)*b)\r\n\u001b[?2004l\r"]
[473.260282, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[473.260305, "o", "\u001b[?2004h> "]
[473.260705, "o", "def try_build(root,qty,stock,work):\r\n\u001b[?2004l\r['\u001b[?2004h"]
[473.260804, "o", "> "]
[473.26119, "o", "    if qty<=0: return dict(stock),dict(work)\r\n\u001b[?2004l\rch\u001b[?2004h"]
[473.261303, "o", "> "]
[473.261832, "o", "    ls=dict(stock); lw=dict(work); top=topo(root,children)\r\n\u001b[?2004l\r"]
[473.26186, "o", "\u001b[?2004h> "]
[473.262394, "o", "    gross=defaultdict(float); gross[root]=float(qty)\r\n\u001b[?2004l\rn"]
[473.262418, "o", "\u001b[?2004h"]
[473.262466, "o", "> "]
[473.262685, "o", "    for part in top:\r\n\u001b[?2004l\r \u001b[?2004h"]
[473.262773, "o", "> "]
[473.263041, "o", "        demand=gross.get(part,0.0)\r\n\u001b[?2004l\rno"]
[473.263064, "o", "\u001b[?2004h"]
[473.263141, "o", "> "]
[473.263339, "o", "        if demand<=EPS: continue\r\n\u001b[?2004l\rosen\u001b[?2004h"]
[473.263363, "o", "> "]
[473.263593, "o", "        if part in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.26418, "o", "            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.264463, "o", "            if short<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.264935, "o", "            batch=parts[part]['batch']; build=ceilb(short,batch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.265271, "o", "            for rt in routing.get(part,[]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.265307, "o", "> "]
[473.265612, "o", "                h=rt['setup']+build*rt['run']\r\n\u001b[?2004l\r"]
[473.265636, "o", "\u001b[?2004h> "]
[473.266055, "o", "                if lw.get(rt['wc'],0.0)+EPS<h: return None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.266309, "o", "                lw[rt['wc']]-=h\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.266591, "o", "            for b in bom[part]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.26667, "o", "> "]
[473.267112, "o", "                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.267471, "o", "                gross[b['child']]+=run+b['setup']\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.267496, "o", "> "]
[473.267779, "o", "            ls[part]+=(build-short)\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.267804, "o", "> "]
[473.267936, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.267961, "o", "> "]
[473.268564, "o", "            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.26884, "o", "            if short<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.269165, "o", "            for su in subs.get(part,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.269473, "o", "                sa=ls.get(su['sub'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.26991, "o", "                if sa<=EPS or su['ratio']<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.270224, "o", "                cover=int(sa//su['ratio'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.270724, "o", "                need=int(math.ceil(short-EPS)); take=min(cover,need)\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.270749, "o", "> "]
[473.271003, "o", "                if take<=0: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.271099, "o", "> "]
[473.271463, "o", "                ls[su['sub']]=sa-take*su['ratio']; short-=take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.271764, "o", "                if short<=EPS: break\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.271789, "o", "> "]
[473.272055, "o", "            if short>EPS: return None\r\n\u001b[?2004l\r"]
[473.272086, "o", "\u001b[?2004h> "]
[473.272235, "o", "    return ls,lw\r\n\u001b[?2004l\r\u001b[?2004h"]
[473.272259, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[473.272346, "o", "> "]
[473.272517, "o", "def req_res(root,qty,stock):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27295, "o", "    req={'leaves':defaultdict(float),'wc':defaultdict(float)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.273084, "o", "    if qty<=0: return req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.273333, "o", "    top=topo(root,children); gross=defaultdict(float); gross[root]=float(qty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.273427, "o", "    for part in top:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.273574, "o", "        demand=gross.get(part,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27371, "o", "        if demand<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.273805, "o", "        if part in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27407, "o", "            on=stock.get(part,0.0); cons=min(on,demand); short=demand-cons\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27422, "o", "            if short<=EPS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.274408, "o", "            build=ceilb(short,parts[part]['batch'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.274741, "o", "            for rt in routing.get(part,[]): req['wc'][rt['wc']]+=rt['setup']+build*rt['run']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27487, "o", "            for b in bom[part]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.275162, "o", "                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.275337, "o", "                gross[b['child']]+=run+b['setup']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27537, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.275589, "o", "            req['leaves'][part]+=demand\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.275614, "o", "    return req\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[473.275696, "o", "\u001b[?2004h> "]
[473.275863, "o", "parts,bom,children,routing,wc,subs,orders=load()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.275949, "o", "# sort processing order\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.276121, "o", "orders.sort(key=lambda o:o['prio'])\r\n\u001b[?2004l\r\u001b[?2004h> pos=[]\r\n\u001b[?2004l\r"]
[473.276286, "o", "\u001b[?2004h> for prio,g in groupby(orders,key=lambda o:o['prio']):\r\n\u001b[?2004l\r"]
[473.276406, "o", "\u001b[?2004h> "]
[473.276648, "o", "    grp=list(g); grp.sort(key=lambda o:o['oid'], reverse=True); pos.extend(grp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27685, "o", "stock={p:parts[p]['on_hand'] for p in parts}; work=dict(wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.276967, "o", "for o in pos:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.277073, "o", "    if o['oid'] in ['O01','O03']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.277433, "o", "        print('==== BEFORE', o['oid'], 'prod', o['prod'], 'req', o['req'], 'batch', parts[o['prod']]['batch'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.277671, "o", "        print('stock', {k:stock[k] for k in stock if stock[k]})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.277871, "o", "        print('wc', {k:work[k] for k in work if work[k]})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278102, "o", "        batch=parts[o['prod']]['batch']; maxb=o['req']//batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278246, "o", "        feasible=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278368, "o", "        for n in range(maxb,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278523, "o", "            r=try_build(o['prod'], n*batch, stock, work)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278739, "o", "            if r is not None: feasible=n*batch; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278911, "o", "        print('feasible', feasible)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.278997, "o", "        target=feasible+batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.27918, "o", "        req=req_res(o['prod'], target, stock)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.279493, "o", "        print('target',target,'req leaves',dict(req['leaves']),'req wc',dict(req['wc']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.279581, "o", "        cand=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.279779, "o", "        for leaf,needed in req['leaves'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.279885, "o", "            if needed<=0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280072, "o", "            avail=stock.get(leaf,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280217, "o", "            for s in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280378, "o", "                sa=stock.get(s['sub'],0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280534, "o", "                if sa>0 and s['ratio']>0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280732, "o", "                    avail += int(sa//s['ratio'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.280831, "o", "            ratio=avail/needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.281142, "o", "            print('LEAF', leaf, 'needed', needed, 'avail', avail, 'ratio', ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.281343, "o", "            if ratio<1-EPS: cand.append((ratio,leaf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.281512, "o", "        for wcname,needed in req['wc'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.281638, "o", "            if needed<=0: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.281868, "o", "            avail=work.get(wcname,0.0); ratio=avail/needed\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282169, "o", "            print('WC', wcname, 'needed', needed, 'avail', avail, 'ratio', ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282357, "o", "            if ratio<1-EPS: cand.append((ratio,wcname))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.28247, "o", "        print('cands', cand)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282604, "o", "        print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282717, "o", "    # commit actual chosen allocation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282922, "o", "    batch=parts[o['prod']]['batch']; maxb=o['req']//batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.282996, "o", "    chosen=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.283102, "o", "    for n in range(maxb,-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.28332, "o", "        r=try_build(o['prod'], n*batch, stock, work)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.283384, "o", "        if r is not None:\r\n\u001b[?2004l\r"]
[473.283401, "o", "\u001b[?2004h> "]
[473.283585, "o", "            chosen=r; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.283685, "o", "    if chosen is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.283759, "o", "        stock,work=chosen\r\n\u001b[?2004l\r\u001b[?2004h> "]
[473.283787, "o", "PY\r\n\u001b[?2004l\r"]
