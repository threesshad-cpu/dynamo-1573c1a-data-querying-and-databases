[473.228229, "i", "python3 - <<'PY'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\nfrom itertools import groupby\n\nDB='/app/manufacturing.db'; EPS=1e-9\n\ndef load():\n    conn=sqlite3.connect(DB); conn.row_factory=sqlite3.Row; cur=conn.cursor()\n    parts={}\n    for r in cur.execute('SELECT part_id,on_hand_qty,batch_size FROM parts'):\n        parts[r['part_id']]={'on_hand':float(r['on_hand_qty']),'batch':int(r['batch_size'])}\n    bom=defaultdict(list); children=defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id,child_part_id,qty_per,scrap_rate_pct,setup_scrap_qty FROM bom'):\n        bom[r['parent_part_id']].append({'child':r['child_part_id'],'qty_per':int(r['qty_per']),'scrap':float(r['scrap_rate_pct']),'setup':int(r['setup_scrap_qty'])})\n        children[r['parent_part_id']].append(r['child_part_id'])\n    routing=defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id,workcenter_id,setup_hours,run_hours_per_unit FROM routing'):\n        routing[r['parent_part_id']].append({'wc':r['wor"]
[473.228318, "i", "kcenter_id'],'setup':float(r['setup_hours']),'run':float(r['run_hours_per_unit'])})\n    wc={}\n    for r in cur.execute('SELECT workcenter_id,available_hours FROM workcenters'): wc[r['workcenter_id']]=float(r['available_hours'])\n    subs=defaultdict(list)\n    for r in cur.execute('SELECT primary_part_id,substitute_part_id,qty_ratio,preference_rank FROM substitutes ORDER BY primary_part_id,preference_rank,substitute_part_id'):\n        subs[r['primary_part_id']].append({'sub':r['substitute_part_id'],'ratio':float(r['qty_ratio'])})\n    orders=[]\n    for r in cur.execute('SELECT order_id,product_part_id,requested_qty,priority FROM orders'):\n        orders.append({'oid':r['order_id'],'prod':r['product_part_id'],'req':int(r['requested_qty']),'prio':int(r['priority'])})\n    conn.close(); return parts,bom,children,routing,wc,subs,orders\n\ndef topo(root,children):\n    desc=set(); stack=[root]\n    while stack:\n        p=stack.pop()\n        if p in desc: continue\n        desc.add(p)\n        for c in children.get(p,[]):\n  "]
[473.228582, "i", "          if c not in desc: stack.append(c)\n    indeg={n:0 for n in desc}\n    for p in desc:\n        for c in children.get(p,[]):\n            if c in desc: indeg[c]+=1\n    q=deque([n for n in desc if indeg[n]==0]); top=[]\n    while q:\n        n=q.popleft(); top.append(n)\n        for c in children.get(n,[]):\n            if c in desc:\n                indeg[c]-=1\n                if indeg[c]==0: q.append(c)\n    return top\n\ndef ceilb(s,b):\n    if s<=EPS: return 0\n    return int(math.ceil(s/b-EPS)*b)\n\ndef try_build(root,qty,stock,work):\n    if qty<=0: return dict(stock),dict(work)\n    ls=dict(stock); lw=dict(work); top=topo(root,children)\n    gross=defaultdict(float); gross[root]=float(qty)\n    for part in top:\n        demand=gross.get(part,0.0)\n        if demand<=EPS: continue\n        if part in bom:\n            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\n            if short<=EPS: continue\n            batch=parts[part]['batch']; build=ceilb(short,batch)\n            for rt in rout"]
[473.228625, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[473.228706, "i", "ing.get(part,[]):\n                h=rt['setup']+build*rt['run']\n                if lw.get(rt['wc'],0.0)+EPS<h: return None\n                lw[rt['wc']]-=h\n            for b in bom[part]:\n                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\n                gross[b['child']]+=run+b['setup']\n            ls[part]+=(build-short)\n        else:\n            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\n            if short<=EPS: continue\n            for su in subs.get(part,[]):\n                sa=ls.get(su['sub'],0.0)\n                if sa<=EPS or su['ratio']<=EPS: continue\n                cover=int(sa//su['ratio'])\n                need=int(math.ceil(short-EPS)); take=min(cover,need)\n                if take<=0: continue\n                ls[su['sub']]=sa-take*su['ratio']; short-=take\n                if short<=EPS: break\n            if short>EPS: return None\n    return ls,lw\n\ndef req_res(root,qty,stock):\n    req={'leaves':defaultdict(float),'wc':defaultdict(float)}\n "]
[473.228834, "o", "\u001b[?2004h> "]
[473.228877, "i", "   if qty<=0: return req\n    top=topo(root,children); gross=defaultdict(float); gross[root]=float(qty)\n    for part in top:\n        demand=gross.get(part,0.0)\n        if demand<=EPS: continue\n        if part in bom:\n            on=stock.get(part,0.0); cons=min(on,demand); short=demand-cons\n            if short<=EPS: continue\n            build=ceilb(short,parts[part]['batch'])\n            for rt in routing.get(part,[]): req['wc'][rt['wc']]+=rt['setup']+build*rt['run']\n            for b in bom[part]:\n                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\n                gross[b['child']]+=run+b['setup']\n        else:\n            req['leaves'][part]+=demand\n    return req\n\nparts,bom,children,routing,wc,subs,orders=load()\n# sort processing order\norders.sort(key=lambda o:o['prio'])\npos=[]\nfor prio,g in groupby(orders,key=lambda o:o['prio']):\n    grp=list(g); grp.sort(key=lambda o:o['oid'], reverse=True); pos.extend(grp)\nstock={p:parts[p]['on_hand'] for p in parts}; work=dict(wc)\nfor o in pos:\n "]
[473.228957, "i", "   if o['oid'] in ['O01','O03']:\n        print('==== BEFORE', o['oid'], 'prod', o['prod'], 'req', o['req'], 'batch', parts[o['prod']]['batch'])\n        print('stock', {k:stock[k] for k in stock if stock[k]})\n        print('wc', {k:work[k] for k in work if work[k]})\n        batch=parts[o['prod']]['batch']; maxb=o['req']//batch\n        feasible=None\n        for n in range(maxb,-1,-1):\n            r=try_build(o['prod'], n*batch, stock, work)\n            if r is not None: feasible=n*batch; break\n        print('feasible', feasible)\n        target=feasible+batch\n        req=req_res(o['prod'], target, stock)\n        print('target',target,'req leaves',dict(req['leaves']),'req wc',dict(req['wc']))\n        cand=[]\n        for leaf,needed in req['leaves'].items():\n            if needed<=0: continue\n            avail=stock.get(leaf,0.0)\n            for s in subs.get(leaf,[]):\n                sa=stock.get(s['sub'],0.0)\n                if sa>0 and s['ratio']>0:\n                    avail += int(sa//s['ratio'])\n            r"]
[473.229056, "o", "import sqlite3, math, json\r\n\u001b[?2004l\rot,"]
[473.229088, "i", "atio=avail/needed\n            print('LEAF', leaf, 'needed', needed, 'avail', avail, 'ratio', ratio)\n            if ratio<1-EPS: cand.append((ratio,leaf))\n        for wcname,needed in req['wc'].items():\n            if needed<=0: continue\n            avail=work.get(wcname,0.0); ratio=avail/needed\n            print('WC', wcname, 'needed', needed, 'avail', avail, 'ratio', ratio)\n            if ratio<1-EPS: cand.append((ratio,wcname))\n        print('cands', cand)\n        print()\n    # commit actual chosen allocation\n    batch=parts[o['prod']]['batch']; maxb=o['req']//batch\n    chosen=None\n    for n in range(maxb,-1,-1):\n        r=try_build(o['prod'], n*batch, stock, work)\n        if r is not None:\n            chosen=r; break\n    if chosen is not None:\n        stock,work=chosen\nPY\n"]
