[225.78348, "i", "should be integer after scrap? Scrap is integer; but could be float? Setup scrap int, running ceil int. So shortage may be integer. Still use numeric.\n                    consume_sub=take*s['ratio']\n                    local_on_hand[s['sub']] = local_on_hand.get(s['sub'],0.0) - consume_sub\n                    shortage -= take\n                    if shortage <= EPS:\n                        break\n                if enforce and shortage > EPS:\n                    success=False\n                    break\n    if enforce and not success:\n        return {'success':False}\n    return {\n        'success':success,\n        'new_on_hand':local_on_hand,\n        'new_wc':local_wc,\n        'leaf_req':dict(leaf_req),\n        'wc_req':dict(wc_req),\n        'manufactured':manufactured\n    }\n\nD=load_db()\nparts=D['parts']\nchildren=D['children']\nbom_by_parent=D['bom']\nrouting=D['routing']\nsubs=D['subs']\nwc_avail=D['wc']\norders=sorted(D['orders'], key=lambda o:(o['priority'], o['order_id']), reverse=False)\n# tie: order_id descending"]
[225.78352, "i", "\norders.sort(key=lambda o:o['priority'])\n# stable grouping by priority desc order_id\norders_sorted=[]\nfrom itertools import groupby\nfor prio, group in groupby(orders, key=lambda o:o['priority']):\n    grp=list(group)\n    grp.sort(key=lambda o:o['order_id'], reverse=True)\n    orders_sorted.extend(grp)\n\ncur_parts={p:parts[p]['on_hand'] for p in parts}\ncur_wc=dict(wc_avail)\nreport=[]\nfor o in orders_sorted:\n    prev_parts=dict(cur_parts)\n    prev_wc=dict(cur_wc)\n    product=o['product']\n    req=o['requested']\n    batch=parts[product]['batch']\n    max_batches=req//batch\n    allocated_batches=None\n    alloc_state=None\n    for n in range(max_batches, -1, -1):\n        qty=n*batch\n        res=simulate_bom(parts, children, routing, cur_wc, subs, product, qty, enforce=True)\n        if res['success']:\n            allocated_batches=n\n            alloc_state=res\n            break\n    if allocated_batches is None:\n        allocated_batches=0\n        alloc_state=simulate_bom(parts, children, routing, cur_wc, subs, product, 0"]
[225.783649, "i", ", enforce=True)\n    allocated_qty=allocated_batches*batch\n    shortfall=req-allocated_qty\n    limiting=None\n    if shortfall>0:\n        target=allocated_qty+batch\n        sim=simulate_bom(parts, children, routing, prev_wc, subs, product, target, enforce=False)\n        candidates=[]\n        # leaf resources\n        for leaf, needed in sim['leaf_req'].items():\n            if needed <= EPS:\n                continue\n            avail=prev_parts.get(leaf,0.0)\n            for s in subs.get(leaf,[]):\n                sub_onhand=prev_parts.get(s['sub'],0.0)\n                if sub_onhand > EPS and s['ratio'] > 0:\n                    cover=math.floor(sub_onhand / s['ratio'] + EPS)\n                    avail += cover\n            ratio=avail/needed\n            if ratio < 1.0 - EPS:\n                candidates.append((ratio, leaf))\n        for wc, needed in sim['wc_req'].items():\n            if needed <= EPS:\n                continue\n            avail=prev_wc.get(wc,0.0)\n            ratio=avail/needed\n            if ratio < "]
