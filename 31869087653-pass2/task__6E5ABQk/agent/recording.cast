[12.454795, "i", "python3 - <<'PY'\nimport sqlite3\nconn=sqlite3.connect('/app/manufacturing.db')\ncur=conn.cursor()\ncur.execute(\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\")\nprint(cur.fetchall())\nfor table in ['parts','bom','workcenters','routing','substitutes','orders']:\n    print('\\nTABLE', table)\n    cur.execute(f'PRAGMA table_info({table})')\n    print(cur.fetchall())\n    cur.execute(f'SELECT * FROM {table} LIMIT 20')\n    print(cur.fetchall())\nconn.close()\nPY\n"]
