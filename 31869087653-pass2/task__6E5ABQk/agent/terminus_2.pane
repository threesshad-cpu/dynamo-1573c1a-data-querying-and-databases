[?2004l[]):
            if c not in desc: stack.append(c)
    indeg={n:0 for n in desc}
    for p in desc:
        for c in children.get(p,[]):
            if c in desc: indeg[c]+=1
    q=deque([n for n in desc if indeg[n]==0]); top=[]
    while q:
        n=q.popleft(); top.append(n)
        for c in children.get(n,[]):
            indeg[c]-=1
            if indeg[c]==0: q.append(c)
    return desc,top

def ceil_to_batch(s,b):
    s=max(0.0,s)
    if s<=EPS: return 0
    return int(math.ceil(s/b-EPS)*b)

def try_build(root,qty,stock,work):
    if qty<=0: return dict(stock),dict(work)
    ls=dict(stock); lw=dict(work); _,top=topo(root,children)
    gross=defaultdict(float); gross[root]=float(qty)
    for part in top:
        demand=gross.get(part,0.0)
        if demand<=EPS: continue
        if part in bom:
            on_hand=ls.get(part,0.0); consume=min(on_hand,demand); ls[part]=on_hand-consume
            shortage=demand-consume
            if shortage<=EPS: continue
            b=parts[part]['batch']; build=ceil_to_batch(shortage,b)
            for rt in routing.get(part,[]):
                h=rt['setup']+build*rt['run']
                if lw.get(rt['wc'],0.0)+EPS < h: return None
                lw[rt['wc']]-=h
            for b in bom[part]:
                base=b['qty_per']*build
                running=math.ceil(base*(1+b['scrap']/100.0)-EPS)
                gross[b['child']]+=running+b['setup_scrap']
            ls[part]+=(build-shortage)
        else:
            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons
            if short<=EPS: continue
            for su in subs.get(part,[]):
                sa=ls.get(su['sub'],0.0)
                if sa<=EPS or su['ratio']<=EPS: continue
                cover=int(sa//su['ratio'])
                need=int(math.ceil(short-EPS))
                take=min(cover,need)
                if take<=0: continue
                ls[su['sub']]=sa-take*su['ratio']; short-=take
                if short<=EPS: break
            if short>EPS: return None
    return ls,lw
