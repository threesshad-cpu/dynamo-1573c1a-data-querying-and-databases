[?2004l[?2004h> def descendants_and_topo(root, children):
[?2004l[?2004h>     desc=set()
[?2004lh[?2004h>     stack=[root]
[?2004l[?2004h>     while stack:
[?2004l([?2004h>         p=stack.pop()
[?2004lm[?2004h>         if p in desc:
[?2004l[?2004h>             continue
[?2004l
[?2004h>         desc.add(p)
[?2004l[?2004h>         for c in children.get(p,[]):
[?2004l[?2004h>             if c not in desc:
[?2004l[?2004h>                 stack.append(c)
[?2004l[?2004h>     indeg={n:0 for n in desc}
[?2004l[?2004h>     for p in desc:
[?2004l[?2004h>         for c in children.get(p,[]):
[?2004l[?2004h>             if c in desc:
[?2004le[?2004h>                 indeg[c]=indeg.get(c,0)+1
[?2004l:[?2004h>     q=deque([n for n in desc if indeg.get(n,0)==0])
[?2004l[?2004h>     topo=[]
[?2004lc':l[?2004h>     while q:
[?2004l[?2004h>         n=q.popleft()
