pop()\n        if p in desc: continue\n        desc.add(p)\n        for c in children.get(p,[]):\n            if c not in desc: stack.append(c)\n    indeg={n:0 for n in desc}\n    for p in desc:\n        for c in children.get(p,[]):\n            if c in desc: indeg[c]+=1\n    q=deque([n for n in desc if indeg[n]==0]); top=[]\n    while q:\n        n=q.popleft(); top.append(n)\n        for c in children.get(n,[]):\n            if c in desc:\n                indeg[c]-=1\n                if indeg[c]==0: q.append(c)\n    return top\n\ndef ceilb(s,b):\n    if s<=EPS: return 0\n    return int(math.ceil(s/b-EPS)*b)\n\ndef try_build(root,qty,stock,work):\n    if qty<=0: return dict(stock),dict(work)\n    ls=dict(stock); lw=dict(work); top=topo(root,children)\n    gross=defaultdict(float); gross[root]=float(qty)\n    for part in top:\n        demand=gross.get(part,0.0)\n        if demand<=EPS: continue\n        if part in bom:\n            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\n            if short<=EPS: continue\n            batch=parts[part]['batch']; build=ceilb(short,batch)\n            for rt in routing.get(part,[]):\n                h=rt['setup']+build*rt['run']\n                if lw.get(rt['wc'],0.0)+EPS<h: return None\n                lw[rt['wc']]-=h\n            for b in bom[part]:\n                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\n                gross[b['child']]+=run+b['setup']\n            ls[part]+=(build-short)\n        else:\n            on=ls.get(part,0.0); cons=min(on,demand); ls[part]=on-cons; short=demand-cons\n            if short<=EPS: continue\n            for su in subs.get(part,[]):\n                sa=ls.get(su['sub'],0.0)\n                if sa<=EPS or su['ratio']<=EPS: continue\n                cover=int(sa//su['ratio'])\n                need=int(math.ceil(short-EPS)); take=min(cover,need)\n                if take<=0: continue\n                ls[su['sub']]=sa-take*su['ratio']; short-=take\n                if short<=EPS: break\n            if short>EPS: return None\n    return ls,lw\n\ndef req_res(root,qty,stock):\n    req={'leaves':defaultdict(float),'wc':defaultdict(float)}\n    if qty<=0: return req\n    top=topo(root,children); gross=defaultdict(float); gross[root]=float(qty)\n    for part in top:\n        demand=gross.get(part,0.0)\n        if demand<=EPS: continue\n        if part in bom:\n            on=stock.get(part,0.0); cons=min(on,demand); short=demand-cons\n            if short<=EPS: continue\n            build=ceilb(short,parts[part]['batch'])\n            for rt in routing.get(part,[]): req['wc'][rt['wc']]+=rt['setup']+build*rt['run']\n            for b in bom[part]:\n                run=math.ceil(b['qty_per']*build*(1+b['scrap']/100.0)-EPS)\n                gross[b['child']]+=run+b['setup']\n        else:\n            req['leaves'][part]+=demand\n    return req\n\nparts,bom,children,routing,wc,subs,orders=load()\n# sort processing order\norders.sort(key=lambda o:o['prio'])\npos=[]\nfor prio,g in groupby(orders,key=lambda o:o['prio']):\n    grp=list(g); grp.sort(key=lambda o:o['oid'], reverse=True); pos.extend(grp)\nstock={p:parts[p]['on_hand'] for p in parts}; work=dict(wc)\nfor o in pos:\n    if o['oid'] in ['O01','O03']:\n        print('==== BEFORE', o['oid'], 'prod', o['prod'], 'req', o['req'], 'batch', parts[o['prod']]['batch'])\n        print('stock', {k:stock[k] for k in stock if stock[k]})\n        print('wc', {k:work[k] for k in work if work[k]})\n        batch=parts[o['prod']]['batch']; maxb=o['req']//batch\n        feasible=None\n        for n in range(maxb,-1,-1):\n            r=try_build(o['prod'], n*batch, stock, work)\n            if r is not None: feasible=n*batch; break\n        print('feasible', feasible)\n        target=feasible+batch\n        req=req_res(o['prod'], target, stock)\n        print('target',target,'req leaves',dict(req['leaves']),'req wc',dict(req['wc']))\n        cand=[]\n        for leaf,neede