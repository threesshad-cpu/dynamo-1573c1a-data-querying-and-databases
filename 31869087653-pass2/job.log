Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, math, copy, json\nfrom collections import defaultdict\n\nDB=\'/app/manufacturing.db\'\nconn=sqlite3.connect(DB)\nconn.row_factory=sqlite3.Row\ncur=conn.cursor()\n\nparts = {}\ncur.execute(\'SELECT * FROM parts\')\nfor r in cur.fetchall():\n    d=dict(r)\n    parts[d[\'part_id\']]={\'name\':d[\'name\'],\'on_hand_qty\':d[\'on_hand_qty\'],\'batch_size\':d[\'batch_size\']}\n\nbom = defaultdict(list)\nparents=set()\nchildren=set()\ncur.execute(\'SELECT * FROM bom\')\nfor r in cur.fetchall():\n    d=dict(r)\n    bom[d[\'parent_part_id\']].append(d)\n    parents.add(d[\'parent_part_id\'])\n    children.add(d[\'child_part_id\'])\n\nworkcenters={}\ncur.execute(\'SELECT * FROM workcenters\')\nfor r in cur.fetchall():\n    d=dict(r)\n    workcenters[d[\'workcenter_id\']]=d[\'available_hours\']\n\nrouting = defaultdict(list)\ncur.execute(\'SELECT * FROM routing\')\nfor r in cur.fetchall():\n    d=dict(r)\n    routing[d[\'parent_part_id\']].append(d)\n\nsubs = defaultdict(list)\ncur.execute(\'SELECT * FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id\')\nfor r in cur.fetchall():\n    d=dict(r)\n    subs[d[\'primary_part_id\']].append(d)\n\norders=[]\ncur.execute(\'SELECT * FROM orders ORDER BY priority ASC, order_id DESC\')\nfor r in cur.fetchall():\n    d=dict(r)\n    orders.append(d)\nconn.close()\n\nall_part_ids=list(parts.keys())\n# compute low-level codes: top-level parts = not children\nlevel={p:0 for p in all_part_ids}\n# Kahn topological: parents -> children\nindeg={p:0 for p in all_part_ids}\ngraph=defaultdict(list)\nfor p,childlist in bom.items():\n    for b in childlist:\n        child=b[\'child_part_id\']\n        graph[p].append(child)\n        indeg[child]+=1\nqueue=[p for p in all_part_ids if indeg[p]==0]\nqueue.sort()\ntopo=[]\nwhile queue:\n    p=queue.pop(0)\n    topo.append(p)\n    for c in graph[p]:\n        if level[p]+1 > level[c]:\n            level[c]=level[p]+1\n        indeg[c]-=1\n        if indeg[c]==0:\n            queue.append(c)\n            queue.sort()\n# sanity: all parts topo? probably yes; if DAG incomplete, levels might be low\nprint(\'Levels:\')\nfor p in sorted(all_part_ids, key=lambda x:(level[x],x)):\n    print(f\'{p}: {level[p]}\')\nprint(\'Topo len\', len(topo))\n\nsorted_parts_by_level=[p for p in sorted(all_part_ids, key=lambda x:(level[x], x))]\n\ndef deep_copy_state(inv, wcav):\n    return (dict(inv), dict(wcav))\n\ndef attempt_build(product_id, total_qty, state_inv, state_wc):\n    # state_inv and state_wc are mutated; returns bool success\n    inv = state_inv\n    wcav = state_wc\n    demands = defaultdict(float)\n    demands[product_id] += total_qty\n    for p in sorted_parts_by_level:\n        qty = demands.get(p, 0.0)\n        if qty <= 1e-12:\n            continue\n        # consume primary stock\n        avail = inv[p]\n        consume = min(qty, avail)\n        inv[p] = avail - consume\n        rem = qty - consume\n        if rem <= 1e-12:\n            continue\n        if p in parents or p in routing:\n            # manufactured part\n            batch = parts[p][\'batch_size\']\n            build_qty = int(math.ceil(rem / batch - 1e-12)) * batch\n            # route hours\n            for rt in routing[p]:\n                wc = rt[\'workcenter_id\']\n                hrs = rt[\'setup_hours\'] + build_qty * rt[\'run_hours_per_unit\']\n                if hrs > wcav[wc] + 1e-9:\n                    return False\n                wcav[wc] -= hrs\n            # child requirements\n            for b in bom[p]:\n                child=b[\'child_part_id\']\n                base=b[\'qty_per\'] * build_qty\n                adj = math.ceil(base * (1.0 + b[\'scrap_rate_pct\']/100.0) - 1e-12) + b[\'setup_scrap_qty\']\n                demands[child] += adj\n            # excess credit\n            if build_qty > rem:\n                inv[p] += build_qty - rem\n        else:\n            # leaf; use substitutes for rem\n 