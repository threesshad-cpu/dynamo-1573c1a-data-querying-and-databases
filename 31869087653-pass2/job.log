Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, math, json\nfrom collections import defaultdict, deque\n\nDB=\'/app/manufacturing.db\'\nEPS=1e-9\n\ndef load_db():\n    conn=sqlite3.connect(DB)\n    conn.row_factory=sqlite3.Row\n    cur=conn.cursor()\n    data={}\n    data[\'parts\']={}\n    for r in cur.execute(\'SELECT part_id, on_hand_qty, batch_size FROM parts\'):\n        data[\'parts\'][r[\'part_id\']]={\'on_hand\':float(r[\'on_hand_qty\']), \'batch\':int(r[\'batch_size\'])}\n    data[\'bom\']=defaultdict(list)\n    data[\'children\']=defaultdict(list)\n    for r in cur.execute(\'SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom\'):\n        row={\n            \'child\': r[\'child_part_id\'],\n            \'qty_per\': int(r[\'qty_per\']),\n            \'scrap\': float(r[\'scrap_rate_pct\']),\n            \'setup_scrap\': int(r[\'setup_scrap_qty\'])\n        }\n        data[\'bom\'][r[\'parent_part_id\']].append(row)\n        data[\'children\'][r[\'parent_part_id\']].append(r[\'child_part_id\'])\n    data[\'routing\']=defaultdict(list)\n    for r in cur.execute(\'SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing\'):\n        data[\'routing\'][r[\'parent_part_id\']].append({\n            \'wc\': r[\'workcenter_id\'],\n            \'setup\': float(r[\'setup_hours\']),\n            \'run\': float(r[\'run_hours_per_unit\'])\n        })\n    data[\'wc\']={}\n    for r in cur.execute(\'SELECT workcenter_id, available_hours FROM workcenters\'):\n        data[\'wc\'][r[\'workcenter_id\']]=float(r[\'available_hours\'])\n    data[\'subs\']=defaultdict(list)\n    for r in cur.execute(\'SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes ORDER BY primary_part_id, preference_rank, substitute_part_id\'):\n        data[\'subs\'][r[\'primary_part_id\']].append({\n            \'sub\': r[\'substitute_part_id\'],\n            \'ratio\': float(r[\'qty_ratio\'])\n        })\n    data[\'orders\']=[]\n    for r in cur.execute(\'SELECT order_id, product_part_id, requested_qty, priority FROM orders\'):\n        data[\'orders\'].append({\n            \'order_id\': r[\'order_id\'],\n            \'product\': r[\'product_part_id\'],\n            \'requested\': int(r[\'requested_qty\']),\n            \'priority\': int(r[\'priority\'])\n        })\n    conn.close()\n    return data\n\ndef descendants_and_topo(root, children):\n    desc=set()\n    stack=[root]\n    while stack:\n        p=stack.pop()\n        if p in desc:\n            continue\n        desc.add(p)\n        for c in children.get(p,[]):\n            if c not in desc:\n                stack.append(c)\n    indeg={n:0 for n in desc}\n    for p in desc:\n        for c in children.get(p,[]):\n            if c in desc:\n                indeg[c]=indeg.get(c,0)+1\n    q=deque([n for n in desc if indeg.get(n,0)==0])\n    topo=[]\n    while q:\n        n=q.popleft()\n        topo.append(n)\n        for c in children.get(n,[]):\n            if c in indeg:\n                indeg[c]-=1\n                if indeg[c]==0:\n                    q.append(c)\n    # fallback if graph has cycle; should not happen\n    if len(topo)!=len(desc):\n        # Add remaining in arbitrary desc order\n        for n in desc:\n            if n not in topo:\n                topo.append(n)\n    return desc, topo\n\ndef simulate_bom(parts, children, routing, wc_avail, subs, root, qty, enforce=True):\n    local_on_hand={p: parts[p][\'on_hand\'] for p in parts}\n    local_wc=dict(wc_avail)\n    desc, topo = descendants_and_topo(root, children)\n    gross=defaultdict(float)\n    gross[root]=float(qty)\n    leaf_req={}\n    wc_req=defaultdict(float)\n    manufactured={}\n    success=True\n    for part in topo:\n        demand=gross.get(part,0.0)\n        if demand <= EPS:\n            continue\n        if part in children:\n            # non-leaf: consume current stock\n            on_hand=local_on_hand.get(part,0.0)\n            consumed=min(on_hand, demand)\n            local_on_hand[part]-=consumed\n            shortage=demand-consumed\n            if shortage <= EPS:\n                manufactured[part]=0\n                continue\n            batch=parts[part][\'batch\']\n            if batch <= 0:\n                batch=1\n            M=math.ceil(shortage/batch - EPS)*batch\n            manufactured[part]=M\n            # capacity consume / record\n            for route in routing.get(part,[]):\n                hours=route[\'setup\'] + M*route[\'run\']\n                wc_req[route[\'wc\']] += hours\n                if enforce:\n                    if hours > local_wc.get(route[\'wc\'],0.0) + EPS:\n                        success=False\n                        break\n                    local_wc[route[\'wc\']] -= hours\n                else:\n                    local_wc[route[\'wc\']] -= hours\n            if enforce and not success:\n                return {\'success\':False}\n            # propagate child demands\n            for b in children.get(part,[]): # not used; we need bom rows\n                pass\n            # Wait, need bom rows not children list.\n            # Re-fetch bom rows from a bom_by_parent dictionary passed in.\n            for b in bom_by_parent.get(part,[]):\n                base=b[\'qty_per\']*M\n                running=math.ceil(base*(1+b[\'scrap\']/100.0) - EPS)\n                child_req=running + b[\'setup_scrap\']\n                gross[b[\'child\']] += child_req\n            # credit excess into inventory for later orders\n            local_on_hand[part] += (M - shortage)\n        else:\n            # leaf: record gross requirement before netting\n            leaf_req[part]=demand\n            # consume primary stock first\n            on_hand=local_on_hand.get(part,0.0)\n            consumed=min(on_hand, demand)\n            local_on_hand[part]-=consumed\n            shortage=demand-consumed\n            if shortage > EPS:\n                for s in subs.get(part,[]):\n                    avail_sub=local_on_hand.get(s[\'sub\'],0.0)\n                    if avail_sub <= EPS or s[\'ratio\'] <= 0:\n                        continue\n                    cover=math.floor(avail_sub / s[\'ratio\'] + EPS)\n                    if cover <= 0:\n                        continue\n                    take=min(cover, math.ceil(shortage - EPS)) # cover units in primary units; but "shortage" may not be integer? Demand should be integer after scrap? Scrap is integer; but could be float? Setup scrap int, running ceil int. So shortage may be integer. Still use numeric.\n                    consume_sub=take*s[\'ratio\']\n                    local_on_hand[s[\'sub\']] = local_on_hand.get(s[\'sub\'],0.0) - consume_sub\n                    shortage -= take\n                    if shortage <= EPS:\n                        break\n                if enforce and shortage > EPS:\n                    success=False\n                    break\n    if enforce and not success:\n        return {\'success\':False}\n    return {\n        \'success\':success,\n        \'new_on_hand\':local_on_hand,\n        \'new_wc\':local_wc,\n        \'leaf_req\':dict(leaf_req),\n        \'wc_req\':dict(wc_req),\n        \'manufactured\':manufactured\n    }\n\nD=load_db()\nparts=D[\'parts\']\nchildren=D[\'children\']\nbom_by_parent=D[\'bom\']\nrouting=D[\'routing\']\nsubs=D[\'subs\']\nwc_avail=D[\'wc\']\norders=sorted(D[\'orders\'], key=lambda o:(o[\'priority\'], o[\'order_id\']), reverse=False)\n# tie: order_id descending\norders.sort(key=lambda o:o[\'priority\'])\n# stable grouping by priority desc order_id\norders_sorted=[]\nfrom itertools import groupby\nfor prio, group in groupby(orders, key=lambda o:o[\'priority\']):\n    grp=list(group)\n    grp.sort(key=lambda o:o[\'order_id\'], reverse=True)\n    orders_sorted.extend(grp)\n\ncur_parts={p:parts[p][\'on_hand\'] for p in parts}\ncur_wc=dict(wc_avail)\nreport=[]\nfor o in orders_sorted:\n    prev_parts=dict(cur_parts)\n    prev_wc=dict(cur_wc)\n    product=o[\'product\']\n    req=o[\'requested\']\n    batch=parts[product][\'batch\']\n    max_batches=req//batch\n    allocated_batches=None\n    alloc_state=None\n    for n in range(max_batches, -1, -1):\n        qty=n*batch\n        res=simulate_bom(parts, children, routing, cur_wc, subs, product, qty, enforce=True)\n        if res[\'success\']:\n            allocated_batches=n\n            alloc_state=res\n            break\n    if allocated_batches is None:\n        allocated_batches=0\n        alloc_state=simulate_bom(parts, children, routing, cur_wc, subs, product, 0, enforce=True)\n    allocated_qty=allocated_batches*batch\n    shortfall=req-allocated_qty\n    limiting=None\n    if shortfall>0:\n        target=allocated_qty+batch\n        sim=simulate_bom(parts, children, routing, prev_wc, subs, product, target, enforce=False)\n        candidates=[]\n        # leaf resources\n        for leaf, needed in sim[\'leaf_req\'].items():\n            if needed <= EPS:\n                continue\n            avail=prev_parts.get(leaf,0.0)\n            for s in subs.get(leaf,[]):\n                sub_onhand=prev_parts.get(s[\'sub\'],0.0)\n                if sub_onhand > EPS and s[\'ratio\'] > 0:\n                    cover=math.floor(sub_onhand / s[\'ratio\'] + EPS)\n                    avail += cover\n            ratio=avail/needed\n            if ratio < 1.0 - EPS:\n                candidates.append((ratio, leaf))\n        for wc, needed in sim[\'wc_req\'].items():\n            if needed <= EPS:\n                continue\n            avail=prev_wc.get(wc,0.0)\n            ratio=avail/needed\n            if ratio < 1.0 - EPS:\n                candidates.append((ratio, wc))\n        if candidates:\n            candidates.sort(key=lambda x:(x[0], x[1]))\n            limiting=candidates[0][1]\n    # commit allocation state\n    if alloc_state and alloc_state.get(\'new_on_hand\') is not None:\n        cur_parts=alloc_state[\'new_on_hand\']\n        cur_wc=alloc_state[\'new_wc\']\n    report.append({\'order_id\':o[\'order_id\'], \'allocated_qty\':int(allocated_qty), \'shortfall_qty\':int(shortfall), \'limiting_resource\':limiting})\n\nreport_sorted=sorted(report, key=lambda x:x[\'order_id\'])\nprint(json.dumps({\'orders\':report_sorted}, indent=2))\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
