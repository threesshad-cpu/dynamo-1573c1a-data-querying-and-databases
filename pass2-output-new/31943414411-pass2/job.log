eaf] = rem\n    for leaf in sorted(remaining):\n        need = remaining[leaf]\n        for sub in substitutes.get(leaf, []):\n            if need <= 0:\n                break\n            sub_id = sub['sub']\n            sub_stock = stock.get(sub_id, 0)\n            if sub_stock <= 0:\n                continue\n            ratio = sub['ratio']\n            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\n            use = min(need, can_primary)\n            if use <= 0:\n                continue\n            need_sub = int(math.ceil(use * ratio))\n            stock[sub_id] = sub_stock - need_sub\n            need -= use\n        if need > 0:\n            return False, None\n    return True, stock\n\ndef feasible(product, target, state_parts):\n    _, leaf_req, wc_hours, _ = compute_plan(product, target, state_parts)\n    for wc, hours in wc_hours.items():\n        if hours > workcenters[wc] + 1e-12:\n            return False\n    ok, _ = satisfy_leaves(leaf_req, state_parts)\n    return ok\n\ndef execute_plan(product, target, plan_data):\n    production, leaf_req, wc_hours, req_all = plan_data\n    ok, new_stock = satisfy_leaves(leaf_req, parts)\n    if not ok:\n        raise RuntimeError('tried to execute infeasible plan')\n    for p in leaf_parts:\n        parts[p]['on_hand'] = new_stock[p]\n    for p, prod in production.items():\n        if p in leaf_parts:\n            continue\n        parts[p]['on_hand'] = parts[p]['on_hand'] + prod - req_all.get(p, 0)\n    for wc, hours in wc_hours.items():\n        workcenters[wc] -= hours\n\ndef leaf_available_equiv(leaf, state_parts):\n    avail = state_parts[leaf]['on_hand']\n    for sub in substitutes.get(leaf, []):\n        sub_stock = state_parts[sub['sub']]['on_hand']\n        if sub['ratio'] > 0:\n            avail += int(math.floor(sub_stock / sub['ratio']))\n    return avail\n\ndef limiting_resource(product, allocated, batch, snap_parts, snap_wc):\n    target = allocated + batch\n    _, leaf_r