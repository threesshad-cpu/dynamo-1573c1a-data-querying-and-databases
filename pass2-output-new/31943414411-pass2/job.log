       total += math.floor(stock / ratio)\n    return total\n\n\ndef limiting_resource_for(product, probe_qty, st):\n    plan = explode(product, probe_qty, st)\n    ratios = []\n    for leaf, gross in plan[\'leaf_req\'].items():\n        if gross <= 1e-12:\n            continue\n        avail = leaf_total_available(leaf, st)\n        ratios.append((avail / gross, leaf))\n    for wc, gross in plan[\'hours_req\'].items():\n        if gross <= 1e-12:\n            continue\n        avail = st[\'wc_avail\'].get(wc, 0.0)\n        ratios.append((avail / gross, wc))\n    below = [(r, res) for r, res in ratios if r < 1.0 - 1e-12]\n    if not below:\n        return None\n    min_r = min(r for r, _ in below)\n    tied = [res for r, res in below if abs(r - min_r) < 1e-12]\n    return sorted(tied)[0]\n\n\nresults = []\nfor order in orders:\n    prod = order[\'product\']\n    req = order[\'qty\']\n    batch = parts[prod][\'batch\']\n    largest_multiple = req - (req % batch)\n\n    chosen_qty = 0\n    chosen_plan = None\n    for q in range(largest_multiple, -1, -batch):\n        test_state = copy.deepcopy(state)\n        plan_candidate = explode(prod, q, test_state)\n        if is_feasible(plan_candidate, test_state):\n            chosen_qty = q\n            chosen_plan = plan_candidate\n            break\n\n    # If fulfilled entirely, no limiting resource.\n    limiting = None\n    if chosen_qty < req:\n        # Compute limiting resource for one batch beyond maximum buildable quantity.\n        probe_qty = chosen_qty + batch\n        limiting = limiting_resource_for(prod, probe_qty, state)\n\n    # Minimum fill-rate cancellation\n    final_alloc = chosen_qty\n    shortfall = req - final_alloc\n    if req > 0 and (final_alloc / req) < 0.5:\n        final_alloc = 0\n        shortfall = req\n    else:\n        if chosen_plan is not None and final_alloc > 0:\n            commit(chosen_plan, state, prod)\n\n    results.append({\n        \'order_id\': order[\'id\'],\n        \'allocated_qty\': int(final_alloc),\n        \'shortfall_qty\': int(shortfall),\n        \'limiting_resource\': limiting\n    })\n    print(f"Order {order[\'id\']}: req={req}, max_buildable={chosen_qty}, final_alloc={final_alloc}, short={shortfall}, lim={limiting}")\n\nprint(\'\\nFinal report:\')\nprint(json.dumps({\'orders\': results}, indent=2))\nprint(\'\\nFinal state:\')\nprint(\'on_hand changed:\', {k:v for k,v in state[\'on_hand\'].items() if abs(v - parts[k][\'on_hand\']) > 1e-12})\nprint(\'wc_avail:\', state[\'wc_avail\'])\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
