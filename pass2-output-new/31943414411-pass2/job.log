     orders.append({\n            'order_id': r['order_id'],\n            'product': r['product_part_id'],\n            'requested_qty': r['requested_qty'],\n            'priority': r['priority']\n        })\n    conn.close()\n    return parts, dict(bom_children), workcenters, dict(routing), substitutes, orders\n\n\ndef topological_order(all_parts, bom_children):\n    indeg = {p: 0 for p in all_parts}\n    out = defaultdict(list)\n    for parent, children in bom_children.items():\n        for c in children:\n            out[parent].append(c['child'])\n            indeg[c['child']] += 1\n    q = deque(sorted([p for p in all_parts if indeg[p] == 0]))\n    order = []\n    while q:\n        p = q.popleft()\n        order.append(p)\n        for ch in out[p]:\n            indeg[ch] -= 1\n            if indeg[ch] == 0:\n                q.append(ch)\n        q = deque(sorted(q))\n    if len(order) != len(all_parts):\n        raise ValueError('Cycle detected or missing part in BOM graph: ' + str(order))\n    return order\n\n\ndef leaf_parts_set(parts, bom_children):\n    return {p for p in parts if p not in bom_children}\n\n\ndef compute_plan(product_id, target_units, parts, bom_children, routing, topo_order):\n    req = defaultdict(int)\n    req[product_id] += target_units\n    production_qty = {}\n    leaf_req = defaultdict(int)\n    wc_hours = defaultdict(float)\n    leafs = {p for p in parts if p not in bom_children}\n    for part_id in topo_order:\n        required = req.get(part_id, 0)\n        if required == 0:\n            continue\n        if part_id in leafs:\n            leaf_req[part_id] = required\n            continue\n        stock = parts[part_id]['on_hand']\n        to_make = required - stock\n        if to_make <= 0:\n            production_qty[part_id] = 0\n            continue\n        batch = parts[part_id]['batch']\n        prod = int(math.ceil(to_make / float(batch)) * batch)\n        production_qty[part_id] = prod\n        for rt in routing.get(part_id, []):\n            wc_hours[rt['workcenter']] += rt['setup'] + prod * rt['run']\n        for child in bom_children.get(part_id, []):\n            base = child['qty_per'] * prod\n            child_req = int(math.ceil(base * (1.0 + child['scrap_rate_pct'] / 100.0))) + child['setup_scrap_qty']\n            req[child['child']] += child_req\n    leaf_req_final = {pid: qty for pid, qty in req.items() if pid in leafs and qty > 0}\n    return production_qty, leaf_req_final, dict(wc_hours), dict(req)\n\n\ndef satisfy_leaf_requirements(leaf_req, parts, leaf_parts):\n    stock = {pid: parts[pid]['on_hand'] for pid in leaf_parts}\n    remaining = {}\n    for leaf_id, qty in leaf_req.items():\n        take = min(stock.get(leaf_id, 0), qty)\n        stock[leaf_id] = stock.get(leaf_id, 0) - take\n        rem = qty - take\n        if rem > 0:\n            remaining[leaf_id] = rem\n    for leaf_id in sorted(remaining):\n        shortage = remaining[leaf_id]\n        for sub in substitutes.get(leaf_id, []):\n            if shortage <= 0:\n                break\n            sub_id = sub['sub']\n            sub_stock = stock.get(sub_id, 0)\n            if sub_stock <= 0:\n                continue\n            ratio = sub['ratio']\n            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\n            use = min(shortage, can_primary)\n            if use <= 0:\n                continue\n            need_sub = int(math.ceil(use * ratio))\n            stock[sub_id] = sub_stock - need_sub\n            shortage -= use\n        remaining[leaf_id] = shortage\n        if shortage > 0:\n            return False, None\n    return True, stock\n\n\ndef is_feasible(plan, parts, workcenters, leaf_parts, substitutes):\n    _, leaf_req, wc_hours, _ = plan\n    for wc, hours in wc_hours.items():\n        if hours > workcenters[wc] + 1e-12:\n            return False\n    ok, _ = satisfy_leaf_requirements(leaf_req, parts, leaf_parts)\n    return ok\n\n\ndef execute_plan(plan, parts, leaf_parts, workcenters):\n    production_qty, leaf_req, wc_hours, req_all = plan\n    ok, new_stock = satisfy_leaf_requirements(leaf_req, parts, leaf_parts)\n    if not ok:\n        raise RuntimeError('Cannot execute infeasible plan')\n    for pid in leaf_parts:\n        if pid in new_stock:\n            parts[pid]['on_hand'] = new_stock[pid]\n    for pid, prod in production_qty.items():\n        if pid in leaf_parts:\n            continue\n        parts[pid]['on_hand'] = parts[pid]['on_hand'] + prod - req_all.get(pid, 0)\n    for wc, hours in wc_hours.items():\n        workcenters[wc] -= hours\n\n\ndef available_leaf_equivalent(leaf_id, parts, substitutes):\n    avail = parts[leaf_id]['on_hand']\n    for sub in substitutes.get(leaf_id, []):\n        sub_stock = parts[sub['sub']]['on_hand']\n        if sub['ratio'] > 0:\n            avail += int(math.floor(sub_stock / sub['ratio']))\n    return avail\n\n\ndef compute_limiting_resource(product_id, allocated_qty, batch_size, parts, bom_children, routing, topo_order, workcenters, substitutes, leaf_parts):\n    target = allocated_qty + batch_size\n    _, leaf_req, wc_hours, _ = compute_plan(product_id, target, parts, bom_children, routing, topo_order)\n    ratios = {}\n    for leaf_id, gross in leaf_req.items():\n        if gross > 0:\n            avail = available_leaf_equivalent(leaf_id, parts, substitutes)\n            ratios[leaf_id] = avail / float(gross)\n    for wc_id, gross in wc_hours.items():\n        if gross > 0:\n            ratios[wc_id] = workcenters[wc_id] / float(gross)\n    lim = None\n    best = None\n    for rid, ratio in ratios.items():\n        if ratio < 1.0 - 1e-12:\n            if best is None or ratio < best - 1e-12 or (abs(ratio - best) <= 1e-12 and rid < lim):\n                best = ratio\n                lim = rid\n    return lim\n\n\ndef solve():\n    parts, bom_children, workcenters, routing, substitutes, orders = load_db(DB_PATH)\n    leaf_parts = leaf_parts_set(parts, bom_children)\