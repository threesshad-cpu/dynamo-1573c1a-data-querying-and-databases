    if node in visited:\n        return\n    if node in temp:\n        return\n    temp.add(node)\n    for edge in bom.get(node, []):\n        dfs(edge[\'child\'])\n    temp.discard(node)\n    visited.add(node)\n    post.append(node)\n\nfor node in all_nodes:\n    dfs(node)\ntopo = list(reversed(post))\n\n# Current mutable state\nstate = {\n    \'on_hand\': {p: parts[p][\'on_hand\'] for p in parts},\n    \'wc_avail\': dict(workcenters)\n}\n\n\ndef material_need(base, scrap_pct, setup_scrap):\n    return math.ceil(base * (1.0 + scrap_pct / 100.0)) + setup_scrap\n\n\ndef explode(product, qty, st):\n    demand = defaultdict(float)\n    demand[product] = float(qty)\n    build = {}\n    leaf_req = defaultdict(float)\n    hours_req = defaultdict(float)\n\n    for p in topo:\n        d = demand.get(p, 0.0)\n        if d <= 1e-12:\n            continue\n        if p not in bom:\n            leaf_req[p] += d\n            continue\n\n        if p == product:\n            need = d\n        else:\n            avail = st[\'on_hand\'].get(p, 0.0)\n            need = max(0.0, d - avail)\n\n        if need > 1e-12:\n            b = parts[p][\'batch\']\n            bq = math.ceil(need / b) * b\n        else:\n            bq = 0\n        build[p] = bq\n\n        if bq > 0:\n            for edge in bom[p]:\n                base = bq * edge[\'qty_per\']\n                child_need = material_need(base, edge[\'scrap_pct\'], edge[\'setup_scrap\'])\n                demand[edge[\'child\']] += child_need\n            for route in routing.get(p, []):\n                hours_req[route[\'wc\']] += route[\'setup\'] + bq * route[\'run\']\n\n    return {\'demand\': demand, \'build\': build, \'leaf_req\': leaf_req, \'hours_req\': hours_req}\n\n\ndef consume_leaf_alloc(leaf, qty, st):\n    """Return consumed dict if enough, else None."""\n    used = defaultdict(float)\n    avail_own = st[\'on_hand\'].get(leaf, 0.0)\n    take = min(avail_own, qty)\n    used[leaf] += take\n    rem = qty - take\n    if