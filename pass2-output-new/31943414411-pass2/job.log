Sending keys: ['python3 - <<\'PY\'\nimport sqlite3, json, math, copy\nfrom collections import defaultdict\n\ndb=\'/app/manufacturing.db\'\nconn=sqlite3.connect(db)\ncur=conn.cursor()\n\n# Load data\nparts = {}\nfor row in cur.execute(\'SELECT part_id,name,on_hand_qty,batch_size FROM parts\'):\n    parts[row[0]] = {\'name\':row[1], \'on_hand\':row[2], \'batch\':row[3]}\n\nbom = defaultdict(list)\nfor parent, child, qty, scrap, setup in cur.execute(\'SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom\'):\n    bom[parent].append({\'child\': child, \'qty\': qty, \'scrap_pct\': scrap, \'setup\': setup})\n\nrouting = defaultdict(list)\nfor parent, wc, setup, run in cur.execute(\'SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing\'):\n    routing[parent].append({\'wc\': wc, \'setup\': setup, \'run\': run})\n\nsubs = defaultdict(list)\nfor primary, sub, ratio, rank in cur.execute(\'SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes\'):\n    subs[primary].append({\'sub\': sub, \'ratio\': ratio, \'rank\': rank})\nfor primary in subs:\n    subs[primary].sort(key=lambda x: (x[\'rank\'], x[\'sub\']))\n\norders = []\nfor oid, prod, qty, prio in cur.execute(\'SELECT order_id, product_part_id, requested_qty, priority FROM orders\'):\n    orders.append({\'id\': oid, \'product\': prod, \'qty\': qty, \'priority\': prio})\norders.sort(key=lambda x: (x[\'priority\'], x[\'id\']))\nconn.close()\n\n# Topological order of all BOM nodes (parents before children)\nall_nodes = set(parts.keys())\nbom_nodes = set(bom.keys()) | {x[\'child\'] for children in bom.values() for x in children}\nall_nodes |= bom_nodes\nvisited=set(); temp=set(); post=[]\ndef dfs(n):\n    if n in visited: return\n    if n in temp:\n        # cycle, skip\n        return\n    temp.add(n)\n    for edge in bom.get(n, []):\n        dfs(edge[\'child\'])\n    temp.discard(n)\n    visited.add(n)\n    post.append(n)\nfor n in all_nodes:\n    dfs(n)\ntopo = list(reversed(post))\nprint(\'Topo order:\', topo)\n\ndef copy_state():\n    return {\n        \'on_hand\': {p: parts[p][\'on_hand\'] for p in parts},\n        \'wc_avail\': {w[0]: w[2] for w in cur.execute(\'\')} if False else None,\n        \'batch\': {p: parts[p][\'batch\'] for p in parts}\n    }\n\ndef order_state():\n    return {\n        \'on_hand\': {p: parts[p][\'on_hand\'] for p in parts},\n        \'wc_avail\': {}\n    }\n\n# Build wc availability\nwc_avail = {}\nconn=sqlite3.connect(db)\ncur=conn.cursor()\nfor wc, name, avail in cur.execute(\'SELECT workcenter_id,name,available_hours FROM workcenters\'):\n    wc_avail[wc] = avail\nconn.close()\n\ncurrent_state = {\n    \'on_hand\': {p: parts[p][\'on_hand\'] for p in parts},\n    \'wc_avail\': dict(wc_avail)\n}\n\ndef plan_order(product, qty, state):\n    demand = defaultdict(float)\n    build = {}\n    leaf_req = defaultdict(float)\n    hours_req = defaultdict(float)\n    demand[product] = qty\n    for p in topo:\n        d = demand.get(p, 0.0)\n        if d <= 0:\n            continue\n        if p not in bom:\n            # leaf\n            leaf_req[p] += d\n        else:\n            if p == product:\n                need = d\n            else:\n                avail = state[\'on_hand\'].get(p, 0.0)\n                need = max(0.0, d - avail)\n            if need > 0:\n                b = parts[p][\'batch\']\n                bq = math.ceil(need / b) * b\n                build[p] = bq\n                for edge in bom[p]:\n                    base = bq * edge[\'qty\']\n                    req = math.ceil(base * (1.0 + edge[\'scrap_pct\']/100.0)) + edge[\'setup\']\n                    demand[edge[\'child\']] += req\n            else:\n                build[p] = 0\n            for rt in routing.get(p, []):\n                bq = build.get(p, 0)\n                if bq > 0:\n                    h = rt[\'setup\'] + bq * rt[\'run\']\n                    hours_req[rt[\'wc\']] += h\n    return {\'demand\': demand, \'build\': build, \'leaf_req\': leaf_req, \'hours_req\': hours_req}\n\ndef leaf_available(leaf, qty, state):\n    avail = state[\'on_hand\'].get(leaf, 0.0)\n    used = {}\n    use_own = min(avail, qty)\n    used[leaf] = use_own\n    rem = qty - use_own\n    for sub in subs.get(leaf, []):\n        if rem <= 1e-12:\n            break\n        stock = state[\'on_hand\'].get(sub[\'sub\'], 0.0)\n        ratio = sub[\'ratio\']\n        cover = math.floor(stock / ratio) if ratio else 0\n        take = min(cover, rem)\n        if take > 0:\n            used[sub[\'sub\']] = used.get(sub[\'sub\'], 0.0) + take * ratio\n            rem -= take\n    return rem <= 1e-12, used\n\ndef feasible(plan, state):\n    # leaves\n    for leaf, q in plan[\'leaf_req\'].items():\n        ok, used = leaf_available(leaf, q, state)\n        if not ok:\n            return False\n    for wc, h in plan[\'hours_req\'].items():\n        if h > state[\'wc_avail\'].get(wc, 0.0) + 1e-12:\n            return False\n    return True\n\ndef commit(plan, state):\n    # leaves\n    for leaf, q in plan[\'leaf_req\'].items():\n        ok, used = leaf_available(leaf, q, state)\n        if not ok:\n            print(\'ERROR leaf commitment\', leaf, q)\n            return\n        for part, amt in used.items():\n            state[\'on_hand\'][part] -= amt\n            if state[\'on_hand\'][part] < -1e-12:\n                print(\'negative leaf inv\', part, state[\'on_hand\'][part])\n    # manufactured parts\n    for p, bq in plan[\'build\'].items():\n        d = plan[\'demand\'].get(p, 0.0)\n        if p not in plan[\'build\'] and p not in bom:\n            pass\n        else:\n            if p == parts and p == \'PRODUCT?\': pass\n            old = state[\'on_hand\'].get(p, 0.0)\n            if p != plan[\'demand\'].get(\'pid\'):\n                pass\n    for p in plan[\'build\']:\n        if p not in bom:\n            continue\n        d = plan[\'demand\'].get(p, 0.0)\n        old = state[\'on_hand\'].get(p, 0.0)\n        if p != plan[\'build\'].get(\'__product\'):\n            pass\n    # Do after leaves\n    for p, bq in plan[\'build\'].items():\n        if p not in bom:\n            continue\n        d = plan[\'demand\'].get(p, 0.0)\n        old = state[\'on_hand\'].get(p, 0.0)\n        if p == plan[\'__product\']:\n            pass\n        consume = min(d, old)\n        state[\'on_hand\'][p] = old - consume\n    for p, bq in plan[\'build\'].items():\n        if p not in bom:\n            continue\n        if bq > 0:\n            state[\'on_hand\'][p] += bq\n    for wc, h in plan[\'hours_req\'].items():\n        state[\'wc_avail\'][wc] -= h\n\n# Let\'s implement candidate simulation manually for each order\nfor od in orders:\n    prod=od[\'product\']; req=od[\'qty\']; batch=parts[prod][\'batch\']\n    candidates = [x for x in range(req, -1, -batch) if x <= req]\n    chosen = None; chosen_plan = None\n    for q in candidates:\n        st_copy = copy.deepcopy(current_state)\n        plan = plan_order(prod, q, st_copy)\n        if feasible(plan, st_copy):\n            chosen = q; chosen_plan = plan\n            break\n    print(f"Order {od[\'id\']}: product={prod}, req={req}, chosen={chosen}")\n    if chosen is None:\n        chosen=0\n        chosen_plan=plan_order(prod,0,copy.deepcopy(current_state))\n    # if zero or not, print lens\n    if chosen_plan:\n        print(\'  demand:\', dict(chosen_plan[\'demand\']))\n        print(\'  build:\', dict(chosen_plan[\'build\']))\n        print(\'  leaf_req:\', dict(chosen_plan[\'leaf_req\']))\n        print(\'  hours_req:\', dict(chosen_plan[\'hours_req\']))\n    # commit unless unviable\n    # We\'ll not implement full unviable now, just continue\n    if chosen > 0:\n        commit(chosen_plan, current_state)\n    print(\'  state after order (if committed): on_hand\', {k:v for k,v in current_state[\'on_hand\'].items() if v != parts[k][\'on_hand\']}, \'wc\', current_state[\'wc_avail\'])\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
