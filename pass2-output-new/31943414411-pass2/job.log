Sending keys: ['cat > /app/solve.py <<\'PY\'\nimport sqlite3, math, copy, json\nfrom collections import defaultdict, deque\n\nDB_PATH = \'/app/manufacturing.db\'\n\n\ndef load_db(db_path):\n    conn = sqlite3.connect(db_path)\n    conn.row_factory = sqlite3.Row\n    cur = conn.cursor()\n    parts = {}\n    for r in cur.execute(\'SELECT part_id, name, on_hand_qty, batch_size FROM parts\'):\n        parts[r[\'part_id\']] = {\'name\': r[\'name\'], \'on_hand\': r[\'on_hand_qty\'], \'batch\': r[\'batch_size\']}\n    bom_parents = defaultdict(list)\n    bom_children = defaultdict(list)\n    for r in cur.execute(\'SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom\'):\n        entry = {\n            \'child\': r[\'child_part_id\'],\n            \'qty_per\': r[\'qty_per\'],\n            \'scrap_rate_pct\': r[\'scrap_rate_pct\'],\n            \'setup_scrap_qty\': r[\'setup_scrap_qty\']\n        }\n        bom_children[r[\'parent_part_id\']].append(entry)\n        bom_parents[r[\'child_part_id\']].append(r[\'parent_part_id\'])\n    workcenters = {}\n    for r in cur.execute(\'SELECT workcenter_id, name, available_hours FROM workcenters\'):\n        workcenters[r[\'workcenter_id\']] = r[\'available_hours\']\n    routing = defaultdict(list)\n    for r in cur.execute(\'SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing\'):\n        routing[r[\'parent_part_id\']].append({\n            \'workcenter\': r[\'workcenter_id\'],\n            \'setup\': r[\'setup_hours\'],\n            \'run\': r[\'run_hours_per_unit\']\n        })\n    substitutes = defaultdict(list)\n    for r in cur.execute(\'SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes\'):\n        substitutes[r[\'primary_part_id\']].append({\n            \'sub\': r[\'substitute_part_id\'],\n            \'ratio\': r[\'qty_ratio\'],\n            \'rank\': r[\'preference_rank\']\n        })\n    for k in substitutes:\n        substitutes[k].sort(key=lambda x: (x[\'rank\'], x[\'sub\']))\n    orders = []\n    for r in cur.execute(\'SELECT order_id, product_part_id, requested_qty, priority FROM orders ORDER BY priority, order_id\'):\n        orders.append({\n            \'order_id\': r[\'order_id\'],\n            \'product\': r[\'product_part_id\'],\n            \'requested_qty\': r[\'requested_qty\'],\n            \'priority\': r[\'priority\']\n        })\n    conn.close()\n    leaf_parts = {pid for pid in parts if pid not in bom_children}\n    return parts, dict(bom_children), workcenters, dict(routing), substitutes, orders, leaf_parts\n\n\ndef topological_order(all_parts, bom_children):\n    # parent -> child edges; topological order where parents precede children\n    indeg = {p: 0 for p in all_parts}\n    out = defaultdict(list)\n    for parent, children in bom_children.items():\n        for c in children:\n            out[parent].append(c[\'child\'])\n            indeg[c[\'child\']] += 1\n    q = deque([p for p in all_parts if indeg[p] == 0])\n    order = []\n    while q:\n        p = q.popleft()\n        order.append(p)\n        for ch in out[p]:\n            indeg[ch] -= 1\n            if indeg[ch] == 0:\n                q.append(ch)\n    if len(order) != len(all_parts):\n        raise ValueError(\'Cycle detected or missing part in BOM graph\')\n    return order\n\n\ndef plan_production(product_id, target_units, parts, bom_children, routing, topo_order):\n    req = defaultdict(int)\n    req[product_id] += target_units\n    production_qty = {}\n    leaf_req = defaultdict(int)\n    wc_hours = defaultdict(float)\n    leaf_parts = {pid for pid in parts if pid not in bom_children}\n\n    for part_id in topo_order:\n        required = req.get(part_id, 0)\n        if required == 0:\n            continue\n        if part_id in leaf_parts:\n            leaf_req[part_id] += required\n            continue\n        old = parts[part_id][\'on_hand\']\n        to_make = required - old\n        if to_make <= 0:\n            production_qty[part_id] = 0\n            continue\n        batch = parts[part_id][\'batch\']\n        prod = int(math.ceil(to_make / batch) * batch)\n        production_qty[part_id] = prod\n        # hours for this production run\n        for rt in routing.get(part_id, []):\n            wc_hours[rt[\'workcenter\']] += rt[\'setup\'] + prod * rt[\'run\']\n        # child demands\n        for ch in bom_children.get(part_id, []):\n            base = ch[\'qty_per\'] * prod\n            scrap_mult = 1.0 + ch[\'scrap_rate_pct\'] / 100.0\n            child_req = int(math.ceil(base * scrap_mult)) + ch[\'setup_scrap_qty\']\n            req[ch[\'child\']] += child_req\n    leaf_req_final = {pid: qty for pid, qty in req.items() if pid in leaf_parts and qty > 0}\n    return production_qty, leaf_req_final, dict(wc_hours), dict(req)\n\n\ndef satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes):\n    """Return (success, updated_leaf_stock_dict)."""\n    leaf_stock = {pid: parts[pid][\'on_hand\'] for pid in leaf_parts}\n    remaining = {}\n    # First reserve direct primary stock for each leaf demand.\n    for leaf_id, qty in leaf_req.items():\n        take = min(leaf_stock.get(leaf_id, 0), qty)\n        leaf_stock[leaf_id] = leaf_stock.get(leaf_id, 0) - take\n        rem = qty - take\n        if rem > 0:\n            remaining[leaf_id] = rem\n\n    # Then use substitutes for remaining shortages.\n    # Process leaf ids in sorted order for determinism.\n    for leaf_id in sorted(remaining.keys()):\n        shortage = remaining[leaf_id]\n        if shortage <= 0:\n            continue\n        subs = substitutes.get(leaf_id, [])\n        for sub in subs:\n            if shortage <= 0:\n                break\n            sub_id = sub[\'sub\']\n            sub_stock = leaf_stock.get(sub_id, 0)\n            if sub_stock <= 0:\n                continue\n            ratio = sub[\'ratio\']\n            # how many primary units can this substitute cover?\n            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\n            use_primary = min(shortage, can_primary)\n            if use_primary <= 0:\n                continue\n            need_sub = int(math.ceil(use_primary * ratio))\n            if need_sub > sub_stock:\n                # adjust if necessary\n                use_primary = int(math.floor(sub_stock / ratio))\n                need_sub = int(math.ceil(use_primary * ratio))\n            leaf_stock[sub_id] = sub_stock - need_sub\n            shortage -= use_primary\n        remaining[leaf_id] = shortage\n        if shortage > 0:\n            return False, None\n    return True, leaf_stock\n\n\ndef is_feasible(plan, parts, workcenters, leaf_parts, substitutes):\n    production_qty, leaf_req, wc_hours, req_all = plan\n    for wc, hours in wc_hours.items():\n        if workcenters[wc] + 1e-9 < hours:\n            return False\n    ok, _ = satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes)\n    return ok\n\n\ndef execute_plan(plan, parts, leaf_parts, substitutes, workcenters):\n    production_qty, leaf_req, wc_hours, req_all = plan\n    ok, new_leaf_stock = satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes)\n    if not ok:\n        raise RuntimeError(\'Execution of infeasible plan\')\n    # Update leaf stocks after consumption\n    for pid in leaf_parts:\n        if pid in new_leaf_stock:\n            parts[pid][\'on_hand\'] = new_leaf_stock[pid]\n    # Update non-leaf inventories: old + produced - required (parents used required)\n    for part_id, prod in production_qty.items():\n        if part_id in leaf_parts:\n            continue\n        old = parts[part_id][\'on_hand\']\n        required = req_all.get(part_id, 0)\n        parts[part_id][\'on_hand\'] = old + prod - required\n    # Update workcenters\n    for wc, hours in wc_hours.items():\n        workcenters[wc] -= hours\n\n\ndef compute_limiting_resource(product_id, allocated_qty, batch_