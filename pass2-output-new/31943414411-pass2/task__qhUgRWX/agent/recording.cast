[251.947477, "o", "\u001b[?2004h"]
[251.947511, "o", "> "]
[251.947594, "o", "def leaf_available(leaf, qty, state):\r\n\u001b[?2004l\r"]
[251.947628, "o", "\u001b[?2004h> "]
[251.947742, "o", "    avail = state['on_hand'].get(leaf, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.947806, "o", "    used = {}\r\n\u001b[?2004l\r"]
[251.947839, "o", "\u001b[?2004h> "]
[251.947915, "o", "    use_own = min(avail, qty)\r\n\u001b[?2004l\r"]
[251.947929, "o", "\u001b[?2004h"]
[251.947956, "o", "> "]
[251.948012, "o", "    used[leaf] = use_own\r\n\u001b[?2004l\r"]
[251.948056, "o", "\u001b[?2004h> "]
[251.948124, "o", "    rem = qty - use_own\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.948242, "o", "    for sub in subs.get(leaf, []):\r\n\u001b[?2004l\r"]
[251.948274, "o", "\u001b[?2004h> "]
[251.948338, "o", "        if rem <= 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.948371, "o", "> "]
[251.948406, "o", "            break\r\n\u001b[?2004l\r"]
[251.948419, "o", "\u001b[?2004h> "]
[251.948584, "o", "        stock = state['on_hand'].get(sub['sub'], 0.0)\r\n\u001b[?2004l\r"]
[251.948619, "o", "\u001b[?2004h> "]
[251.948691, "o", "        ratio = sub['ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.948723, "o", "> "]
[251.948881, "o", "        cover = math.floor(stock / ratio) if ratio else 0\r\n\u001b[?2004l\r"]
[251.948895, "o", "\u001b[?2004h> "]
[251.948999, "o", "        take = min(cover, rem)\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.949037, "o", "> "]
[251.949083, "o", "        if take > 0:\r\n\u001b[?2004l\r"]
[251.9491, "o", "\u001b[?2004h> "]
[251.949304, "o", "            used[sub['sub']] = used.get(sub['sub'], 0.0) + take * ratio\r\n\u001b[?2004l\r"]
[251.94932, "o", "\u001b[?2004h> "]
[251.949401, "o", "            rem -= take\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.949414, "o", "> "]
[251.949505, "o", "    return rem <= 1e-12, used\r\n\u001b[?2004l\r"]
[251.949519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[251.949554, "o", "\u001b[?2004h> "]
[251.949635, "o", "def feasible(plan, state):\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.949667, "o", "> "]
[251.9497, "o", "    # leaves\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.949715, "o", "> "]
[251.949846, "o", "    for leaf, q in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[251.949858, "o", "\u001b[?2004h"]
[251.949886, "o", "> "]
[251.950035, "o", "        ok, used = leaf_available(leaf, q, state)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.950114, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.950202, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.950236, "o", "> "]
[251.950348, "o", "    for wc, h in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[251.950361, "o", "\u001b[?2004h> "]
[251.950525, "o", "        if h > state['wc_avail'].get(wc, 0.0) + 1e-12:\r\n\u001b[?2004l\r"]
[251.950539, "o", "\u001b[?2004h> "]
[251.950621, "o", "            return False\r\n\u001b[?2004l\r"]
[251.950654, "o", "\u001b[?2004h> "]
[251.950695, "o", "    return True\r\n\u001b[?2004l\r"]
[251.950728, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[251.950761, "o", "\u001b[?2004h> "]
[251.950816, "o", "def commit(plan, state):\r\n\u001b[?2004l\r"]
[251.95083, "o", "\u001b[?2004h> "]
[251.950888, "o", "    # leaves\r\n\u001b[?2004l\r"]
[251.950902, "o", "\u001b[?2004h> "]
[251.951051, "o", "    for leaf, q in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[251.951086, "o", "\u001b[?2004h> "]
[251.951215, "o", "        ok, used = leaf_available(leaf, q, state)\r\n\u001b[?2004l\r"]
[251.951248, "o", "\u001b[?2004h> "]
[251.951293, "o", "        if not ok:\r\n\u001b[?2004l\r"]
[251.951327, "o", "\u001b[?2004h> "]
[251.951456, "o", "            print('ERROR leaf commitment', leaf, q)\r\n\u001b[?2004l\r"]
[251.951469, "o", "\u001b[?2004h> "]
[251.951541, "o", "            return\r\n\u001b[?2004l\r"]
[251.951574, "o", "\u001b[?2004h> "]
[251.951674, "o", "        for part, amt in used.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.951687, "o", "> "]
[251.951812, "o", "            state['on_hand'][part] -= amt\r\n\u001b[?2004l\r"]
[251.951825, "o", "\u001b[?2004h> "]
[251.951976, "o", "            if state['on_hand'][part] < -1e-12:\r\n\u001b[?2004l\r"]
[251.95199, "o", "\u001b[?2004h> "]
[251.952212, "o", "                print('negative leaf inv', part, state['on_hand'][part])\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.952225, "o", "> "]
[251.952311, "o", "    # manufactured parts\r\n\u001b[?2004l\r"]
[251.952346, "o", "\u001b[?2004h> "]
[251.952448, "o", "    for p, bq in plan['build'].items():\r\n\u001b[?2004l\r"]
[251.952464, "o", "\u001b[?2004h> "]
[251.952579, "o", "        d = plan['demand'].get(p, 0.0)\r\n\u001b[?2004l\r"]
[251.952612, "o", "\u001b[?2004h> "]
[251.952756, "o", "        if p not in plan['build'] and p not in bom:\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.95277, "o", "> "]
[251.952829, "o", "            pass\r\n\u001b[?2004l\r"]
[251.952843, "o", "\u001b[?2004h> "]
[251.952893, "o", "        else:\r\n\u001b[?2004l\r"]
[251.952914, "o", "\u001b[?2004h> "]
[251.953079, "o", "            if p == parts and p == 'PRODUCT?': pass\r\n\u001b[?2004l\r"]
[251.953094, "o", "\u001b[?2004h> "]
[251.953232, "o", "            old = state['on_hand'].get(p, 0.0)\r\n\u001b[?2004l\r"]
[251.953265, "o", "\u001b[?2004h> "]
[251.953389, "o", "            if p != plan['demand'].get('pid'):\r\n\u001b[?2004l\r"]
[251.953422, "o", "\u001b[?2004h> "]
[251.953473, "o", "                pass\r\n\u001b[?2004l\r"]
[251.953506, "o", "\u001b[?2004h> "]
[251.953577, "o", "    for p in plan['build']:\r\n\u001b[?2004l\r"]
[251.95361, "o", "\u001b[?2004h> "]
[251.953673, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[251.953688, "o", "\u001b[?2004h> "]
[251.953757, "o", "            continue\r\n\u001b[?2004l\r"]
[251.953784, "o", "\u001b[?2004h> "]
[251.953887, "o", "        d = plan['demand'].get(p, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.953925, "o", "> "]
[251.954045, "o", "        old = state['on_hand'].get(p, 0.0)\r\n\u001b[?2004l\r"]
[251.95408, "o", "\u001b[?2004h> "]
[251.95423, "o", "        if p != plan['build'].get('__product'):\r\n\u001b[?2004l\r"]
[251.954244, "o", "\u001b[?2004h> "]
[251.954304, "o", "            pass\r\n\u001b[?2004l\r"]
[251.954318, "o", "\u001b[?2004h> "]
[251.954391, "o", "    # Do after leaves\r\n\u001b[?2004l\r"]
[251.954406, "o", "\u001b[?2004h> "]
[251.954528, "o", "    for p, bq in plan['build'].items():\r\n\u001b[?2004l\r"]
[251.954542, "o", "\u001b[?2004h> "]
[251.954622, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[251.954656, "o", "\u001b[?2004h> "]
[251.9547, "o", "            continue\r\n\u001b[?2004l\r"]
[251.954713, "o", "\u001b[?2004h> "]
[251.954839, "o", "        d = plan['demand'].get(p, 0.0)\r\n\u001b[?2004l\r"]
[251.954873, "o", "\u001b[?2004h> "]
[251.954993, "o", "        old = state['on_hand'].get(p, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.955007, "o", "> "]
[251.955118, "o", "        if p == plan['__product']:\r\n\u001b[?2004l\r"]
[251.955131, "o", "\u001b[?2004h> "]
[251.95519, "o", "            pass\r\n\u001b[?2004l\r"]
[251.955204, "o", "\u001b[?2004h"]
[251.955232, "o", "> "]
[251.955299, "o", "        consume = min(d, old)\r\n\u001b[?2004l\r"]
[251.955312, "o", "\u001b[?2004h"]
[251.95534, "o", "> "]
[251.955446, "o", "        state['on_hand'][p] = old - consume\r\n\u001b[?2004l\r"]
[251.955459, "o", "\u001b[?2004h"]
[251.955486, "o", "> "]
[251.955582, "o", "    for p, bq in plan['build'].items():\r\n\u001b[?2004l\r"]
[251.955595, "o", "\u001b[?2004h"]
[251.955623, "o", "> "]
[251.955677, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[251.955711, "o", "\u001b[?2004h> "]
[251.955766, "o", "            continue\r\n\u001b[?2004l\r"]
[251.955782, "o", "\u001b[?2004h> "]
[251.955841, "o", "        if bq > 0:\r\n\u001b[?2004l\r"]
[251.955855, "o", "\u001b[?2004h"]
[251.955891, "o", "> "]
[251.955977, "o", "            state['on_hand'][p] += bq\r\n\u001b[?2004l\r"]
[251.95601, "o", "\u001b[?2004h> "]
[251.956139, "o", "    for wc, h in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[251.956155, "o", "\u001b[?2004h> "]
[251.956262, "o", "        state['wc_avail'][wc] -= h\r\n\u001b[?2004l\r"]
[251.956276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[251.956287, "o", "\u001b[?2004h> "]
[251.956484, "o", "# Let's implement candidate simulation manually for each order\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.956519, "o", "> "]
[251.956564, "o", "for od in orders:\r\n\u001b[?2004l\r"]
[251.956578, "o", "\u001b[?2004h> "]
[251.956773, "o", "    prod=od['product']; req=od['qty']; batch=parts[prod]['batch']\r\n\u001b[?2004l\r"]
[251.956792, "o", "\u001b[?2004h> "]
[251.956984, "o", "    candidates = [x for x in range(req, -1, -batch) if x <= req]\r\n\u001b[?2004l\r"]
[251.956999, "o", "\u001b[?2004h> "]
[251.957133, "o", "    chosen = None; chosen_plan = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.957224, "o", "    for q in candidates:\r\n\u001b[?2004l\r"]
[251.95724, "o", "\u001b[?2004h> "]
[251.95738, "o", "        st_copy = copy.deepcopy(current_state)\r\n\u001b[?2004l\r"]
[251.957395, "o", "\u001b[?2004h> "]
[251.95752, "o", "        plan = plan_order(prod, q, st_copy)\r\n\u001b[?2004l\r"]
[251.957533, "o", "\u001b[?2004h> "]
[251.957652, "o", "        if feasible(plan, st_copy):\r\n\u001b[?2004l\r"]
[251.957666, "o", "\u001b[?2004h> "]
[251.957795, "o", "            chosen = q; chosen_plan = plan\r\n\u001b[?2004l\r"]
[251.957828, "o", "\u001b[?2004h> "]
[251.957864, "o", "            break\r\n\u001b[?2004l\r"]
[251.957878, "o", "\u001b[?2004h> "]
[251.958124, "o", "    print(f\"Order {od['id']}: product={prod}, req={req}, chosen={chosen}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[251.958208, "o", "    if chosen is None:\r\n\u001b[?2004l\r"]
[251.958221, "o", "\u001b[?2004h> "]
[251.958281, "o", "        chosen=0\r\n\u001b[?2004l\r"]
[251.958294, "o", "\u001b[?2004h"]
[251.958323, "o", "> "]
[251.958491, "o", "        chosen_plan=plan_order(prod,0,copy.deepcopy(current_state))\r\n\u001b[?2004l\r"]
[251.958506, "o", "\u001b[?2004h> "]
[251.958616, "o", "    # if zero or not, print lens\r\n\u001b[?2004l\r"]
[251.95865, "o", "\u001b[?2004h> "]
[251.958695, "o", "    if chosen_plan:\r\n\u001b[?2004l\r"]
[251.958728, "o", "\u001b[?2004h> "]
[251.95888, "o", "        print('  demand:', dict(chosen_plan['demand']))\r\n\u001b[?2004l\r"]
[251.958917, "o", "\u001b[?2004h> "]
[251.959066, "o", "        print('  build:', dict(chosen_plan['build']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.959101, "o", "> "]
[251.959262, "o", "        print('  leaf_req:', dict(chosen_plan['leaf_req']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[251.959276, "o", "> "]
[251.959451, "o", "        print('  hours_req:', dict(chosen_plan['hours_req']))\r\n\u001b[?2004l\r"]
[251.959464, "o", "\u001b[?2004h> "]
[251.959561, "o", "    # commit unless unviable\r\n\u001b[?2004l\r"]
[251.959575, "o", "\u001b[?2004h> "]
[251.95975, "o", "    # We'll not implement full unviable now, just continue\r\n\u001b[?2004l\r"]
[251.959763, "o", "\u001b[?2004h> "]
[251.959828, "o", "    if chosen > 0:\r\n\u001b[?2004l\r"]
[251.959842, "o", "\u001b[?2004h"]
[251.959869, "o", "> "]
[251.959985, "o", "        commit(chosen_plan, current_state)\r\n\u001b[?2004l\r"]
[251.959999, "o", "\u001b[?2004h"]
[251.960036, "o", "> "]
[251.960502, "o", "    print('  state after order (if committed): on_hand', {k:v for k,v in current_state['on_hand'].items() if v != parts[k]['on_hand']}, 'wc', current_state['wc_avail'])\r\n\u001b[?2004l\r"]
[251.960516, "o", "\u001b[?2004h> "]
[251.960544, "o", "PY\r\n\u001b[?2004l\r"]
[251.981577, "o", "Topo order: ['P_B', 'SUB_L3_B', 'P4', 'P3', 'L3', 'P1', 'SUB_L3_A', 'P5', 'L4', 'P2', 'SA2', 'L2', 'SA1', 'L1', 'L_TIE']\r\n"]
[251.981769, "o", "Order O1: product=P1, req=12, chosen=12\r\n"]
[251.981804, "o", "  demand: {'P1': 12, 'SA1': 12.0, 'L1': 44.0}\r\n  build: {'P1': 12, 'SA1': 10}\r\n  leaf_req: {'L1': 44.0}\r\n  hours_req: {'WC1': 23.0}\r\n"]
[251.984838, "o", "Traceback (most recent call last):\r\n"]
[251.984878, "o", "  File \u001b[35m\"<stdin>\"\u001b[0m, line \u001b[35m215\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n  File \u001b[35m\"<stdin>\"\u001b[0m, line \u001b[35m179\u001b[0m, in \u001b[35mcommit\u001b[0m\r\n\u001b[1;35mKeyError\u001b[0m: \u001b[35m'__product'\u001b[0m\r\n"]
[251.988183, "o", "\u001b[?2004hroot@c1bca28e-fe7d-42f0-97e9-868cb11bd491:/app# "]
[363.568575, "i", "python3 - <<'PY'\nimport sqlite3, json, math, copy\nfrom collections import defaultdict\n\nDB = '/app/manufacturing.db'\n\n# Load database\nconn = sqlite3.connect(DB)\ncur = conn.cursor()\n\nparts = {}\nfor pid, name, qty, batch in cur.execute('SELECT part_id, name, on_hand_qty, batch_size FROM parts'):\n    parts[pid] = {'name': name, 'on_hand': float(qty), 'batch': int(batch)}\n\nbom = defaultdict(list)\nfor parent, child, qty, scrap, setup in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n    bom[parent].append({'child': child, 'qty_per': qty, 'scrap_pct': scrap, 'setup_scrap': setup})\n\nrouting = defaultdict(list)\nfor parent, wc, setup, run in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\n    routing[parent].append({'wc': wc, 'setup': setup, 'run': run})\n\nsubstitutes = defaultdict(list)\nfor primary, sub, ratio, rank in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substi"]
[363.568631, "i", "tutes'):\n    substitutes[primary].append({'sub': sub, 'ratio': ratio, 'rank': rank})\nfor k, v in substitutes.items():\n    v.sort(key=lambda x: (x['rank'], x['sub']))\n\nworkcenters = {}\nfor wc, name, avail in cur.execute('SELECT workcenter_id, name, available_hours FROM workcenters'):\n    workcenters[wc] = float(avail)\n\norders = []\nfor oid, prod, qty, prio in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders'):\n    orders.append({'id': oid, 'product': prod, 'qty': int(qty), 'priority': int(prio)})\norders.sort(key=lambda x: (x['priority'], x['id']))\nconn.close()\n\n# Build topological order: parent before child/leaf.\nall_nodes = set(parts.keys())\nbom_nodes = set(bom.keys()) | {e['child'] for children in bom.values() for e in children}\nall_nodes |= bom_nodes\n\nvisited = set()\ntemp = set()\npost = []\n\ndef dfs(node):\n    if node in visited:\n        return\n    if node in temp:\n        return\n    temp.add(node)\n    for edge in bom.get(node, []):\n        dfs(edge['child'])\n    temp.discard"]
[363.568826, "i", "(node)\n    visited.add(node)\n    post.append(node)\n\nfor node in all_nodes:\n    dfs(node)\ntopo = list(reversed(post))\n\n# Current mutable state\nstate = {\n    'on_hand': {p: parts[p]['on_hand'] for p in parts},\n    'wc_avail': dict(workcenters)\n}\n\n\ndef material_need(base, scrap_pct, setup_scrap):\n    return math.ceil(base * (1.0 + scrap_pct / 100.0)) + setup_scrap\n\n\ndef explode(product, qty, st):\n    demand = defaultdict(float)\n    demand[product] = float(qty)\n    build = {}\n    leaf_req = defaultdict(float)\n    hours_req = defaultdict(float)\n\n    for p in topo:\n        d = demand.get(p, 0.0)\n        if d <= 1e-12:\n            continue\n        if p not in bom:\n            leaf_req[p] += d\n            continue\n\n        if p == product:\n            need = d\n        else:\n            avail = st['on_hand'].get(p, 0.0)\n            need = max(0.0, d - avail)\n\n        if need > 1e-12:\n            b = parts[p]['batch']\n            bq = math.ceil(need / b) * b\n        else:\n            bq = 0\n        build[p] = bq\n\n     "]
[363.568865, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.568883, "i", "   if bq > 0:\n            for edge in bom[p]:\n                base = bq * edge['qty_per']\n                child_need = material_need(base, edge['scrap_pct'], edge['setup_scrap'])\n                demand[edge['child']] += child_need\n            for route in routing.get(p, []):\n                hours_req[route['wc']] += route['setup'] + bq * route['run']\n\n    return {'demand': demand, 'build': build, 'leaf_req': leaf_req, 'hours_req': hours_req}\n\n\ndef consume_leaf_alloc(leaf, qty, st):\n    \"\"\"Return consumed dict if enough, else None.\"\"\"\n    used = defaultdict(float)\n    avail_own = st['on_hand'].get(leaf, 0.0)\n    take = min(avail_own, qty)\n    used[leaf] += take\n    rem = qty - take\n    if rem <= 1e-12:\n        return dict(used)\n\n    for sub in substitutes.get(leaf, []):\n        sub_part = sub['sub']\n        ratio = sub['ratio']\n        stock = st['on_hand'].get(sub_part, 0.0)\n        cover = math.floor(stock / ratio) if ratio > 0 else 0\n        take_primary = min(cover, rem)\n        if take_primary > 0:\n      "]
[363.568915, "i", "      used[sub_part] += take_primary * ratio\n            rem -= take_primary\n        if rem <= 1e-12:\n            return dict(used)\n    return None\n\n\ndef is_feasible(plan, st):\n    for leaf, qty in plan['leaf_req'].items():\n        if consume_leaf_alloc(leaf, qty, st) is None:\n            return False\n    for wc, hrs in plan['hours_req'].items():\n        if hrs > st['wc_avail'].get(wc, 0.0) + 1e-12:\n            return False\n    return True\n\n\ndef commit(plan, st, product):\n    # Consume leaf materials and substitutes\n    for leaf, qty in plan['leaf_req'].items():\n        used = consume_leaf_alloc(leaf, qty, st)\n        if used is None:\n            raise RuntimeError(f\"Could not consume leaf {leaf} quantity {qty}\")\n        for part, amt in used.items():\n            st['on_hand'][part] -= amt\n\n    # Consume existing sub-assembly inventories, then add manufactured parts\n    for p in topo:\n        if p not in bom:\n            continue\n        d = plan['demand'].get(p, 0.0)\n        if d <= 1e-12:\n            contin"]
[363.568956, "i", "ue\n        if p != product:\n            take = min(d, st['on_hand'].get(p, 0.0))\n            st['on_hand'][p] -= take\n        bq = plan['build'].get(p, 0)\n        if bq > 0:\n            st['on_hand'][p] += bq\n\n    # Consume workcenter hours\n    for wc, hrs in plan['hours_req'].items():\n        st['wc_avail'][wc] -= hrs\n\n\ndef leaf_total_available(leaf, st):\n    total = st['on_hand'].get(leaf, 0.0)\n    for sub in substitutes.get(leaf, []):\n        stock = st['on_hand'].get(sub['sub'], 0.0)\n        ratio = sub['ratio']\n        if ratio > 0:\n            total += math.floor(stock / ratio)\n    return total\n\n\ndef limiting_resource_for(product, probe_qty, st):\n    plan = explode(product, probe_qty, st)\n    ratios = []\n    for leaf, gross in plan['leaf_req'].items():\n        if gross <= 1e-12:\n            continue\n        avail = leaf_total_available(leaf, st)\n        ratios.append((avail / gross, leaf))\n    for wc, gross in plan['hours_req'].items():\n        if gross <= 1e-12:\n            continue\n        avail = st["]
[363.568971, "o", "import sqlite3, json, math, copy\r\n\u001b[?2004l\r"]
[363.568993, "i", "'wc_avail'].get(wc, 0.0)\n        ratios.append((avail / gross, wc))\n    below = [(r, res) for r, res in ratios if r < 1.0 - 1e-12]\n    if not below:\n        return None\n    min_r = min(r for r, _ in below)\n    tied = [res for r, res in below if abs(r - min_r) < 1e-12]\n    return sorted(tied)[0]\n\n\nresults = []\nfor order in orders:\n    prod = order['product']\n    req = order['qty']\n    batch = parts[prod]['batch']\n    largest_multiple = req - (req % batch)\n\n    chosen_qty = 0\n    chosen_plan = None\n    for q in range(largest_multiple, -1, -batch):\n        test_state = copy.deepcopy(state)\n        plan_candidate = explode(prod, q, test_state)\n        if is_feasible(plan_candidate, test_state):\n            chosen_qty = q\n            chosen_plan = plan_candidate\n            break\n\n    # If fulfilled entirely, no limiting resource.\n    limiting = None\n    if chosen_qty < req:\n        # Compute limiting resource for one batch beyond maximum buildable quantity.\n        probe_qty = chosen_qty + batch\n        limiting "]
[363.569006, "o", "\u001b[?2004h> "]
[363.569046, "i", "= limiting_resource_for(prod, probe_qty, state)\n\n    # Minimum fill-rate cancellation\n    final_alloc = chosen_qty\n    shortfall = req - final_alloc\n    if req > 0 and (final_alloc / req) < 0.5:\n        final_alloc = 0\n        shortfall = req\n    else:\n        if chosen_plan is not None and final_alloc > 0:\n            commit(chosen_plan, state, prod)\n\n    results.append({\n        'order_id': order['id'],\n        'allocated_qty': int(final_alloc),\n        'shortfall_qty': int(shortfall),\n        'limiting_resource': limiting\n    })\n    print(f\"Order {order['id']}: req={req}, max_buildable={chosen_qty}, final_alloc={final_alloc}, short={shortfall}, lim={limiting}\")\n\nprint('\\nFinal report:')\nprint(json.dumps({'orders': results}, indent=2))\nprint('\\nFinal state:')\nprint('on_hand changed:', {k:v for k,v in state['on_hand'].items() if abs(v - parts[k]['on_hand']) > 1e-12})\nprint('wc_avail:', state['wc_avail'])\nPY\n"]
