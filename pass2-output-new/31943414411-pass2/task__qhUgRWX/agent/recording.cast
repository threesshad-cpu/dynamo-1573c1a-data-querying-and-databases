[497.570615, "i", "python3 - <<'PY'\nimport sqlite3, json, math, copy\nfrom collections import defaultdict\n\nDB='/app/manufacturing.db'\nconn=sqlite3.connect(DB)\ncur=conn.cursor()\n\nparts={}\nfor pid,name,q,b in cur.execute('SELECT part_id,name,on_hand_qty,batch_size FROM parts'):\n    parts[pid]={'name':name,'on_hand':float(q),'batch':int(b)}\n\nbom=defaultdict(list)\nfor parent,child,q,scrap,setup in cur.execute('SELECT parent_part_id,child_part_id,qty_per,scrap_rate_pct,setup_scrap_qty FROM bom'):\n    bom[parent].append({'child':child,'qty_per':q,'scrap_pct':scrap,'setup_scrap':setup})\n\nrouting=defaultdict(list)\nfor parent,wc,setup,run in cur.execute('SELECT parent_part_id,workcenter_id,setup_hours,run_hours_per_unit FROM routing'):\n    routing[parent].append({'wc':wc,'setup':setup,'run':run})\n\nsubs=defaultdict(list)\nfor primary,sub,ratio,rank in cur.execute('SELECT primary_part_id,substitute_part_id,qty_ratio,preference_rank FROM substitutes'):\n    subs[primary].append({'sub':sub,'ratio':ratio,'rank':rank})\nfor k,v in subs.items():\n "]
[497.57067, "i", "   v.sort(key=lambda x:(x['rank'],x['sub']))\n\nwcs={}\nfor wc,name,av in cur.execute('SELECT workcenter_id,name,available_hours FROM workcenters'):\n    wcs[wc]=float(av)\n\norders=[]\nfor oid,prod,q,prio in cur.execute('SELECT order_id,product_part_id,requested_qty,priority FROM orders'):\n    orders.append({'id':oid,'product':prod,'qty':int(q),'priority':int(prio)})\norders.sort(key=lambda x:(x['priority'],x['id']))\nconn.close()\n\n# Build a deterministic topo order using Kahn on current BOM, sorted by node where no parents constraints?  \n# We'll use a DFS postorder; set iteration is okay for valid parent-before-child but non-deterministic.\nall_nodes=set(parts.keys()) | set(bom.keys()) | {e['child'] for ch in bom.values() for e in ch}\nvisited=set(); temp=set(); post=[]\n\ndef dfs(n):\n    if n in visited or n in temp:\n        return\n    temp.add(n)\n    for e in bom.get(n,[]):\n        dfs(e['child'])\n    temp.discard(n)\n    visited.add(n)\n    post.append(n)\nfor n in sorted(all_nodes):\n    dfs(n)\ntopo=list(reversed(post))"]
[497.570849, "i", "\n\nstate={'on_hand':{p:parts[p]['on_hand'] for p in parts},'wc_avail':dict(wcs)}\n\ndef mat_need(base, scrap, setup):\n    return math.ceil(base*(1.0+scrap/100.0)) + setup\n\ndef explode(product, qty, st):\n    demand=defaultdict(float)\n    demand[product]=float(qty)\n    build={}\n    leaf_req=defaultdict(float)\n    hours_req=defaultdict(float)\n    for p in topo:\n        d=demand.get(p,0.0)\n        if d<=1e-12:\n            continue\n        if p not in bom:\n            leaf_req[p]+=d\n            continue\n        if p==product:\n            need=d\n        else:\n            need=max(0.0,d-st['on_hand'].get(p,0.0))\n        if need>1e-12:\n            bq=math.ceil(need/parts[p]['batch'])*parts[p]['batch']\n        else:\n            bq=0\n        build[p]=bq\n        if bq>0:\n            for e in bom[p]:\n                child_need=mat_need(bq*e['qty_per'], e['scrap_pct'], e['setup_scrap'])\n                demand[e['child']]+=child_need\n            for r in routing.get(p,[]):\n                hours_req[r['wc']]+=r['setup'] + bq*r"]
[497.570886, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[497.57092, "i", "['run']\n    return {'demand':demand,'build':build,'leaf_req':leaf_req,'hours_req':hours_req}\n\ndef consume_leaf(leaf,qty,st,commit=False):\n    used=defaultdict(float)\n    take=min(st['on_hand'].get(leaf,0.0), qty)\n    used[leaf]+=take\n    rem=qty-take\n    if rem<=1e-12:\n        if commit:\n            for p,a in used.items(): st['on_hand'][p]-=a\n        return True\n    for sub in subs.get(leaf,[]):\n        sp=sub['sub']; stock=st['on_hand'].get(sp,0.0); ratio=sub['ratio']\n        cover=math.floor(stock/ratio) if ratio>0 else 0\n        take_p=min(cover, rem)\n        if take_p>0:\n            used[sp]+=take_p*ratio\n            rem-=take_p\n        if rem<=1e-12:\n            if commit:\n                for p,a in used.items(): st['on_hand'][p]-=a\n            return True\n    return False\n\ndef feasible(plan,st):\n    for leaf,q in plan['leaf_req'].items():\n        if not consume_leaf(leaf,q,st):\n            return False\n    for wc,h in plan['hours_req'].items():\n        if h>st['wc_avail'].get(wc,0.0)+1e-12:\n           "]
[497.570957, "o", "import sqlite3, json, math, copy\r\n\u001b[?2004l\r"]
[497.570971, "i", " return False\n    return True\n\ndef commit(plan,st,product):\n    # consume leaves\n    for leaf,q in plan['leaf_req'].items():\n        ok=consume_leaf(leaf,q,st,commit=True)\n        if not ok:\n            raise RuntimeError('leaf commit fail')\n    # update manufactured/intermediate parts: old + built - total demand (for component use)\n    for p in topo:\n        if p not in bom:\n            continue\n        d=plan['demand'].get(p,0.0)\n        bq=plan['build'].get(p,0)\n        if p==product:\n            # product itself is not consumed as a component in this order\n            st['on_hand'][p] += bq\n        else:\n            # p is consumed as a component, all demand d is consumed\n            st['on_hand'][p] += bq - d\n    for wc,h in plan['hours_req'].items():\n        st['wc_avail'][wc]-=h\n\ndef leaf_total_available(leaf,st):\n    total=st['on_hand'].get(leaf,0.0)\n    for sub in subs.get(leaf,[]):\n        ratio=sub['ratio']\n        if ratio>0:\n            total += math.floor(st['on_hand'].get(sub['sub'],0.0)/ratio)"]
[497.571016, "o", "\u001b[?2004h> "]
[497.571051, "i", "\n    return total\n\ndef limiting(product,probe_q,st):\n    plan=explode(product,probe_q,st)\n    ratios=[]\n    for leaf,gross in plan['leaf_req'].items():\n        if gross>1e-12:\n            ratios.append((leaf_total_available(leaf,st)/gross, leaf))\n    for wc,gross in plan['hours_req'].items():\n        if gross>1e-12:\n            ratios.append((st['wc_avail'].get(wc,0.0)/gross, wc))\n    below=[(r,res) for r,res in ratios if r < 1.0-1e-12]\n    if not below:\n        return None\n    minr=min(r for r,_ in below)\n    tied=[res for r,res in below if abs(r-minr)<1e-12]\n    return sorted(tied)[0]\n\nresults=[]\nfor od in orders:\n    prod=od['product']; req=od['qty']; batch=parts[prod]['batch']\n    chosen=None; chosen_plan=None\n    for q in range(req-(req%batch), -1, -batch):\n        test=copy.deepcopy(state)\n        pc=explode(prod,q,test)\n        if feasible(pc,test):\n            chosen=q; chosen_plan=pc; break\n    if chosen is None:\n        chosen=0; chosen_plan=explode(prod,0,copy.deepcopy(state))\n    lim=None\n    if c"]
[497.571105, "i", "hosen<req:\n        lim=limiting(prod, chosen+batch, state)\n    final=chosen\n    short=req-final\n    if req>0 and (final/req)<0.5:\n        final=0; short=req\n    else:\n        if final>0:\n            commit(chosen_plan, state, prod)\n    results.append({'order_id':od['id'],'allocated_qty':int(final),'shortfall_qty':int(short),'limiting_resource':lim})\n    print(f\"{od['id']}: req={req}, chosen={chosen}, final={final}, short={short}, lim={lim}\")\n\nresults_sorted=sorted(results,key=lambda x:x['order_id'])\nprint('\\nreport:')\nprint(json.dumps({'orders':results_sorted},indent=2))\nprint('\\nfinal on_hand:')\nfor k in sorted(state['on_hand']):\n    v=state['on_hand'][k]\n    if not math.isclose(v,parts[k]['on_hand']):\n        print(k, v)\nprint('wcs:', state['wc_avail'])\nPY\n"]
