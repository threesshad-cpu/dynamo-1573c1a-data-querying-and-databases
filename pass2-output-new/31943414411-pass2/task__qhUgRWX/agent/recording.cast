[585.343719, "i", "  used[leaf]+=take\n    rem=qty-take\n    if rem<=1e-12:\n        if commit:\n            for p,a in used.items(): st['on_hand'][p]-=a\n        return True\n    for sub in subs.get(leaf,[]):\n        sp=sub['sub']; stock=st['on_hand'].get(sp,0.0); ratio=sub['ratio']\n        cover=math.floor(stock/ratio) if ratio>0 else 0\n        take_p=min(cover, rem)\n        if take_p>0:\n            used[sp]+=take_p*ratio\n            rem-=take_p\n        if rem<=1e-12:\n            if commit:\n                for p,a in used.items(): st['on_hand'][p]-=a\n            return True\n    return False\n\ndef feasible(plan, st):\n    for leaf,q in plan['leaf_req'].items():\n        if not consume_leaf(leaf,q,st):\n            return False\n    for wc,h in plan['hours_req'].items():\n        if h > st['wc_avail'].get(wc,0.0) + 1e-12:\n            return False\n    return True\n\ndef commit(plan, st, product):\n    for leaf,q in plan['leaf_req'].items():\n        if not consume_leaf(leaf,q,st,commit=True):\n            raise RuntimeError('leaf commit fail')\n "]
