[585.343652, "i", "t(float)\n    demand[product]=float(qty)\n    build={}\n    leaf_req=defaultdict(float)\n    hours_req=defaultdict(float)\n    for p in topo:\n        d=demand.get(p,0.0)\n        if d<=1e-12:\n            continue\n        if p not in bom:\n            leaf_req[p]+=d\n            continue\n        if p==product:\n            need=d\n        else:\n            need=max(0.0, d - st['on_hand'].get(p,0.0))\n        if need>1e-12:\n            bq=math.ceil(need/parts[p]['batch'])*parts[p]['batch']\n        else:\n            bq=0\n        build[p]=bq\n        if bq>0:\n            for e in bom[p]:\n                child_need=mat_need(bq*e['qty_per'], e['scrap_pct'], e['setup_scrap'])\n                demand[e['child']]+=child_need\n            for r in routing.get(p,[]):\n                hours_req[r['wc']]+=r['setup'] + bq*r['run']\n    return {'demand':demand,'build':build,'leaf_req':leaf_req,'hours_req':hours_req}\n\ndef consume_leaf(leaf, qty, st, commit=False):\n    used=defaultdict(float)\n    take=min(st['on_hand'].get(leaf,0.0), qty)\n  "]
