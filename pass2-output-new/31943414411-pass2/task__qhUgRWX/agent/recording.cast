[251.928967, "i", "  print('negative leaf inv', part, state['on_hand'][part])\n    # manufactured parts\n    for p, bq in plan['build'].items():\n        d = plan['demand'].get(p, 0.0)\n        if p not in plan['build'] and p not in bom:\n            pass\n        else:\n            if p == parts and p == 'PRODUCT?': pass\n            old = state['on_hand'].get(p, 0.0)\n            if p != plan['demand'].get('pid'):\n                pass\n    for p in plan['build']:\n        if p not in bom:\n            continue\n        d = plan['demand'].get(p, 0.0)\n        old = state['on_hand'].get(p, 0.0)\n        if p != plan['build'].get('__product'):\n            pass\n    # Do after leaves\n    for p, bq in plan['build'].items():\n        if p not in bom:\n            continue\n        d = plan['demand'].get(p, 0.0)\n        old = state['on_hand'].get(p, 0.0)\n        if p == plan['__product']:\n            pass\n        consume = min(d, old)\n        state['on_hand'][p] = old - consume\n    for p, bq in plan['build'].items():\n        if p not in bom:\n         "]
