[585.354076, "o", "def mat_need(base, scrap, setup):\r\n\u001b[?2004l\r"]
[585.354089, "o", "\u001b[?2004h> "]
[585.35432, "o", "    return math.ceil(base*(1.0+scrap/100.0)) + setup\r\n\u001b[?2004l\r"]
[585.354355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rl"]
[585.354384, "o", "\u001b[?2004h> "]
[585.354536, "o", "def explode(product, qty, st):\r\n\u001b[?2004l\rx\u001b[?2004h> "]
[585.354678, "o", "    demand=defaultdict(float)\r\n\u001b[?2004l\r"]
[585.354691, "o", "\u001b[?2004h> "]
[585.354874, "o", "    demand[product]=float(qty)\r\n\u001b[?2004l\r"]
[585.354903, "o", "\u001b[?2004h> "]
[585.354959, "o", "    build={}\r\n\u001b[?2004l\r"]
[585.354988, "o", "\u001b[?2004h> "]
[585.35513, "o", "    leaf_req=defaultdict(float)\r\n\u001b[?2004l\r"]
[585.355143, "o", "\u001b[?2004h> "]
[585.355293, "o", "    hours_req=defaultdict(float)\r\n\u001b[?2004l\r"]
[585.355322, "o", "\u001b[?2004h> "]
[585.3554, "o", "    for p in topo:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.35551, "o", "        d=demand.get(p,0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.355539, "o", "> "]
[585.355597, "o", "        if d<=1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.355624, "o", "> "]
[585.35568, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.355715, "o", "> "]
[585.355781, "o", "        if p not in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.355886, "o", "            leaf_req[p]+=d\r\n\u001b[?2004l\r"]
[585.355916, "o", "\u001b[?2004h> "]
[585.355966, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.355995, "o", "> "]
[585.35607, "o", "        if p==product:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.356145, "o", "            need=d\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.356174, "o", "> "]
[585.35621, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.35624, "o", "> "]
[585.356395, "o", "            need=max(0.0, d - st['on_hand'].get(p,0.0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.356428, "o", "> "]
[585.356495, "o", "        if need>1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.356523, "o", "> "]
[585.356712, "o", "            bq=math.ceil(need/parts[p]['batch'])*parts[p]['batch']\r\n\u001b[?2004l\r"]
[585.356742, "o", "\u001b[?2004h> "]
[585.35678, "o", "        else:\r\n\u001b[?2004l\r"]
[585.35681, "o", "\u001b[?2004h> "]
[585.356857, "o", "            bq=0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.356938, "o", "        build[p]=bq\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.35701, "o", "        if bq>0:\r\n\u001b[?2004l\r"]
[585.357058, "o", "\u001b[?2004h> "]
[585.357128, "o", "            for e in bom[p]:\r\n\u001b[?2004l\r"]
[585.357161, "o", "\u001b[?2004h> "]
[585.357421, "o", "                child_need=mat_need(bq*e['qty_per'], e['scrap_pct'], e['setup_scrap'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.357435, "o", "> "]
[585.357584, "o", "                demand[e['child']]+=child_need\r\n\u001b[?2004l\r"]
[585.357616, "o", "\u001b[?2004h> "]
[585.357734, "o", "            for r in routing.get(p,[]):\r\n\u001b[?2004l\r"]
[585.357769, "o", "\u001b[?2004h> "]
[585.357956, "o", "                hours_req[r['wc']]+=r['setup'] + bq*r['run']\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.357971, "o", "> "]
[585.35822, "o", "    return {'demand':demand,'build':build,'leaf_req':leaf_req,'hours_req':hours_req}\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.358236, "o", "> \r\n\u001b[?2004l\r"]
[585.358267, "o", "\u001b[?2004h> "]
[585.35841, "o", "def consume_leaf(leaf, qty, st, commit=False):\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.358425, "o", "> "]
[585.358515, "o", "    used=defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.358531, "o", "> "]
[585.358673, "o", "    take=min(st['on_hand'].get(leaf,0.0), qty)\r\n\u001b[?2004l\r"]
[585.358689, "o", "\u001b[?2004h> "]
[585.358788, "o", "    used[leaf]+=take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.35884, "o", "    rem=qty-take\r\n\u001b[?2004l\r"]
[585.358855, "o", "\u001b[?2004h> "]
[585.358925, "o", "    if rem<=1e-12:\r\n\u001b[?2004l\r"]
[585.358939, "o", "\u001b[?2004h> "]
[585.359002, "o", "        if commit:\r\n\u001b[?2004l\r"]
[585.359015, "o", "\u001b[?2004h> "]
[585.3592, "o", "            for p,a in used.items(): st['on_hand'][p]-=a\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.359432, "o", "        return True\r\n\u001b[?2004l\r\u001b[?2004h>     for sub in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.359647, "o", "        sp=sub['sub']; stock=st['on_hand'].get(sp,0.0); ratio=sub['ratio']\r\n\u001b[?2004l\r"]
[585.359679, "o", "\u001b[?2004h> "]
[585.359829, "o", "        cover=math.floor(stock/ratio) if ratio>0 else 0\r\n\u001b[?2004l\r"]
[585.359859, "o", "\u001b[?2004h> "]
[585.359948, "o", "        take_p=min(cover, rem)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.359979, "o", "> "]
[585.360051, "o", "        if take_p>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.360086, "o", "> "]
[585.360167, "o", "            used[sp]+=take_p*ratio\r\n\u001b[?2004l\r"]
[585.360197, "o", "\u001b[?2004h> "]
[585.36026, "o", "            rem-=take_p\r\n\u001b[?2004l\r"]
[585.36029, "o", "\u001b[?2004h> "]
[585.360351, "o", "        if rem<=1e-12:\r\n\u001b[?2004l\r"]
[585.36038, "o", "\u001b[?2004h> "]
[585.360452, "o", "            if commit:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.360645, "o", "                for p,a in used.items(): st['on_hand'][p]-=a\r\n\u001b[?2004l\r"]
[585.360677, "o", "\u001b[?2004h> "]
[585.360738, "o", "            return True\r\n\u001b[?2004l\r"]
[585.360767, "o", "\u001b[?2004h> "]
[585.360819, "o", "    return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.360849, "o", "> \r\n\u001b[?2004l\r"]
[585.360878, "o", "\u001b[?2004h> "]
[585.360943, "o", "def feasible(plan, st):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.361102, "o", "    for leaf,q in plan['leaf_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.361242, "o", "        if not consume_leaf(leaf,q,st):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.361334, "o", "            return False\r\n\u001b[?2004l\r"]
[585.361365, "o", "\u001b[?2004h> "]
[585.361495, "o", "    for wc,h in plan['hours_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.361525, "o", "> "]
[585.361664, "o", "        if h > st['wc_avail'].get(wc,0.0) + 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.361694, "o", "> "]
[585.361759, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.361789, "o", "> "]
[585.36183, "o", "    return True\r\n\u001b[?2004l\r"]
[585.361846, "o", "\u001b[?2004h> \r\n"]
[585.361854, "o", "\u001b[?2004l\r\u001b[?2004h"]
[585.361888, "o", "> "]
[585.361975, "o", "def commit(plan, st, product):\r\n\u001b[?2004l\r"]
[585.362008, "o", "\u001b[?2004h> "]
[585.362137, "o", "    for leaf,q in plan['leaf_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.362299, "o", "        if not consume_leaf(leaf,q,st,commit=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.362314, "o", "> "]
[585.362472, "o", "            raise RuntimeError('leaf commit fail')\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.362489, "o", "> "]
[585.362551, "o", "    for p in topo:\r\n\u001b[?2004l\r"]
[585.362584, "o", "\u001b[?2004h> "]
[585.362653, "o", "        if p not in bom:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.362736, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.362767, "o", "> "]
[585.36287, "o", "        d=plan['demand'].get(p,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.362988, "o", "        bq=plan['build'].get(p,0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.363018, "o", "> "]
[585.363091, "o", "        if p==product:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.363213, "o", "            st['on_hand'][p] += bq\r\n\u001b[?2004l\r"]
[585.363244, "o", "\u001b[?2004h> "]
[585.363276, "o", "        else:\r\n\u001b[?2004l\r"]
[585.363307, "o", "\u001b[?2004h> "]
[585.363421, "o", "            st['on_hand'][p] += bq - d\r\n\u001b[?2004l\r"]
[585.363437, "o", "\u001b[?2004h> "]
[585.363567, "o", "    for wc,h in plan['hours_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.363583, "o", "> "]
[585.363676, "o", "        st['wc_avail'][wc]-=h\r\n\u001b[?2004l\r"]
[585.363691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[585.36373, "o", "\u001b[?2004h> "]
[585.363838, "o", "def leaf_total_available(leaf, st):\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.363869, "o", "> "]
[585.363975, "o", "    total=st['on_hand'].get(leaf,0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.363991, "o", "> "]
[585.364109, "o", "    for sub in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.364201, "o", "        ratio=sub['ratio']\r\n\u001b[?2004l\r"]
[585.364235, "o", "\u001b[?2004h> "]
[585.364284, "o", "        if ratio>0:\r\n\u001b[?2004l\r"]
[585.364315, "o", "\u001b[?2004h> "]
[585.364529, "o", "            total += math.floor(st['on_hand'].get(sub['sub'],0.0)/ratio)\r\n\u001b[?2004l\r"]
[585.364545, "o", "\u001b[?2004h> "]
[585.3646, "o", "    return total\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.364615, "o", "> \r\n\u001b[?2004l\r"]
[585.364627, "o", "\u001b[?2004h"]
[585.364669, "o", "> "]
[585.364766, "o", "def limiting(product, probe_qty, st):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.364904, "o", "    plan=explode(product, probe_qty, st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.364921, "o", "> "]
[585.364971, "o", "    ratios=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.364987, "o", "> "]
[585.365137, "o", "    for leaf,gross in plan['leaf_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.365153, "o", "> "]
[585.365276, "o", "        if gross>1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.365462, "o", "            ratios.append((leaf_total_available(leaf,st)/gross, leaf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.365478, "o", "> "]
[585.365621, "o", "    for wc,gross in plan['hours_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.365638, "o", "> "]
[585.365722, "o", "        if gross>1e-12:\r\n\u001b[?2004l\r"]
[585.365756, "o", "\u001b[?2004h> "]
[585.365928, "o", "            ratios.append((st['wc_avail'].get(wc,0.0)/gross, wc))\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.365945, "o", "> "]
[585.366127, "o", "    below=[(r,res) for r,res in ratios if r < 1.0-1e-12]\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.36616, "o", "> "]
[585.366205, "o", "    if not below:\r\n\u001b[?2004l\r"]
[585.366237, "o", "\u001b[?2004h> "]
[585.366288, "o", "        return None\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.36632, "o", "> "]
[585.366412, "o", "    minr=min(r for r,_ in below)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.366444, "o", "> "]
[585.366594, "o", "    tied=[res for r,res in below if abs(r-minr)<1e-12]\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.36661, "o", "> "]
[585.366695, "o", "    return sorted(tied)[0]\r\n\u001b[?2004l\r"]
[585.366709, "o", "\u001b[?2004h> \r\n"]
[585.366722, "o", "\u001b[?2004l\r"]
[585.366762, "o", "\u001b[?2004h> "]
[585.366794, "o", "results=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.366827, "o", "> "]
[585.366863, "o", "for od in orders:\r\n\u001b[?2004l\r"]
[585.366893, "o", "\u001b[?2004h> "]
[585.367086, "o", "    prod=od['product']; req=od['qty']; batch=parts[prod]['batch']\r\n\u001b[?2004l\r"]
[585.367101, "o", "\u001b[?2004h> "]
[585.36721, "o", "    chosen=None; chosen_plan=None\r\n\u001b[?2004l\r"]
[585.367241, "o", "\u001b[?2004h> "]
[585.367378, "o", "    for q in range(req-(req%batch), -1, -batch):\r\n\u001b[?2004l\r"]
[585.367414, "o", "\u001b[?2004h> "]
[585.367506, "o", "        test=copy.deepcopy(state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.367537, "o", "> "]
[585.36762, "o", "        pc=explode(prod,q,test)\r\n\u001b[?2004l\r"]
[585.36765, "o", "\u001b[?2004h> "]
[585.367732, "o", "        if feasible(pc,test):\r\n\u001b[?2004l\r"]
[585.367747, "o", "\u001b[?2004h> "]
[585.367861, "o", "            chosen=q; chosen_plan=pc\r\n\u001b[?2004l\r"]
[585.367893, "o", "\u001b[?2004h> "]
[585.367939, "o", "            break\r\n\u001b[?2004l\r"]
[585.367971, "o", "\u001b[?2004h> "]
[585.368053, "o", "    if chosen is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.368253, "o", "        chosen=0; chosen_plan=explode(prod,0,copy.deepcopy(state))\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.368284, "o", "> "]
[585.368326, "o", "    lim=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[585.368402, "o", "    if chosen < req:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.368438, "o", "> "]
[585.368568, "o", "        lim=limiting(prod, chosen+batch, state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.3686, "o", "> "]
[585.36866, "o", "    final_alloc=chosen\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.368692, "o", "> "]
[585.36877, "o", "    shortfall=req-final_alloc\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.368802, "o", "> "]
[585.368914, "o", "    if req>0 and (final_alloc/req) < 0.5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.368928, "o", "> "]
[585.369003, "o", "        final_alloc=0\r\n\u001b[?2004l\r"]
[585.369045, "o", "\u001b[?2004h> "]
[585.3691, "o", "        shortfall=req\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.369132, "o", "> "]
[585.369163, "o", "    else:\r\n\u001b[?2004l\r"]
[585.369194, "o", "\u001b[?2004h> "]
[585.369255, "o", "        if final_alloc>0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.369287, "o", "> "]
[585.369413, "o", "            commit(chosen_plan, state, prod)\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.369443, "o", "> "]
[585.369801, "o", "    results.append({'order_id':od['id'],'allocated_qty':int(final_alloc),'shortfall_qty':int(shortfall),'limiting_resource':lim})\r\n\u001b[?2004l\r\u001b[?2004h"]
[585.369816, "o", "> \r\n\u001b[?2004l\r"]
[585.369827, "o", "\u001b[?2004h"]
[585.36987, "o", "> "]
[585.369969, "o", "results.sort(key=lambda x:x['order_id'])\r\n\u001b[?2004l\r"]
[585.369999, "o", "\u001b[?2004h> "]
[585.370124, "o", "with open('/app/report.json','w') as f:\r\n\u001b[?2004l\r"]
[585.370156, "o", "\u001b[?2004h> "]
[585.370293, "o", "    json.dump({'orders':results}, f, indent=2)\r\n\u001b[?2004l\r"]
[585.370323, "o", "\u001b[?2004h> "]
[585.370481, "o", "print(json.dumps({'orders':results}, indent=2))\r\n\u001b[?2004l\r"]
[585.370494, "o", "\u001b[?2004h> "]
