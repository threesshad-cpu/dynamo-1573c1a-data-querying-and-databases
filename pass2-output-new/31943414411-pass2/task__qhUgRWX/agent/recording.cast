[497.581656, "o", "    return math.ceil(base*(1.0+scrap/100.0)) + setup\r\n\u001b[?2004l\r"]
[497.581672, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.581704, "o", "\u001b[?2004h> "]
[497.581808, "o", "def explode(product, qty, st):\r\n\u001b[?2004l\r"]
[497.581841, "o", "\u001b[?2004h> "]
[497.581973, "o", "    demand=defaultdict(float)\r\n\u001b[?2004l\rro\u001b[?2004h> "]
[497.58211, "o", "    demand[product]=float(qty)\r\n\u001b[?2004l\r"]
[497.582125, "o", "\u001b[?2004h> "]
[497.582206, "o", "    build={}\r\n\u001b[?2004l\r],'"]
[497.582239, "o", "\u001b[?2004h> "]
[497.582366, "o", "    leaf_req=defaultdict(float)\r\n\u001b[?2004l\r"]
[497.582399, "o", "\u001b[?2004h> "]
[497.582523, "o", "    hours_req=defaultdict(float)\r\n\u001b[?2004l\r"]
[497.582536, "o", "\u001b[?2004h> "]
[497.582629, "o", "    for p in topo:\r\n\u001b[?2004l\rp\u001b[?2004h"]
[497.582644, "o", "> "]
[497.582765, "o", "        d=demand.get(p,0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[497.582867, "o", "        if d<=1e-12:\r\n\u001b[?2004l\r"]
[497.582881, "o", "\u001b[?2004h> "]
[497.58298, "o", "            continue\r\n\u001b[?2004l\rs\u001b[?2004h"]
[497.582993, "o", "> "]
[497.583107, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[497.583122, "o", "\u001b[?2004h> "]
[497.583249, "o", "            leaf_req[p]+=d\r\n\u001b[?2004l\rke"]
[497.583262, "o", "\u001b[?2004h> "]
[497.583361, "o", "            continue\r\n\u001b[?2004l\r"]
[497.583375, "o", "\u001b[?2004h> "]
[497.583475, "o", "        if p==product:\r\n\u001b[?2004l\r"]
[497.583488, "o", "')\u001b[?2004h> "]
[497.583584, "o", "            need=d\r\n\u001b[?2004l\r{\u001b[?2004h"]
[497.583597, "o", "> "]
[497.583663, "o", "        else:\r\n\u001b[?2004l\r"]
[497.583676, "o", "\u001b[?2004h> "]
[497.583919, "o", "            need=max(0.0,d-st['on_hand'].get(p,0.0))\r\n\u001b[?2004l\r"]
[497.583932, "o", "\u001b[?2004h> "]
[497.58405, "o", "        if need>1e-12:\r\n\u001b[?2004l\r"]
[497.584089, "o", "\u001b[?2004h> "]
[497.584377, "o", "            bq=math.ceil(need/parts[p]['batch'])*parts[p]['batch']\r\n\u001b[?2004l\r"]
[497.584411, "o", "\u001b[?2004h> "]
[497.584469, "o", "        else:\r\n\u001b[?2004l\r\r\n"]
[497.584483, "o", "\u001b[?2004h> "]
[497.584573, "o", "            bq=0\r\n\u001b[?2004l\r"]
[497.584587, "o", "\u001b[?2004h> "]
[497.584688, "o", "        build[p]=bq\r\n\u001b[?2004l\r"]
[497.5847, "o", "\u001b[?2004h> "]
[497.584798, "o", "        if bq>0:\r\n\u001b[?2004l\r"]
[497.584829, "o", "\u001b[?2004h> "]
[497.584922, "o", "            for e in bom[p]:\r\n\u001b[?2004l\r"]
[497.584954, "o", "\u001b[?2004h> "]
[497.585194, "o", "                child_need=mat_need(bq*e['qty_per'], e['scrap_pct'], e['setup_scrap'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.585225, "o", "> "]
[497.585351, "o", "                demand[e['child']]+=child_need\r\n\u001b[?2004l\r"]
[497.585383, "o", "\u001b[?2004h> "]
[497.585488, "o", "            for r in routing.get(p,[]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.585507, "o", "> "]
[497.585693, "o", "                hours_req[r['wc']]+=r['setup'] + bq*r['run']\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.585707, "o", "> "]
[497.585951, "o", "    return {'demand':demand,'build':build,'leaf_req':leaf_req,'hours_req':hours_req}\r\n\u001b[?2004l\r"]
[497.585985, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.586017, "o", "\u001b[?2004h> "]
[497.586134, "o", "def consume_leaf(leaf,qty,st,commit=False):\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.586149, "o", "> "]
[497.586242, "o", "    used=defaultdict(float)\r\n\u001b[?2004l\r"]
[497.586259, "o", "\u001b[?2004h> "]
[497.586402, "o", "    take=min(st['on_hand'].get(leaf,0.0), qty)\r\n\u001b[?2004l\r"]
[497.586418, "o", "\u001b[?2004h> "]
[497.586487, "o", "    used[leaf]+=take\r\n\u001b[?2004l\r"]
[497.586511, "o", "\u001b[?2004h> "]
[497.586579, "o", "    rem=qty-take\r\n\u001b[?2004l\r"]
[497.586594, "o", "\u001b[?2004h> "]
[497.586658, "o", "    if rem<=1e-12:\r\n\u001b[?2004l\r"]
[497.586674, "o", "\u001b[?2004h> "]
[497.586744, "o", "        if commit:\r\n\u001b[?2004l\r"]
[497.586776, "o", "\u001b[?2004h> "]
[497.586929, "o", "            for p,a in used.items(): st['on_hand'][p]-=a\r\n\u001b[?2004l\r"]
[497.58696, "o", "\u001b[?2004h> "]
[497.587018, "o", "        return True\r\n\u001b[?2004l\r"]
[497.587044, "o", "\u001b[?2004h> "]
[497.587144, "o", "    for sub in subs.get(leaf,[]):\r\n\u001b[?2004l\r"]
[497.587176, "o", "\u001b[?2004h> "]
[497.587381, "o", "        sp=sub['sub']; stock=st['on_hand'].get(sp,0.0); ratio=sub['ratio']\r\n\u001b[?2004l\r"]
[497.587412, "o", "\u001b[?2004h> "]
[497.587569, "o", "        cover=math.floor(stock/ratio) if ratio>0 else 0\r\n\u001b[?2004l\r"]
[497.587585, "o", "\u001b[?2004h> "]
[497.587685, "o", "        take_p=min(cover, rem)\r\n\u001b[?2004l\r"]
[497.587702, "o", "\u001b[?2004h> "]
[497.587775, "o", "        if take_p>0:\r\n\u001b[?2004l\r"]
[497.587808, "o", "\u001b[?2004h> "]
[497.587899, "o", "            used[sp]+=take_p*ratio\r\n\u001b[?2004l\r"]
[497.58793, "o", "\u001b[?2004h> "]
[497.587998, "o", "            rem-=take_p\r\n\u001b[?2004l\r"]
[497.58804, "o", "\u001b[?2004h> "]
[497.5881, "o", "        if rem<=1e-12:\r\n\u001b[?2004l\r"]
[497.588132, "o", "\u001b[?2004h> "]
[497.588196, "o", "            if commit:\r\n\u001b[?2004l\r"]
[497.588227, "o", "\u001b[?2004h> "]
[497.588398, "o", "                for p,a in used.items(): st['on_hand'][p]-=a\r\n\u001b[?2004l\r"]
[497.588429, "o", "\u001b[?2004h> "]
[497.588495, "o", "            return True\r\n\u001b[?2004l\r"]
[497.588526, "o", "\u001b[?2004h> "]
[497.58857, "o", "    return False\r\n\u001b[?2004l\r"]
[497.588602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.588634, "o", "\u001b[?2004h> "]
[497.588688, "o", "def feasible(plan,st):\r\n\u001b[?2004l\r"]
[497.588703, "o", "\u001b[?2004h> "]
[497.588843, "o", "    for leaf,q in plan['leaf_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.588876, "o", "> "]
[497.588984, "o", "        if not consume_leaf(leaf,q,st):\r\n\u001b[?2004l\r"]
[497.589015, "o", "\u001b[?2004h> "]
[497.589091, "o", "            return False\r\n\u001b[?2004l\r"]
[497.589125, "o", "\u001b[?2004h> "]
[497.589242, "o", "    for wc,h in plan['hours_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.589256, "o", "> "]
[497.589404, "o", "        if h>st['wc_avail'].get(wc,0.0)+1e-12:\r\n\u001b[?2004l\r"]
[497.589437, "o", "\u001b[?2004h> "]
[497.589507, "o", "            return False\r\n\u001b[?2004l\r"]
[497.589522, "o", "\u001b[?2004h> "]
[497.589578, "o", "    return True\r\n\u001b[?2004l\r"]
[497.589594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.589633, "o", "\u001b[?2004h> "]
[497.589713, "o", "def commit(plan,st,product):\r\n\u001b[?2004l\r"]
[497.589745, "o", "\u001b[?2004h> "]
[497.589798, "o", "    # consume leaves\r\n\u001b[?2004l\r"]
[497.589814, "o", "\u001b[?2004h> "]
[497.589947, "o", "    for leaf,q in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[497.589979, "o", "\u001b[?2004h> "]
[497.590117, "o", "        ok=consume_leaf(leaf,q,st,commit=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.590132, "o", "> "]
[497.5902, "o", "        if not ok:\r\n\u001b[?2004l\r"]
[497.590217, "o", "\u001b[?2004h> "]
[497.59037, "o", "            raise RuntimeError('leaf commit fail')\r\n\u001b[?2004l\r"]
[497.590401, "o", "\u001b[?2004h> "]
[497.590658, "o", "    # update manufactured/intermediate parts: old + built - total demand (for component use)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.590675, "o", "> "]
[497.590743, "o", "    for p in topo:\r\n\u001b[?2004l\r"]
[497.590758, "o", "\u001b[?2004h> "]
[497.590846, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[497.590861, "o", "\u001b[?2004h> "]
[497.590934, "o", "            continue\r\n\u001b[?2004l\r"]
[497.590949, "o", "\u001b[?2004h> "]
[497.591071, "o", "        d=plan['demand'].get(p,0.0)\r\n\u001b[?2004l\r"]
[497.591087, "o", "\u001b[?2004h> "]
[497.591193, "o", "        bq=plan['build'].get(p,0)\r\n\u001b[?2004l\r"]
[497.591225, "o", "\u001b[?2004h> "]
[497.591284, "o", "        if p==product:\r\n\u001b[?2004l\r"]
[497.591316, "o", "\u001b[?2004h> "]
[497.591524, "o", "            # product itself is not consumed as a component in this order\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.591539, "o", "> "]
[497.591695, "o", "            st['on_hand'][p] += bq\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.591727, "o", "> "]
[497.591758, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.591772, "o", "> "]
[497.591977, "o", "            # p is consumed as a component, all demand d is consumed\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.591991, "o", "> "]
[497.592123, "o", "            st['on_hand'][p] += bq - d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[497.592264, "o", "    for wc,h in plan['hours_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.592296, "o", "> "]
[497.592373, "o", "        st['wc_avail'][wc]-=h\r\n\u001b[?2004l\r"]
[497.592387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.592414, "o", "\u001b[?2004h> "]
[497.592533, "o", "def leaf_total_available(leaf,st):\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.592565, "o", "> "]
[497.592664, "o", "    total=st['on_hand'].get(leaf,0.0)\r\n\u001b[?2004l\r"]
[497.592694, "o", "\u001b[?2004h> "]
[497.592788, "o", "    for sub in subs.get(leaf,[]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.592802, "o", "> "]
[497.59289, "o", "        ratio=sub['ratio']\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.592923, "o", "> "]
[497.592973, "o", "        if ratio>0:\r\n\u001b[?2004l\r"]
[497.592989, "o", "\u001b[?2004h> "]
[497.59321, "o", "            total += math.floor(st['on_hand'].get(sub['sub'],0.0)/ratio)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.593225, "o", "> "]
[497.593283, "o", "    return total\r\n\u001b[?2004l\r"]
[497.593299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.59335, "o", "\u001b[?2004h> "]
[497.593429, "o", "def limiting(product,probe_q,st):\r\n\u001b[?2004l\r"]
[497.59346, "o", "\u001b[?2004h> "]
[497.593565, "o", "    plan=explode(product,probe_q,st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.593579, "o", "> "]
[497.59363, "o", "    ratios=[]\r\n\u001b[?2004l\r"]
[497.593661, "o", "\u001b[?2004h> "]
[497.59379, "o", "    for leaf,gross in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[497.593821, "o", "\u001b[?2004h> "]
[497.593883, "o", "        if gross>1e-12:\r\n\u001b[?2004l\r"]
[497.593915, "o", "\u001b[?2004h> "]
[497.594116, "o", "            ratios.append((leaf_total_available(leaf,st)/gross, leaf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.594132, "o", "> "]
[497.594275, "o", "    for wc,gross in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[497.594306, "o", "\u001b[?2004h> "]
[497.594366, "o", "        if gross>1e-12:\r\n\u001b[?2004l\r"]
[497.594397, "o", "\u001b[?2004h> "]
[497.594582, "o", "            ratios.append((st['wc_avail'].get(wc,0.0)/gross, wc))\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.594613, "o", "> "]
[497.594766, "o", "    below=[(r,res) for r,res in ratios if r < 1.0-1e-12]\r\n\u001b[?2004l\r"]
[497.594798, "o", "\u001b[?2004h> "]
[497.594844, "o", "    if not below:\r\n\u001b[?2004l\r"]
[497.594875, "o", "\u001b[?2004h> "]
[497.594927, "o", "        return None\r\n\u001b[?2004l\r"]
[497.594958, "o", "\u001b[?2004h> "]
[497.595048, "o", "    minr=min(r for r,_ in below)\r\n\u001b[?2004l\r"]
[497.595091, "o", "\u001b[?2004h> "]
[497.595241, "o", "    tied=[res for r,res in below if abs(r-minr)<1e-12]\r\n\u001b[?2004l\r"]
[497.595272, "o", "\u001b[?2004h> "]
[497.595344, "o", "    return sorted(tied)[0]\r\n\u001b[?2004l\r"]
[497.595375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[497.595406, "o", "\u001b[?2004h> "]
[497.595436, "o", "results=[]\r\n\u001b[?2004l\r"]
[497.595468, "o", "\u001b[?2004h> "]
[497.595518, "o", "for od in orders:\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.59555, "o", "> "]
[497.595728, "o", "    prod=od['product']; req=od['qty']; batch=parts[prod]['batch']\r\n\u001b[?2004l\r"]
[497.595759, "o", "\u001b[?2004h> "]
[497.595845, "o", "    chosen=None; chosen_plan=None\r\n\u001b[?2004l\r"]
[497.595876, "o", "\u001b[?2004h> "]
[497.596009, "o", "    for q in range(req-(req%batch), -1, -batch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.596029, "o", "> "]
[497.59614, "o", "        test=copy.deepcopy(state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.596157, "o", "> "]
[497.596256, "o", "        pc=explode(prod,q,test)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.596269, "o", "> "]
[497.596364, "o", "        if feasible(pc,test):\r\n\u001b[?2004l\r"]
[497.596395, "o", "\u001b[?2004h> "]
[497.596522, "o", "            chosen=q; chosen_plan=pc; break\r\n\u001b[?2004l\r"]
[497.596537, "o", "\u001b[?2004h> "]
[497.596608, "o", "    if chosen is None:\r\n\u001b[?2004l\r"]
[497.596624, "o", "\u001b[?2004h> "]
[497.59682, "o", "        chosen=0; chosen_plan=explode(prod,0,copy.deepcopy(state))\r\n\u001b[?2004l\r"]
[497.596835, "o", "\u001b[?2004h> "]
[497.596884, "o", "    lim=None\r\n\u001b[?2004l\r"]
[497.596899, "o", "\u001b[?2004h> "]
[497.596963, "o", "    if chosen<req:\r\n\u001b[?2004l\r"]
[497.596979, "o", "\u001b[?2004h> "]
[497.597135, "o", "        lim=limiting(prod, chosen+batch, state)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.597151, "o", "> "]
[497.597208, "o", "    final=chosen\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.59724, "o", "> "]
[497.597294, "o", "    short=req-final\r\n\u001b[?2004l\r"]
[497.597325, "o", "\u001b[?2004h> "]
[497.597412, "o", "    if req>0 and (final/req)<0.5:\r\n\u001b[?2004l\r"]
[497.597443, "o", "\u001b[?2004h> "]
[497.597519, "o", "        final=0; short=req\r\n\u001b[?2004l\r"]
[497.597535, "o", "\u001b[?2004h> "]
[497.597573, "o", "    else:\r\n\u001b[?2004l\r"]
[497.597589, "o", "\u001b[?2004h> "]
[497.597656, "o", "        if final>0:\r\n\u001b[?2004l\r"]
[497.597687, "o", "\u001b[?2004h> "]
[497.597808, "o", "            commit(chosen_plan, state, prod)\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.59784, "o", "> "]
[497.598177, "o", "    results.append({'order_id':od['id'],'allocated_qty':int(final),'shortfall_qty':int(short),'limiting_resource':lim})\r\n\u001b[?2004l\r\u001b[?2004h"]
[497.598192, "o", "> "]
[497.59847, "o", "    print(f\"{od['id']}: req={req}, chosen={chosen}, final={final}, short={short}, lim={lim}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[497.59851, "o", "\r\n\u001b[?2004l\r"]
[497.598543, "o", "\u001b[?2004h> "]
[497.598686, "o", "results_sorted=sorted(results,key=lambda x:x['order_id'])\r\n\u001b[?2004l\r"]
[497.598702, "o", "\u001b[?2004h> "]
[497.598768, "o", "print('\\nreport:')\r\n\u001b[?2004l\r"]
[497.598783, "o", "\u001b[?2004h> "]
[497.598945, "o", "print(json.dumps({'orders':results_sorted},indent=2))\r\n\u001b[?2004l\r"]
[497.59896, "o", "\u001b[?2004h> "]
[497.599043, "o", "print('\\nfinal on_hand:')\r\n\u001b[?2004l\r"]
[497.599077, "o", "\u001b[?2004h> "]
