[363.637388, "o", "\r\non_hand changed: {'L1': 95.0, 'L2': 1.0, 'L3': 0.0, 'L4': 0.0, 'SUB_L3_A': 0.0, 'SUB_L3_B': 4.0, 'SA1': 14.0, 'SA2': 16.0, 'P1': 12.0, 'P2': 8.0, 'P3': 5.0, 'P5': 10.0}\r\nwc_avail: {'WC1': 187.0, 'WC2': 52.0, 'WC_TIE': 10.0}\r\n"]
