[363.587873, "o", "\u001b[?2004h> "]
[363.587994, "o", "        build[p] = bq\r\n\u001b[?2004l\r"]
[363.588008, "o", "\u001b[?2004h> "]
[363.588054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.58807, "o", "> "]
[363.588171, "o", "        if bq > 0:\r\n\u001b[?2004l\r"]
[363.588185, "o", "\u001b[?2004h> "]
[363.588349, "o", "            for edge in bom[p]:\r\n\u001b[?2004l\r"]
[363.588384, "o", "\u001b[?2004h> "]
[363.588608, "o", "                base = bq * edge['qty_per']\r\n\u001b[?2004l\r"]
[363.588622, "o", "\u001b[?2004h> "]
[363.589164, "o", "                child_need = material_need(base, edge['scrap_pct'], edge['setup_scrap'])\r\n\u001b[?2004l\r"]
[363.589178, "o", "\u001b[?2004h> "]
[363.589458, "o", "                demand[edge['child']] += child_need\r\n\u001b[?2004l\r"]
[363.589473, "o", "\u001b[?2004h> "]
[363.589729, "o", "            for route in routing.get(p, []):\r\n\u001b[?2004l\r"]
[363.589768, "o", "\u001b[?2004h> "]
[363.590161, "o", "                hours_req[route['wc']] += route['setup'] + bq * route['run']\r\n\u001b[?2004l\r"]
[363.590208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[363.590242, "o", "> "]
[363.590733, "o", "    return {'demand': demand, 'build': build, 'leaf_req': leaf_req, 'hours_req': hours_req}\r\n\u001b[?2004l\r"]
[363.590773, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.590786, "o", "\u001b[?2004h> "]
[363.590819, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.590832, "o", "> "]
[363.591035, "o", "def consume_leaf_alloc(leaf, qty, st):\r\n\u001b[?2004l\r"]
[363.591066, "o", "\u001b[?2004h> "]
[363.591349, "o", "    \"\"\"Return consumed dict if enough, else None.\"\"\"\r\n\u001b[?2004l\r"]
[363.591366, "o", "\u001b[?2004h> "]
[363.591553, "o", "    used = defaultdict(float)\r\n\u001b[?2004l\r"]
[363.591591, "o", "\u001b[?2004h> "]
[363.591853, "o", "    avail_own = st['on_hand'].get(leaf, 0.0)\r\n\u001b[?2004l\r"]
[363.591866, "o", "\u001b[?2004h> "]
[363.592039, "o", "    take = min(avail_own, qty)\r\n\u001b[?2004l\r"]
[363.592057, "o", "\u001b[?2004h> "]
[363.592201, "o", "    used[leaf] += take\r\n\u001b[?2004l\r"]
[363.592272, "o", "\u001b[?2004h> "]
[363.592444, "o", "    rem = qty - take\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.592476, "o", "> "]
[363.592603, "o", "    if rem <= 1e-12:\r\n\u001b[?2004l\r"]
[363.592635, "o", "\u001b[?2004h> "]
[363.592805, "o", "        return dict(used)\r\n\u001b[?2004l\r,\u001b[?2004h"]
[363.59282, "o", "> \r\n\u001b[?2004l\r"]
[363.59286, "o", " "]
[363.592873, "o", "\u001b[?2004h> "]
[363.593097, "o", "    for sub in substitutes.get(leaf, []):\r\n\u001b[?2004l\r'"]
[363.593125, "o", "\u001b[?2004h> "]
[363.593287, "o", "        sub_part = sub['sub']\r\n\u001b[?2004l\r"]
[363.593311, "o", "\u001b[?2004h> "]
[363.593459, "o", "        ratio = sub['ratio']\r\n\u001b[?2004l\r"]
[363.593471, "o", "\u001b[?2004h"]
[363.593491, "o", "> "]
[363.593767, "o", "        stock = st['on_hand'].get(sub_part, 0.0)\r\n\u001b[?2004l\r"]
[363.593781, "o", "\u001b[?2004h"]
[363.593806, "o", "> "]
[363.594107, "o", "        cover = math.floor(stock / ratio) if ratio > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.594281, "o", "        take_primary = min(cover, rem)\r\n\u001b[?2004l\r"]
[363.594309, "o", "\u001b[?2004h> "]
[363.594429, "o", "        if take_primary > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.594458, "o", "> "]
[363.594658, "o", "            used[sub_part] += take_primary * ratio\r\n\u001b[?2004l\r"]
[363.594674, "o", "\u001b[?2004h> "]
[363.594826, "o", "            rem -= take_primary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[363.594954, "o", "        if rem <= 1e-12:\r\n\u001b[?2004l\r"]
[363.594989, "o", "\u001b[?2004h> "]
[363.595111, "o", "            return dict(used)\r\n\u001b[?2004l\r"]
[363.595129, "o", "\u001b[?2004h> "]
[363.595217, "o", "    return None\r\n\u001b[?2004l\r"]
[363.595229, "o", "\u001b[?2004h> "]
[363.595244, "o", "\r\n\u001b[?2004l\r"]
[363.595281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.59532, "o", "\u001b[?2004h> "]
[363.595429, "o", "def is_feasible(plan, st):\r\n\u001b[?2004l\r"]
[363.595453, "o", "\u001b[?2004h> "]
[363.595646, "o", "    for leaf, qty in plan['leaf_req'].items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.595662, "o", "> "]
[363.595895, "o", "        if consume_leaf_alloc(leaf, qty, st) is None:\r\n\u001b[?2004l\r"]
[363.595923, "o", "\u001b[?2004h"]
[363.595938, "o", "> "]
[363.596041, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.596072, "o", "> "]
[363.59625, "o", "    for wc, hrs in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[363.596275, "o", "\u001b[?2004h> "]
[363.596493, "o", "        if hrs > st['wc_avail'].get(wc, 0.0) + 1e-12:\r\n\u001b[?2004l\r"]
[363.596517, "o", "\u001b[?2004h> "]
[363.596623, "o", "            return False\r\n\u001b[?2004l\r"]
[363.596636, "o", "\u001b[?2004h> "]
[363.596729, "o", "    return True\r\n\u001b[?2004l\r"]
[363.596741, "o", "\u001b[?2004h> "]
[363.596763, "o", "\r\n\u001b[?2004l\r"]
[363.596792, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.596823, "o", "\u001b[?2004h> "]
[363.596952, "o", "def commit(plan, st, product):\r\n\u001b[?2004l\r"]
[363.596983, "o", "\u001b[?2004h"]
[363.596995, "o", "> "]
[363.597173, "o", "    # Consume leaf materials and substitutes\r\n\u001b[?2004l\r"]
[363.597188, "o", "\u001b[?2004h> "]
[363.597385, "o", "    for leaf, qty in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[363.59741, "o", "\u001b[?2004h> "]
[363.597606, "o", "        used = consume_leaf_alloc(leaf, qty, st)\r\n\u001b[?2004l\r"]
[363.597623, "o", "\u001b[?2004h> "]
[363.597747, "o", "        if used is None:\r\n\u001b[?2004l\r"]
[363.59776, "o", "\u001b[?2004h> "]
[363.598097, "o", "            raise RuntimeError(f\"Could not consume leaf {leaf} quantity {qty}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.598108, "o", "> "]
[363.598278, "o", "        for part, amt in used.items():\r\n\u001b[?2004l\r"]
[363.5983, "o", "\u001b[?2004h> "]
[363.598462, "o", "            st['on_hand'][part] -= amt\r\n\u001b[?2004l\r"]
[363.598482, "o", "\u001b[?2004h> "]
[363.598511, "o", "\r\n\u001b[?2004l\r"]
[363.598522, "o", "\u001b[?2004h> "]
[363.598836, "o", "    # Consume existing sub-assembly inventories, then add manufactured parts\r\n\u001b[?2004l\r"]
[363.598847, "o", "\u001b[?2004h> "]
[363.598939, "o", "    for p in topo:\r\n\u001b[?2004l\r"]
[363.598964, "o", "\u001b[?2004h> "]
[363.599082, "o", "        if p not in bom:\r\n\u001b[?2004l\r"]
[363.599108, "o", "\u001b[?2004h> "]
[363.5992, "o", "            continue\r\n\u001b[?2004l\r"]
[363.599221, "o", "\u001b[?2004h> "]
[363.599377, "o", "        d = plan['demand'].get(p, 0.0)\r\n\u001b[?2004l\r"]
[363.599402, "o", "\u001b[?2004h> "]
[363.599501, "o", "        if d <= 1e-12:\r\n\u001b[?2004l\r"]
[363.599533, "o", "\u001b[?2004h> "]
[363.599622, "o", "            continue\r\n\u001b[?2004l\r"]
[363.599647, "o", "\u001b[?2004h> "]
[363.599759, "o", "        if p != product:\r\n\u001b[?2004l\r"]
[363.599771, "o", "\u001b[?2004h> "]
[363.599997, "o", "            take = min(d, st['on_hand'].get(p, 0.0))\r\n\u001b[?2004l\r"]
[363.600008, "o", "\u001b[?2004h> "]
[363.600181, "o", "            st['on_hand'][p] -= take\r\n\u001b[?2004l\r"]
[363.600192, "o", "\u001b[?2004h> "]
[363.600353, "o", "        bq = plan['build'].get(p, 0)\r\n\u001b[?2004l\r"]
[363.600375, "o", "\u001b[?2004h> "]
[363.600466, "o", "        if bq > 0:\r\n\u001b[?2004l\r"]
[363.600476, "o", "\u001b[?2004h> "]
[363.600634, "o", "            st['on_hand'][p] += bq\r\n\u001b[?2004l\r"]
[363.600644, "o", "\u001b[?2004h> "]
[363.600657, "o", "\r\n\u001b[?2004l\r"]
[363.600689, "o", "\u001b[?2004h> "]
[363.600828, "o", "    # Consume workcenter hours\r\n\u001b[?2004l\r"]
[363.600837, "o", "\u001b[?2004h> "]
[363.601042, "o", "    for wc, hrs in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[363.601058, "o", "\u001b[?2004h> "]
[363.601209, "o", "        st['wc_avail'][wc] -= hrs\r\n\u001b[?2004l\r"]
[363.601231, "o", "\u001b[?2004h> "]
[363.601246, "o", "\r\n\u001b[?2004l\r"]
[363.601269, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.601298, "o", "\u001b[?2004h"]
[363.601311, "o", "> "]
[363.60146, "o", "def leaf_total_available(leaf, st):\r\n\u001b[?2004l\r"]
[363.601488, "o", "\u001b[?2004h> "]
[363.60165, "o", "    total = st['on_hand'].get(leaf, 0.0)\r\n\u001b[?2004l\r"]
[363.601674, "o", "\u001b[?2004h> "]
[363.601852, "o", "    for sub in substitutes.get(leaf, []):\r\n\u001b[?2004l\r"]
[363.601878, "o", "\u001b[?2004h> "]
[363.602089, "o", "        stock = st['on_hand'].get(sub['sub'], 0.0)\r\n\u001b[?2004l\r"]
[363.602115, "o", "\u001b[?2004h> "]
[363.602238, "o", "        ratio = sub['ratio']\r\n\u001b[?2004l\r"]
[363.602267, "o", "\u001b[?2004h> "]
[363.602362, "o", "        if ratio > 0:\r\n\u001b[?2004l\r"]
[363.602373, "o", "\u001b[?2004h> "]
[363.602577, "o", "            total += math.floor(stock / ratio)\r\n\u001b[?2004l\r"]
[363.602588, "o", "\u001b[?2004h> "]
[363.602677, "o", "    return total\r\n\u001b[?2004l\r"]
[363.602688, "o", "\u001b[?2004h> "]
[363.602717, "o", "\r\n\u001b[?2004l\r"]
[363.602738, "o", "\u001b[?2004h> \r\n"]
[363.602767, "o", "\u001b[?2004l\r\u001b[?2004h"]
[363.602788, "o", "> "]
[363.602994, "o", "def limiting_resource_for(product, probe_qty, st):\r\n\u001b[?2004l\r"]
[363.60302, "o", "\u001b[?2004h> "]
[363.603199, "o", "    plan = explode(product, probe_qty, st)\r\n\u001b[?2004l\r"]
[363.603219, "o", "\u001b[?2004h> "]
[363.603301, "o", "    ratios = []\r\n\u001b[?2004l\r"]
[363.603322, "o", "\u001b[?2004h> "]
[363.603517, "o", "    for leaf, gross in plan['leaf_req'].items():\r\n\u001b[?2004l\r"]
[363.603542, "o", "\u001b[?2004h> "]
[363.603661, "o", "        if gross <= 1e-12:\r\n\u001b[?2004l\r"]
[363.603674, "o", "\u001b[?2004h> "]
[363.603784, "o", "            continue\r\n\u001b[?2004l\r"]
[363.603805, "o", "\u001b[?2004h> "]
[363.603998, "o", "        avail = leaf_total_available(leaf, st)\r\n\u001b[?2004l\r"]
[363.60401, "o", "\u001b[?2004h> "]
[363.604214, "o", "        ratios.append((avail / gross, leaf))\r\n\u001b[?2004l\r"]
[363.604226, "o", "\u001b[?2004h> "]
[363.604427, "o", "    for wc, gross in plan['hours_req'].items():\r\n\u001b[?2004l\r"]
[363.60445, "o", "\u001b[?2004h> "]
[363.604567, "o", "        if gross <= 1e-12:\r\n\u001b[?2004l\r"]
[363.60459, "o", "\u001b[?2004h> "]
[363.604682, "o", "            continue\r\n\u001b[?2004l\r"]
[363.604707, "o", "\u001b[?2004h> "]
[363.604892, "o", "        avail = st['wc_avail'].get(wc, 0.0)\r\n\u001b[?2004l\r"]
[363.60492, "o", "\u001b[?2004h> "]
[363.605112, "o", "        ratios.append((avail / gross, wc))\r\n\u001b[?2004l\r"]
[363.605135, "o", "\u001b[?2004h> "]
[363.605387, "o", "    below = [(r, res) for r, res in ratios if r < 1.0 - 1e-12]\r\n\u001b[?2004l\r"]
[363.605398, "o", "\u001b[?2004h> "]
[363.605492, "o", "    if not below:\r\n\u001b[?2004l\r"]
[363.605503, "o", "\u001b[?2004h> "]
[363.605604, "o", "        return None\r\n\u001b[?2004l\r"]
[363.605629, "o", "\u001b[?2004h> "]
[363.605786, "o", "    min_r = min(r for r, _ in below)\r\n\u001b[?2004l\r"]
[363.605797, "o", "\u001b[?2004h> "]
[363.606069, "o", "    tied = [res for r, res in below if abs(r - min_r) < 1e-12]\r\n\u001b[?2004l\r"]
[363.606079, "o", "\u001b[?2004h> "]
[363.606207, "o", "    return sorted(tied)[0]\r\n\u001b[?2004l\r"]
[363.606238, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.606262, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[363.606295, "o", "\u001b[?2004h> "]
[363.60636, "o", "results = []\r\n\u001b[?2004l\r"]
[363.606371, "o", "\u001b[?2004h> "]
[363.606484, "o", "for order in orders:\r\n\u001b[?2004l\r"]
[363.606506, "o", "\u001b[?2004h> "]
[363.606619, "o", "    prod = order['product']\r\n\u001b[?2004l\r"]
[363.606643, "o", "\u001b[?2004h> "]
[363.606752, "o", "    req = order['qty']\r\n\u001b[?2004l\r"]
[363.606776, "o", "\u001b[?2004h> "]
[363.606915, "o", "    batch = parts[prod]['batch']\r\n\u001b[?2004l\r"]
[363.606927, "o", "\u001b[?2004h> "]
[363.607122, "o", "    largest_multiple = req - (req % batch)\r\n\u001b[?2004l\r"]
[363.607144, "o", "\u001b[?2004h> "]
[363.607157, "o", "\r\n\u001b[?2004l\r"]
[363.607182, "o", "\u001b[?2004h> "]
[363.60727, "o", "    chosen_qty = 0\r\n\u001b[?2004l\r"]
[363.607281, "o", "\u001b[?2004h> "]
[363.607394, "o", "    chosen_plan = None\r\n\u001b[?2004l\r"]
[363.607414, "o", "\u001b[?2004h> "]
[363.60762, "o", "    for q in range(largest_multiple, -1, -batch):\r\n\u001b[?2004l\r"]
[363.60764, "o", "\u001b[?2004h> "]
[363.607824, "o", "        test_state = copy.deepcopy(state)\r\n\u001b[?2004l\r"]
[363.607835, "o", "\u001b[?2004h> "]
[363.608073, "o", "        plan_candidate = explode(prod, q, test_state)\r\n\u001b[?2004l\r"]
[363.608084, "o", "\u001b[?2004h> "]
[363.608307, "o", "        if is_feasible(plan_candidate, test_state):\r\n\u001b[?2004l\r"]
[363.608317, "o", "\u001b[?2004h> "]
[363.608445, "o", "            chosen_qty = q\r\n\u001b[?2004l\r"]
[363.608456, "o", "\u001b[?2004h> "]
[363.60868, "o", "            chosen_plan = plan_candidate\r\n\u001b[?2004l\r"]
[363.608691, "o", "\u001b[?2004h> "]
[363.608794, "o", "            break\r\n\u001b[?2004l\r"]
[363.608804, "o", "\u001b[?2004h> "]
[363.608825, "o", "\r\n\u001b[?2004l\r"]
[363.608849, "o", "\u001b[?2004h> "]
[363.609067, "o", "    # If fulfilled entirely, no limiting resource.\r\n\u001b[?2004l\r"]
[363.609079, "o", "\u001b[?2004h> "]
[363.609179, "o", "    limiting = None\r\n\u001b[?2004l\r"]
[363.60919, "o", "\u001b[?2004h> "]
[363.60931, "o", "    if chosen_qty < req:\r\n\u001b[?2004l\r"]
[363.609332, "o", "\u001b[?2004h> "]
[363.609669, "o", "        # Compute limiting resource for one batch beyond maximum buildable quantity.\r\n\u001b[?2004l\r"]
[363.609691, "o", "\u001b[?2004h> "]
[363.609858, "o", "        probe_qty = chosen_qty + batch\r\n\u001b[?2004l\r"]
[363.60987, "o", "\u001b[?2004h> "]
[363.610149, "o", "        limiting = limiting_resource_for(prod, probe_qty, state)\r\n\u001b[?2004l\r"]
[363.610158, "o", "\u001b[?2004h> "]
[363.610181, "o", "\r\n\u001b[?2004l\r"]
[363.610206, "o", "\u001b[?2004h> "]
[363.610364, "o", "    # Minimum fill-rate cancellation\r\n\u001b[?2004l\r"]
[363.610375, "o", "\u001b[?2004h> "]
[363.610511, "o", "    final_alloc = chosen_qty\r\n\u001b[?2004l\r"]
[363.610521, "o", "\u001b[?2004h> "]
[363.610695, "o", "    shortfall = req - final_alloc\r\n\u001b[?2004l\r"]
[363.610706, "o", "\u001b[?2004h> "]
[363.610914, "o", "    if req > 0 and (final_alloc / req) < 0.5:\r\n\u001b[?2004l\r"]
[363.610925, "o", "\u001b[?2004h> "]
[363.611049, "o", "        final_alloc = 0\r\n\u001b[?2004l\r"]
[363.611077, "o", "\u001b[?2004h> "]
[363.611177, "o", "        shortfall = req\r\n\u001b[?2004l\r"]
[363.611202, "o", "\u001b[?2004h> "]
[363.611256, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[363.611289, "o", "> "]
[363.611505, "o", "        if chosen_plan is not None and final_alloc > 0:\r\n\u001b[?2004l\r"]
[363.611516, "o", "\u001b[?2004h> "]
[363.611721, "o", "            commit(chosen_plan, state, prod)\r\n\u001b[?2004l\r"]
