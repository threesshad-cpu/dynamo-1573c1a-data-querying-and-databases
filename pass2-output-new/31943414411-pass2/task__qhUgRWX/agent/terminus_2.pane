def plan_order(product, qty, state):
    demand = defaultdict(float)
    build = {}
    leaf_req = defaultdict(float)
    hours_req = defaultdict(float)
    demand[product] = qty
    for p in topo:
        d = demand.get(p, 0.0)
        if d <= 0:
            continue
        if p not in bom:
            # leaf
            leaf_req[p] += d
        else:
            if p == product:
                need = d
            else:
                avail = state['on_hand'].get(p, 0.0)
                need = max(0.0, d - avail)
            if need > 0:
                b = parts[p]['batch']
                bq = math.ceil(need / b) * b
                build[p] = bq
                for edge in bom[p]:
                    base = bq * edge['qty']
                    req = math.ceil(base * (1.0 + edge['scrap_pct']/100.0)) + edge['setup']
                    demand[edge['child']] += req
            else:
                build[p] = 0
            for rt in routing.get(p, []):
                bq = build.get(p, 0)
                if bq > 0:
                    h = rt['setup'] + bq * rt['run']
                    hours_req[rt['wc']] += h
    return {'demand': demand, 'build': build, 'leaf_req': leaf_req, 'hours_req': hours_req}

