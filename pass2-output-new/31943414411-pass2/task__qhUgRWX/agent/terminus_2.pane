[?2004l[?2004h> def limiting(product, probe_qty, st):
[?2004l[?2004h>     plan=explode(product, probe_qty, st)
[?2004l[?2004h>     ratios=[]
[?2004l[?2004h>     for leaf,gross in plan['leaf_req'].items():
[?2004l[?2004h>         if gross>1e-12:
[?2004l[?2004h>             ratios.append((leaf_total_available(leaf,st)/gross, leaf))
[?2004l[?2004h>     for wc,gross in plan['hours_req'].items():
[?2004l[?2004h>         if gross>1e-12:
[?2004l[?2004h>             ratios.append((st['wc_avail'].get(wc,0.0)/gross, wc))
[?2004l[?2004h>     below=[(r,res) for r,res in ratios if r < 1.0-1e-12]
[?2004l[?2004h>     if not below:
[?2004l[?2004h>         return None
[?2004l[?2004h>     minr=min(r for r,_ in below)
[?2004l[?2004h>     tied=[res for r,res in below if abs(r-minr)<1e-12]
[?2004l[?2004h>     return sorted(tied)[0]
