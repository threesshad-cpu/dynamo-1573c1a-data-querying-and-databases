    demand[product]=float(qty)
    build={}
    leaf_req=defaultdict(float)
    hours_req=defaultdict(float)
    for p in topo:
        d=demand.get(p,0.0)
        if d<=1e-12:
            continue
        if p not in bom:
            leaf_req[p]+=d
            continue
        if p==product:
            need=d
        else:
            need=max(0.0, d - st['on_hand'].get(p,0.0))
        if need>1e-12:
            bq=math.ceil(need/parts[p]['batch'])*parts[p]['batch']
        else:
            bq=0
        build[p]=bq
        if bq>0:
            for e in bom[p]:
                child_need=mat_need(bq*e['qty_per'], e['scrap_pct'], e['setup_scrap'])
                demand[e['child']]+=child_need
            for r in routing.get(p,[]):
                hours_req[r['wc']]+=r['setup'] + bq*r['run']
    return {'demand':demand,'build':build,'leaf_req':leaf_req,'hours_req':hours_req}

def consume_leaf(leaf, qty, st, commit=False):
    used=defaultdict(float)
    take=min(st['on_hand'].get(leaf,0.0), qty)
    used[leaf]+=take
    rem=qty-take
    if rem<=1e-12:
        if commit:
            for p,a in used.items(): st['on_hand'][p]-=a
        return True
    for sub in subs.get(leaf,[]):
        sp=sub['sub']; stock=st['on_hand'].get(sp,0.0); ratio=sub['ratio']
        cover=math.floor(stock/ratio) if ratio>0 else 0
        take_p=min(cover, rem)
        if take_p>0:
            used[sp]+=take_p*ratio
            rem-=take_p
        if rem<=1e-12:
            if commit:
                for p,a in used.items(): st['on_hand'][p]-=a
            return True
    return False

def feasible(plan, st):
    for leaf,q in plan['leaf_req'].items():
        if not consume_leaf(leaf,q,st):
            return False
    for wc,h in plan['hours_req'].items():
        if h > st['wc_avail'].get(wc,0.0) + 1e-12:
            return False
    return True

def commit(plan, st, product):
    for leaf,q in plan['leaf_req'].items():
        if not consume_leaf(leaf,q,st,commit=True):
            raise RuntimeError('leaf commit fail')
