[830.380957, "i", "cat > /app/solve_final.py <<'PY'\nimport sqlite3, math, copy, json\nfrom collections import defaultdict\n\nDB = '/app/manufacturing.db'\nconn = sqlite3.connect(DB)\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\nparts = {}\nfor r in cur.execute('SELECT part_id, name, on_hand_qty, batch_size FROM parts'):\n    parts[r['part_id']] = {'name': r['name'], 'on_hand': r['on_hand_qty'], 'batch': r['batch_size']}\n\nbom_children = defaultdict(list)\nfor r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n    bom_children[r['parent_part_id']].append({'child': r['child_part_id'], 'qty_per': r['qty_per'], 'scrap_rate_pct': r['scrap_rate_pct'], 'setup_scrap_qty': r['setup_scrap_qty']})\n\nworkcenters = {}\nfor r in cur.execute('SELECT workcenter_id, name, available_hours FROM workcenters'):\n    workcenters[r['workcenter_id']] = r['available_hours']\n\nrouting = defaultdict(list)\nfor r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM ro"]
[830.381021, "i", "uting'):\n    routing[r['parent_part_id']].append({'workcenter': r['workcenter_id'], 'setup': r['setup_hours'], 'run': r['run_hours_per_unit']})\n\nsubstitutes = defaultdict(list)\nfor r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes'):\n    substitutes[r['primary_part_id']].append({'sub': r['substitute_part_id'], 'ratio': r['qty_ratio'], 'rank': r['preference_rank']})\nfor k in substitutes:\n    substitutes[k].sort(key=lambda x: (x['rank'], x['sub']))\n\norders = []\nfor r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders ORDER BY priority, order_id'):\n    orders.append({'order_id': r['order_id'], 'product': r['product_part_id'], 'requested_qty': r['requested_qty'], 'priority': r['priority']})\nconn.close()\n\nleaf_parts = set(p for p in parts if p not in bom_children)\n\ndef topo_order():\n    indeg = {p: 0 for p in parts}\n    out = defaultdict(list)\n    for parent, children in bom_children.items():\n        for c in children:\n     "]
[830.381255, "i", "       out[parent].append(c['child'])\n            indeg[c['child']] += 1\n    import heapq\n    q = [p for p in parts if indeg[p] == 0]\n    heapq.heapify(q)\n    order = []\n    while q:\n        p = heapq.heappop(q)\n        order.append(p)\n        for ch in out[p]:\n            indeg[ch] -= 1\n            if indeg[ch] == 0:\n                heapq.heappush(q, ch)\n    if len(order) != len(parts):\n        raise ValueError('cycle detected')\n    return order\n\ntopo = topo_order()\n\ndef compute_plan(product, target, state_parts):\n    req = defaultdict(int)\n    req[product] += target\n    production = {}\n    leaf_req = {}\n    wc_hours = defaultdict(float)\n    for pid in topo:\n        needed = req.get(pid, 0)\n        if needed == 0:\n            continue\n        if pid in leaf_parts:\n            leaf_req[pid] = needed\n            continue\n        stock = state_parts[pid]['on_hand']\n        to_make = needed - stock\n        if to_make <= 0:\n            production[pid] = 0\n            continue\n        batch = state_parts[pid]['bat"]
[830.381297, "i", "ch']\n        prod = int(math.ceil(to_make / float(batch)) * batch)\n        production[pid] = prod\n        for rt in routing.get(pid, []):\n            wc_hours[rt['workcenter']] += rt['setup'] + prod * rt['run']\n        for ch in bom_children.get(pid, []):\n            base = ch['qty_per'] * prod\n            child_req = int(math.ceil(base * (1.0 + ch['scrap_rate_pct'] / 100.0))) + ch['setup_scrap_qty']\n            req[ch['child']] += child_req\n    return production, leaf_req, dict(wc_hours), dict(req)\n\ndef satisfy_leaves(leaf_req, state_parts):\n    stock = {p: state_parts[p]['on_hand'] for p in leaf_parts}\n    remaining = {}\n    for leaf, need in leaf_req.items():\n        take = min(stock.get(leaf, 0), need)\n        stock[leaf] -= take\n        rem = need - take\n        if rem > 0:\n            remaining[leaf] = rem\n    for leaf in sorted(remaining):\n        need = remaining[leaf]\n        for sub in substitutes.get(leaf, []):\n            if need <= 0:\n                break\n            sub_id = sub['sub']\n        "]
[830.38134, "i", "    sub_stock = stock.get(sub_id, 0)\n            if sub_stock <= 0:\n                continue\n            ratio = sub['ratio']\n            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\n            use = min(need, can_primary)\n            if use <= 0:\n                continue\n            need_sub = int(math.ceil(use * ratio))\n            stock[sub_id] = sub_stock - need_sub\n            need -= use\n        if need > 0:\n            return False, None\n    return True, stock\n\ndef feasible(product, target, state_parts):\n    _, leaf_req, wc_hours, _ = compute_plan(product, target, state_parts)\n    for wc, hours in wc_hours.items():\n        if hours > workcenters[wc] + 1e-12:\n            return False\n    ok, _ = satisfy_leaves(leaf_req, state_parts)\n    return ok\n\ndef execute_plan(product, target, plan_data):\n    production, leaf_req, wc_hours, req_all = plan_data\n    ok, new_stock = satisfy_leaves(leaf_req, parts)\n    if not ok:\n        raise RuntimeError('tried to execute infeasible plan')\n   "]
[830.381431, "o", "cat > /app/solve_final.py <<'PY'\r\n\u001b[?2004l\r"]
[830.381459, "i", " for p in leaf_parts:\n        parts[p]['on_hand'] = new_stock[p]\n    for p, prod in production.items():\n        if p in leaf_parts:\n            continue\n        parts[p]['on_hand'] = parts[p]['on_hand'] + prod - req_all.get(p, 0)\n    for wc, hours in wc_hours.items():\n        workcenters[wc] -= hours\n\ndef leaf_available_equiv(leaf, state_parts):\n    avail = state_parts[leaf]['on_hand']\n    for sub in substitutes.get(leaf, []):\n        sub_stock = state_parts[sub['sub']]['on_hand']\n        if sub['ratio'] > 0:\n            avail += int(math.floor(sub_stock / sub['ratio']))\n    return avail\n\ndef limiting_resource(product, allocated, batch, snap_parts, snap_wc):\n    target = allocated + batch\n    _, leaf_req, wc_hours, _ = compute_plan(product, target, snap_parts)\n    ratios = {}\n    for leaf, gross in leaf_req.items():\n        if gross > 0:\n            ratios[leaf] = leaf_available_equiv(leaf, snap_parts) / float(gross)\n    for wc, gross in wc_hours.items():\n        if gross > 0:\n            ratios[wc] = snap_wc"]
[830.381585, "o", "\u001b[?2004h> "]
[830.381611, "i", "[wc] / float(gross)\n    best_id = None\n    best_ratio = None\n    for rid, ratio in ratios.items():\n        if ratio < 1.0 - 1e-12:\n            if best_ratio is None or ratio < best_ratio - 1e-12 or (abs(ratio - best_ratio) <= 1e-12 and rid < best_id):\n                best_ratio = ratio\n                best_id = rid\n    return best_id\n\nreport_orders = []\nfor order in orders:\n    order_id = order['order_id']\n    product = order['product']\n    requested = order['requested_qty']\n    batch = parts[product]['batch']\n\n    snap_parts = copy.deepcopy(parts)\n    snap_wc = copy.deepcopy(workcenters)\n\n    candidates = list(range(0, requested + 1, batch))\n    max_alloc = 0\n    max_plan = None\n    for target in candidates:\n        if feasible(product, target, parts):\n            max_alloc = target\n            max_plan = compute_plan(product, target, parts)\n\n    shortfall = requested - max_alloc\n    if max_alloc / requested < 0.5:\n        lim = limiting_resource(product, max_alloc, batch, snap_parts, snap_wc)\n        report"]
[830.381698, "i", "_orders.append({'order_id': order_id, 'allocated_qty': 0, 'shortfall_qty': requested, 'limiting_resource': lim})\n    else:\n        lim = None\n        if shortfall > 0:\n            lim = limiting_resource(product, max_alloc, batch, snap_parts, snap_wc)\n        report_orders.append({'order_id': order_id, 'allocated_qty': max_alloc, 'shortfall_qty': shortfall, 'limiting_resource': lim})\n        if max_alloc > 0:\n            execute_plan(product, max_alloc, max_plan)\n\nreport_orders.sort(key=lambda x: x['order_id'])\nwith open('/app/report.json', 'w') as f:\n    json.dump({'orders': report_orders}, f, indent=2)\nprint(json.dumps({'orders': report_orders}, indent=2))\nPY\npython3 /app/solve_final.py\n"]
[830.381999, "o", "import sqlite3, math, copy, json\r\n\u001b[?2004l\r"]
[830.382081, "o", "\u001b[?2004h> "]
[830.38246, "o", "from collections import defaultdict\r\n\u001b[?2004l\r \u001b[?2004h"]
[830.38257, "o", "> \r\n\u001b[?2004l\r"]
[830.382599, "o", "\u001b[?2004h"]
[830.38268, "o", "> "]
[830.382973, "o", "DB = '/app/manufacturing.db'\r\n\u001b[?2004l\r"]
[830.383057, "o", "\u001b[?2004h> "]
[830.383345, "o", "conn = sqlite3.connect(DB)\r\n\u001b[?2004l\r"]
[830.383451, "o", "\u001b[?2004h> "]
[830.383826, "o", "conn.row_factory = sqlite3.Row\r\n\u001b[?2004l\r"]
[830.38391, "o", "\u001b[?2004h> "]
[830.384102, "o", "cur = conn.cursor()\r\n\u001b[?2004l\r"]
[830.384181, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[830.384245, "o", "\u001b[?2004h> "]
[830.384411, "o", "parts = {}\r\n\u001b[?2004l\r"]
[830.384439, "o", "\u001b[?2004h> "]
[830.38532, "o", "for r in cur.execute('SELECT part_id, name, on_hand_qty, batch_size FROM parts'):\r\n\u001b[?2004l\r \u001b[?2004h"]
[830.385396, "o", "> "]
[830.386662, "o", "    parts[r['part_id']] = {'name': r['name'], 'on_hand': r['on_hand_qty'], 'batch': r['batch_size']}\r\n\u001b[?2004l\r"]
[830.386756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.386838, "o", "\u001b[?2004h> "]
[830.387297, "o", "bom_children = defaultdict(list)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[830.388769, "o", "for r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\r\n\u001b[?2004l\r"]
[830.388878, "o", "\u001b[?2004h> "]
[830.390989, "o", "    bom_children[r['parent_part_id']].append({'child': r['child_part_id'], 'qty_per': r['qty_per'], 'scrap_rate_pct': r['scrap_rate_pct'], 'setup_scrap_qty': r['setup_scrap_qty']})\r\n\u001b[?2004l\r"]
[830.391084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.391161, "o", "\u001b[?2004h> "]
[830.391389, "o", "workcenters = {}\r\n\u001b[?2004l\res"]
[830.391467, "o", "\u001b[?2004h> "]
[830.392475, "o", "for r in cur.execute('SELECT workcenter_id, name, available_hours FROM workcenters'):\r\n\u001b[?2004l\r"]
[830.392632, "o", "\u001b[?2004h> "]
[830.393294, "o", "    workcenters[r['workcenter_id']] = r['available_hours']\r\n\u001b[?2004l\r"]
[830.39337, "o", "\u001b[?2004h> \r\n"]
[830.393599, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[830.393916, "o", "routing = defaultdict(list)\r\n\u001b[?2004l\r"]
[830.394003, "o", "\u001b[?2004h> "]
[830.395399, "o", "for r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\r\n\u001b[?2004l\r"]
[830.39548, "o", "\u001b[?2004h> "]
[830.397005, "o", "    routing[r['parent_part_id']].append({'workcenter': r['workcenter_id'], 'setup': r['setup_hours'], 'run': r['run_hours_per_unit']})\r\n\u001b[?2004l\r "]
[830.397036, "o", "\u001b[?2004h> "]
[830.397108, "o", "\r\n\u001b[?2004l\r"]
[830.397181, "o", "\u001b[?2004h> "]
[830.397629, "o", "substitutes = defaultdict(list)\r\n\u001b[?2004l\r"]
[830.397707, "o", "\u001b[?2004h> "]
[830.398873, "o", "for r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes'):\r\n\u001b[?2004l\r"]
[830.398961, "o", "\u001b[?2004h> "]
[830.400453, "o", "    substitutes[r['primary_part_id']].append({'sub': r['substitute_part_id'], 'ratio': r['qty_ratio'], 'rank': r['preference_rank']})\r\n\u001b[?2004l\r"]
[830.400522, "o", "\u001b[?2004h> "]
[830.400843, "o", "for k in substitutes:\r\n\u001b[?2004l\r"]
[830.40087, "o", "\u001b[?2004h> "]
[830.401608, "o", "    substitutes[k].sort(key=lambda x: (x['rank'], x['sub']))\r\n\u001b[?2004l\r"]
[830.401696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[830.401788, "o", "\u001b[?2004h> "]
[830.401923, "o", "orders = []\r\n\u001b[?2004l\r"]
[830.401999, "o", "\u001b[?2004h> "]
[830.403502, "o", "for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders ORDER BY priority, order_id'):\r\n\u001b[?2004l\r"]
[830.403536, "o", "\u001b[?2004h> "]
[830.405188, "o", "    orders.append({'order_id': r['order_id'], 'product': r['product_part_id'], 'requested_qty': r['requested_qty'], 'priority': r['priority']})\r\n\u001b[?2004l\r"]
[830.405217, "o", "\u001b[?2004h> "]
[830.405433, "o", "conn.close()\r\n\u001b[?2004l\r"]
[830.405495, "o", "\u001b[?2004h> "]
[830.405521, "o", "\r\n\u001b[?2004l\r"]
[830.405626, "o", "\u001b[?2004h> "]
[830.406245, "o", "leaf_parts = set(p for p in parts if p not in bom_children)\r\n\u001b[?2004l\r"]
[830.406305, "o", "\u001b[?2004h> "]
[830.406379, "o", "\r\n\u001b[?2004l\r"]
[830.406404, "o", "\u001b[?2004h> "]
[830.406631, "o", "def topo_order():\r\n\u001b[?2004l\r"]
[830.406708, "o", "\u001b[?2004h> "]
[830.407049, "o", "    indeg = {p: 0 for p in parts}\r\n\u001b[?2004l\r"]
[830.407127, "o", "\u001b[?2004h> "]
[830.407446, "o", "    out = defaultdict(list)\r\n\u001b[?2004l\r"]
[830.407476, "o", "\u001b[?2004h> "]
[830.40803, "o", "    for parent, children in bom_children.items():\r\n\u001b[?2004l\r"]
[830.40811, "o", "\u001b[?2004h> "]
[830.408384, "o", "        for c in children:\r\n\u001b[?2004l\r"]
[830.408473, "o", "\u001b[?2004h> "]
[830.408995, "o", "            out[parent].append(c['child'])\r\n\u001b[?2004l\r"]
[830.40907, "o", "\u001b[?2004h> "]
[830.409475, "o", "            indeg[c['child']] += 1\r\n\u001b[?2004l\rd"]
[830.409606, "o", "\u001b[?2004h> "]
[830.409748, "o", "    import heapq\r\n\u001b[?2004l\r"]
[830.409811, "o", "\u001b[?2004h> "]
[830.410307, "o", "    q = [p for p in parts if indeg[p] == 0]\r\n\u001b[?2004l\r"]
[830.41038, "o", "\u001b[?2004h> "]
[830.410663, "o", "    heapq.heapify(q)\r\n\u001b[?2004l\r"]
[830.410689, "o", "\u001b[?2004h> "]
[830.410938, "o", "    order = []\r\n\u001b[?2004l\rr"]
[830.410962, "o", "\u001b[?2004h> "]
[830.411135, "o", "    while q:\r\n\u001b[?2004l\rr"]
[830.411161, "o", "\u001b[?2004h> "]
[830.411532, "o", "        p = heapq.heappop(q)\r\n\u001b[?2004l\r"]
[830.411634, "o", "\u001b[?2004h> "]
[830.411973, "o", "        order.append(p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.412066, "o", "> "]
[830.412385, "o", "        for ch in out[p]:\r\n\u001b[?2004l\r "]
[830.412466, "o", "\u001b[?2004h> "]
[830.412876, "o", "            indeg[ch] -= 1\r\n\u001b[?2004l\r"]
[830.412955, "o", "\u001b[?2004h> "]
[830.413358, "o", "            if indeg[ch] == 0:\r\n\u001b[?2004l\r  "]
[830.413419, "o", "\u001b[?2004h> "]
[830.413846, "o", "                heapq.heappush(q, ch)\r\n\u001b[?2004l\r"]
[830.413938, "o", "\u001b[?2004h> "]
[830.414301, "o", "    if len(order) != len(parts):\r\n\u001b[?2004l\r"]
[830.414393, "o", "\u001b[?2004h> "]
[830.414875, "o", "        raise ValueError('cycle detected')\r\n\u001b[?2004l\r"]
[830.414901, "o", "\u001b[?2004h> "]
[830.415115, "o", "    return order\r\n\u001b[?2004l\re"]
[830.415141, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.415246, "o", "\u001b[?2004h> "]
[830.415479, "o", "topo = topo_order()\r\n\u001b[?2004l\rt"]
[830.41554, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.415652, "o", "e\u001b[?2004h"]
[830.415678, "o", "> "]
[830.416119, "o", "def compute_plan(product, target, state_parts):\r\n\u001b[?2004l\r"]
[830.416147, "o", "\u001b[?2004h> "]
[830.416479, "o", "    req = defaultdict(int)\r\n\u001b[?2004l\ry\u001b[?2004h"]
[830.416506, "o", "> "]
[830.416922, "o", "    req[product] += target\r\n\u001b[?2004l\r."]
[830.41695, "o", "\u001b[?2004h> "]
[830.41721, "o", "    production = {}\r\n\u001b[?2004l\rs"]
[830.417269, "o", "\u001b[?2004h> "]
[830.417475, "o", "    leaf_req = {}\r\n\u001b[?2004l\r "]
[830.417521, "o", "\u001b[?2004h> "]
[830.418006, "o", "    wc_hours = defaultdict(float)\r\n\u001b[?2004l\r"]
[830.418095, "o", "\u001b[?2004h> "]
[830.41825, "o", "    for pid in topo:\r\n\u001b[?2004l\r"]
[830.418346, "o", "\u001b[?2004h> "]
[830.418762, "o", "        needed = req.get(pid, 0)\r\n\u001b[?2004l\r"]
[830.418839, "o", "\u001b[?2004h> "]
[830.41911, "o", "        if needed == 0:\r\n\u001b[?2004l\r"]
[830.419168, "o", "\u001b[?2004h> "]
[830.419392, "o", "            continue\r\n\u001b[?2004l\rc"]
[830.419418, "o", "\u001b[?2004h"]
[830.419434, "o", "> "]
[830.454112, "o", "        if pid in leaf_parts:\r\n\u001b[?2004l\r\u001b[?2004h>             leaf_req[pid] = needed\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\rn(\u001b[?2004h>         stock = state_parts[pid]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h>         to_make = needed - stock\r\n\u001b[?2004l\r\u001b[?2004h>         if to_make <= 0:\r\n\u001b[?2004l\r\u001b[?2004h>             production[pid] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.454292, "o", "            continue\r\n\u001b[?2004l\r"]
[830.45434, "o", "\u001b[?2004h> "]
[830.454918, "o", "        batch = state_parts[pid]['batch']\r\n\u001b[?2004l\r"]
[830.455011, "o", "\u001b[?2004h> "]
[830.45582, "o", "        prod = int(math.ceil(to_make / float(batch)) * batch)\r\n\u001b[?2004l\ra"]
[830.455849, "o", "\u001b[?2004h> "]
[830.456208, "o", "        production[pid] = prod\r\n\u001b[?2004l\r"]
[830.456294, "o", "\u001b[?2004h> "]
[830.456766, "o", "        for rt in routing.get(pid, []):\r\n\u001b[?2004l\r"]
[830.456798, "o", "\u001b[?2004h"]
[830.456846, "o", "> "]
[830.457929, "o", "            wc_hours[rt['workcenter']] += rt['setup'] + prod * rt['run']\r\n\u001b[?2004l\r"]
[830.457967, "o", "\u001b[?2004h> "]
[830.458516, "o", "        for ch in bom_children.get(pid, []):\r\n\u001b[?2004l\r"]
[830.458613, "o", "\u001b[?2004h> "]
[830.459204, "o", "            base = ch['qty_per'] * prod\r\n\u001b[?2004l\r"]
[830.459296, "o", "\u001b[?2004h> "]
[830.460882, "o", "            child_req = int(math.ceil(base * (1.0 + ch['scrap_rate_pct'] / 100.0))) + ch['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[830.460909, "o", "\u001b[?2004h> "]
[830.461425, "o", "            req[ch['child']] += child_req\r\n\u001b[?2004l\r"]
[830.461466, "o", "\u001b[?2004h> "]
[830.462461, "o", "    return production, leaf_req, dict(wc_hours), dict(req)\r\n\u001b[?2004l\r"]
[830.462613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r'\u001b[?2004h"]
[830.462699, "o", "> "]
[830.463152, "o", "def satisfy_leaves(leaf_req, state_parts):\r\n\u001b[?2004l\r'"]
[830.46318, "o", "\u001b[?2004h> "]
[830.463951, "o", "    stock = {p: state_parts[p]['on_hand'] for p in leaf_parts}\r\n\u001b[?2004l\r"]
[830.463981, "o", "\u001b[?2004h"]
[830.464034, "o", "> "]
[830.464324, "o", "    remaining = {}\r\n\u001b[?2004l\r"]
[830.46442, "o", "\u001b[?2004h> "]
[830.464909, "o", "    for leaf, need in leaf_req.items():\r\n\u001b[?2004l\r"]
[830.464967, "o", "\u001b[?2004h> "]
[830.465449, "o", "        take = min(stock.get(leaf, 0), need)\r\n\u001b[?2004l\r"]
[830.465475, "o", "\u001b[?2004h> "]
[830.465908, "o", "        stock[leaf] -= take\r\n\u001b[?2004l\r"]
[830.465935, "o", "\u001b[?2004h"]
[830.465999, "o", "> "]
[830.466299, "o", "        rem = need - take\r\n\u001b[?2004l\r"]
[830.466326, "o", "\u001b[?2004h> "]
[830.466596, "o", "        if rem > 0:\r\n\u001b[?2004l\r"]
[830.466627, "o", "\u001b[?2004h> "]
[830.466973, "o", "            remaining[leaf] = rem\r\n\u001b[?2004l\r"]
[830.467, "o", "\u001b[?2004h> "]
[830.467354, "o", "    for leaf in sorted(remaining):\r\n\u001b[?2004l\r"]
[830.46738, "o", "\u001b[?2004h"]
[830.4675, "o", "> "]
[830.467832, "o", "        need = remaining[leaf]\r\n\u001b[?2004l\r"]
[830.467917, "o", "\u001b[?2004h> "]
[830.468411, "o", "        for sub in substitutes.get(leaf, []):\r\n\u001b[?2004l\r"]
[830.46845, "o", "\u001b[?2004h> "]
[830.468806, "o", "            if need <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.469386, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.469526, "o", "            sub_id = sub['sub']\r\n\u001b[?2004l\r"]
[830.46962, "o", "\u001b[?2004h> "]
[830.470038, "o", "            sub_stock = stock.get(sub_id, 0)\r\n\u001b[?2004l\r"]
[830.470065, "o", "\u001b[?2004h> "]
[830.470525, "o", "            if sub_stock <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.470837, "o", "                continue\r\n\u001b[?2004l\r"]
[830.47087, "o", "\u001b[?2004h> "]
[830.471206, "o", "            ratio = sub['ratio']\r\n\u001b[?2004l\r"]
[830.471232, "o", "\u001b[?2004h> "]
[830.472126, "o", "            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\r\n\u001b[?2004l\r"]
[830.472153, "o", "\u001b[?2004h> "]
[830.472588, "o", "            use = min(need, can_primary)\r\n\u001b[?2004l\r"]
[830.472679, "o", "\u001b[?2004h> "]
[830.472916, "o", "            if use <= 0:\r\n\u001b[?2004l\r"]
[830.472942, "o", "\u001b[?2004h> "]
[830.473186, "o", "                continue\r\n\u001b[?2004l\r"]
[830.473211, "o", "\u001b[?2004h> "]
[830.473704, "o", "            need_sub = int(math.ceil(use * ratio))\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.473732, "o", "> "]
[830.474197, "o", "            stock[sub_id] = sub_stock - need_sub\r\n\u001b[?2004l\r"]
[830.474223, "o", "\u001b[?2004h> "]
[830.47452, "o", "            need -= use\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.47458, "o", "> "]
[830.474764, "o", "        if need > 0:\r\n\u001b[?2004l\r"]
[830.474796, "o", "\u001b[?2004h> "]
[830.475089, "o", "            return False, None\r\n\u001b[?2004l\r"]
[830.47512, "o", "\u001b[?2004h> "]
[830.475358, "o", "    return True, stock\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.475384, "o", "> \r\n\u001b[?2004l\r"]
[830.475429, "o", "\u001b[?2004h"]
[830.475502, "o", "> "]
[830.475882, "o", "def feasible(product, target, state_parts):\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.47591, "o", "> "]
[830.476611, "o", "    _, leaf_req, wc_hours, _ = compute_plan(product, target, state_parts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.476643, "o", "> "]
[830.476986, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r"]
[830.477063, "o", "\u001b[?2004h> "]
[830.47746, "o", "        if hours > workcenters[wc] + 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.477488, "o", "> "]
[830.477777, "o", "            return False\r\n\u001b[?2004l\r"]
[830.477861, "o", "\u001b[?2004h> "]
[830.478305, "o", "    ok, _ = satisfy_leaves(leaf_req, state_parts)\r\n\u001b[?2004l\r"]
[830.478348, "o", "\u001b[?2004h> "]
[830.478595, "o", "    return ok\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.478732, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.479162, "o", "def execute_plan(product, target, plan_data):\r\n\u001b[?2004l\r"]
[830.479187, "o", "\u001b[?2004h> "]
[830.479775, "o", "    production, leaf_req, wc_hours, req_all = plan_data\r\n\u001b[?2004l\r"]
[830.479887, "o", "\u001b[?2004h> "]
[830.480257, "o", "    ok, new_stock = satisfy_leaves(leaf_req, parts)\r\n\u001b[?2004l\r"]
[830.480282, "o", "\u001b[?2004h> "]
[830.480475, "o", "    if not ok:\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.480501, "o", "> "]
[830.481041, "o", "        raise RuntimeError('tried to execute infeasible plan')\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.481123, "o", "> "]
[830.48136, "o", "    for p in leaf_parts:\r\n\u001b[?2004l\r"]
[830.481391, "o", "\u001b[?2004h> "]
[830.481861, "o", "        parts[p]['on_hand'] = new_stock[p]\r\n\u001b[?2004l\r"]
[830.481887, "o", "\u001b[?2004h> "]
[830.482236, "o", "    for p, prod in production.items():\r\n\u001b[?2004l\r"]
[830.482261, "o", "\u001b[?2004h> "]
[830.482653, "o", "        if p in leaf_parts:\r\n\u001b[?2004l\r"]
[830.482737, "o", "\u001b[?2004h> "]
[830.48292, "o", "            continue\r\n\u001b[?2004l\r"]
[830.482951, "o", "\u001b[?2004h> "]
[830.483697, "o", "        parts[p]['on_hand'] = parts[p]['on_hand'] + prod - req_all.get(p, 0)\r\n\u001b[?2004l\r"]
[830.483723, "o", "\u001b[?2004h> "]
[830.484068, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.48413, "o", "> "]
[830.484472, "o", "        workcenters[wc] -= hours\r\n\u001b[?2004l\r"]
[830.484498, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.484587, "o", "\u001b[?2004h> "]
[830.484997, "o", "def leaf_available_equiv(leaf, state_parts):\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.485023, "o", "> "]
[830.485387, "o", "    avail = state_parts[leaf]['on_hand']\r\n\u001b[?2004l\r"]
[830.485413, "o", "\u001b[?2004h> "]
[830.485798, "o", "    for sub in substitutes.get(leaf, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.486198, "o", "        sub_stock = state_parts[sub['sub']]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.486479, "o", "        if sub['ratio'] > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.486508, "o", "> "]
[830.486884, "o", "            avail += int(math.floor(sub_stock / sub['ratio']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.486975, "o", "    return avail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.487274, "o", "def limiting_resource(product, allocated, batch, snap_parts, snap_wc):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.487428, "o", "    target = allocated + batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.487692, "o", "    _, leaf_req, wc_hours, _ = compute_plan(product, target, snap_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.487776, "o", "    ratios = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.48793, "o", "    for leaf, gross in leaf_req.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.488017, "o", "        if gross > 0:\r\n\u001b[?2004l\r"]
[830.48804, "o", "\u001b[?2004h> "]
[830.488377, "o", "            ratios[leaf] = leaf_available_equiv(leaf, snap_parts) / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.488541, "o", "    for wc, gross in wc_hours.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.4887, "o", "        if gross > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.48883, "o", "            ratios[wc] = snap_wc[wc] / float(gross)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.488917, "o", "    best_id = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.489045, "o", "    best_ratio = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.489207, "o", "    for rid, ratio in ratios.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.489376, "o", "        if ratio < 1.0 - 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.489926, "o", "            if best_ratio is None or ratio < best_ratio - 1e-12 or (abs(ratio - best_ratio) <= 1e-12 and rid < best_id):\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.489956, "o", "> "]
[830.490096, "o", "                best_ratio = ratio\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.49012, "o", "> "]
[830.490247, "o", "                best_id = rid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.490391, "o", "    return best_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.490425, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.490484, "o", "> "]
[830.490575, "o", "report_orders = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.490702, "o", "for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.490728, "o", "> "]
[830.490857, "o", "    order_id = order['order_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.491079, "o", "    product = order['product']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.491172, "o", "    requested = order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.491281, "o", "    batch = parts[product]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[830.491385, "o", "> "]
[830.491482, "o", "    snap_parts = copy.deepcopy(parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.491652, "o", "    snap_wc = copy.deepcopy(workcenters)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[830.491677, "o", "> "]
[830.49191, "o", "    candidates = list(range(0, requested + 1, batch))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.492018, "o", "    max_alloc = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.49212, "o", "    max_plan = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.492249, "o", "    for target in candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.492463, "o", "        if feasible(product, target, parts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.492582, "o", "            max_alloc = target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.492819, "o", "            max_plan = compute_plan(product, target, parts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[830.492853, "o", "\u001b[?2004h> "]
[830.493055, "o", "    shortfall = requested - max_alloc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.493156, "o", "    if max_alloc / requested < 0.5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.493185, "o", "> "]
[830.493459, "o", "        lim = limiting_resource(product, max_alloc, batch, snap_parts, snap_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.493882, "o", "        report_orders.append({'order_id': order_id, 'allocated_qty': 0, 'shortfall_qty': requested, 'limiting_resource': lim})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.493975, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.494119, "o", "        lim = None\r\n\u001b[?2004l\r\u001b[?2004h>         if shortfall > 0:\r\n\u001b[?2004l\r"]
[830.494147, "o", "\u001b[?2004h> "]
[830.494517, "o", "            lim = limiting_resource(product, max_alloc, batch, snap_parts, snap_wc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.494995, "o", "        report_orders.append({'order_id': order_id, 'allocated_qty': max_alloc, 'shortfall_qty': shortfall, 'limiting_resource': lim})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.495145, "o", "        if max_alloc > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.495378, "o", "            execute_plan(product, max_alloc, max_plan)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.495597, "o", "report_orders.sort(key=lambda x: x['order_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.495795, "o", "with open('/app/report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.496029, "o", "    json.dump({'orders': report_orders}, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.496251, "o", "print(json.dumps({'orders': report_orders}, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[830.498917, "o", "\u001b[?2004hroot@93ec7a01-a954-4d1d-af50-47c61b603cc6:/app# "]
[830.498992, "o", "python3 /app/solve_final.py\r\n\u001b[?2004l\r"]
