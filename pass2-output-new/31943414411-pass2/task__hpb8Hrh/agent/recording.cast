[29.091266, "i", "python3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/app/manufacturing.db')\ncur = conn.cursor()\nprint('SCHEMA:')\nfor row in cur.execute(\"SELECT sql FROM sqlite_master WHERE type IN ('table','view') ORDER BY name\"):\n    print(row[0])\nprint('\\nPARTS:')\nfor row in cur.execute('SELECT * FROM parts'): print(row)\nprint('\\nBOM:')\nfor row in cur.execute('SELECT * FROM bom'): print(row)\nprint('\\nWORKCENTERS:')\nfor row in cur.execute('SELECT * FROM workcenters'): print(row)\nprint('\\nROUTING:')\nfor row in cur.execute('SELECT * FROM routing'): print(row)\nprint('\\nSUBSTITUTES:')\nfor row in cur.execute('SELECT * FROM substitutes'): print(row)\nprint('\\nORDERS:')\nfor row in cur.execute('SELECT * FROM orders ORDER BY priority, order_id'): print(row)\nconn.close()\nPY\n"]
