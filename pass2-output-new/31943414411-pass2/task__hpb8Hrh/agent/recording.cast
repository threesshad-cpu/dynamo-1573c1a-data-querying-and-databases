[396.856066, "i", " feasible(target,parts):\n    prod,leaf_req,wc,req=plan(product,target,parts)\n    for w,h in wc.items():\n        if h>workcenters[w]+1e-9: return False, prod,leaf_req,wc,req\n    if not satisfy_check(leaf_req,parts): return False, prod,leaf_req,wc,req\n    return True, prod,leaf_req,wc,req\n\nfor order in orders:\n    print('\\n=====', order['order_id'], order['product'], 'request', order['requested_qty'])\n    print('Before parts:', {k:parts[k]['on_hand'] for k in sorted(parts)})\n    print('Before wc:', workcenters)\n    snap_parts=copy.deepcopy(parts); snap_wc=copy.deepcopy(workcenters)\n    product=order['product']; qty=order['requested_qty']; batch=parts[product]['batch']\n    cand=list(range(0,qty+1,batch))\n    print('candidates', cand)\n    for target in cand:\n        ok,prod,leaf_req,wc,req=feasible(target,parts)\n        print(' target',target,'ok',ok)\n        if not ok:\n            print('   prod',prod,'leaf',leaf_req,'wc',wc,'req',dict(req))\n    # find max feasible\n    maxok=0; planok=None\n    for target in cand"]
