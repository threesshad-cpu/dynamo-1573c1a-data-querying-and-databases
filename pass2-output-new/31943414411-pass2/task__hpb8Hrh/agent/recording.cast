[553.992276, "o", "def execute_plan(plan, parts, leaf_parts, workcenters):\r\n\u001b[?2004l\r, ind\u001b[?2004h> "]
[553.992512, "o", "    production_qty, leaf_req, wc_hours, req_all = plan\r\n\u001b[?2004l\red\u001b[?2004h> "]
[553.992865, "o", "    ok, new_stock = satisfy_leaf_requirements(leaf_req, parts, leaf_parts)\r\n\u001b[?2004l\rNT\u001b[?2004h> "]
[553.992944, "o", "    if not ok:\r\n\u001b[?2004l\rr"]
[553.993004, "o", " \u001b[?2004h> "]
[553.993268, "o", "        raise RuntimeError('Cannot execute infeasible plan')\r\n\u001b[?2004l\rtho\u001b[?2004h> "]
[553.993412, "o", "    for pid in leaf_parts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.993541, "o", "        if pid in new_stock:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.993756, "o", "            parts[pid]['on_hand'] = new_stock[pid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.993925, "o", "    for pid, prod in production_qty.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.994046, "o", "        if pid in leaf_parts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.994133, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.994452, "o", "        parts[pid]['on_hand'] = parts[pid]['on_hand'] + prod - req_all.get(pid, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.994627, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.994713, "o", "        workcenters[wc] -= hours\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.994743, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
