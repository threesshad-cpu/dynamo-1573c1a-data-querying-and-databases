[338.913477, "o", "def topological_order(all_parts, bom_children):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.913822, "o", "    # parent -> child edges; topological order where parents precede children\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.913975, "o", "    indeg = {p: 0 for p in all_parts}\r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[338.914114, "o", "    out = defaultdict(list)\r\n\u001b[?2004l\rrts\u001b[?2004h> "]
[338.914348, "o", "    for parent, children in bom_children.items():\r\n\u001b[?2004l\r produ\u001b[?2004h> "]
[338.914487, "o", "        for c in children:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.914706, "o", "            out[parent].append(c['child'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.91488, "o", "            indeg[c['child']] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.915138, "o", "    q = deque([p for p in all_parts if indeg[p] == 0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.91518, "o", "    order = []\r\n\u001b[?2004l\r"]
[338.915215, "o", "\u001b[?2004h> "]
[338.915334, "o", "    while q:\r\n\u001b[?2004l\rcut\u001b[?2004h> "]
[338.915469, "o", "        p = q.popleft()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.915587, "o", "        order.append(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.91572, "o", "        for ch in out[p]:\r\n\u001b[?2004l\r"]
[338.915758, "o", "\u001b[?2004h> "]
[338.915819, "o", "            indeg[ch] -= 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.916022, "o", "            if indeg[ch] == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.91614, "o", "                q.append(ch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.916377, "o", "    if len(order) != len(all_parts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.916648, "o", "        raise ValueError('Cycle detected or missing part in BOM graph')\r\n\u001b[?2004l\rd)\r\n\u001b[?2004h> "]
[338.916724, "o", "    return order\r\n\u001b[?2004l\r"]
