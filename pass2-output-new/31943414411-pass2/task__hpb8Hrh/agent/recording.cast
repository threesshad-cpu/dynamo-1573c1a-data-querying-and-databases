[338.885691, "i", "cat > /app/solve.py <<'PY'\nimport sqlite3, math, copy, json\nfrom collections import defaultdict, deque\n\nDB_PATH = '/app/manufacturing.db'\n\n\ndef load_db(db_path):\n    conn = sqlite3.connect(db_path)\n    conn.row_factory = sqlite3.Row\n    cur = conn.cursor()\n    parts = {}\n    for r in cur.execute('SELECT part_id, name, on_hand_qty, batch_size FROM parts'):\n        parts[r['part_id']] = {'name': r['name'], 'on_hand': r['on_hand_qty'], 'batch': r['batch_size']}\n    bom_parents = defaultdict(list)\n    bom_children = defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\n        entry = {\n            'child': r['child_part_id'],\n            'qty_per': r['qty_per'],\n            'scrap_rate_pct': r['scrap_rate_pct'],\n            'setup_scrap_qty': r['setup_scrap_qty']\n        }\n        bom_children[r['parent_part_id']].append(entry)\n        bom_parents[r['child_part_id']].append(r['parent_part_id'])\n    workcenters = {}\n    for r in cur."]
