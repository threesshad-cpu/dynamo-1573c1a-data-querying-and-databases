[553.925758, "i", "lable_hours']\n    routing = defaultdict(list)\n    for r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\n        routing[r['parent_part_id']].append({\n            'workcenter': r['workcenter_id'],\n            'setup': r['setup_hours'],\n            'run': r['run_hours_per_unit']\n        })\n    substitutes = defaultdict(list)\n    for r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes'):\n        substitutes[r['primary_part_id']].append({\n            'sub': r['substitute_part_id'],\n            'ratio': r['qty_ratio'],\n            'rank': r['preference_rank']\n        })\n    for k in substitutes:\n        substitutes[k].sort(key=lambda x: (x['rank'], x['sub']))\n    orders = []\n    for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders ORDER BY priority, order_id'):\n        orders.append({\n            'order_id': r['order_id'],\n            'product': r['product_part_id'],\n  "]
[553.925788, "i", "          'requested_qty': r['requested_qty'],\n            'priority': r['priority']\n        })\n    conn.close()\n    return parts, dict(bom_children), workcenters, dict(routing), substitutes, orders\n\n\ndef topological_order(all_parts, bom_children):\n    indeg = {p: 0 for p in all_parts}\n    out = defaultdict(list)\n    for parent, children in bom_children.items():\n        for c in children:\n            out[parent].append(c['child'])\n            indeg[c['child']] += 1\n    q = deque(sorted([p for p in all_parts if indeg[p] == 0]))\n    order = []\n    while q:\n        p = q.popleft()\n        order.append(p)\n        for ch in out[p]:\n            indeg[ch] -= 1\n            if indeg[ch] == 0:\n                q.append(ch)\n        q = deque(sorted(q))\n    if len(order) != len(all_parts):\n        raise ValueError('Cycle detected or missing part in BOM graph: ' + str(order))\n    return order\n\n\ndef leaf_parts_set(parts, bom_children):\n    return {p for p in parts if p not in bom_children}\n\n\ndef compute_plan(product_id, tar"]
