[553.996521, "o", "def compute_limiting_resource(product_id, allocated_qty, batch_size, parts, bom_children, routing, topo_order, workcenters, substitutes, leaf_parts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.996701, "o", "    target = allocated_qty + batch_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.997065, "o", "    _, leaf_req, wc_hours, _ = compute_plan(product_id, target, parts, bom_children, routing, topo_order)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.997151, "o", "    ratios = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.99731, "o", "    for leaf_id, gross in leaf_req.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.997397, "o", "        if gross > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
