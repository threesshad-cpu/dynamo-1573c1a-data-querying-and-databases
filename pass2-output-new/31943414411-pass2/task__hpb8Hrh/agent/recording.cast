[396.855337, "i", "python3 - <<'PY'\nimport sqlite3, math, copy, json\nfrom collections import defaultdict, deque\n\nconn = sqlite3.connect('/app/manufacturing.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\nparts={}\nfor r in cur.execute('SELECT * FROM parts'):\n    parts[r['part_id']]={'name':r['name'],'on_hand':r['on_hand_qty'],'batch':r['batch_size']}\nbom_children=defaultdict(list)\nfor r in cur.execute('SELECT * FROM bom'):\n    bom_children[r['parent_part_id']].append({'child':r['child_part_id'],'qty_per':r['qty_per'],'scrap_rate_pct':r['scrap_rate_pct'],'setup_scrap_qty':r['setup_scrap_qty']})\nworkcenters={}\nfor r in cur.execute('SELECT * FROM workcenters'):\n    workcenters[r['workcenter_id']]=r['available_hours']\nrouting=defaultdict(list)\nfor r in cur.execute('SELECT * FROM routing'):\n    routing[r['parent_part_id']].append({'workcenter':r['workcenter_id'],'setup':r['setup_hours'],'run':r['run_hours_per_unit']})\nsubstitutes=defaultdict(list)\nfor r in cur.execute('SELECT * FROM substitutes'):\n    substitutes[r['primary_p"]
[396.855425, "i", "art_id']].append({'sub':r['substitute_part_id'],'ratio':r['qty_ratio'],'rank':r['preference_rank']})\nfor k in substitutes:\n    substitutes[k].sort(key=lambda x:(x['rank'],x['sub']))\norders=[]\nfor r in cur.execute('SELECT * FROM orders ORDER BY priority, order_id'):\n    orders.append({'order_id':r['order_id'],'product':r['product_part_id'],'requested_qty':r['requested_qty'],'priority':r['priority']})\nconn.close()\n\nleaf_parts=set(p for p in parts if p not in bom_children)\nprint('leaf_parts', sorted(leaf_parts))\n\ndef topo(parts,bom_children):\n    indeg={p:0 for p in parts}; out=defaultdict(list)\n    for parent in bom_children:\n        for c in bom_children[parent]:\n            out[parent].append(c['child']); indeg[c['child']]+=1\n    q=deque([p for p in parts if indeg[p]==0]); order=[]\n    while q:\n        p=q.popleft(); order.append(p)\n        for ch in out[p]:\n            indeg[ch]-=1\n            if indeg[ch]==0: q.append(ch)\n    return order\ntopo_order=topo(parts,bom_children)\nprint('topo', topo_order)\n\ndef pl"]
[396.855696, "i", "an(product, target, parts):\n    req=defaultdict(int); req[product]+=target\n    prod={}; leaf_req=defaultdict(int); wc=defaultdict(float)\n    leaf_parts_local=set(p for p in parts if p not in bom_children)\n    for pid in topo_order:\n        need=req.get(pid,0)\n        if need==0: continue\n        if pid in leaf_parts_local:\n            leaf_req[pid]+=need\n            continue\n        old=parts[pid]['on_hand']\n        make=need-old\n        if make<=0:\n            prod[pid]=0\n            continue\n        batch=parts[pid]['batch']\n        q=math.ceil(make/batch)*batch\n        prod[pid]=q\n        for rt in routing.get(pid,[]):\n            wc[rt['workcenter']]+=rt['setup']+q*rt['run']\n        for c in bom_children.get(pid,[]):\n            child_req=math.ceil(c['qty_per']*q*(1+c['scrap_rate_pct']/100.0))+c['setup_scrap_qty']\n            req[c['child']]+=child_req\n    leaf_req_final={pid:q for pid,q in req.items() if pid in leaf_parts_local and q>0}\n    return prod, leaf_req_final, dict(wc), dict(req)\n\ndef available_"]
[396.855737, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[396.855826, "i", "for_leaf_pool(leaf_id, parts):\n    avail=parts[leaf_id]['on_hand']\n    for s in substitutes.get(leaf_id,[]):\n        sub_stock=parts[s['sub']]['on_hand']\n        if s['ratio']>0:\n            avail += int(math.floor(sub_stock/s['ratio']))\n    return avail\n\ndef satisfy_check(leaf_req,parts):\n    stock={p:parts[p]['on_hand'] for p in leaf_parts}\n    remaining={}\n    for leaf,qty in leaf_req.items():\n        take=min(stock.get(leaf,0),qty); stock[leaf]-=take; rem=qty-take\n        if rem>0: remaining[leaf]=rem\n    for leaf in sorted(remaining):\n        rem=remaining[leaf]\n        for s in substitutes.get(leaf,[]):\n            if rem<=0: break\n            sub=s['sub']; sub_stock=stock.get(sub,0)\n            if sub_stock<=0: continue\n            can_primary=int(math.floor(sub_stock/s['ratio']))\n            use=min(rem,can_primary)\n            if use>0:\n                need_sub=int(math.ceil(use*s['ratio']))\n                stock[sub]-=need_sub; rem-=use\n        if rem>0:\n            return False\n    return True\n\ndef"]
