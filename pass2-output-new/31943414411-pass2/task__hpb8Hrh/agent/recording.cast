[338.917203, "o", "def plan_production(product_id, target_units, parts, bom_children, routing, topo_order):\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[338.917343, "o", "    req = defaultdict(int)\r\n\u001b[?2004l\r'o\u001b[?2004h> "]
[338.91753, "o", "    req[product_id] += target_units\r\n\u001b[?2004l\r.\u001b[?2004h> "]
[338.917654, "o", "    production_qty = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.917863, "o", "    leaf_req = defaultdict(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.918031, "o", "    wc_hours = defaultdict(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.91834, "o", "    leaf_parts = {pid for pid in parts if pid not in bom_children}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs[\u001b[?2004h> "]
[338.918484, "o", "    for part_id in topo_order:\r\n\u001b[?2004l\rlimi\u001b[?2004h> "]
[338.918683, "o", "        required = req.get(part_id, 0)\r\n\u001b[?2004l\rqty"]
[338.918722, "o", "\u001b[?2004h> "]
[338.91884, "o", "        if required == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.918978, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.919148, "o", "        if part_id in leaf_parts:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.919365, "o", "            leaf_req[part_id] += required\r\n\u001b[?2004l\rment for \u001b[?2004h> "]
[338.919458, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.919691, "o", "        old = parts[part_id]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.919853, "o", "        to_make = required - old\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.919979, "o", "        if to_make <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.920173, "o", "            production_qty[part_id] = 0\r\n\u001b[?2004l\rrget\u001b[?2004h> "]
[338.920322, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.920498, "o", "        batch = parts[part_id]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.954151, "o", "        prod = int(math.ceil(to_make / batch) * batch)\r\n\u001b[?2004l\r"]
[338.954182, "o", "\u001b[?2004h> "]
[338.954396, "o", "        production_qty[part_id] = prod\r\n\u001b[?2004l\rubstitu\u001b[?2004h> "]
[338.954572, "o", "        # hours for this production run\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[338.954789, "o", "        for rt in routing.get(part_id, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.95512, "o", "            wc_hours[rt['workcenter']] += rt['setup'] + prod * rt['run']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.955199, "o", "        # child demands\r\n\u001b[?2004l\r"]
[338.955225, "o", "\u001b[?2004h> "]
[338.955432, "o", "        for ch in bom_children.get(part_id, []):\r\n\u001b[?2004l\r"]
[338.955449, "o", "\u001b[?2004h> "]
[338.95563, "o", "            base = ch['qty_per'] * prod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.955896, "o", "            scrap_mult = 1.0 + ch['scrap_rate_pct'] / 100.0\r\n\u001b[?2004l\rid]\r\n   \u001b[?2004h> "]
[338.956239, "o", "            child_req = int(math.ceil(base * scrap_mult)) + ch['setup_scrap_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.956423, "o", "            req[ch['child']] += child_req\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.956812, "o", "    leaf_req_final = {pid: qty for pid, qty in req.items() if pid in leaf_parts and qty > 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.957088, "o", "    return production_qty, leaf_req_final, dict(wc_hours), dict(req)\r\n\u001b[?2004l\rid, rat\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.957149, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.957475, "o", "def satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes):\r\n\u001b[?2004l\rif best i\u001b[?2004h> "]
[338.957726, "o", "    \"\"\"Return (success, updated_leaf_stock_dict).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.958029, "o", "    leaf_stock = {pid: parts[pid]['on_hand'] for pid in leaf_parts}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.958122, "o", "    remaining = {}\r\n\u001b[?2004l\rur\u001b[?2004h"]
[338.958141, "o", "> "]
[338.958402, "o", "    # First reserve direct primary stock for each leaf demand.\r\n\u001b[?2004l\rout\u001b[?2004h> "]
[338.958622, "o", "    for leaf_id, qty in leaf_req.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.958836, "o", "        take = min(leaf_stock.get(leaf_id, 0), qty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.959127, "o", "        leaf_stock[leaf_id] = leaf_stock.get(leaf_id, 0) - take\r\n\u001b[?2004l\r   for o\u001b[?2004h> "]
[338.959233, "o", "        rem = qty - take\r\n\u001b[?2004l\r        o\u001b[?2004h> "]
[338.959342, "o", "        if rem > 0:\r\n\u001b[?2004l\rer['ord\u001b[?2004h> "]
[338.959563, "o", "            remaining[leaf_id] = rem\r\n\u001b[?2004l\r['p\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[338.959654, "o", "> "]
[338.959818, "o", "    # Then use substitutes for remaining shortages.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.960063, "o", "    # Process leaf ids in sorted order for determinism.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.960269, "o", "    for leaf_id in sorted(remaining.keys()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.960436, "o", "        shortage = remaining[leaf_id]\r\n\u001b[?2004l\ry.de\u001b[?2004h> "]
[338.960569, "o", "        if shortage <= 0:\r\n\u001b[?2004l\rrk\u001b[?2004h> "]
[338.960688, "o", "            continue\r\n\u001b[?2004l\ropy\u001b[?2004h> "]
[338.960905, "o", "        subs = substitutes.get(leaf_id, [])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961033, "o", "        for sub in subs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961167, "o", "            if shortage <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961286, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961447, "o", "            sub_id = sub['sub']\r\n\u001b[?2004l\rd\u001b[?2004h> "]
[338.961686, "o", "            sub_stock = leaf_stock.get(sub_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961845, "o", "            if sub_stock <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.961955, "o", "                continue\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[338.962103, "o", "            ratio = sub['ratio']\r\n\u001b[?2004l\r lo, hi =\u001b[?2004h> "]
[338.962376, "o", "            # how many primary units can this substitute cover?\r\n\u001b[?2004l\r  mid = \u001b[?2004h> "]
[338.962761, "o", "            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\r\n\u001b[?2004l\rct\u001b[?2004h> "]
[338.962984, "o", "            use_primary = min(shortage, can_primary)\r\n\u001b[?2004l\r"]
[338.962997, "o", "\u001b[?2004h> "]
[338.963171, "o", "            if use_primary <= 0:\r\n\u001b[?2004l\re\u001b[?2004h> "]
[338.963327, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.963567, "o", "            need_sub = int(math.ceil(use_primary * ratio))\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.963582, "o", "> "]
[338.963747, "o", "            if need_sub > sub_stock:\r\n\u001b[?2004l\rasi\u001b[?2004h> "]
[338.96392, "o", "                # adjust if necessary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.96419, "o", "                use_primary = int(math.floor(sub_stock / ratio))\r\n\u001b[?2004l\r  al\u001b[?2004h> "]
[338.964452, "o", "                need_sub = int(math.ceil(use_primary * ratio))\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.964466, "o", "> "]
[338.964725, "o", "            leaf_stock[sub_id] = sub_stock - need_sub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.964873, "o", "            shortage -= use_primary\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.964886, "o", "> "]
[338.965058, "o", "        remaining[leaf_id] = shortage\r\n\u001b[?2004l\rr)\r\n\r\n   \u001b[?2004h> "]
[338.965204, "o", "        if shortage > 0:\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[338.965362, "o", "            return False, None\r\n\u001b[?2004l\rule "]
[338.965377, "o", "\u001b[?2004h> "]
[338.965494, "o", "    return True, leaf_stock\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.965511, "o", "> \r\n\u001b[?2004l\r"]
[338.965587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.965605, "o", "\u001b[?2004h"]
[338.965659, "o", "> "]
[338.965911, "o", "def is_feasible(plan, parts, workcenters, leaf_parts, substitutes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966141, "o", "    production_qty, leaf_req, wc_hours, req_all = plan\r\n\u001b[?2004l\r     limi\u001b[?2004h> "]
[338.966329, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r(\r\n     \u001b[?2004h> "]
[338.96656, "o", "        if workcenters[wc] + 1e-9 < hours:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.966667, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.966682, "o", "> "]
[338.966999, "o", "    ok, _ = satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes)\r\n\u001b[?2004l\r"]
[338.967078, "o", "\u001b[?2004h> "]
[338.967096, "o", "    return ok\r\n\u001b[?2004l\r   \u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.967152, "o", " "]
[338.967171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[338.967449, "o", "def execute_plan(plan, parts, leaf_parts, substitutes, workcenters):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.967688, "o", "    production_qty, leaf_req, wc_hours, req_all = plan\r\n\u001b[?2004l\r"]
[338.967704, "o", "\u001b[?2004h> "]
[338.968081, "o", "    ok, new_leaf_stock = satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.96815, "o", "    if not ok:\r\n\u001b[?2004l\r"]
[338.968168, "o", "\u001b[?2004h> "]
[338.968398, "o", "        raise RuntimeError('Execution of infeasible plan')\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.968426, "o", "> "]
[338.968599, "o", "    # Update leaf stocks after consumption\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.968618, "o", "> "]
[338.968739, "o", "    for pid in leaf_parts:\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.968753, "o", "> "]
[338.968892, "o", "        if pid in new_leaf_stock:\r\n\u001b[?2004l\r"]
[338.968907, "o", "\u001b[?2004h> "]
[338.969165, "o", "            parts[pid]['on_hand'] = new_leaf_stock[pid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.969516, "o", "    # Update non-leaf inventories: old + produced - required (parents used required)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.969757, "o", "    for part_id, prod in production_qty.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.96989, "o", "        if part_id in leaf_parts:\r\n\u001b[?2004l\rt_o\u001b[?2004h"]
[338.969906, "o", "> "]
[338.970017, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.970173, "o", "        old = parts[part_id]['on_hand']\r\n\u001b[?2004l\r"]
[338.970189, "o", "\u001b[?2004h> "]
[338.970373, "o", "        required = req_all.get(part_id, 0)\r\n\u001b[?2004l\r      'sh\u001b[?2004h> "]
[338.970622, "o", "        parts[part_id]['on_hand'] = old + prod - required\r\n\u001b[?2004l\r: \u001b[?2004h> "]
[338.970761, "o", "    # Update workcenters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.97094, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r"]
[338.971058, "o", "\u001b[?2004h> "]
[338.971077, "o", "        workcenters[wc] -= hours\r\n\u001b[?2004l\r"]
[338.971097, "o", "\u001b[?2004h> "]
[338.971105, "o", "\r\n"]
[338.971195, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[338.971829, "o", "def compute_limiting_resource(product_id, allocated_qty, batch_size, parts, bom_children, routing, topo_order, workcenters, substitutes, leaf_parts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.972205, "o", "    # Gross requirement for one more batch than allocated; net out subassemblies, not leaf inventory.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.972409, "o", "    target = allocated_qty + batch_size\r\n\u001b[?2004l\rname__ ==\u001b[?2004h> "]
[338.972816, "o", "    plan = plan_production(product_id, target, parts, bom_children, routing, topo_order)\r\n\u001b[?2004l\rprint(j\u001b[?2004h> "]
[338.973036, "o", "    production_qty, leaf_req, wc_hours, _ = plan\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[338.973125, "o", "    ratios = {}\r\n\u001b[?2004l\r"]
[338.973149, "o", "\u001b[?2004h> "]
[338.973437, "o", "    # Leaves: available = own stock + substitute-equivalent stock\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.973566, "o", "    for leaf_id in leaf_req:\r\n\u001b[?2004l\rORKC\u001b[?2004h"]
[338.973589, "o", "> "]
[338.97381, "o", "        avail = parts[leaf_id]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.973985, "o", "        for sub in substitutes.get(leaf_id, []):\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.974002, "o", "> "]
[338.974208, "o", "            sub_stock = parts[sub['sub']]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.974358, "o", "            if sub['ratio'] > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.97459, "o", "                avail += int(math.floor(sub_stock / sub['ratio']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.974612, "o", "> "]
[338.97475, "o", "        gross = leaf_req[leaf_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.974846, "o", "        if gross > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975019, "o", "            ratios[leaf_id] = avail / gross\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975107, "o", "    # Workcenters\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975289, "o", "    for wc_id in wc_hours:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975386, "o", "        avail = workcenters[wc_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975519, "o", "        gross = wc_hours[wc_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975702, "o", "        if gross > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975886, "o", "            ratios[wc_id] = avail / gross\r\n\u001b[?2004l\r\u001b[?2004h>     lim = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.975999, "o", "    best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976129, "o", "    for rid, ratio in ratios.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976253, "o", "        if ratio < 1.0 - 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976584, "o", "            if best is None or ratio < best - 1e-12 or (abs(ratio-best) <= 1e-12 and rid < lim):\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.976601, "o", "> "]
[338.976724, "o", "                best = ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976835, "o", "                lim = rid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976903, "o", "    return lim\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.976976, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.976992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.97706, "o", "def solve():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.977396, "o", "    parts, bom_children, workcenters, routing, substitutes, orders, leaf_parts = load_db(DB_PATH)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.977655, "o", "    topo_order = topological_order(list(parts.keys()), bom_children)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.977757, "o", "    report_orders = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.977788, "o", "\u001b[?2004h> "]
[338.977909, "o", "    for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978053, "o", "        order_id = order['order_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978199, "o", "        product_id = order['product']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978354, "o", "        qty = order['requested_qty']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978509, "o", "        batch = parts[product_id]['batch']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978537, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978825, "o", "        # Snapshot parts before order for limiting-resource computation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.978994, "o", "        parts_before = copy.deepcopy(parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979198, "o", "        workcenters_before = copy.deepcopy(workcenters)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979215, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.979294, "o", "> "]
[338.979359, "o", "        candidates = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979446, "o", "        m = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979528, "o", "        while m < qty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979689, "o", "            candidates.append(m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979794, "o", "            m += batch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.979921, "o", "        candidates.append(qty)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.980089, "o", "        candidates = sorted(set(candidates))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.980168, "o", "\u001b[?2004h> "]
[338.980237, "o", "        feasible_target = -1\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.980252, "o", "> "]
[338.980376, "o", "        feasible_plan = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.980522, "o", "        lo, hi = 0, len(candidates)-1\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.980537, "o", "> "]
[338.980654, "o", "        while lo <= hi:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.980797, "o", "            mid = (lo + hi)//2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.980939, "o", "            target = candidates[mid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.98128, "o", "            plan = plan_production(product_id, target, parts, bom_children, routing, topo_order)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.981567, "o", "            if is_feasible(plan, parts, workcenters, leaf_parts, substitutes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.981734, "o", "                feasible_target = target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.981883, "o", "                feasible_plan = plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.982003, "o", "                lo = mid + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.982098, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.982213, "o", "                hi = mid - 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.982295, "o", "\u001b[?2004h> "]
[338.982403, "o", "        allocated = feasible_target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.982516, "o", "        if allocated < 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.982641, "o", "            allocated = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.983008, "o", "            feasible_plan = plan_production(product_id, allocated, parts, bom_children, routing, topo_order)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.983019, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.983067, "o", "> "]
[338.983184, "o", "        shortfall = qty - allocated\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.983248, "o", "\u001b[?2004h> "]
[338.983423, "o", "        # Cancel rule if allocated/requested < 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.983566, "o", "        if allocated / qty < 0.5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.983578, "o", "> "]
[338.98373, "o", "            allocated_effective = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.98387, "o", "            shortfall_effective = qty\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.984066, "o", "            limiting = compute_limiting_resource(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.98438, "o", "                product_id, 0, batch, parts_before, bom_children, routing, topo_order,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.984595, "o", "                workcenters_before, substitutes, leaf_parts\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.984606, "o", "> "]
[338.984688, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.984902, "o", "            # Do not consume any inventory or workcenters.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985042, "o", "            report_orders.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985193, "o", "                'order_id': order_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985423, "o", "                'allocated_qty': allocated_effective,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985618, "o", "                'shortfall_qty': shortfall_effective,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985793, "o", "                'limiting_resource': limiting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985859, "o", "            })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.985951, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[338.986017, "o", "\u001b[?2004h> "]
[338.98612, "o", "        if shortfall > 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[338.986134, "o", "> "]
[338.986364, "o", "            limiting = compute_limiting_resource(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.986732, "o", "                product_id, allocated, batch, parts_before, bom_children, routing, topo_order,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.98696, "o", "                workcenters_before, substitutes, leaf_parts\r\n\u001b[?2004l\r\u001b[?2004h> "]
[338.987014, "o", "            )\r\n\u001b[?2004l\r"]
[338.987057, "o", "\u001b[?2004h> "]
