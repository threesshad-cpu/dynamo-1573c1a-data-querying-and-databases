[338.885941, "i", "order_id'):\n        orders.append({\n            'order_id': r['order_id'],\n            'product': r['product_part_id'],\n            'requested_qty': r['requested_qty'],\n            'priority': r['priority']\n        })\n    conn.close()\n    leaf_parts = {pid for pid in parts if pid not in bom_children}\n    return parts, dict(bom_children), workcenters, dict(routing), substitutes, orders, leaf_parts\n\n\ndef topological_order(all_parts, bom_children):\n    # parent -> child edges; topological order where parents precede children\n    indeg = {p: 0 for p in all_parts}\n    out = defaultdict(list)\n    for parent, children in bom_children.items():\n        for c in children:\n            out[parent].append(c['child'])\n            indeg[c['child']] += 1\n    q = deque([p for p in all_parts if indeg[p] == 0])\n    order = []\n    while q:\n        p = q.popleft()\n        order.append(p)\n        for ch in out[p]:\n            indeg[ch] -= 1\n            if indeg[ch] == 0:\n                q.append(ch)\n    if len(order) != len(all_pa"]
[338.885973, "i", "rts):\n        raise ValueError('Cycle detected or missing part in BOM graph')\n    return order\n\n\ndef plan_production(product_id, target_units, parts, bom_children, routing, topo_order):\n    req = defaultdict(int)\n    req[product_id] += target_units\n    production_qty = {}\n    leaf_req = defaultdict(int)\n    wc_hours = defaultdict(float)\n    leaf_parts = {pid for pid in parts if pid not in bom_children}\n\n    for part_id in topo_order:\n        required = req.get(part_id, 0)\n        if required == 0:\n            continue\n        if part_id in leaf_parts:\n            leaf_req[part_id] += required\n            continue\n        old = parts[part_id]['on_hand']\n        to_make = required - old\n        if to_make <= 0:\n            production_qty[part_id] = 0\n            continue\n        batch = parts[part_id]['batch']\n        prod = int(math.ceil(to_make / batch) * batch)\n        production_qty[part_id] = prod\n        # hours for this production run\n        for rt in routing.get(part_id, []):\n            wc_hours[rt['w"]
[338.886033, "i", "orkcenter']] += rt['setup'] + prod * rt['run']\n        # child demands\n        for ch in bom_children.get(part_id, []):\n            base = ch['qty_per'] * prod\n            scrap_mult = 1.0 + ch['scrap_rate_pct'] / 100.0\n            child_req = int(math.ceil(base * scrap_mult)) + ch['setup_scrap_qty']\n            req[ch['child']] += child_req\n    leaf_req_final = {pid: qty for pid, qty in req.items() if pid in leaf_parts and qty > 0}\n    return production_qty, leaf_req_final, dict(wc_hours), dict(req)\n\n\ndef satisfy_leaf_requirements(leaf_req, leaf_parts, parts, substitutes):\n    \"\"\"Return (success, updated_leaf_stock_dict).\"\"\"\n    leaf_stock = {pid: parts[pid]['on_hand'] for pid in leaf_parts}\n    remaining = {}\n    # First reserve direct primary stock for each leaf demand.\n    for leaf_id, qty in leaf_req.items():\n        take = min(leaf_stock.get(leaf_id, 0), qty)\n        leaf_stock[leaf_id] = leaf_stock.get(leaf_id, 0) - take\n        rem = qty - take\n        if rem > 0:\n            remaining[leaf_id] = rem\n"]
