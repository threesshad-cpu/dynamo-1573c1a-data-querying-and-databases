[553.995032, "o", "def available_leaf_equivalent(leaf_id, parts, substitutes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.995198, "o", "    avail = parts[leaf_id]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.995359, "o", "    for sub in substitutes.get(leaf_id, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.995534, "o", "        sub_stock = parts[sub['sub']]['on_hand']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.995685, "o", "        if sub['ratio'] > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.995883, "o", "            avail += int(math.floor(sub_stock / sub['ratio']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.99597, "o", "    return avail\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
