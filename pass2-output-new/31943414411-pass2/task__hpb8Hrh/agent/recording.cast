[553.99885, "o", "    for rid, ratio in ratios.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.999046, "o", "        if ratio < 1.0 - 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.999406, "o", "            if best is None or ratio < best - 1e-12 or (abs(ratio - best) <= 1e-12 and rid < lim):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.999564, "o", "                best = ratio\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.999691, "o", "                lim = rid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.999769, "o", "    return lim\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
