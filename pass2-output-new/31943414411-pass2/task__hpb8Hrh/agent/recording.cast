[1394.744002, "i", "python3 - <<'PY'\nimport sqlite3\nconn = sqlite3.connect('/app/manufacturing.db')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\nprint('Current parts state from DB (initial):')\nfor row in cur.execute('SELECT * FROM parts'):\n    print(dict(row))\nprint('Workcenters:')\nfor row in cur.execute('SELECT * FROM workcenters'):\n    print(dict(row))\nconn.close()\nPY\n"]
