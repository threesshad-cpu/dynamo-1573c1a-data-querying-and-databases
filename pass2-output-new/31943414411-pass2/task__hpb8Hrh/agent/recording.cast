[553.932717, "o", "        parts[r['part_id']] = {'name': r['name'], 'on_hand': r['on_hand_qty'], 'batch': r['batch_size']}\r\n\u001b[?2004l\r"]
[553.932788, "o", "\u001b[?2004h> "]
[553.933188, "o", "    bom_children = defaultdict(list)\r\n\u001b[?2004l\r"]
[553.933223, "o", "\u001b[?2004h"]
[553.933305, "o", "> "]
[553.934391, "o", "    for r in cur.execute('SELECT parent_part_id, child_part_id, qty_per, scrap_rate_pct, setup_scrap_qty FROM bom'):\r\n\u001b[?2004l\r"]
[553.934475, "o", "\u001b[?2004h> "]
[553.93501, "o", "        bom_children[r['parent_part_id']].append({\r\n\u001b[?2004l\r"]
[553.935119, "o", "\u001b[?2004h> "]
[553.935494, "o", "            'child': r['child_part_id'],\r\n\u001b[?2004l\ri\u001b[?2004h"]
[553.935527, "o", "> "]
[553.93593, "o", "            'qty_per': r['qty_per'],\r\n\u001b[?2004l\r"]
[553.936067, "o", "\u001b[?2004h> "]
[553.936509, "o", "            'scrap_rate_pct': r['scrap_rate_pct'],\r\n\u001b[?2004l\r"]
[553.936583, "o", "\u001b[?2004h> "]
[553.937326, "o", "            'setup_scrap_qty': r['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[553.937356, "o", "\u001b[?2004h> "]
[553.93758, "o", "        })\r\n\u001b[?2004l\r \u001b[?2004h"]
[553.937616, "o", "> "]
[553.93792, "o", "    workcenters = {}\r\n\u001b[?2004l\r"]
[553.938033, "o", "\u001b[?2004h> "]
[553.939043, "o", "    for r in cur.execute('SELECT workcenter_id, name, available_hours FROM workcenters'):\r\n\u001b[?2004l\r"]
[553.939074, "o", "\u001b[?2004h> "]
[553.939762, "o", "        workcenters[r['workcenter_id']] = r['available_hours']\r\n\u001b[?2004l\rs\u001b[?2004h"]
[553.939789, "o", "> "]
[553.940162, "o", "    routing = defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.940272, "o", "> "]
[553.941297, "o", "    for r in cur.execute('SELECT parent_part_id, workcenter_id, setup_hours, run_hours_per_unit FROM routing'):\r\n\u001b[?2004l\rne\u001b[?2004h"]
[553.941332, "o", "> "]
[553.941873, "o", "        routing[r['parent_part_id']].append({\r\n\u001b[?2004l\r"]
[553.941963, "o", "\u001b[?2004h> "]
[553.942482, "o", "            'workcenter': r['workcenter_id'],\r\n\u001b[?2004l\r"]
[553.942513, "o", "\u001b[?2004h> "]
[553.943035, "o", "            'setup': r['setup_hours'],\r\n\u001b[?2004l\r"]
[553.943143, "o", "\u001b[?2004h> "]
[553.943569, "o", "            'run': r['run_hours_per_unit']\r\n\u001b[?2004l\r"]
[553.943599, "o", "\u001b[?2004h"]
[553.94374, "o", ">         })\r\n\u001b[?2004l\r"]
[553.943802, "o", "\u001b[?2004h> "]
[553.944224, "o", "    substitutes = defaultdict(list)\r\n\u001b[?2004l\r"]
[553.944249, "o", "\u001b[?2004h> "]
[553.945804, "o", "    for r in cur.execute('SELECT primary_part_id, substitute_part_id, qty_ratio, preference_rank FROM substitutes'):\r\n\u001b[?2004l\r"]
[553.945891, "o", "\u001b[?2004h> "]
[553.946476, "o", "        substitutes[r['primary_part_id']].append({\r\n\u001b[?2004l\r"]
[553.94657, "o", "\u001b[?2004h> "]
[553.947033, "o", "            'sub': r['substitute_part_id'],\r\n\u001b[?2004l\r"]
[553.947092, "o", "\u001b[?2004h> "]
[553.947461, "o", "            'ratio': r['qty_ratio'],\r\n\u001b[?2004l\r"]
[553.947488, "o", "\u001b[?2004h> "]
[553.947971, "o", "            'rank': r['preference_rank']\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.948049, "o", "> "]
[553.948127, "o", "        })\r\n\u001b[?2004l\r"]
[553.948186, "o", "\u001b[?2004h> "]
[553.948471, "o", "    for k in substitutes:\r\n\u001b[?2004l\ra\u001b[?2004h"]
[553.948508, "o", "> "]
[553.949173, "o", "        substitutes[k].sort(key=lambda x: (x['rank'], x['sub']))\r\n\u001b[?2004l\r"]
[553.949204, "o", "\u001b[?2004h> "]
[553.94942, "o", "    orders = []\r\n\u001b[?2004l\r_a\u001b[?2004h"]
[553.949491, "o", "> "]
[553.95092, "o", "    for r in cur.execute('SELECT order_id, product_part_id, requested_qty, priority FROM orders ORDER BY priority, order_id'):\r\n\u001b[?2004l\r(\u001b[?2004h"]
[553.951026, "o", "> "]
[553.951254, "o", "        orders.append({\r\n\u001b[?2004l\rb\u001b[?2004h"]
[553.951286, "o", "> "]
[553.951716, "o", "            'order_id': r['order_id'],\r\n\u001b[?2004l\r"]
[553.951803, "o", "\u001b[?2004h> "]
[553.952402, "o", "            'product': r['product_part_id'],\r\n\u001b[?2004l\r"]
[553.952489, "o", "\u001b[?2004h> "]
[553.953131, "o", "            'requested_qty': r['requested_qty'],\r\n\u001b[?2004l\r"]
[553.953244, "o", "\u001b[?2004h> "]
[553.953632, "o", "            'priority': r['priority']\r\n\u001b[?2004l\r"]
[553.953698, "o", "\u001b[?2004h> "]
[553.953826, "o", "        })\r\n\u001b[?2004l\r"]
[553.953855, "o", "\u001b[?2004h> "]
[553.954078, "o", "    conn.close()\r\n\u001b[?2004l\r   "]
[553.954143, "o", "\u001b[?2004h"]
[553.954173, "o", "> "]
[553.95507, "o", "    return parts, dict(bom_children), workcenters, dict(routing), substitutes, orders\r\n\u001b[?2004l\r"]
[553.955179, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[553.955241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.955342, "o", "\u001b[?2004h> "]
[553.955837, "o", "def topological_order(all_parts, bom_children):\r\n\u001b[?2004l\r:\r\n"]
[553.955865, "o", "\u001b[?2004h> "]
[553.956313, "o", "    indeg = {p: 0 for p in all_parts}\r\n\u001b[?2004l\rdef\u001b[?2004h"]
[553.956345, "o", "> "]
[553.956705, "o", "    out = defaultdict(list)\r\n\u001b[?2004l\r"]
[553.956738, "o", "\u001b[?2004h> "]
[553.957266, "o", "    for parent, children in bom_children.items():\r\n\u001b[?2004l\r"]
[553.957294, "o", "\u001b[?2004h> "]
[553.957607, "o", "        for c in children:\r\n\u001b[?2004l\r"]
[553.95769, "o", "\u001b[?2004h> "]
[553.958115, "o", "            out[parent].append(c['child'])\r\n\u001b[?2004l\r"]
[553.958196, "o", "\u001b[?2004h> "]
[553.958579, "o", "            indeg[c['child']] += 1\r\n\u001b[?2004l\rh\u001b[?2004h> "]
[553.959443, "o", "    q = deque(sorted([p for p in all_parts if indeg[p] == 0]))\r\n\u001b[?2004l\r"]
[553.959532, "o", "\u001b[?2004h> "]
[553.959749, "o", "    order = []\r\n\u001b[?2004l\r"]
[553.959851, "o", "\u001b[?2004h> "]
[553.96002, "o", "    while q:\r\n\u001b[?2004l\r"]
[553.960122, "o", "\u001b[?2004h> "]
[553.960331, "o", "        p = q.popleft()\r\n\u001b[?2004l\r"]
[553.960358, "o", "\u001b[?2004h> "]
[553.96068, "o", "        order.append(p)\r\n\u001b[?2004l\rr"]
[553.960709, "o", "\u001b[?2004h> "]
[553.961014, "o", "        for ch in out[p]:\r\n\u001b[?2004l\r"]
[553.961043, "o", "\u001b[?2004h> "]
[553.961333, "o", "            indeg[ch] -= 1\r\n\u001b[?2004l\r"]
[553.96137, "o", "\u001b[?2004h> "]
[553.961764, "o", "            if indeg[ch] == 0:\r\n\u001b[?2004l\r"]
[553.961792, "o", "\u001b[?2004h> "]
[553.962127, "o", "                q.append(ch)\r\n\u001b[?2004l\res\u001b[?2004h"]
[553.962156, "o", "> "]
[553.962518, "o", "        q = deque(sorted(q))\r\n\u001b[?2004l\ra\u001b[?2004h"]
[553.962576, "o", "> "]
[553.962969, "o", "    if len(order) != len(all_parts):\r\n\u001b[?2004l\r"]
[553.963051, "o", "\u001b[?2004h> "]
[553.963983, "o", "        raise ValueError('Cycle detected or missing part in BOM graph: ' + str(order))\r\n\u001b[?2004l\r"]
[553.964071, "o", "\u001b[?2004h> "]
[553.964255, "o", "    return order\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.964283, "o", "> \r\n\u001b[?2004l\rs"]
[553.964365, "o", "\u001b[?2004h"]
[553.964403, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[553.964914, "o", "def leaf_parts_set(parts, bom_children):\r\n\u001b[?2004l\ri\u001b[?2004h"]
[553.96496, "o", "> "]
[553.965505, "o", "    return {p for p in parts if p not in bom_children}\r\n\u001b[?2004l\r"]
[553.965533, "o", "\u001b[?2004h> "]
[553.965621, "o", "\r\n\u001b[?2004l\r"]
[553.965705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.965806, "o", "\u001b[?2004h> "]
[553.966901, "o", "def compute_plan(product_id, target_units, parts, bom_children, routing, topo_order):\r\n\u001b[?2004l\r"]
[553.967003, "o", "\u001b[?2004h> "]
[553.967274, "o", "    req = defaultdict(int)\r\n\u001b[?2004l\r"]
[553.967354, "o", "\u001b[?2004h> "]
[553.967728, "o", "    req[product_id] += target_units\r\n\u001b[?2004l\r"]
[553.967763, "o", "\u001b[?2004h> "]
[553.968038, "o", "    production_qty = {}\r\n\u001b[?2004l\r  \u001b[?2004h"]
[553.968071, "o", "> "]
[553.96841, "o", "    leaf_req = defaultdict(int)\r\n\u001b[?2004l\r"]
[553.968513, "o", "\u001b[?2004h> "]
[553.968861, "o", "    wc_hours = defaultdict(float)\r\n\u001b[?2004l\re\u001b[?2004h"]
[553.96889, "o", "> "]
[553.96949, "o", "    leafs = {p for p in parts if p not in bom_children}\r\n\u001b[?2004l\r\r\n \u001b[?2004h"]
[553.969518, "o", "> "]
[553.969871, "o", "    for part_id in topo_order:\r\n\u001b[?2004l\r2:\r\n\u001b[?2004h"]
[553.969901, "o", "> "]
[553.97032, "o", "        required = req.get(part_id, 0)\r\n\u001b[?2004l\r"]
[553.970385, "o", "\u001b[?2004h> "]
[553.970749, "o", "        if required == 0:\r\n\u001b[?2004l\r"]
[553.970783, "o", "\u001b[?2004h> "]
[553.971051, "o", "            continue\r\n\u001b[?2004l\rd\u001b[?2004h"]
[553.971122, "o", "> "]
[553.971387, "o", "        if part_id in leafs:\r\n\u001b[?2004l\r"]
[553.971471, "o", "\u001b[?2004h> "]
[553.971902, "o", "            leaf_req[part_id] = required\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.971929, "o", "> "]
[553.972184, "o", "            continue\r\n\u001b[?2004l\ro"]
[553.972213, "o", "\u001b[?2004h> "]
[553.972727, "o", "        stock = parts[part_id]['on_hand']\r\n\u001b[?2004l\r"]
[553.972814, "o", "\u001b[?2004h> "]
[553.973248, "o", "        to_make = required - stock\r\n\u001b[?2004l\r"]
[553.973335, "o", "\u001b[?2004h> "]
[553.973707, "o", "        if to_make <= 0:\r\n\u001b[?2004l\r"]
[553.973789, "o", "\u001b[?2004h> "]
[553.974224, "o", "            production_qty[part_id] = 0\r\n\u001b[?2004l\rr"]
[553.974252, "o", "\u001b[?2004h> "]
[553.974495, "o", "            continue\r\n\u001b[?2004l\r"]
[553.974523, "o", "\u001b[?2004h> "]
[553.975002, "o", "        batch = parts[part_id]['batch']\r\n\u001b[?2004l\ril\u001b[?2004h"]
[553.97503, "o", "> "]
[553.975729, "o", "        prod = int(math.ceil(to_make / float(batch)) * batch)\r\n\u001b[?2004l\r"]
[553.975763, "o", "\u001b[?2004h> "]
[553.976228, "o", "        production_qty[part_id] = prod\r\n\u001b[?2004l\rp\u001b[?2004h"]
[553.976259, "o", "> "]
[553.976721, "o", "        for rt in routing.get(part_id, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.977581, "o", "            wc_hours[rt['workcenter']] += rt['setup'] + prod * rt['run']\r\n\u001b[?2004l\r"]
[553.977617, "o", "\u001b[?2004h> "]
[553.978163, "o", "        for child in bom_children.get(part_id, []):\r\n\u001b[?2004l\ro\u001b[?2004h"]
[553.978191, "o", "> "]
[553.978666, "o", "            base = child['qty_per'] * prod\r\n\u001b[?2004l\r"]
[553.978696, "o", "\u001b[?2004h> "]
[553.980021, "o", "            child_req = int(math.ceil(base * (1.0 + child['scrap_rate_pct'] / 100.0))) + child['setup_scrap_qty']\r\n\u001b[?2004l\r"]
[553.98016, "o", "\u001b[?2004h> "]
[553.980697, "o", "            req[child['child']] += child_req\r\n\u001b[?2004l\r"]
[553.980783, "o", "\u001b[?2004h> "]
[553.981646, "o", "    leaf_req_final = {pid: qty for pid, qty in req.items() if pid in leafs and qty > 0}\r\n\u001b[?2004l\r"]
[553.981677, "o", "\u001b[?2004h> "]
[553.982427, "o", "    return production_qty, leaf_req_final, dict(wc_hours), dict(req)\r\n\u001b[?2004l\r"]
[553.982456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[553.98254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[553.982705, "o", "\u001b[?2004h> "]
[553.983287, "o", "def satisfy_leaf_requirements(leaf_req, parts, leaf_parts):\r\n\u001b[?2004l\rts\u001b[?2004h"]
[553.983316, "o", "> "]
[553.983978, "o", "    stock = {pid: parts[pid]['on_hand'] for pid in leaf_parts}\r\n\u001b[?2004l\r"]
[553.984078, "o", "\u001b[?2004h> "]
[553.984275, "o", "    remaining = {}\r\n\u001b[?2004l\r"]
[553.984314, "o", "\u001b[?2004h"]
[553.984415, "o", "> "]
[553.984892, "o", "    for leaf_id, qty in leaf_req.items():\r\n\u001b[?2004l\r \u001b[?2004h"]
[553.984921, "o", "> "]
[553.985379, "o", "        take = min(stock.get(leaf_id, 0), qty)\r\n\u001b[?2004l\r"]
[553.985408, "o", "\u001b[?2004h> "]
[553.986005, "o", "        stock[leaf_id] = stock.get(leaf_id, 0) - take\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.986231, "o", "        rem = qty - take\r\n\u001b[?2004l\r \u001b[?2004h"]
[553.98626, "o", "> "]
[553.986432, "o", "        if rem > 0:\r\n\u001b[?2004l\r"]
[553.986459, "o", "\u001b[?2004h"]
[553.986576, "o", "> "]
[553.98679, "o", "            remaining[leaf_id] = rem\r\n\u001b[?2004l\r"]
[553.986819, "o", "\u001b[?2004h> "]
[553.98706, "o", "    for leaf_id in sorted(remaining):\r\n\u001b[?2004l\r \u001b[?2004h"]
[553.987088, "o", "> "]
[553.987252, "o", "        shortage = remaining[leaf_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.987448, "o", "        for sub in substitutes.get(leaf_id, []):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.987623, "o", "            if shortage <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.987745, "o", "                break\r\n\u001b[?2004l\r: o\u001b[?2004h> "]
[553.987888, "o", "            sub_id = sub['sub']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.988092, "o", "            sub_stock = stock.get(sub_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.988258, "o", "            if sub_stock <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.988386, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.98858, "o", "            ratio = sub['ratio']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.988908, "o", "            can_primary = int(math.floor(sub_stock / ratio)) if ratio > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.989141, "o", "            use = min(shortage, can_primary)\r\n\u001b[?2004l\rn, routi\u001b[?2004h> "]
[553.98926, "o", "            if use <= 0:\r\n\u001b[?2004l\rbs\u001b[?2004h"]
[553.989289, "o", "> "]
[553.989384, "o", "                continue\r\n\u001b[?2004l\rarts\r\n     \u001b[?2004h> "]
[553.989606, "o", "            need_sub = int(math.ceil(use * ratio))\r\n\u001b[?2004l\r"]
[553.989633, "o", "\u001b[?2004h> "]
[553.989829, "o", "            stock[sub_id] = sub_stock - need_sub\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.98996, "o", "            shortage -= use\r\n\u001b[?2004l\r'li\u001b[?2004h> "]
[553.990156, "o", "        remaining[leaf_id] = shortage\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.990259, "o", "        if shortage > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.990429, "o", "            return False, None\r\n\u001b[?2004l\rst_p\u001b[?2004h> "]
[553.990536, "o", "    return True, stock\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[553.990625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.990912, "o", "def is_feasible(plan, parts, workcenters, leaf_parts, substitutes):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.991063, "o", "    _, leaf_req, wc_hours, _ = plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.991239, "o", "    for wc, hours in wc_hours.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.991472, "o", "        if hours > workcenters[wc] + 1e-12:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.991619, "o", "            return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.99188, "o", "    ok, _ = satisfy_leaf_requirements(leaf_req, parts, leaf_parts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.991965, "o", "    return ok\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rn"]
[553.991993, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rt"]
