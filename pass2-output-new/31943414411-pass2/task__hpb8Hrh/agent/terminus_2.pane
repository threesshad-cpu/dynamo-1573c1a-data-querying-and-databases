[?2004lan(product, target, parts):
    req=defaultdict(int); req[product]+=target
    prod={}; leaf_req=defaultdict(int); wc=defaultdict(float)
    leaf_parts_local=set(p for p in parts if p not in bom_children)
    for pid in topo_order:
        need=req.get(pid,0)
        if need==0: continue
        if pid in leaf_parts_local:
            leaf_req[pid]+=need
            continue
        old=parts[pid]['on_hand']
        make=need-old
        if make<=0:
            prod[pid]=0
            continue
        batch=parts[pid]['batch']
        q=math.ceil(make/batch)*batch
        prod[pid]=q
        for rt in routing.get(pid,[]):
            wc[rt['workcenter']]+=rt['setup']+q*rt['run']
        for c in bom_children.get(pid,[]):
            child_req=math.ceil(c['qty_per']*q*(1+c['scrap_rate_pct']/100.0))+c['setup_scrap_qty']
            req[c['child']]+=child_req
    leaf_req_final={pid:q for pid,q in req.items() if pid in leaf_parts_local and q>0}
    return prod, leaf_req_final, dict(wc), dict(req)

def available_for_leaf_pool(leaf_id, parts):
    avail=parts[leaf_id]['on_hand']
    for s in substitutes.get(leaf_id,[]):
        sub_stock=parts[s['sub']]['on_hand']
        if s['ratio']>0:
            avail += int(math.floor(sub_stock/s['ratio']))
    return avail

def satisfy_check(leaf_req,parts):
    stock={p:parts[p]['on_hand'] for p in leaf_parts}
    remaining={}
    for leaf,qty in leaf_req.items():
        take=min(stock.get(leaf,0),qty); stock[leaf]-=take; rem=qty-take
        if rem>0: remaining[leaf]=rem
    for leaf in sorted(remaining):
        rem=remaining[leaf]
        for s in substitutes.get(leaf,[]):
            if rem<=0: break
            sub=s['sub']; sub_stock=stock.get(sub,0)
            if sub_stock<=0: continue
            can_primary=int(math.floor(sub_stock/s['ratio']))
            use=min(rem,can_primary)
            if use>0:
                need_sub=int(math.ceil(use*s['ratio']))
                stock[sub]-=need_sub; rem-=use
        if rem>0:
            return False
    return True

